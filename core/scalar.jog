@intrinsic(int, signed: false, bits: 8)
type u8: byte

@intrinsic(int, signed: true, bits: 8)
type i8: byte

@intrinsic(int, signed: false, bits: 16)
type u16: [2]byte

@intrinsic(int, signed: true, bits: 16)
type i16: [2]byte

@intrinsic(int, signed: false, bits: 32)
type u32: [4]byte

@intrinsic(int, signed: true, bits: 32)
type i32: [4]byte

@intrinsic(int, signed: false, bits: 64)
type u64: [8]byte

@intrinsic(int, signed: true, bits: 64)
type i64: [8]byte

@intrinsic(int, signed: false, bits: ptr)
type usize: [ptr]byte

@intrinsic(int, signed: true, bits: ptr)
type isize: [ptr]byte

@intrinsic(float, bits: 32)
type f32: [4]byte

@intrinsic(float, bits: 64)
type f64: [8]byte

@intrinsic(bool)
type bool: byte

type rune: u32

type bytes = []byte
type str: []const byte

// Operator methods. Each body is one intrinsic.

fn i8.op+(o: i8): i8 = @add(self, o)
fn i8.op-(o: i8): i8 = @sub(self, o)
fn i8.op*(o: i8): i8 = @mul(self, o)
fn i8.op/(o: i8): i8 = @div(self, o)
fn i8.op%(o: i8): i8 = @rem(self, o)
fn i8.op&(o: i8): i8 = @and(self, o)
fn i8.op|(o: i8): i8 = @or(self, o)
fn i8.op^(o: i8): i8 = @xor(self, o)
fn i8.op<<(o: i8): i8 = @shl(self, o)
fn i8.op>>(o: i8): i8 = @shr(self, o)
fn i8.op==(o: i8): bool = @eq(self, o)
fn i8.op!=(o: i8): bool = @ne(self, o)
fn i8.op<(o: i8): bool = @lt(self, o)
fn i8.op<=(o: i8): bool = @le(self, o)
fn i8.op>(o: i8): bool = @gt(self, o)
fn i8.op>=(o: i8): bool = @ge(self, o)
fn i8.op-(): i8 = @neg(self)
fn i8.op~(): i8 = @bitnot(self)

