fn bool.op==(o: bool): bool = @eq(self, o)
fn bool.op!=(o: bool): bool = @ne(self, o)
fn bool.op!(): bool = @not(self)

struct void {}

enum Option<T> {
    None
    Some(value: T)
}

enum Ordering: i8 {
    Less = -1
    Equal = 0
    Greater = 1
}

interface error {
    fn message(): str
}
