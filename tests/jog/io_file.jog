// expect: ok

import std.mem
import std.io

fn main() {
    var raw: bytes[3]
    val p = raw[..].ptr
    *p = 1
    *(p + 1) = 2
    *(p + 2) = 3
    val view = raw[..]
    if !io.write_all("io_file.bin", view) {
        return
    }
    val (got, ok) = io.read_all("io_file.bin")
    if !ok || got.len != view.len || *got.ptr != 1 || *(got.ptr + 1) != 2 || *(got.ptr + 2) != 3 {
        return
    }
    io.println("ok")
}
