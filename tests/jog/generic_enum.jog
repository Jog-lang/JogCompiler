// expect: ok

extern {
    fn puts(s: *const c_char): c_int
}

type c_char = i8
type c_int = i32

enum Result<T> {
    Ok(value: T)
    Err(code: i32)
}

fn make<T>(x: T): Result<T> {
    return Result<T>.Ok(value: x)
}

fn take(r: Result<i32>): i32 {
    return when r {
        Ok(value) -> value
        Err(code) -> code
    }
}

fn main() {
    var a = make<i32>(4)
    var b = Result<i32>.Err(code: 2)
    if take(a) == 4 && take(b) == 2 {
        if puts(c"ok") < 0 {
            return
        }
    }
}
