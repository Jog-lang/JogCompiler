// expect: 30
// expect: 2
// expect: 1
// expect: 4
// expect: 9
// expect: 0
// expect: 1
// expect: 1

import std.mem

extern {
    fn printf(fmt: *const c_char, ...): c_int
}

type c_char = i8
type c_int = i32

fn move(pp: **i32): i32 {
    *pp += 4
    return 1
}

fn main() {
    var xs = [8]i32(10, 20, 30, 40, 50, 60, 70, 80)
    var p: *i32 = &xs[0]
    var pp: **i32 = &p
    scope {
        val stepped = go with (mem.heap()) {
            p += 3
            p -= 1
        }
        stepped.join()
        val at: i32 = (p - &xs[0]) as i32
        if printf(c"%d\n", *p) < 0 {
            return
        }
        if printf(c"%d\n", at) < 0 {
            return
        }

        p = &xs[0]
        val nudged = go with (mem.heap()) {
            p += move(pp)
        }
        nudged.join()
        val moved: i32 = (p - &xs[0]) as i32
        if printf(c"%d\n", moved) < 0 {
            return
        }

        val task = go with (mem.heap()) {
            var lo: i32 = 4
            var hi: i32 = 9
            if true {
                return lo, hi
            }
            return 1, 2
        }
        val (lo, hi) = task.join()
        if printf(c"%d\n", lo) < 0 {
            return
        }
        if printf(c"%d\n", hi) < 0 {
            return
        }
    }

    var saw: i32 = 0
    var scope_flag: i32 = 0
    val scope_err = scope {
        val ch = Chan<i32>.init(0) with (mem.heap())
        ch.close()
        val task = go with (mem.heap()) {
            val (v, err) = ch.recv()
            return v, err
        }
        val (v, err) = task.join()
        if printf(c"%d\n", v) < 0 {
            return
        }
        if err != null {
            saw = 1
        }
    }
    if printf(c"%d\n", saw) < 0 {
        return
    }
    if scope_err != null {
        scope_flag = 1
    }
    if printf(c"%d\n", scope_flag) < 0 {
        return
    }
}
