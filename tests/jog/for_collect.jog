// expect: ok

extern {
    fn puts(s: *const c_char): c_int
}

type c_char = i8
type c_int = i32

fn keep(b: bytes[1]): i32 {
    return 1
}

fn count<T>(xs: []T): i32 {
    var n: i32 = 0
    for _ in xs {
        n = n + 1
    }
    return n
}

fn sumArray(): i32 {
    val a = [4]i32(1, 2, 3, 4)
    var s: i32 = 0
    for x in a {
        s = s + x
    }
    return s
}

fn main() {
    val folded = @comptime(sumArray())
    if folded != 10 {
        return
    }
    var a = [4]i32(1, 2, 3, 4)
    var sum: i32 = 0
    for x in a {
        sum = sum + x
    }
    if sum != 10 {
        return
    }
    sum = 0
    for i, x in a {
        if i == 0 {
            a[1] = 9
        }
        sum = sum + x
    }
    if sum != 10 || a[1] != 9 {
        return
    }
    a[1] = 2
    var view = a[..]
    sum = 0
    for i, x in view {
        if i == 0 {
            a[1] = 9
        }
        sum = sum + x
    }
    if sum != 17 {
        return
    }
    sum = 0
    for x in view {
        view = []i32()
        sum = sum + x
    }
    if sum != 17 {
        return
    }
    val cs = []const i32(4, 5)
    sum = 0
    for x in cs {
        sum = sum + x
    }
    if sum != 9 {
        return
    }
    if count([]i32(1, 2, 3)) != 3 || count([]i32()) != 0 {
        return
    }
    var n: i32 = 0
    for b in "jog" {
        n = n + keep(b)
    }
    if n != 3 {
        return
    }
    n = 0
    var m: i32 = 0
    for i, b in "abcd"[1..3] {
        n = n + (i as i32)
        m = m + keep(b)
    }
    if n != 1 || m != 2 {
        return
    }
    var raw: bytes[4]
    n = 0
    for b in raw {
        n = n + keep(b)
    }
    if n != 4 {
        return
    }
    val mem: bytes = raw[..]
    n = 0
    for _, b in mem {
        n = n + keep(b)
    }
    if n != 4 {
        return
    }
    n = 0
    for b in bytes() {
        n = n + keep(b)
    }
    if n != 0 {
        return
    }
    n = 0
    for x in a {
        if x == 1 {
            continue
        }
        if x == 3 {
            break
        }
        n = n + x
    }
    if n != 9 {
        return
    }
    val nested = [2][2]i32([2]i32(1, 0), [2]i32(0, 1))
    n = 0
    for row in nested {
        for cell in row {
            n = n + cell
        }
    }
    if n != 2 {
        return
    }
    if puts(c"ok") < 0 {
        return
    }
}
