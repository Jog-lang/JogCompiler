extern {
    fn puts(s: *const c_char): c_int
}

type c_char = i8
type c_int = i32

fn embeddedLen(): usize {
    return @embed("jog.mod").len
}

val Mod = @embed("./jog.mod")
val ModLen = @comptime(embeddedLen())

fn main() {
    val blob = @embed("jog.mod")
    if Mod != blob {
        return
    }
    if blob != "module e2e\n" {
        return
    }
    if ModLen != 11 {
        return
    }
    if blob.len != ModLen {
        return
    }
    if puts(c"ok") < 0 {
        return
    }
}

// expect: ok
