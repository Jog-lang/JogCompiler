// expect: ok

extern {
    fn puts(s: *const c_char): c_int
}

type c_char = i8
type c_int = i32

val scale: f64 = 1.5
val wide: f32 = 1.0 + 0.5

fn both<T>(a: T, b: T): T {
    return b
}

fn main() {
    var a: f32 = wide
    var b: f32 = both(a, 2.0)
    var c: f64 = both(2.0, 3.0)
    var n: f64 = 10.0
    var d: f64 = 3.0
    var rem = n % d
    var nf: f32 = 10.0
    var df: f32 = 3.0
    var remf = nf % df
    var ch: i64 = 'A'
    var trunc: i32 = 3.9 as i32
    var back: f64 = 3 as f64
    var neg: f64 = -scale
    if scale == 1.5 && wide == 1.5 && b == 2.0 && c == 3.0 && rem == 1.0 && remf == 1.0 && ch == 65 && trunc == 3 &&
        back == 3.0 && neg == -1.5 {
        if puts(c"ok") < 0 {
            return
        }
    }
}
