struct Point {
    x: i32
    y: i32
}

var n: i32 = 1
var xs: [4]i32 = [4]i32(1, 2, 3, 4)

fn main() {
    var p: *i32 = &n
    val second = xs[1]
    var s = []i32(10, 20, 30)
    val mid = s[1]
    val part = s[0..2]
    val through = *p
    *p = 5
    val q = p + 1
    val back = q - p
    p += 1
    var pt = Point(x: 1, y: 2)
    var pp: *Point = &pt
    val fx = &pp.x
    *fx = 8
    val same = p == q
}
