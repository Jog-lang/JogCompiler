fn count<T>(xs: []T): i32 {
    var n: i32 = 0
    for _, x in xs {
        val y: T = x
        n = n + 1
    }
    for x in xs {
        n = n + 1
    }
    for _ in xs {
        n = n + 1
    }
    return n
}

fn main() {
    var a = [4]i32(1, 2, 3, 4)
    var sum: i32 = 0
    for x in a {
        sum = sum + x
    }
    for i, x in a {
        if i == 0 {
            continue
        }
        sum = sum + x
    }
    val view = a[0..2]
    for x in view {
        sum = sum + x
    }
    val cs = []const i32(4, 5)
    for x in cs {
        sum = sum + x
    }
    for b in "jog" {
        sum = sum + 1
    }
    var raw: [4]byte
    val mem: bytes = raw[..]
    for b in raw {
        sum = sum + 1
    }
    for _, b in mem {
        sum = sum + 1
    }
    for b in "abcd"[1..3] {
        sum = sum + 1
    }
    val n = count(a[..])
    val limit: i32 = 4
    for i in 0..limit {
        sum = sum + i
    }
    for sum < 1000 {
        break
    }
    for {
        break
    }
    val nested = [2][2]i32([2]i32(1, 0), [2]i32(0, 1))
    for row in nested {
        for cell in row {
            sum = sum + cell
        }
    }
}
