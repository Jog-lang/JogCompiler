interface Allocator {
    fn alloc(size: usize, align: usize): i32
}

fn work() with (a: Allocator, s: Scope) {
    val ch = Chan<i32>.init(0)
    go { ch.send(1) }
    val (v, err) = ch.recv()
    yield()
    val e = sleep(0)
    s.cancel()
    if err != null {
        return
    }
    if e != null {
        return
    }
    if v != 1 {
        return
    }
    select {
        recv(ch) { got ->
            if got != 0 {
                return
            }
        }
        default { }
    }
    go {
        var lo: i32 = 1
        var hi: i32 = 2
        if true {
            return lo, hi
        }
        return 3, 4
    }
}

fn main() {
    scope { }
}
