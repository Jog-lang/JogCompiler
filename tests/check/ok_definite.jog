extern {
    fn get(): *i32
}

fn both(c: bool): *i32 {
    var p: *i32
    if c {
        p = get()
    } else {
        p = get()
    }
    return p
}

fn after_break(): *i32 {
    var p: *i32
    for {
        p = get()
        break
    }
    return p
}

fn forever_returns(c: bool): i32 {
    for {
        if c {
            return 1
        }
        continue
    }
}

// Forever loop that only returns/continues: no trailing return needed.
fn forever_return(c: bool): i32 {
    for {
        if c {
            return 1
        }
        continue
    }
}
