fn both<T>(a: T, b: T): T {
    return a
}

fn mix() {
    val x = 1 + 1.0
}

fn nofit() {
    val x: i32 = 1.5
}

fn wide() {
    val x: f32 = 1e40
}

fn zdiv() {
    val x = 1.0 / 0.0
}

fn clash() {
    val x = both(1, 1.0)
}

fn rune() {
    val x: i8 = '\u{E9}'
}

