fn id<T>(x: T): T {
    return x
}

fn both<T>(a: T, b: T): T {
    return b
}

fn main() {
    var a: f32 = 1.0 + 0.5
    var b: f32 = a + 2.0
    var picked: f32 = both(a, 2.0)
    var wide: f64 = both(2.0, 3.0)
    var named: f64 = id(1.5)
    var ch: i64 = 'A'
    var byte: i8 = 'A'
    var trunc: i32 = 3.9 as i32
    var back: f64 = 3 as f64
    var neg: f64 = -1.5
    var rem: f64 = 10.0 % 3.0
    var branch: f64 = if true { 1.5 } else { 2.5 }
    a += 0.5
    if b == 3.5 && picked == 2.0 && wide == 3.0 && named == 1.5 && ch == 65 && byte == 65 && trunc == 3 && back == 3.0 &&
        neg == -1.5 && rem == 1.0 && branch == 1.5 && a == 2.0 {
        return
    }
}
