fn add(a: i32, b: i32): i32 {
    return a + b
}

fn abs(x: i32): i32 {
    if x < 0 {
        return -x
    }
    return x
}

fn square(x: i32): i32 = x * x

fn main() {
    val n = add(b: 20, a: 22)
    var sum: i32 = 0
    for i in 0..n {
        if i == 0 {
            continue
        }
        sum = sum + i
    }
    for sum < 100 {
        sum = sum + 1
    }
    val flag = n == 42 && abs(n) > 0
    val text = "jog"
    if flag {
        val same = text == "jog"
        if !same {
            return
        }
    } else {
        val wide: i64 = n as i64
        val bits: u8 = 1 << 3
        val masked = bits & 15
        val squared = square(sum)
    }
    for {
        break
    }
}
