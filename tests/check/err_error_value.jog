struct Plain {
    tag: u8
}

var plain: Plain

fn bad(): error? {
    return &plain
}

fn num(): error? {
    var n: i32 = 1
    return &n
}

fn both(): bool {
    var a: error? = null
    var b: error? = null
    return a == b
}

// error: type mismatch: expected error?, got *Plain
// error: type mismatch: expected error?, got *i32
// error: operator '==' does not apply to error?
