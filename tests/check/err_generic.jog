fn bad<T: i32>(x: T): T {
    return x
}

fn add<T>(x: T): T {
    return x + x
}

fn make<T>(): i32 {
    return 0
}

fn clash<T>(a: T, b: T): T {
    return a
}

fn id<T>(x: T): T {
    return x
}

fn calls() {
    make()
    clash(1, true)
    id<i32, bool>(1)
}

@export
fn exp<T>(x: T): T {
    return x
}

fn def<T>(x: T = 1): T {
    return x
}

fn main<T>() {
}

