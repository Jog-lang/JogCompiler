enum Color: u8 { Red = 1, Green, Blue }

enum Shape {
    Circle(r: i32)
    Rect(w: i32, h: i32)
    Empty
}

enum Flag { Off, On }

struct Box {
    n: i32
}

fn raw(c: Color): u8 {
    return c as u8
}

fn area(s: Shape): i32 {
    return when s {
        Circle(r) -> r
        Rect(w, h) -> w + h
        Empty -> 0
    }
}

fn kind(code: i32): i32 {
    return when code {
        200, 404 -> 1
        in 1..10 -> 2
        else -> 0
    }
}

fn sign(x: i32) {
    when {
        x < 0 -> { return }
        else -> { return }
    }
}

fn open_only(n: i32) {
    when n {
        1 -> { return }
    }
}

fn forced(p: i32?): i32 {
    return p!!
}

fn fallback(p: i32?): i32 {
    return p ?: 0
}

fn read(b: Box?): i32? {
    return b?.n
}

fn empty(s: Shape): bool {
    return s is Empty
}

fn some_of(p: i32?): i32 {
    return when p {
        Some(v) -> v
        None -> 0
    }
}

struct Point {
    x: i32
    y: i32
}

enum Event {
    Click(at: Point)
    Key(code: i32)
}

enum Inner {
    A(n: i32)
    B
}

enum Outer {
    Wrap(inner: Inner)
}

enum Item {
    Num(n: i32 = 7)
    Pair(a: i32, b: i32 = 2)
}

fn edge(e: Event): i32 {
    return when e {
        Click(Point(x: 0, y)) -> y
        Click(Point(x, y)) -> x + y
        Key(code: in 1..10) -> code
        Key(code) -> code
    }
}

fn nested(o: Outer): i32 {
    return when o {
        Wrap(A(n)) -> n
        Wrap(B) -> 0
    }
}

fn taken(it: Item): i32 {
    return when it {
        Num(n) -> n
        Pair(a, b) -> a + b
    }
}

fn named_some(p: i32?): i32 {
    return when p {
        Some(value: v) -> v
        None -> 0
    }
}

fn ranged_some(p: i32?): i32 {
    return when p {
        Some(value: in 1..10) -> value
        Some(v) -> v
        None -> 0
    }
}

fn main() {
    val c = Color.Green
    val s = Shape.Circle(r: 3)
    val e: Shape = .Empty
    var f: Flag
    val n = area(s)
    val q: i32? = null
    val box: Box? = null
    f = Flag.On
    if empty(e) {
        return
    }
    if raw(c) == 0 || n == 0 {
        return
    }
    if forced(q) == fallback(q) {
        return
    }
    if read(box) != null {
        return
    }
    if some_of(q) == kind(200) {
        return
    }
    if edge(Event.Click(at: Point(x: 0, y: 4))) != 4 {
        return
    }
    if nested(Outer.Wrap(inner: Inner.A(n: 5))) != 5 {
        return
    }
    if taken(Item.Num()) != 7 || taken(Item.Pair(a: 3)) != 5 {
        return
    }
    if named_some(q) != ranged_some(q) {
        return
    }
    sign(n)
    open_only(n)
}
