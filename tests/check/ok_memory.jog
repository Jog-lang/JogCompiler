struct Point {
    x: i32
    y: i32
}

struct Link {
    next: *Link
}

fn field_addr(p: *Point): *i32 {
    return &p.x
}

fn read_const(p: *const Point): i32 {
    return p.x
}

fn bump(p: *Link) {
    p.next += 1
}

fn main() {
    var a = [4]i32(1, 2, 3, 4)
    val view = a[1..3]
    val x = view[0]
    var p: *i32 = &a[0]
    val y = *p
    *p = 9
    val q = p + 1
    val d: isize = q - p
    val before = q < p
    p += 1
    var s = []i32(10, 20, 30)
    s[0] = 9
    val t = s[0..2]
    val z = t[1]
    val row = [_]i32(4, 5)
    val nested = [2][2]i32([2]i32(1, 0), [2]i32(0, 1))
    val cell = nested[1][0]
    val c = []const i32(4, 5)
    val cz = c[0]
    var raw: bytes[4]
    val one: bytes[1] = raw[0]
    val midb = raw[1..3]
    val empty = bytes()
    val ch: bytes[1] = "ab"[0]
    val pre: str = "abcd"[1..3]
    var n: i32 = 1
    var np: *i32 = &n
    var pt = Point(x: 1, y: 2)
    var pp: *Point = &pt
    val f = &pp.x
    *f = 3
    val got = field_addr(pp)
    @unchecked {
        val u = a[0]
    }
    val sum = x + y + z + cell + cz + row[0] + pt.x + n
    val whole = a[..]
    val tail = s[1..]
    val head = s[..2]
}
