// jogc CLI: reads os.argv, dispatches one command, exits with that code.
// Frontend packages come from the jogc library (require jogc ..).
// std.os has no exit, so the code goes through c.jogrt_exit.

import jogc.src.check
import jogc.src.emit
import jogc.src.lex
import jogc.src.load
import jogc.src.lower
import jogc.src.parse
import std.c
import std.io
import std.list
import std.mem
import std.os
import std.text as texts

fn say(to_err: bool, text: str) {
    if to_err {
        io.eprintln(text)
    } else {
        io.println(text)
    }
}

fn usage(to_err: bool) {
    say(to_err, "usage: jogc <command> [arguments]")
    say(to_err, "")
    say(to_err, "commands:")
    say(to_err, "  jogc lex <file>          print the tokens of a file")
    say(to_err, "  jogc parse <file>        print the AST of a file")
    say(to_err, "  jogc check [package]     run the frontend only")
    say(to_err, "  jogc emit-ir [package]   print the IR")
    say(to_err, "  jogc emit-c [package]    print the generated C")
    say(to_err, "  jogc build [package]     compile to an executable")
    say(to_err, "  jogc run [package]       build and run")
    say(to_err, "  jogc test [package]      run *.test.jog tests")
    say(to_err, "  jogc version             print the compiler version")
    say(to_err, "  jogc help                show this message")
}

fn dispatch(): i32 with (a: mem.Allocator) {
    if os.argc() < 2 {
        usage(true)
        return 2
    }
    val command = os.argv(1)
    if command == "help" {
        usage(false)
        return 0
    }
    if command == "version" {
        io.println("jogc 0.1.0")
        return 0
    }
    if command == "lex" {
        if os.argc() < 3 {
            io.eprintln("usage: jog lex <file>")
            return 2
        }
        return lex.run(os.argv(2))
    }
    if command == "parse" {
        if os.argc() < 3 {
            io.eprintln("usage: jog parse <file>")
            return 2
        }
        return parse.run(os.argv(2))
    }
    if command == "check" {
        var start = "."
        var saw_start = false
        var module_flags = list.empty<str>()
        var i: i64 = 2
        for i < os.argc() {
            val arg = os.argv(i)
            if arg == "--module" {
                if i + 1 >= os.argc() {
                    io.eprintln("jogc: --module expects <name>=<dir>")
                    return 2
                }
                i = i + 1
                val value = os.argv(i)
                val (_, _, ok) = load.split_module_flag(value)
                if !ok {
                    io.eprint("jogc: --module expects <name>=<dir>, got '")
                    io.eprint(value)
                    io.eprintln("'")
                    return 2
                }
                module_flags.push(value)
            } else if arg.len > 9 && texts.slice(arg, 0, 9) == "--module=" {
                val value = texts.slice(arg, 9, arg.len)
                val (_, _, ok) = load.split_module_flag(value)
                if !ok {
                    io.eprint("jogc: --module expects <name>=<dir>, got '")
                    io.eprint(value)
                    io.eprintln("'")
                    return 2
                }
                module_flags.push(value)
            } else if !saw_start {
                start = arg
                saw_start = true
            } else {
                io.eprint("jogc: unexpected argument '")
                io.eprint(arg)
                io.eprintln("'")
                return 2
            }
            i = i + 1
        }
        val (prog, loaded) = load.run(start, module_flags.items(), false)
        if loaded != 0 {
            return loaded
        }
        val (_, code) = check.run(prog)
        return code
    }
    if command == "emit-ir" {
        var start = "."
        var saw_start = false
        var module_flags = list.empty<str>()
        var i: i64 = 2
        for i < os.argc() {
            val arg = os.argv(i)
            if arg == "--module" {
                if i + 1 >= os.argc() {
                    io.eprintln("jogc: --module expects <name>=<dir>")
                    return 2
                }
                i = i + 1
                val value = os.argv(i)
                val (_, _, ok) = load.split_module_flag(value)
                if !ok {
                    io.eprint("jogc: --module expects <name>=<dir>, got '")
                    io.eprint(value)
                    io.eprintln("'")
                    return 2
                }
                module_flags.push(value)
            } else if arg.len > 9 && texts.slice(arg, 0, 9) == "--module=" {
                val value = texts.slice(arg, 9, arg.len)
                val (_, _, ok) = load.split_module_flag(value)
                if !ok {
                    io.eprint("jogc: --module expects <name>=<dir>, got '")
                    io.eprint(value)
                    io.eprintln("'")
                    return 2
                }
                module_flags.push(value)
            } else if !saw_start {
                start = arg
                saw_start = true
            } else {
                io.eprint("jogc: unexpected argument '")
                io.eprint(arg)
                io.eprintln("'")
                return 2
            }
            i = i + 1
        }
        val (prog, loaded) = load.run(start, module_flags.items(), false)
        if loaded != 0 {
            return loaded
        }
        val (checked, code) = check.run(prog)
        if code != 0 {
            return code
        }
        return lower.run(checked)
    }
    if command == "emit-c" {
        var start = "."
        var saw_start = false
        var saw_steps = false
        var steps: u64 = 0
        var module_flags = list.empty<str>()
        var i: i64 = 2
        for i < os.argc() {
            val arg = os.argv(i)
            if arg == "--comptime-steps" || (arg.len >= 17 && texts.slice(arg, 0, 17) == "--comptime-steps=") {
                if saw_steps {
                    io.eprintln("usage: jog emit-c [package] [--module name=dir ...]")
                    return 2
                }
                var value = ""
                if arg == "--comptime-steps" {
                    if i + 1 >= os.argc() {
                        io.eprintln("jog: --comptime-steps expects a positive integer")
                        return 2
                    }
                    i = i + 1
                    value = os.argv(i)
                } else {
                    value = texts.slice(arg, 17, arg.len)
                }
                val (n, ok) = emit.parse_steps(value)
                if !ok {
                    io.eprintln("jog: --comptime-steps expects a positive integer")
                    return 2
                }
                steps = n
                saw_steps = true
            } else if arg == "--module" {
                if i + 1 >= os.argc() {
                    io.eprintln("jogc: --module expects <name>=<dir>")
                    return 2
                }
                i = i + 1
                val value = os.argv(i)
                val (_, _, ok) = load.split_module_flag(value)
                if !ok {
                    io.eprint("jogc: --module expects <name>=<dir>, got '")
                    io.eprint(value)
                    io.eprintln("'")
                    return 2
                }
                module_flags.push(value)
            } else if arg.len > 9 && texts.slice(arg, 0, 9) == "--module=" {
                val value = texts.slice(arg, 9, arg.len)
                val (_, _, ok) = load.split_module_flag(value)
                if !ok {
                    io.eprint("jogc: --module expects <name>=<dir>, got '")
                    io.eprint(value)
                    io.eprintln("'")
                    return 2
                }
                module_flags.push(value)
            } else if !saw_start {
                start = arg
                saw_start = true
            } else {
                io.eprint("jogc: unexpected argument '")
                io.eprint(arg)
                io.eprintln("'")
                return 2
            }
            i = i + 1
        }
        val (prog, loaded) = load.run(start, module_flags.items(), false)
        if loaded != 0 {
            return loaded
        }
        val (checked, code) = check.run(prog)
        if code != 0 {
            return code
        }
        if !lower.ready(checked) {
            return 1
        }
        val (got, lowered) = lower.build_steps(checked, steps)
        if lowered != 0 {
            return lowered
        }
        var mod = got
        return emit.emit_c(&mod)
    }
    if command == "build" || command == "run" || command == "test" {
        return emit.run(command)
    }
    io.eprint("jogc: unknown command '")
    io.eprint(command)
    io.eprintln("'")
    usage(true)
    return 2
}

fn main() {
    var code: i32 = 0
    with (mem.heap()) {
        code = dispatch()
    }
    c.jogrt_exit(code)
}
