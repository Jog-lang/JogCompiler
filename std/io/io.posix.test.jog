// POSIX does not translate "\n". The shared io tests cover binary mode,
// end of input, and an empty buffer.

import std.mem
import std.proc
import std.testing

@test
fn textStdout() with (t: testing.Testing) {
    child_gate()
    with (mem.heap()) {
        val (got, err) = run_child("--io-text")
        t.expect(err == null)
        t.expect(got.code == 0)
        t.expectEq(got.stdout, "a\nb\n")
        proc.free_output(got)
    }
}
