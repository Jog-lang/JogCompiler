// Package std.math. libm via @link("m") — SDL-facing sin/cos/floor/…
// Phase A (Zig v2): method attachments on intrinsic scalars and generic
// min/max over cmp.Number wait on checker prelude binding; free fns for now.

@link("m")
extern {
    fn floor(x: f64): f64
    fn ceil(x: f64): f64
    fn log2(x: f64): f64
    fn exp2(x: f64): f64
    fn fabs(x: f64): f64
    fn sqrt(x: f64): f64
    fn sin(x: f64): f64
    fn cos(x: f64): f64
    fn pow(x: f64, y: f64): f64
}

/**
 * Absolute value. The most negative i64 panics.
 */
fn i64_abs(self: i64): i64 {
    if self == -9223372036854775808 {
        panic("abs overflow")
    }
    if self < 0 {
        return -self
    }
    return self
}

/**
 * Absolute value (f64).
 */
fn f64_abs(self: f64): f64 {
    return fabs(self)
}

/**
 * Lesser of a and b (i64).
 */
fn min(a: i64, b: i64): i64 {
    if a < b {
        return a
    }
    return b
}

/**
 * Greater of a and b (i64).
 */
fn max(a: i64, b: i64): i64 {
    if a < b {
        return b
    }
    return a
}

/**
 * Lesser of a and b (f64).
 */
fn minf(a: f64, b: f64): f64 {
    if a < b {
        return a
    }
    return b
}

/**
 * Greater of a and b (f64).
 */
fn maxf(a: f64, b: f64): f64 {
    if a < b {
        return b
    }
    return a
}
