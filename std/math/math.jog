import std.cmp

@link("m")
extern {
    fn floor(x: f64): f64
    fn ceil(x: f64): f64
    fn log2(x: f64): f64
    fn exp2(x: f64): f64
    fn fabs(x: f64): f64
    fn sqrt(x: f64): f64
    fn sin(x: f64): f64
    fn cos(x: f64): f64
    fn pow(x: f64, y: f64): f64
}

/**
 * Absolute value. The most negative i64 panics.
 * @param self value
 * @return self when self >= 0, otherwise -self
 */
fn i64.abs(): i64 {
    if self == -9223372036854775808 {
        panic("abs overflow")
    }
    if self < 0 {
        return -self
    }
    return self
}

/**
 * Absolute value.
 * @param self value
 * @return fabs(self)
 */
fn f64.abs(): f64 = fabs(self)

/**
 * Lesser of a and b.
 * @param a first value
 * @param b second value
 * @return a when a < b, otherwise b
 */
fn min<T: cmp.Number>(a: T, b: T): T {
    if a < b {
        return a
    }
    return b
}

/**
 * Greater of a and b.
 * @param a first value
 * @param b second value
 * @return b when a < b, otherwise a
 */
fn max<T: cmp.Number>(a: T, b: T): T {
    if a < b {
        return b
    }
    return a
}
