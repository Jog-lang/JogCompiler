// Package std.math. libm via @link("m") — SDL-facing sin/cos/floor/…
// Phase A (Zig v2): method attachments on intrinsic scalars and generic
// min/max over cmp.Number wait on checker prelude binding; free fns for now.

@link("m")
extern {
    fn floor(x: f64): f64
    fn ceil(x: f64): f64
    fn log2(x: f64): f64
    fn exp2(x: f64): f64
    fn fabs(x: f64): f64
    fn sqrt(x: f64): f64
    fn sin(x: f64): f64
    fn cos(x: f64): f64
    fn pow(x: f64, y: f64): f64
}

/**
 * Absolute value. The most negative i64 panics.
 */
fn i64_abs(self: i64): i64 {
    if self == -9223372036854775808 {
        panic("abs overflow")
    }
    if self < 0 {
        return -self
    }
    return self
}

/**
 * Absolute value (f64).
 */
fn f64_abs(self: f64): f64 {
    return fabs(self)
}

/**
 * Lesser of a and b (i64).
 */
fn min(a: i64, b: i64): i64 {
    if a < b {
        return a
    }
    return b
}

/**
 * Greater of a and b (i64).
 */
fn max(a: i64, b: i64): i64 {
    if a < b {
        return b
    }
    return a
}

/**
 * Lesser of a and b (f64).
 */
fn minf(a: f64, b: f64): f64 {
    if a < b {
        return a
    }
    return b
}

/**
 * Greater of a and b (f64).
 */
fn maxf(a: f64, b: f64): f64 {
    if a < b {
        return b
    }
    return a
}

/**
 * Clamp v into [lo, hi] (i64).
 */
fn clamp(v: i64, lo: i64, hi: i64): i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

/**
 * Clamp v into [lo, hi] (f64).
 */
fn clampf(v: f64, lo: f64, hi: f64): f64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

/**
 * Sign of v as -1, 0, or 1 (i64).
 */
fn sign(v: i64): i64 {
    if v < 0 {
        return -1
    }
    if v > 0 {
        return 1
    }
    return 0
}

/**
 * Sign of v as -1.0, 0.0, or 1.0 (f64). Zero for ±0.0.
 */
fn signf(v: f64): f64 {
    if v < 0.0 {
        return -1.0
    }
    if v > 0.0 {
        return 1.0
    }
    return 0.0
}
