// Package std.testing. testing() is the value an @test receives when it
// asks for Testing and no context global has that type. expect and
// expectEq print nothing when the check holds. fail and a failing check
// write to stderr and increment failures. fatal writes, then panics.
// finish exits the process with status 1 when a check recorded a failure,
// and returns when the count is zero. The harness calls note before each
// @test and report after the last one. report writes one summary line to
// stderr, then calls finish. One shared value, not a checking allocator.
// expectPanic catches a panic inside the closure. A panic outside it
// still aborts.
//
// v2 note: speak to stderr via jogrt_write (not std.io) so loading tests
// does not pull io's open-slice / import-alias gaps.

import std.c

interface Testing {
    fn expect(cond: bool)
    fn expectEq(got: str, want: str)
    fn fail(msg: str)
    fn fatal(msg: str)
    fn expectPanic(body: () -> ())
}

struct Test {
    tag: u8
}

var test_value: Test
var failures: i32 = 0

fn testing(): Testing {
    return &test_value
}

fn note(name: str) {
    // v2: package `str` vars need literal init and `.len` field meta is incomplete.
    // The harness still calls note; failure lines omit the test name for now.
    if name.len == 0 {
    }
}

private fn eprint(text: str) {
    if !c.jogrt_write(2, text.ptr as *const void?, text.len) {
        // ignore write failure in the test harness
    }
}

private fn eprint_buf(p: *u8, len: usize) {
    if !c.jogrt_write(2, p as *const void?, len) {
    }
}

private fn write_str(p: *u8, at: usize, text: str): usize {
    // Index stores (v2); deref-assign `*(p+i)=` is still a Zig-driver gap.
    for i in 0 as usize..text.len {
        p[at + i] = text.ptr[i]
    }
    return at + text.len
}

private fn write_i32(p: *u8, at: usize, n: i32): usize {
    var digits: [16]u8
    var i: usize = 0
    var x: i32 = n
    if x < 0 {
        x = 0 - x
    }
    if x == 0 {
        p[at] = 48
        return at + 1
    }
    for unused in 0..16 {
        if x == 0 {
            break
        }
        val d = (x % 10) + 48
        digits[i] = d as u8
        i = i + 1
        x = x / 10
        if unused > 16 {
            break
        }
    }
    for k in 0 as usize..i {
        p[at + k] = digits[i - 1 - k]
    }
    return at + i
}

fn report(ran: i32) {
    var raw: [80]byte
    // Open slice `raw[..]` / `&raw[0]` still limited on v2; `&raw` is the array data pointer.
    val p = &raw
    var at: usize = 0
    at = write_i32(p, at, ran)
    at = write_str(p, at, " tests, ")
    if failures == 0 {
        at = write_i32(p, at, ran)
        at = write_str(p, at, " passed\n")
    } else {
        at = write_i32(p, at, failures)
        at = write_str(p, at, " failed\n")
    }
    eprint_buf(p, at)
    finish()
}

private fn note_fail() {
}

fn Test.expect(cond: bool) {
    if !cond {
        failures = failures + 1
        note_fail()
        eprint("fail\n")
    }
}

fn Test.expectEq(got: str, want: str) {
    if got != want {
        failures = failures + 1
        note_fail()
        eprint("fail\n")
    }
}

fn Test.fail(msg: str) {
    failures = failures + 1
    note_fail()
    eprint(msg)
}

fn Test.fatal(msg: str) {
    failures = failures + 1
    eprint(msg)
    panic(msg)
}

fn Test.expectPanic(body: () -> ()) {
    // v2: closure / fn-type call lowering is incomplete — do not invoke `body`.
    // Suites that need expectPanic will see a recorded failure until panic-call lands.
    failures = failures + 1
    note_fail()
    eprint("fail\n")
}

fn finish() {
    if failures != 0 {
        c.jogrt_exit(1)
    }
}
