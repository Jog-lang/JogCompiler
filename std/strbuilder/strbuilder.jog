// Package std.strbuilder. StrBuilder is a growable buffer of bytes. The
// value is one block, a length, and a capacity. The allocator is not a
// field: append, append_byte, append_char, append_int, and free take it
// as a context, with (a: mem.Allocator), the same way std.mem and
// std.list do.
//
// One allocation owns the bytes. The first block holds 8 bytes, then
// the capacity doubles. A request larger than that next capacity uses
// the request. empty is the zero value: len 0, cap 0, ptr null, no
// block. clear does not free the block.
//
// append_char writes one Unicode scalar as UTF-8. append_int writes an
// i64 in a base from 2 to 36, lowercase, with a leading '-' when the
// value is negative. parse_i64 reads that text. An empty input, a bad
// digit, or a value outside i64 is (0, false), not a panic.

import std.c
import std.mem

// ptr is null until the first allocation. len is the live count. cap is
// how many bytes the block holds.
struct StrBuilder {
    ptr: *u8?
    len: usize
    cap: usize
}

fn empty(): StrBuilder {
    return StrBuilder()
}

// alloc, copy the live bytes, free the old block. Alignment is align(u8).
private fn *StrBuilder.grow(min_cap: usize) with (a: mem.Allocator) {
    var new_cap: usize = 8
    if self.cap != 0 {
        new_cap = self.cap * 2
    }
    if new_cap < min_cap {
        new_cap = min_cap
    }
    val (raw, err) = a.alloc(size(u8) * new_cap, align(u8))
    if err != null {
        panic("out of memory")
    }
    val fresh = raw.ptr
    if self.len > 0 {
        c.memcpy(fresh as *void, self.ptr!! as *const void, self.len)
    }
    if self.cap > 0 {
        var block = bytes()
        block.ptr = self.ptr!!
        block.len = size(u8) * self.cap
        a.free(block)
    }
    self.ptr = fresh as *u8?
    self.cap = new_cap
}

// Copies text onto the end. An empty str allocates nothing.
fn *StrBuilder.append(text: str) with (a: mem.Allocator) {
    if text.len == 0 {
        return
    }
    val need = self.len + text.len
    if need > self.cap {
        self.grow(need)
    }
    val dest = self.ptr!!
    c.memcpy((dest + self.len) as *void, text.ptr as *const void, text.len)
    self.len = need
}

// Copies one byte onto the end.
fn *StrBuilder.append_byte(b: u8) with (a: mem.Allocator) {
    val need = self.len + 1
    if need > self.cap {
        self.grow(need)
    }
    val dest = self.ptr!!
    dest[self.len] = b
    self.len = need
}

// Digit value of one ASCII byte, or -1 when it is not 0-9, a-z, or A-Z.
private fn digit_value(b: u8): i64 {
    if b >= '0' as u8 && b <= '9' as u8 {
        return (b as i64) - ('0' as i64)
    }
    if b >= 'a' as u8 && b <= 'z' as u8 {
        return (b as i64) - ('a' as i64) + 10
    }
    if b >= 'A' as u8 && b <= 'Z' as u8 {
        return (b as i64) - ('A' as i64) + 10
    }
    return -1
}

// Lowercase digit. d is 0..35.
private fn digit_char(d: u64): u8 {
    if d < 10 {
        return (('0' as i64) + (d as i64)) as u8
    }
    return (('a' as i64) + (d as i64) - 10) as u8
}

// Writes one Unicode scalar as UTF-8. A surrogate or a value outside
// 0..0x10FFFF is a programmer error.
fn *StrBuilder.append_char(cp: i64) with (a: mem.Allocator) {
    if cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
        panic("invalid code point")
    }
    if cp <= 0x7F {
        self.append_byte(cp as u8)
        return
    }
    if cp <= 0x7FF {
        self.append_byte(((cp >> 6) | 0xC0) as u8)
        self.append_byte(((cp & 0x3F) | 0x80) as u8)
        return
    }
    if cp <= 0xFFFF {
        self.append_byte(((cp >> 12) | 0xE0) as u8)
        self.append_byte((((cp >> 6) & 0x3F) | 0x80) as u8)
        self.append_byte(((cp & 0x3F) | 0x80) as u8)
        return
    }
    self.append_byte(((cp >> 18) | 0xF0) as u8)
    self.append_byte((((cp >> 12) & 0x3F) | 0x80) as u8)
    self.append_byte((((cp >> 6) & 0x3F) | 0x80) as u8)
    self.append_byte(((cp & 0x3F) | 0x80) as u8)
}

// Writes n in base. base is 2..36. Digits are lowercase. Zero is "0".
// A base outside that range is a programmer error. i64 min is special:
// its magnitude does not fit in i64, so the digits are counted in u64.
fn *StrBuilder.append_int(n: i64, base: i64) with (a: mem.Allocator) {
    if base < 2 || base > 36 {
        panic("base out of range")
    }
    if n == 0 {
        self.append_byte('0' as u8)
        return
    }
    var neg = false
    var mag: u64 = 0
    if n < 0 {
        neg = true
        if n == -9223372036854775808 {
            mag = 9223372036854775808
        } else {
            mag = (-n) as u64
        }
    } else {
        mag = n as u64
    }
    var digits: [64]u8
    var count: usize = 0
    val ubase = base as u64
    for mag != 0 {
        val rem = mag % ubase
        mag = mag / ubase
        digits[count] = digit_char(rem)
        count = count + 1
    }
    if neg {
        self.append_byte('-' as u8)
    }
    for count != 0 {
        count = count - 1
        self.append_byte(digits[count])
    }
}

fn *StrBuilder.clear() {
    self.len = 0
}

fn *StrBuilder.free() with (a: mem.Allocator) {
    if self.cap == 0 {
        return
    }
    var block = bytes()
    block.ptr = self.ptr!!
    block.len = size(u8) * self.cap
    a.free(block)
    self.ptr = null
    self.len = 0
    self.cap = 0
}

// Live bytes as str, length len, not capacity. No copy: the header
// points at this block. A later growth moves the block and invalidates
// this str.
fn StrBuilder.str(): str {
    var view = bytes()
    if self.len == 0 {
        return view
    }
    view.ptr = self.ptr!!
    view.len = self.len
    return view
}

// Reads text as an i64 in base. base is 2..36. An optional leading '+'
// or '-' is accepted, and letters may be either case. ok is false for
// an empty input, a base outside 2..36, a bad digit, or overflow. The
// value is 0 when ok is false. The magnitude is accumulated in u64 so
// i64 min does not overflow the multiply.
fn parse_i64(text: str, base: i64): (i64, bool) {
    if text.len == 0 || base < 2 || base > 36 {
        return 0, false
    }
    var neg = false
    var start: usize = 0
    val sign = text.ptr[0]
    if sign == '-' as u8 {
        neg = true
        start = 1
    } else if sign == '+' as u8 {
        start = 1
    }
    if start == text.len {
        return 0, false
    }
    var acc: u64 = 0
    var limit: u64 = 9223372036854775807
    if neg {
        limit = 9223372036854775808
    }
    val ubase = base as u64
    for i in start..text.len {
        val d = digit_value(text.ptr[i])
        if d < 0 || d >= base {
            return 0, false
        }
        val ud = d as u64
        if acc > (limit - ud) / ubase {
            return 0, false
        }
        acc = acc * ubase + ud
    }
    if neg {
        if acc == 9223372036854775808 {
            return -9223372036854775808, true
        }
        return -(acc as i64), true
    }
    return acc as i64, true
}
