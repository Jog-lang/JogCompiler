// Windows list. WIN32_FIND_DATAA is 320 bytes on this host. cFileName
// is CHAR[260] at byte 44. FindFirstFileA writes that layout into the
// buffer. list rejects a path that does not leave room for a separator,
// '*', and NUL in a 4096-byte buffer.

import std.c
import std.list as lists
import std.mem

private val name_offset: usize = 44
private val name_cap: usize = 260

// Writes path, a separator when path does not end with one, '*', and NUL.
// false means the path is empty or does not fit.
private fn fill_pattern(dest: *u8, cap: usize, path: str): bool {
    if path.len == 0 || path.len >= cap || cap - path.len < 3 {
        return false
    }
    c.memcpy(dest as *void, path.ptr as *const void, path.len)
    var at = path.len
    if !is_sep(path.ptr[path.len - 1]) {
        dest[at] = '/' as u8
        at = at + 1
    }
    dest[at] = '*' as u8
    at = at + 1
    dest[at] = 0
    return true
}

// false means the directory could not be opened. The list is empty then.
// Each kept name is its own block. free_names releases them.
fn list(path: str): (lists.List<str>, bool) with (a: mem.Allocator) {
    var names: lists.List<str>
    var pattern: [4096]u8
    if !fill_pattern(pattern[..].ptr, 4096, path) {
        return names, false
    }
    var data: [320]u8
    val handle = c.FindFirstFileA(pattern[..].ptr as *const c.char, data[..].ptr)
    if handle == -1 {
        return names, false
    }
    for {
        val name_ptr = data[..].ptr + name_offset
        push_copied(&names, name_ptr, cstr_len(name_ptr, name_cap))
        if c.FindNextFileA(handle, data[..].ptr) == 0 {
            break
        }
    }
    c.FindClose(handle)
    sort_names(&names)
    return names, true
}
