// POSIX directory helpers for the fs tests. The scratch directory is
// under /tmp. mkdir's mode is jogrt_mkdir, so mode_t stays in C.

import std.c
import std.mem

private fn cstr_ok(path: str, buf: *u8, cap: usize): bool {
    if path.len >= cap {
        return false
    }
    if path.len > 0 {
        c.memcpy(buf as *void, path.ptr as *const void, path.len)
    }
    buf[path.len] = 0
    return true
}

fn make_dir(path: str): bool {
    var buf: [4096]u8
    if !cstr_ok(path, buf[..].ptr, 4096) {
        return false
    }
    return c.jogrt_mkdir(buf[..].ptr as *const c.char) == 0
}

private fn delete_file(path: str) {
    var buf: [4096]u8
    if !cstr_ok(path, buf[..].ptr, 4096) {
        return
    }
    c.unlink(buf[..].ptr as *const c.char)
}

private fn remove_dir(path: str) {
    var buf: [4096]u8
    if !cstr_ok(path, buf[..].ptr, 4096) {
        return
    }
    c.rmdir(buf[..].ptr as *const c.char)
}

private fn remove_child(dir: str, name: str) with (a: mem.Allocator) {
    val path = join(dir, name)
    delete_file(path)
    remove_dir(path)
    free_str(path)
}

private fn wipe(dir: str) with (a: mem.Allocator) {
    remove_child(dir, ".hid")
    remove_child(dir, "B")
    remove_child(dir, "a")
    remove_child(dir, "a2")
    remove_child(dir, "c")
    remove_child(dir, "m")
    remove_child(dir, "hello.txt")
    remove_child(dir, "old.txt")
    remove_child(dir, "new.txt")
    remove_child(dir, "nul.bin")
    val sub = join(dir, "sub")
    remove_child(sub, "f.txt")
    free_str(sub)
    remove_child(dir, "sub")
    // A backslash is a normal character in a POSIX name.
    remove_child(dir, "\\hello.txt")
    remove_dir(dir)
}

fn scratch(name: str): str with (a: mem.Allocator) {
    val dir = join("/tmp", name)
    wipe(dir)
    return dir
}

fn close_dir(dir: str) with (a: mem.Allocator) {
    wipe(dir)
    free_str(dir)
}

fn put(dir: str, name: str, text: str): bool with (a: mem.Allocator) {
    val path = join(dir, name)
    var data = bytes()
    data.ptr = text.ptr as *u8
    data.len = text.len
    val wrote = write_all(path, data)
    free_str(path)
    return wrote
}

fn mkdir_at(dir: str, name: str): bool with (a: mem.Allocator) {
    val path = join(dir, name)
    val made = make_dir(path)
    free_str(path)
    return made
}
