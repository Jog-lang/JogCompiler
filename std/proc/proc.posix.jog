// POSIX run. posix_spawnp, with stdout and stderr sent to mkstemp files
// the same way Windows uses temp files. stdin is /dev/null. The exit
// code comes from waitpid and WEXITSTATUS (jogrt_wexitstatus). File
// actions are opaque, so jogrt_spawn_actions_* owns that struct.
// A name with no slash is searched on PATH, which is what posix_spawnp
// does. Arguments are an argv array, not a quoted command line, so a
// space needs no extra quoting.

import std.c
import std.mem

private fn copy_at(dest: *u8, at: usize, text: str): usize {
    if text.len > 0 {
        c.memcpy((dest + at) as *void, text.ptr as *const void, text.len)
    }
    return at + text.len
}

// /tmp/<prefix>XXXXXX. mkstemp rewrites dest with the real name.
// -1 means the template did not fit or the file was not created.
private fn make_temp(prefix: str, dest: *u8, cap: usize): c.int {
    val need = 5 + prefix.len + 6 + 1
    if prefix.len == 0 || need > cap {
        return -1
    }
    var at: usize = 0
    at = copy_at(dest, at, "/tmp/")
    at = copy_at(dest, at, prefix)
    at = copy_at(dest, at, "XXXXXX")
    dest[at] = 0
    return c.mkstemp(dest as *c.char)
}

private fn close_fd(fd: c.int) {
    if fd >= 0 {
        c.close(fd)
    }
}

private fn unlink_made(path: *u8, made: bool) {
    if made {
        c.unlink(path as *const c.char)
    }
}

// LP64 x86-64. size(*u8) is not accepted: size() only takes a named type.
private val ptr_bytes: usize = 8

private struct Argv {
    slots: *(*const c.char?)
    vector: bytes
    blob: bytes
}

// One packed NUL-terminated copy per argument, then a NULL-terminated
// pointer vector into that block. Both blocks belong to the caller.
private fn build_argv(args: []str): Argv with (a: mem.Allocator) {
    var total: usize = 0
    var i: usize = 0
    for i < args.len {
        total = total + args[i].len + 1
        i = i + 1
    }
    val (blob, blob_err) = a.alloc(total, align(u8))
    if blob_err != null {
        panic("out of memory")
    }
    val count = args.len + 1
    val (raw, err) = a.alloc(ptr_bytes * count, ptr_bytes)
    if err != null {
        panic("out of memory")
    }
    var built = Argv(
        slots: raw.ptr as *(*const c.char?),
        vector: raw,
        blob: blob,
    )
    var at: usize = 0
    i = 0
    for i < args.len {
        val n = args[i].len
        if n > 0 {
            c.memcpy((blob.ptr + at) as *void, args[i].ptr as *const void, n)
        }
        blob.ptr[at + n] = 0
        built.slots[i] = (blob.ptr + at) as *const c.char?
        at = at + n + 1
        i = i + 1
    }
    built.slots[args.len] = null
    return built
}

private fn free_argv(built: *Argv) with (a: mem.Allocator) {
    a.free(built.blob)
    a.free(built.vector)
}

private fn cleanup_temps(out_path: *u8, err_path: *u8) {
    unlink_made(out_path, true)
    unlink_made(err_path, true)
}

private fn spawn(args: []str): Output with (a: mem.Allocator) {
    var out_path: [64]u8
    var err_path: [64]u8
    val out_fd = make_temp("jpo", out_path[..].ptr, 64)
    val err_fd = make_temp("jpe", err_path[..].ptr, 64)
    if out_fd < 0 || err_fd < 0 {
        close_fd(out_fd)
        close_fd(err_fd)
        unlink_made(out_path[..].ptr, out_fd >= 0)
        unlink_made(err_path[..].ptr, err_fd >= 0)
        return Output()
    }
    val nul_fd = c.open(c"/dev/null", 0)
    if nul_fd < 0 {
        close_fd(out_fd)
        close_fd(err_fd)
        cleanup_temps(out_path[..].ptr, err_path[..].ptr)
        return Output()
    }
    val actions = c.jogrt_spawn_actions_new()
    if actions == null {
        close_fd(nul_fd)
        close_fd(out_fd)
        close_fd(err_fd)
        cleanup_temps(out_path[..].ptr, err_path[..].ptr)
        return Output()
    }
    val dup_ok = c.jogrt_spawn_actions_adddup2(actions!!, nul_fd, 0) == 0 &&
        c.jogrt_spawn_actions_adddup2(actions!!, out_fd, 1) == 0 &&
        c.jogrt_spawn_actions_adddup2(actions!!, err_fd, 2) == 0
    if !dup_ok {
        c.jogrt_spawn_actions_free(actions)
        close_fd(nul_fd)
        close_fd(out_fd)
        close_fd(err_fd)
        cleanup_temps(out_path[..].ptr, err_path[..].ptr)
        return Output()
    }
    var argv = build_argv(args)
    var pid: c.int = 0
    val spawned = c.posix_spawnp(&pid, argv.slots[0]!!, actions as *const void?, null, argv.slots, null)
    c.jogrt_spawn_actions_free(actions)
    close_fd(nul_fd)
    close_fd(out_fd)
    close_fd(err_fd)
    if spawned != 0 {
        free_argv(&argv)
        cleanup_temps(out_path[..].ptr, err_path[..].ptr)
        return Output()
    }
    var status: c.int = 0
    val waited = c.waitpid(pid, &status, 0)
    free_argv(&argv)
    if waited != pid {
        cleanup_temps(out_path[..].ptr, err_path[..].ptr)
        return Output()
    }
    val code = c.jogrt_wexitstatus(status)
    if code < 0 {
        cleanup_temps(out_path[..].ptr, err_path[..].ptr)
        return Output()
    }
    val out = read_captures(out_path[..].ptr, err_path[..].ptr, code)
    cleanup_temps(out_path[..].ptr, err_path[..].ptr)
    return out
}

// args[0] is the program. The call waits. ok is false when the program
// cannot be started or the captures cannot be read.
actual fn run(args: []str): Output with (a: mem.Allocator) {
    if args.len == 0 {
        panic("empty argument vector")
    }
    if !args_ok(args) {
        return Output()
    }
    return spawn(args)
}

// Same start and wait as run, with no file actions, so the child keeps
// the parent's stdout and stderr. The result has no captured bytes.
actual fn run_inherit(args: []str): (i32, bool) with (a: mem.Allocator) {
    if args.len == 0 {
        panic("empty argument vector")
    }
    if !args_ok(args) {
        return 0, false
    }
    var argv = build_argv(args)
    var pid: c.int = 0
    val spawned = c.posix_spawnp(&pid, argv.slots[0]!!, null, null, argv.slots, null)
    if spawned != 0 {
        free_argv(&argv)
        return 0, false
    }
    var status: c.int = 0
    val waited = c.waitpid(pid, &status, 0)
    free_argv(&argv)
    if waited != pid {
        return 0, false
    }
    val code = c.jogrt_wexitstatus(status)
    if code < 0 {
        return 0, false
    }
    return code, true
}
