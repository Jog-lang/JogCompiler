// Windows actuals for std.os.
// Fixed-size wide/UTF-8 scratch uses open slice `buf[..].ptr` (same as std.fs / std.io).
// Variable-length environ entry conversion still mallocs (size = wide chars × 4).

import std.c
import std.list
import std.mem
import std.text

actual fn env(name: str): (str, bool) {
    var wname: [512]u16
    var wbuf: [4096]u16
    if !c.utf8_to_wide(name, wname[..].ptr, 512) {
        return "", false
    }
    val n = c.GetEnvironmentVariableW(wname[..].ptr, wbuf[..].ptr, 4096)
    if n == 0 || n >= 4096 {
        return "", false
    }
    var utf8: [8192]u8
    val len = c.wide_to_utf8(wbuf[..].ptr, n as usize, utf8[..].ptr, 8192)
    if len == 0 {
        return "", false
    }
    utf8[len] = 0
    return c.copyCStr(utf8[..].ptr as *const c.char), true
}

actual fn setenv(name: str, value: str): bool {
    var wname: [512]u16
    var wval: [4096]u16
    if !c.utf8_to_wide(name, wname[..].ptr, 512) {
        return false
    }
    if !c.utf8_to_wide(value, wval[..].ptr, 4096) {
        return false
    }
    return c.SetEnvironmentVariableW(wname[..].ptr, wval[..].ptr) != 0
}

actual fn unsetenv(name: str): bool {
    var wname: [512]u16
    if !c.utf8_to_wide(name, wname[..].ptr, 512) {
        return false
    }
    return c.SetEnvironmentVariableW(wname[..].ptr, null) != 0
}

actual fn pid(): i64 {
    return c.GetCurrentProcessId() as i64
}

actual fn hostname(): (str, bool) {
    var wbuf: [256]u16
    var n: c.unsigned_long = 256
    if c.GetComputerNameW(wbuf[..].ptr, &n) == 0 {
        return "", false
    }
    var utf8: [512]u8
    val len = c.wide_to_utf8(wbuf[..].ptr, n as usize, utf8[..].ptr, 512)
    if len == 0 {
        return "", false
    }
    utf8[len] = 0
    return c.copyCStr(utf8[..].ptr as *const c.char), true
}

actual fn exe_path(): (str, bool) {
    var wbuf: [1024]u16
    val n = c.GetModuleFileNameW(0, wbuf[..].ptr, 1024)
    if n == 0 || n >= 1024 {
        return "", false
    }
    var utf8: [4096]u8
    val len = c.wide_to_utf8(wbuf[..].ptr, n as usize, utf8[..].ptr, 4096)
    if len == 0 {
        return "", false
    }
    utf8[len] = 0
    return c.copyCStr(utf8[..].ptr as *const c.char), true
}

// Snapshot via GetEnvironmentStringsW → owned UTF-8 KEY=value (same contract as POSIX).
actual fn environ(): list.List<str> {
    with (mem.heap()) {
        var xs = list.empty<str>()
        val block = c.GetEnvironmentStringsW()
        if block == null {
            return xs
        }
        var p = block!!
        for {
            if p[0] == 0 {
                break
            }
            var n: usize = 0
            for {
                if p[n] == 0 {
                    break
                }
                n = n + 1
            }
            // UTF-8 needs at most 4 bytes per UTF-16 code unit, plus NUL.
            val cap = n * 4 + 1
            val utf8_raw = c.malloc(cap)
            if utf8_raw != null {
                val utf8 = utf8_raw!! as *u8
                val len = c.wide_to_utf8(p, n, utf8, cap)
                if len > 0 {
                    utf8[len] = 0
                    xs.push(c.fromCStr(utf8 as *const c.char).clone())
                }
                c.free(utf8_raw!!)
            }
            // Advance past this entry and its trailing UTF-16 NUL.
            p = ((p as *u8) + ((n + 1) * 2)) as *u16
        }
        c.FreeEnvironmentStringsW(block!!)
        return xs
    }
}

actual fn free_environ(xs: list.List<str>) {
    with (mem.heap()) {
        free_environ_owned(xs)
    }
}

private fn free_environ_owned(xs: list.List<str>) with (a: mem.Allocator) {
    var owned = xs
    var i: usize = 0
    for i < owned.len {
        val s = owned.get(i)
        if s.len > 0 {
            var block = bytes()
            block.ptr = s.ptr as *u8
            block.len = s.len
            a.free(block)
        }
        i = i + 1
    }
    owned.free()
}
