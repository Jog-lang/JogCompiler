// Sets JOG_OS_PROBE via os.setenv, then reads it back.

import std.testing

@test
fn presentEnv() with (t: testing.Testing) {
    t.expect(setenv("JOG_OS_PROBE_251025", "jog-os-value"))
    val (got, ok) = env("JOG_OS_PROBE_251025")
    t.expect(ok)
    t.expectEq(got, "jog-os-value")
    val (again, ok2) = env("JOG_OS_PROBE_251025")
    t.expect(ok2)
    t.expectEq(again, "jog-os-value")
    t.expect(unsetenv("JOG_OS_PROBE_251025"))
}

@test
fn pidPositive() with (t: testing.Testing) {
    t.expect(pid() > 0)
}
