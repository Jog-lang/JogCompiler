// POSIX actuals for std.os. env views live until the next getenv.
// hostname/exe_path copy into the error arena via copyCStr.
// Stack buffers use open slice `buf[..].ptr` (same pattern as std.fs).

import std.c
import std.list
import std.mem
import std.text

actual fn env(name: str): (str, bool) {
    with (mem.heap()) {
        val p = name.cstr()
        val r = c.getenv(p)
        free_cstr(p, name.len)
        if r == null {
            return "", false
        }
        return c.fromCStr(r as *const c.char), true
    }
}

actual fn setenv(name: str, value: str): bool {
    with (mem.heap()) {
        val n = name.cstr()
        val v = value.cstr()
        val rc = c.setenv(n, v, 1)
        free_cstr(n, name.len)
        free_cstr(v, value.len)
        return rc == 0
    }
}

actual fn unsetenv(name: str): bool {
    with (mem.heap()) {
        val n = name.cstr()
        val rc = c.unsetenv(n)
        free_cstr(n, name.len)
        return rc == 0
    }
}

actual fn pid(): i64 {
    return c.getpid() as i64
}

actual fn hostname(): (str, bool) {
    var buf: [256]u8
    if c.gethostname(buf[..].ptr as *c.char, 256) != 0 {
        return "", false
    }
    return c.copyCStr(buf[..].ptr as *const c.char), true
}

actual fn exe_path(): (str, bool) {
    var buf: [4096]u8
    val n = c.readlink(c"/proc/self/exe", buf[..].ptr as *c.char, 4095)
    if n < 0 {
        return "", false
    }
    buf[n as usize] = 0
    return c.copyCStr(buf[..].ptr as *const c.char), true
}

actual fn environ(): list.List<str> {
    with (mem.heap()) {
        var xs = list.empty<str>()
        val envp = c.jogrt_environ()
        if envp == null {
            return xs
        }
        var i: usize = 0
        for {
            // envp is *(*const char?)? — walk as an array of optional C string pointers.
            val entry_slot = ((envp!! as *u8) + (i * 8)) as **const c.char?
            val entry = entry_slot[0]
            if entry == null {
                break
            }
            xs.push(c.fromCStr(entry!!).clone())
            i = i + 1
        }
        return xs
    }
}

actual fn free_environ(xs: list.List<str>) {
    with (mem.heap()) {
        free_environ_owned(xs)
    }
}

private fn free_environ_owned(xs: list.List<str>) with (a: mem.Allocator) {
    var owned = xs
    var i: usize = 0
    for i < owned.len {
        val s = owned.get(i)
        if s.len > 0 {
            var block = bytes()
            block.ptr = s.ptr as *u8
            block.len = s.len
            a.free(block)
        }
        i = i + 1
    }
    owned.free()
}
