// Package std.os — argc/argv, env, and process parameters.
// env/setenv/unsetenv/pid/hostname/exe_path are expect/actual.
// home/temp_dir use env. exit is core.
// hostname/exe_path return error-arena copies (no with on expect yet).

import std.c
import std.list
import std.mem
import std.text

expect fn env(name: str): (str, bool)
expect fn setenv(name: str, value: str): bool
expect fn unsetenv(name: str): bool
expect fn pid(): i64
expect fn hostname(): (str, bool)
expect fn exe_path(): (str, bool)

fn argc(): i64 {
    return c.jogrt_argc() as i64
}

fn c_view(p: *u8, n: usize): str {
    var view = bytes()
    view.ptr = p
    view.len = n
    return view
}

fn argv(i: i64): str {
    val n = c.jogrt_argc() as i64
    if (i < 0 || i >= n) {
        panic("argument index out of range")
    }
    val p = c.jogrt_arg_ptr(i as c.int)
    if (p == null) {
        panic("argument index out of range")
    }
    val raw = p as *u8
    return c_view(raw, c.strlen(p as *const c.char))
}

/**
 * All process arguments as a List of views (same lifetime as argv).
 * Caller frees the list header with xs.free(); does not free the string bytes.
 */
fn args(): list.List<str> with (a: mem.Allocator) {
    var xs = list.empty<str>()
    val n = argc()
    xs.reserve(n as usize)
    var i: i64 = 0
    for i < n {
        xs.push(argv(i))
        i = i + 1
    }
    return xs
}

/**
 * Snapshot of the process environment as `KEY=value` strings (owned copies).
 * Call free_environ when done. POSIX uses jogrt_environ(); Windows walks via GetEnvironmentStringsW.
 */
expect fn environ(): list.List<str>
expect fn free_environ(xs: list.List<str>)

fn exit(code: i32) {
    // libc exit — jogrt_exit is not in the linux runtime yet (Friction).
    c.exit(code as c.int)
}

/**
 * $HOME or USERPROFILE via env. View lifetime matches env().
 */
fn home(): (str, bool) {
    val (v, ok) = env("HOME")
    if ok {
        return v, true
    }
    return env("USERPROFILE")
}

/**
 * Temp directory: TMPDIR, TEMP, TMP, or "/tmp".
 */
fn temp_dir(): (str, bool) {
    val (a1, ok1) = env("TMPDIR")
    if ok1 && a1.len > 0 {
        return a1, true
    }
    val (a2, ok2) = env("TEMP")
    if ok2 && a2.len > 0 {
        return a2, true
    }
    val (a3, ok3) = env("TMP")
    if ok3 && a3.len > 0 {
        return a3, true
    }
    return "/tmp", true
}
