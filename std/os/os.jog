// Package std.os — argc/argv for jog-v2 (env is platform actual).
import std.c

expect fn env(name: str): (str, bool)

fn argc(): i64 {
    return c.jogrt_argc() as i64
}

fn c_view(p: *u8, n: usize): str {
    var view = bytes()
    view.ptr = p
    view.len = n
    return view
}

fn argv(i: i64): str {
    val n = c.jogrt_argc() as i64
    if (i < 0 || i >= n) {
        panic("argument index out of range")
    }
    val p = c.jogrt_arg_ptr(i as c.int)
    if (p == null) {
        panic("argument index out of range")
    }
    val raw = p as *u8
    return c_view(raw, c.strlen(p as *const c.char))
}
