// Package std.conv. Parse and format integers and floats, and encode
// bytes as hex. parse_i64 matches strbuilder's historical contract;
// strbuilder.parse_i64 forwards here. format_* returns an owned str.
// parse_f64 rejects NaN and Inf spellings so JSON can reuse it.

import std.c
import std.math
import std.mem

// Digit value of one ASCII byte, or -1 when it is not 0-9, a-z, or A-Z.
private fn digit_value(b: u8): i64 {
    if b >= '0' as u8 && b <= '9' as u8 {
        return (b as i64) - ('0' as i64)
    }
    if b >= 'a' as u8 && b <= 'z' as u8 {
        return (b as i64) - ('a' as i64) + 10
    }
    if b >= 'A' as u8 && b <= 'Z' as u8 {
        return (b as i64) - ('A' as i64) + 10
    }
    return -1
}

// Lowercase digit. d is 0..35.
private fn digit_char(d: u64): u8 {
    if d < 10 {
        return (('0' as i64) + (d as i64)) as u8
    }
    return (('a' as i64) + (d as i64) - 10) as u8
}

private fn ascii_eq_ignore_case(text: str, word: str): bool {
    if text.len != word.len {
        return false
    }
    val gap = 'a' as u8 - 'A' as u8
    for i in 0 as usize..text.len {
        var a = text.ptr[i]
        var b = word.ptr[i]
        if a >= 'A' as u8 && a <= 'Z' as u8 {
            a = a + gap
        }
        if b >= 'A' as u8 && b <= 'Z' as u8 {
            b = b + gap
        }
        if a != b {
            return false
        }
    }
    return true
}

private fn is_nan_or_inf(text: str): bool {
    var start: usize = 0
    if text.len > 0 && (text.ptr[0] == '+' as u8 || text.ptr[0] == '-' as u8) {
        start = 1
    }
    if start >= text.len {
        return false
    }
    var view = bytes()
    view.ptr = (text.ptr + start) as *u8
    view.len = text.len - start
    return ascii_eq_ignore_case(view, "nan") ||
        ascii_eq_ignore_case(view, "inf") ||
        ascii_eq_ignore_case(view, "infinity")
}

/**
 * Reads text as an i64 in base. base is 2..36. An optional leading '+'
 * or '-' is accepted, and letters may be either case. ok is false for
 * an empty input, a base outside 2..36, a bad digit, or overflow.
 */
fn parse_i64(text: str, base: i64): (i64, bool) {
    if text.len == 0 || base < 2 || base > 36 {
        return 0, false
    }
    var neg = false
    var start: usize = 0
    val sign = text.ptr[0]
    if sign == '-' as u8 {
        neg = true
        start = 1
    } else if sign == '+' as u8 {
        start = 1
    }
    if start == text.len {
        return 0, false
    }
    var acc: u64 = 0
    var limit: u64 = 9223372036854775807
    if neg {
        limit = 9223372036854775808
    }
    val ubase = base as u64
    for i in start..text.len {
        val d = digit_value(text.ptr[i])
        if d < 0 || d >= base {
            return 0, false
        }
        val ud = d as u64
        if acc > (limit - ud) / ubase {
            return 0, false
        }
        acc = acc * ubase + ud
    }
    if neg {
        if acc == 9223372036854775808 {
            return -9223372036854775808, true
        }
        return -(acc as i64), true
    }
    return acc as i64, true
}

/**
 * Reads text as a u64 in base. base is 2..36. No sign. ok is false for
 * an empty input, a bad base, a bad digit, or overflow.
 */
fn parse_u64(text: str, base: i64): (u64, bool) {
    if text.len == 0 || base < 2 || base > 36 {
        return 0, false
    }
    var acc: u64 = 0
    val ubase = base as u64
    val max: u64 = 18446744073709551615
    for i in 0 as usize..text.len {
        val d = digit_value(text.ptr[i])
        if d < 0 || d >= base {
            return 0, false
        }
        val ud = d as u64
        if acc > (max - ud) / ubase {
            return 0, false
        }
        acc = acc * ubase + ud
    }
    return acc, true
}

/**
 * Parses a decimal float with an optional exponent. Rejects NaN and Inf
 * literals. Empty input, a bad digit, or a missing digit after '.' / 'e'
 * is (0.0, false).
 */
fn parse_f64(text: str): (f64, bool) {
    if text.len == 0 || is_nan_or_inf(text) {
        return 0.0, false
    }
    var neg = false
    var i: usize = 0
    if text.ptr[0] == '-' as u8 {
        neg = true
        i = 1
    } else if text.ptr[0] == '+' as u8 {
        i = 1
    }
    if i >= text.len {
        return 0.0, false
    }
    var value: f64 = 0.0
    var saw_digit = false
    for i < text.len {
        val c = text.ptr[i]
        if c < '0' as u8 || c > '9' as u8 {
            break
        }
        saw_digit = true
        value = value * 10.0 + ((c - '0' as u8) as i64 as f64)
        i = i + 1
    }
    if i < text.len && text.ptr[i] == '.' as u8 {
        i = i + 1
        var scale: f64 = 0.1
        var frac_digit = false
        for i < text.len {
            val c = text.ptr[i]
            if c < '0' as u8 || c > '9' as u8 {
                break
            }
            frac_digit = true
            saw_digit = true
            value = value + ((c - '0' as u8) as i64 as f64) * scale
            scale = scale * 0.1
            i = i + 1
        }
        if !frac_digit {
            return 0.0, false
        }
    }
    if !saw_digit {
        return 0.0, false
    }
    if i < text.len && (text.ptr[i] == 'e' as u8 || text.ptr[i] == 'E' as u8) {
        i = i + 1
        if i >= text.len {
            return 0.0, false
        }
        var exp_neg = false
        if text.ptr[i] == '-' as u8 {
            exp_neg = true
            i = i + 1
        } else if text.ptr[i] == '+' as u8 {
            i = i + 1
        }
        if i >= text.len {
            return 0.0, false
        }
        var exp: i64 = 0
        var exp_digit = false
        for i < text.len {
            val c = text.ptr[i]
            if c < '0' as u8 || c > '9' as u8 {
                break
            }
            exp_digit = true
            exp = exp * 10 + ((c - '0' as u8) as i64)
            if exp > 400 {
                return 0.0, false
            }
            i = i + 1
        }
        if !exp_digit {
            return 0.0, false
        }
        val factor = math.pow(10.0, exp as f64)
        if exp_neg {
            value = value / factor
        } else {
            value = value * factor
        }
    }
    if i != text.len {
        return 0.0, false
    }
    if neg {
        return -value, true
    }
    return value, true
}

private fn owned_from_digits(neg: bool, digits: *[64]u8, count: usize): str with (a: mem.Allocator) {
    var total = count
    if neg {
        total = total + 1
    }
    if total == 0 {
        return ""
    }
    val (raw, err) = a.alloc(total, align(u8))
    if err != null {
        panic("out of memory")
    }
    var at: usize = 0
    if neg {
        raw.ptr[0] = '-' as u8
        at = 1
    }
    var n = count
    for n != 0 {
        n = n - 1
        raw.ptr[at] = digits[n]
        at = at + 1
    }
    return raw
}

/**
 * Owned decimal/base text for n. base is 2..36. Digits are lowercase.
 */
fn format_i64(n: i64, base: i64): str with (a: mem.Allocator) {
    if base < 2 || base > 36 {
        panic("base out of range")
    }
    if n == 0 {
        val (raw, err) = a.alloc(1, align(u8))
        if err != null {
            panic("out of memory")
        }
        raw.ptr[0] = '0' as u8
        return raw
    }
    var neg = false
    var mag: u64 = 0
    if n < 0 {
        neg = true
        if n == -9223372036854775808 {
            mag = 9223372036854775808
        } else {
            mag = (-n) as u64
        }
    } else {
        mag = n as u64
    }
    var digits: [64]u8
    var count: usize = 0
    val ubase = base as u64
    for mag != 0 {
        val rem = mag % ubase
        mag = mag / ubase
        digits[count] = digit_char(rem)
        count = count + 1
    }
    return owned_from_digits(neg, &digits, count)
}

/**
 * Owned text for an unsigned value in base 2..36.
 */
fn format_u64(n: u64, base: i64): str with (a: mem.Allocator) {
    if base < 2 || base > 36 {
        panic("base out of range")
    }
    if n == 0 {
        val (raw, err) = a.alloc(1, align(u8))
        if err != null {
            panic("out of memory")
        }
        raw.ptr[0] = '0' as u8
        return raw
    }
    var mag = n
    var digits: [64]u8
    var count: usize = 0
    val ubase = base as u64
    for mag != 0 {
        val rem = mag % ubase
        mag = mag / ubase
        digits[count] = digit_char(rem)
        count = count + 1
    }
    return owned_from_digits(false, &digits, count)
}

/**
 * Fixed-precision decimal text. prec is the digit count after the point
 * (0..18). No locale. Rounds half away from zero for the last digit.
 */
fn format_f64(n: f64, prec: i64): str with (a: mem.Allocator) {
    if prec < 0 || prec > 18 {
        panic("precision out of range")
    }
    var neg = false
    var x = n
    if x < 0.0 {
        neg = true
        x = -x
    }
    var scale: f64 = 1.0
    var p: i64 = 0
    for p < prec {
        scale = scale * 10.0
        p = p + 1
    }
    var scaled = x * scale
    // Round half away from zero.
    scaled = math.floor(scaled + 0.5)
    var whole = math.floor(scaled / scale)
    var frac = scaled - whole * scale
    val wi = whole as i64
    val fi = frac as i64
    val int_text = format_i64(wi, 10)
    if prec == 0 {
        if !neg {
            return int_text
        }
        val (raw, err) = a.alloc(int_text.len + 1, align(u8))
        if err != null {
            panic("out of memory")
        }
        raw.ptr[0] = '-' as u8
        if int_text.len > 0 {
            c.memcpy((raw.ptr + 1) as *void, int_text.ptr as *const void, int_text.len)
        }
        var block = bytes()
        block.ptr = int_text.ptr as *u8
        block.len = int_text.len
        a.free(block)
        return raw
    }
    val frac_text = format_u64(fi as u64, 10)
    // Left-pad frac to prec digits.
    val pad = (prec as usize) - frac_text.len
    var total: usize = int_text.len + 1 + (prec as usize)
    if neg {
        total = total + 1
    }
    val (raw, err) = a.alloc(total, align(u8))
    if err != null {
        panic("out of memory")
    }
    var at: usize = 0
    if neg {
        raw.ptr[at] = '-' as u8
        at = at + 1
    }
    if int_text.len > 0 {
        c.memcpy((raw.ptr + at) as *void, int_text.ptr as *const void, int_text.len)
        at = at + int_text.len
    }
    raw.ptr[at] = '.' as u8
    at = at + 1
    var z: usize = 0
    for z < pad {
        raw.ptr[at] = '0' as u8
        at = at + 1
        z = z + 1
    }
    if frac_text.len > 0 {
        c.memcpy((raw.ptr + at) as *void, frac_text.ptr as *const void, frac_text.len)
    }
    var ib = bytes()
    ib.ptr = int_text.ptr as *u8
    ib.len = int_text.len
    a.free(ib)
    if frac_text.len > 0 {
        var fb = bytes()
        fb.ptr = frac_text.ptr as *u8
        fb.len = frac_text.len
        a.free(fb)
    }
    return raw
}

private fn hex_nibble(b: u8): u8 {
    val v = b as i64
    if v < 10 {
        return (('0' as i64) + v) as u8
    }
    return (('a' as i64) + v - 10) as u8
}

/**
 * Lowercase hex of every byte. Empty input allocates nothing.
 */
fn hex_encode(data: bytes): str with (a: mem.Allocator) {
    if data.len == 0 {
        return ""
    }
    val (raw, err) = a.alloc(data.len * 2, align(u8))
    if err != null {
        panic("out of memory")
    }
    for i in 0 as usize..data.len {
        val b = data.ptr[i]
        raw.ptr[i * 2] = hex_nibble(b >> 4)
        raw.ptr[i * 2 + 1] = hex_nibble(b & 0x0F)
    }
    return raw
}

/**
 * Decode an even-length hex string into owned bytes. Odd length or a
 * bad digit is (empty, false) and allocates nothing on failure.
 */
fn hex_decode(text: str): (bytes, bool) with (a: mem.Allocator) {
    if text.len == 0 {
        return bytes(), true
    }
    if text.len % 2 != 0 {
        return bytes(), false
    }
    val n = text.len / 2
    val (raw, err) = a.alloc(n, align(u8))
    if err != null {
        panic("out of memory")
    }
    for i in 0 as usize..n {
        val hi = digit_value(text.ptr[i * 2])
        val lo = digit_value(text.ptr[i * 2 + 1])
        if hi < 0 || hi > 15 || lo < 0 || lo > 15 {
            a.free(raw)
            return bytes(), false
        }
        raw.ptr[i] = ((hi * 16) + lo) as u8
    }
    return raw, true
}
