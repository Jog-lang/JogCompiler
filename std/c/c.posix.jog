// POSIX declarations and the 64-bit LP64 long. Loaded for linux and macos.
// struct dirent, posix_spawn_file_actions_t, and WEXITSTATUS are not
// declared here: their layouts and the macro are not stable enough to
// spell in Jog. jogrt_dirent_name, jogrt_spawn_actions_*, and
// jogrt_wexitstatus hide them. O_RDONLY is 0 on linux and macos, so
// open of /dev/null passes 0 and does not need the flag macros.
// mode_t for mkdir is jogrt_mkdir, because the typedef width differs
// between linux and macos.

type long = i64
type unsigned_long = u64

extern {
    fn opendir(name: *const char): *void?
    fn readdir(dir: *void): *void?
    fn closedir(dir: *void): int
    fn rmdir(path: *const char): int
    fn unlink(path: *const char): int
    fn rename(old_path: *const char, new_path: *const char): int
    fn setenv(name: *const char, value: *const char, overwrite: int): int
    fn posix_spawnp(
        pid: *int,
        file: *const char,
        actions: *const void?,
        attr: *const void?,
        argv: *(*const char?),
        envp: *(*const char?)?,
    ): int
    fn waitpid(pid: int, status: *int, options: int): int
    fn mkstemp(template: *char): int
    fn dup2(old_fd: int, new_fd: int): int
    fn read(fd: int, buf: *void, count: size_t): intptr_t
    fn write(fd: int, buf: *const void, count: size_t): intptr_t
    fn close(fd: int): int
    fn open(path: *const char, flags: int): int

    fn jogrt_dirent_name(ent: *const void?): *const char?
    fn jogrt_mkdir(path: *const char): int
    fn jogrt_spawn_actions_new(): *void?
    fn jogrt_spawn_actions_adddup2(actions: *void, fd: int, new_fd: int): int
    fn jogrt_spawn_actions_free(actions: *void?)
    fn jogrt_wexitstatus(status: int): int
}
