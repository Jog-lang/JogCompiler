// Package list, same as list.jog, so the tests see List and empty with
// no import of std.list. push, reserve, insert, new, and free need the
// allocator context: with (mem.heap()). t.expect takes a bool.
// A method does not take a trailing lambda as an argument, so each
// callback is passed in parentheses. map and fold name R.
//
// Programmer-error panics are expectPanic tests at the bottom.
// Out of memory in grow is not an @test.

import std.mem
import std.testing

struct Item {
    tag: u8
    n: i32
}

@test
fn listIterPull() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(10, 20, 30)
        var cur = xs.iter()
        val (a, aok) = cur.next()
        t.expect(aok)
        t.expect(a == 10)
        val (b, bok) = cur.next()
        t.expect(bok)
        t.expect(b == 20)
        val (c, cok) = cur.next()
        t.expect(cok)
        t.expect(c == 30)
        val (extra, more) = cur.next()
        t.expect(!more)
        t.expect(extra == 0)
        xs.free()
    }
    var none = empty<i32>().iter()
    val (missing, nok) = none.next()
    t.expect(!nok)
    t.expect(missing == 0)
}

@test
fn emptyList() with (t: testing.Testing) {
    var xs = empty<i32>()
    t.expect(xs.len == 0)
    t.expect(xs.cap == 0)
}

@test
fn pushOne() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(7)
        t.expect(xs.len == 1)
        t.expect(xs.cap == 8)
        t.expect(xs.get(0) == 7)
        xs.free()
    }
}

@test
fn pushPack() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(1, 2, 3)
        t.expect(xs.len == 3)
        t.expect(xs.get(0) == 1)
        t.expect(xs.get(1) == 2)
        t.expect(xs.get(2) == 3)
        t.expect(xs.cap == 8)
        xs.free()
    }
}

@test
fn growPastFirstCap() with (t: testing.Testing) {
    // First block is 8 slots, then capacity doubles.
    var xs = empty<i32>()
    with (mem.heap()) {
        for _ in 0 as usize..8 {
            xs.push(1)
        }
        t.expect(xs.len == 8)
        t.expect(xs.cap == 8)
        xs.push(1)
        t.expect(xs.len == 9)
        t.expect(xs.cap == 16)
        xs.free()
    }
}

@test
fn getAndSet() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(1)
        xs.push(2)
        xs.set(0, 9)
        t.expect(xs.get(0) == 9)
        t.expect(xs.get(1) == 2)
        t.expect(xs.len == 2)
        xs.free()
    }
}

@test
fn popLast() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(1)
        xs.push(2)
        val cap = xs.cap
        t.expect(xs.pop() == 2)
        t.expect(xs.len == 1)
        t.expect(xs.get(0) == 1)
        t.expect(xs.cap == cap)
        xs.free()
    }
}

@test
fn clearKeepsCap() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(1)
        xs.push(2)
        val cap = xs.cap
        xs.clear()
        t.expect(xs.len == 0)
        t.expect(xs.cap == cap)
        xs.push(3)
        t.expect(xs.cap == cap)
        t.expect(xs.len == 1)
        t.expect(xs.get(0) == 3)
        xs.free()
    }
}

@test
fn reserveEmpty() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.reserve(10)
        t.expect(xs.len == 0)
        t.expect(xs.cap >= 10)
        val cap = xs.cap
        xs.push(1)
        t.expect(xs.cap == cap)
        t.expect(xs.get(0) == 1)
        xs.free()
    }
}

@test
fn newCopiesPack() with (t: testing.Testing) {
    with (mem.heap()) {
        var none = new<i32>()
        t.expect(none.len == 0)
        t.expect(none.cap == 0)
        var xs = new<i32>(4, 5, 6)
        t.expect(xs.len == 3)
        t.expect(xs.cap >= 3)
        t.expect(xs.get(0) == 4)
        t.expect(xs.get(1) == 5)
        t.expect(xs.get(2) == 6)
        xs.free()
    }
}

@test
fn sliceViewSharesElements() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(1)
        xs.push(2)
        var view = xs.slice_view()
        t.expect(view.len == 2)
        t.expect(view[0] == 1)
        t.expect(view[1] == 2)
        view[0] = 9
        t.expect(xs.get(0) == 9)
        t.expect(xs.get(1) == 2)
        xs.clear()
        var emptyView = xs.slice_view()
        t.expect(emptyView.len == 0)
        xs.free()
    }
}

@test
fn insertAndRemove() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(1)
        xs.push(3)
        xs.insert(1, 2)
        t.expect(xs.len == 3)
        t.expect(xs.get(0) == 1)
        t.expect(xs.get(1) == 2)
        t.expect(xs.get(2) == 3)
        xs.insert(xs.len, 4)
        t.expect(xs.get(3) == 4)
        val gone = xs.remove(1)
        t.expect(gone == 2)
        t.expect(xs.len == 3)
        t.expect(xs.get(0) == 1)
        t.expect(xs.get(1) == 3)
        t.expect(xs.get(2) == 4)
        val last = xs.remove(xs.len - 1)
        t.expect(last == 4)
        t.expect(xs.len == 2)
        val cap = xs.cap
        for _ in 0 as usize..6 {
            xs.push(1)
        }
        t.expect(xs.len == 8)
        t.expect(xs.cap == cap)
        xs.insert(0, 7)
        t.expect(xs.len == 9)
        t.expect(xs.cap == 16)
        t.expect(xs.get(0) == 7)
        t.expect(xs.get(1) == 1)
        t.expect(xs.get(8) == 1)
        val head = xs.remove(0)
        t.expect(head == 7)
        t.expect(xs.len == 8)
        t.expect(xs.cap == 16)
        xs.free()
        t.expect(xs.len == 0)
        t.expect(xs.cap == 0)
        xs.push(5)
        t.expect(xs.get(0) == 5)
        t.expect(xs.cap == 8)
        xs.free()
    }
}

@test
fn structElements() with (t: testing.Testing) {
    var xs = empty<Item>()
    with (mem.heap()) {
        xs.push(Item(tag: 1, n: 10))
        xs.push(Item(tag: 2, n: 20))
        t.expect(xs.len == 2)
        t.expect(xs.cap == 8)
        val first = xs.get(0)
        val second = xs.get(1)
        t.expect(first.tag == 1)
        t.expect(first.n == 10)
        t.expect(second.tag == 2)
        t.expect(second.n == 20)
        xs.set(0, Item(tag: 9, n: 11))
        val updated = xs.get(0)
        t.expect(updated.tag == 9)
        t.expect(updated.n == 11)
        val last = xs.pop()
        t.expect(last.tag == 2)
        t.expect(last.n == 20)
        t.expect(xs.cap == 8)
        var built = new<Item>(Item(tag: 3, n: 30), Item(tag: 4, n: 40))
        t.expect(built.len == 2)
        val fromNew = built.get(1)
        t.expect(fromNew.n == 40)
        var view = built.slice_view()
        t.expect(view.len == 2)
        view[0] = Item(tag: 8, n: 80)
        val seen = built.get(0)
        t.expect(seen.tag == 8)
        t.expect(seen.n == 80)
        built.free()
        xs.free()
    }
}

@test
fn itemsWalksLivePrefix() with (t: testing.Testing) {
    var xs = empty<i32>()
    var n: i32 = 0
    var sum: i32 = 0
    for x in xs.items() {
        n = n + 1
        sum = sum + x
    }
    t.expect(n == 0)
    t.expect(sum == 0)
    with (mem.heap()) {
        xs.push(1)
        xs.push(2)
        xs.push(3)
        for x in xs.items() {
            n = n + 1
            sum = sum + x
        }
        t.expect(n == 3)
        t.expect(sum == 6)
        var view = xs.items()
        t.expect(view.len == xs.len)
        t.expect(view.len != xs.cap)
        view[0] = 9
        t.expect(xs.get(0) == 9)
        xs.clear()
        var gone = xs.items()
        t.expect(gone.len == 0)
        xs.free()
    }
}

@test
fn atMutates() with (t: testing.Testing) {
    var xs = empty<Item>()
    with (mem.heap()) {
        var item: Item
        item.n = 1
        xs.push(item)
        val p = xs.at(0)
        p.n = 9
        t.expect(xs.get(0).n == 9)
        xs.free()
    }
}

@test
fn helpersOnEmpty() with (t: testing.Testing) {
    var xs = empty<i32>()
    var n: i32 = 0
    xs.each((it) -> { n = n + 1 })
    t.expect(n == 0)
    var indexed: i32 = 0
    xs.each_index((item, index) -> {
        if index == 0 {
            indexed = item
        }
    })
    t.expect(indexed == 0)
    val anyEmpty = xs.any((it) -> it == 1)
    t.expect(anyEmpty == false)
    val allEmpty = xs.all((it) -> it == 1)
    t.expect(allEmpty)
    val folded = xs.fold<i32>(4 as i32, (acc, x) -> acc + x)
    t.expect(folded == 4)
    val (_, found) = xs.find((it) -> it == 1)
    t.expect(found == false)
    xs.reverse()
    t.expect(xs.len == 0)
    with (mem.heap()) {
        var mapped = xs.map<i32>((it) -> it + 1)
        t.expect(mapped.len == 0)
        t.expect(mapped.cap == 0)
        var kept = xs.filter((it) -> it > 0)
        t.expect(kept.len == 0)
        t.expect(kept.cap == 0)
        var copied = xs.clone()
        t.expect(copied.len == 0)
        t.expect(copied.cap == 0)
        mapped.free()
        kept.free()
        copied.free()
        xs.free()
    }
}

@test
fn mapAddsOne() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(1, 2, 3)
        var ys = xs.map<i32>((it) -> it + 1)
        t.expect(ys.len == 3)
        t.expect(ys.get(0) == 2)
        t.expect(ys.get(1) == 3)
        t.expect(ys.get(2) == 4)
        t.expect(xs.get(0) == 1)
        ys.free()
        xs.free()
    }
}

@test
fn filterKeepsMatches() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(1, 2, 3, 4)
        var ys = xs.filter((it) -> it > 2)
        t.expect(ys.len == 2)
        t.expect(ys.get(0) == 3)
        t.expect(ys.get(1) == 4)
        t.expect(xs.len == 4)
        ys.free()
        xs.free()
    }
}

@test
fn foldFromLeft() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(1, 2, 3)
        val sum = xs.fold<i32>(0 as i32, (acc, x) -> acc + x)
        t.expect(sum == 6)
        val order = xs.fold<i32>(0 as i32, (acc, x) -> acc * 10 + x)
        t.expect(order == 123)
        xs.free()
    }
}

@test
fn eachIndexOrder() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(10, 20, 30)
        var walk: i32 = 0
        xs.each((it) -> { walk = walk * 10 + it })
        t.expect(walk == 1230)
        var at0: i32 = -1
        var at1: i32 = -1
        var at2: i32 = -1
        xs.each_index((item, index) -> {
            if index == 0 {
                at0 = item
            }
            if index == 1 {
                at1 = item
            }
            if index == 2 {
                at2 = item
            }
        })
        t.expect(at0 == 10)
        t.expect(at1 == 20)
        t.expect(at2 == 30)
        val has = xs.any((it) -> it == 20)
        t.expect(has)
        val every = xs.all((it) -> it > 0)
        t.expect(every)
        val none = xs.any((it) -> it == 7)
        t.expect(none == false)
        val notAll = xs.all((it) -> it == 10)
        t.expect(notAll == false)
        xs.free()
    }
}

@test
fn findMissing() with (t: testing.Testing) {
    var xs = empty<i32>()
    val (emptyHit, emptyOk) = xs.find((it) -> it == 1)
    t.expect(emptyOk == false)
    t.expect(emptyHit == 0)
    with (mem.heap()) {
        xs.push(1, 2, 2)
        val (hit, ok) = xs.find((it) -> it == 2)
        t.expect(ok)
        t.expect(hit == 2)
        val (missed, miss) = xs.find((it) -> it == 9)
        t.expect(miss == false)
        t.expect(missed == 0)
        xs.free()
    }
}

@test
fn cloneCopiesPrefix() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(1, 2)
        var ys = xs.clone()
        t.expect(ys.len == 2)
        t.expect(ys.get(0) == 1)
        t.expect(ys.get(1) == 2)
        ys.set(0, 9)
        t.expect(xs.get(0) == 1)
        xs.push(3)
        t.expect(ys.len == 2)
        ys.free()
        xs.free()
    }
}

@test
fn reverseInPlace() with (t: testing.Testing) {
    var xs = empty<i32>()
    with (mem.heap()) {
        xs.push(5)
        xs.reverse()
        t.expect(xs.get(0) == 5)
        t.expect(xs.len == 1)
        xs.free()
        xs.push(1, 2, 3)
        val cap = xs.cap
        xs.reverse()
        t.expect(xs.len == 3)
        t.expect(xs.cap == cap)
        t.expect(xs.get(0) == 3)
        t.expect(xs.get(1) == 2)
        t.expect(xs.get(2) == 1)
        xs.reverse()
        t.expect(xs.get(0) == 1)
        t.expect(xs.get(2) == 3)
        xs.free()
    }
}

@test
fn panicUse() with (t: testing.Testing) {
    var xs = empty<i32>()
    t.expectPanic(() -> { xs.pop() })
    t.expect(xs.len == 0)
    with (mem.heap()) {
        xs.push(1)
    }
    t.expectPanic(() -> { xs.get(1) })
    t.expectPanic() { xs.set(1, 2) }
    t.expect(xs.get(0) == 1)
    t.expect(xs.len == 1)
    with (mem.heap()) {
        t.expectPanic(() -> { xs.insert(2, 3) })
        t.expectPanic(() -> { xs.remove(1) })
        t.expect(xs.len == 1)
        t.expect(xs.get(0) == 1)
        xs.free()
    }
}
