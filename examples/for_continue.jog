// for (condition form) + continue (jogc-shaped control flow).

fn main() {
    var i: i64 = 0
    var sum: i64 = 0
    for (i < 6) {
        i = i + 1
        if (i == 3) {
            continue
        }
        if (i >= 5) {
            break
        }
        sum = sum + i
    }
    // 1+2+4 = 7
    if (sum == 7 && i == 5) {
        print("for continue ok\n")
    } else {
        panic("for continue fail\n")
    }
}
