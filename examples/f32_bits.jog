// Native f32 bitcast helpers (replaces host libf32bits for demos).

fn main() {
    // 2.0f32 bits = 0x40000000 = 1073741824
    val bits = f32_bits(2.0)
    if (bits != 1073741824) {
        panic("f32_bits(2.0) BAD\n")
    }
    val back = f32_from_bits(1073741824)
    if (back != 2.0) {
        panic("f32_from_bits BAD\n")
    }
    // -0.5f32 bits = 0xBF000000 = 3204448256 as u32; compare via f32_from_bits
    val neg = f32_from_bits(3204448256)
    if (neg != (0.0 - 0.5)) {
        panic("f32_from_bits(-0.5) BAD\n")
    }
    print("f32 bits ok\n")
}
