// Optional pointers + flow-sensitive null check.

fn classify(p: *byte?): i64 {
    if (p != null) {
        return 1
    }
    return 0
}

fn main() {
    val a: *byte? = null
    if (classify(a) != 0) {
        panic("null should be empty\n")
    }
    val b: *byte? = alloc(8)
    if (classify(b) != 1) {
        panic("alloc should be non-null\n")
    }
    print("null flow ok\n")
}
