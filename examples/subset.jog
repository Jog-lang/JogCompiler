// v2 language subset: bytes-first buffers, interfaces, contexts, casting, null flow.

type Handle = u64

interface fn Handler(code: u16): u32

interface struct Allocator {
    fn alloc(size: usize): *byte
}

struct Buf {
    ptr: *byte
    len: usize
    cap: usize
}

fn *Buf.alloc(size: usize) with Allocator: *byte {
    return null
}

struct Arena {
    ptr: *byte
    len: usize
    cap: usize
}

fn *Arena.alloc(size: usize): *byte {
    return null
}

fn widen(x: u16): u32 {
    return x
}

fn narrow(x: u32): u16 {
    return x as u16
}

fn useBoth() with (a: Allocator): u16 {
    return 1
}

fn maybe(p: *byte?): usize {
    if (p != null) {
        return 1
    }
    return 0
}

fn optCall(p: *Buf?): usize {
    p?.alloc(8)
    return 0
}

fn main() {
    print("subset ok\n")
}
