// v2 language subset smoke: bytes-first buffers, interfaces, contexts, casting, null flow.

type Handle = u64

interface fn Handler(code: u16): u32

interface struct Allocator {
    fn alloc(size: usize): *byte
}

struct Buf {
    ptr: *byte
    len: usize
    cap: usize
}

fn *Buf.alloc(size: usize): *byte {
    return alloc(size)
}

struct Arena {
    ptr: *byte
    len: usize
    cap: usize
}

fn *Arena.alloc(size: usize): *byte {
    return alloc(size)
}

fn widen(x: u16): u32 {
    return x
}

fn narrow(x: u32): u16 {
    return x as u16
}

fn useBoth(n: usize) with (a: Allocator): *byte {
    return a.alloc(n)
}

fn maybe(p: *byte?): usize {
    if (p != null) {
        return 1
    }
    return 0
}

fn optCall(p: *Buf?): usize {
    p?.alloc(8)
    return 0
}

fn main() {
    val arena = Arena(ptr: null, len: 0, cap: 0)
    val p = useBoth(8) with (arena)
    if (maybe(p) != 1) {
        panic("subset alloc\n")
    }
    val b = Buf(ptr: p, len: 8, cap: 8)
    val q: *Buf? = b
    if (optCall(q) != 0) {
        panic("subset opt\n")
    }
    if (optCall(null) != 0) {
        panic("subset null opt\n")
    }
    if (narrow(widen(7)) != 7) {
        panic("subset cast\n")
    }
    print("subset ok\n")
}
