// Multi-method interface vtable.

interface struct Counter {
    fn inc(): i64
    fn get(): i64
}

struct Box {
    n: i64
}

fn *Box.inc(): i64 {
    self.n = self.n + 1
    return self.n
}

fn *Box.get(): i64 {
    return self.n
}

fn bump(c: Counter): i64 {
    c.inc()
    return c.get()
}

fn main() {
    val b = Box(n: 10)
    val v = bump(b as Counter)
    if (v == 11) {
        print("vtable ok\n")
    } else {
        panic("vtable fail\n")
    }
}
