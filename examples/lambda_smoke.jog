fn apply(x: i64, f: (i64) -> i64): i64 = f(x)

fn repeat(n: i64, body: (i64) -> ()) {
    for i in 0..n {
        body(i)
    }
}

fn twiceDo(body: () -> ()) {
    body()
    body()
}

fn main() {
    val double = (x: i64) -> { x * 2 }
    val inc = (x: i64): i64 -> x + 1
    var sum: i64 = 0
    repeat(3) { i -> sum += i }
    repeat(2) { sum += it }
    twiceDo { sum += 100 }
    val r = apply(5, double) + apply(5, inc) + sum + apply(1) { it * 7 }
    if r != 10 + 6 + 3 + 1 + 200 + 7 {
        panic("lambda smoke bad")
    }
    print("lambda ok\n")
}
