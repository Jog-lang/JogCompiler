// Native returning mainloop via jog_host_run_loop + @export tick.

var ticks: i64 = 0

@export
fn tick(): i32 {
    ticks = ticks + 1
    if (ticks >= 3) {
        return 0
    }
    return 1
}

fn main() {
    jog_host_run_loop(tick)
    if (ticks == 3) {
        print("host run loop ok\n")
    } else {
        panic("host run loop fail\n")
    }
}
