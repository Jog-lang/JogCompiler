// Multi-return tuples + destructure (JOG-87 P1).

fn pair(a: i64, b: i64): (i64, i64) {
    return (a, b)
}

fn main() {
    val (x, y) = pair(3, 4)
    if (x + y == 7) {
        val t = (10, 20)
        // Spec: pair.0 / pair.1 (Types.md); `_0` remains accepted as the synthetic name.
        if (t.0 + t.1 == 30) {
            print("tuples ok\n")
        } else {
            panic("fields\n")
        }
    } else {
        panic("destructure\n")
    }
}
