// %, <=/>=, bitwise &|^~ << >> (parity unlock).

fn main() {
    val a: i64 = 13
    val b: i64 = 5
    if (a % b != 3) {
        panic("rem\n")
    }
    if (!(a >= b) || !(b <= a)) {
        panic("cmp\n")
    }
    if ((a & b) != 5) {
        panic("and\n")
    }
    if ((a | b) != 13) {
        panic("or\n")
    }
    if ((a ^ b) != 8) {
        panic("xor\n")
    }
    if ((1 << 3) != 8) {
        panic("shl\n")
    }
    if ((16 >> 2) != 4) {
        panic("shr\n")
    }
    if ((~0 & 255) != 255) {
        panic("not\n")
    }
    print("bitwise ops ok\n")
}
