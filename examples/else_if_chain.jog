fn classify(x: i64): i64 {
    if x < 0 {
        return -1
    } else if x == 0 {
        return 0
    } else {
        return 1
    }
}
fn main() {
    if classify(-3) == -1 {
        if classify(0) == 0 {
            if classify(2) == 1 {
                print("else if ok\n")
                return
            }
        }
    }
    panic("else if fail\n")
}
