// JIR builders. Checked against compiler/src/ir.h and ir.c.
// Study note: JogDocs bootstrap/study/IR. LowerGuide steps 1+.

import src.check
import std.io
import std.list
import std.mem

enum OperandKind {
    NONE
    LOCAL
    INT
    FLOAT
    STRING
    CSTRING
    NULL
    GLOBAL
    FUNC
}

enum BinOp {
    ADD
    SUB
    MUL
    DIV
    REM
    AND
    OR
    XOR
    SHL
    SHR
    EQ
    NE
    LT
    LE
    GT
    GE
}

enum UnOp {
    NEG
    NOT
    BITNOT
}

enum Op {
    COPY
    ZERO
    BINARY
    UNARY
    CONVERT
    BITCAST
    LOAD
    STORE
    ADDR
    FIELD_ADDR
    ELEM_ADDR
    EXTRACT
    AGGREGATE
    ENUM_TAG
    CALL
    BOUNDS_CHECK
    NULL_CHECK
    PANIC
}

enum TermKind {
    NONE
    BR
    COND_BR
    SWITCH
    RET
    UNREACHABLE
}

enum Linkage {
    INTERNAL
    PUBLIC
    EXPORT
    EXTERN
}

enum RelocKind {
    NONE
    STRING
    CSTRING
    GLOBAL
    FUNC
}

struct Pos {
    file: str
    line: i64
    column: i64
}

struct Operand {
    kind: OperandKind
    ty: *check.Type?
    local: u32
    // Kept for layout parity with earlier jogc / stage0 codegen; stores of these
    // fields are unreliable (Friction). Int/float payloads use local|global|func.
    bits: u64
    f: f64
    str_ptr: str
    global: u32
    func: u32
}

struct Inst {
    op: Op
    aux: u32
    aux2: u32
    checked: bool
    dst: i32
    a: Operand
    b: Operand
    args: list.List<Operand>
    pos: Pos
}

struct Case {
    // i64 not u64: stage0 u64 field stores are broken (Friction Operand.bits).
    value: i64
    target: u32
}

struct Term {
    kind: TermKind
    value: Operand
    target: u32
    else_target: u32
    cases: list.List<Case>
    pos: Pos
}

struct Block {
    label: str
    // Heap *Inst (like Func): List<Inst> by value relocates on grow and
    // dangling *Inst from emit() corrupt memory under heavy fmt lowering.
    insts: list.List<*Inst>
    term: Term
}

struct Local {
    name: str
    ty: *check.Type?
    is_param: bool
    address_taken: bool
}

struct Func {
    name: str
    jog_name: str
    linkage: Linkage
    ty: *check.Type?
    param_count: u32
    locals: list.List<Local>
    blocks: list.List<Block>
    pos: Pos
}

struct Reloc {
    offset: u32
    index: u32
    addend: u32
    kind: RelocKind
    ptr: str
}

struct Global {
    name: str
    ty: *check.Type?
    is_const: bool
    data: list.List<u8>
    has_data: bool
    data_len: usize
    pos: Pos
    relocs: list.List<Reloc>
}

struct IfaceSlot {
    func: i32
    fn_type: *check.Type?
}

// One concrete/interface vtable. global is the dummy u8 emit skips.
struct IfaceTable {
    name: str
    tid_name: str
    global: i32
    concrete: *check.Type?
    iface: *check.Type?
    slots: list.List<IfaceSlot>
    offsets: list.List<u64>
}

struct Module {
    types: *check.TypeTable
    funcs: list.List<*Func>
    globals: list.List<*Global>
    iface_tables: list.List<IfaceTable>
    main_func: i32
    init_func: i32
}

fn pos_none(): Pos {
    var p: Pos
    p.file = ""
    p.line = 0
    p.column = 0
    return p
}

fn pos_of(file: str, line: i64, column: i64): Pos {
    var p: Pos
    p.file = file
    p.line = line
    p.column = column
    return p
}

fn none_op(): Operand {
    var o: Operand
    o.kind = OperandKind.NONE
    o.ty = null
    o.local = 0
    o.bits = 0
    o.f = 0.0
    o.str_ptr = ""
    o.global = 0
    o.func = 0
    return o
}

fn local_op(func: *Func, index: u32): Operand {
    var o = none_op()
    o.kind = OperandKind.LOCAL
    o.local = index
    if (index as usize) < func.locals.len {
        o.ty = func.locals.at(index as usize).ty
    }
    return o
}

private fn low32_u64(bits: u64): u32 {
    // Mask must be u64 — bare 0xffffffff is signed and sign-extends.
    val mask: u64 = 0xffffffff
    val lo = bits & mask
    // Bit-pun into u32 (checked `as u32` can still reject large-looking u64).
    var w: u64 = lo
    val p: *u8 = &w as *u8
    var out: u32 = 0
    val op: *u8 = &out as *u8
    op[0] = p[0]
    op[1] = p[1]
    op[2] = p[2]
    op[3] = p[3]
    return out
}

fn int_op(ty: *check.Type?, bits: i64): Operand {
    var o = none_op()
    o.kind = OperandKind.INT
    o.ty = ty
    // Stage0 drops u64 params/fields on Operand (Friction): store the
    // two's-complement low 32 bits in `local` (same slot C uses via union).
    // Bit-pun i64→u64 so negatives and values above i64::MAX do not panic on cast.
    var wide = bits
    val wp: *u8 = &wide as *u8
    var ubits: u64 = 0
    val up: *u8 = &ubits as *u8
    var i: usize = 0
    for i < 8 {
        up[i] = wp[i]
        i = i + 1
    }
    // Prefer local for the common path. Only stash hi32 in `global` when
    // needed — some stage0 Operand copies appear to lose `local` after a
    // following `global` write when both are set unconditionally.
    o.local = low32_u64(ubits)
    val hi = low32_u64(ubits >> 32)
    if hi != 0 {
        o.global = hi
    }
    return o
}

/** Reconstruct integer bits stored by int_op (local|global). */
fn int_operand_bits(op: Operand): u64 {
    return (op.local as u64) | ((op.global as u64) << 32)
}

/**
 * Float operand from a local f64 (pass by pointer — f64 params are unreliable).
 * Matches global.jog's byte extract into lo/hi on Operand.
 */
fn float_op(ty: *check.Type?, value: *f64): Operand {
    var o = none_op()
    o.kind = OperandKind.FLOAT
    o.ty = ty
    val p: *u8 = value as *u8
    var lo: u32 = 0
    var hi: u32 = 0
    val lp: *u8 = &lo as *u8
    val hp: *u8 = &hi as *u8
    var i: usize = 0
    for i < 4 {
        lp[i] = p[i]
        hp[i] = p[i + 4]
        i = i + 1
    }
    o.local = lo
    o.func = hi
    return o
}

fn string_op(ty: *check.Type?, text: str): Operand {
    var o = none_op()
    o.kind = OperandKind.STRING
    o.ty = ty
    o.str_ptr = text
    return o
}

fn cstring_op(ty: *check.Type?, text: str): Operand {
    var o = string_op(ty, text)
    o.kind = OperandKind.CSTRING
    return o
}

fn null_op(ty: *check.Type?): Operand {
    var o = none_op()
    o.kind = OperandKind.NULL
    o.ty = ty
    return o
}

fn global_ref(module: *Module, index: u32): Operand with (a: mem.Allocator) {
    var o = none_op()
    o.kind = OperandKind.GLOBAL
    o.global = index
    if (index as usize) < module.globals.len {
        val g = module.globals.get(index as usize)
        if g.ty != null {
            o.ty = check.type_ptr(module.types, g.ty!!, g.is_const) as *check.Type?
        }
    }
    return o
}

fn func_ref(module: *Module, index: u32): Operand {
    var o = none_op()
    o.kind = OperandKind.FUNC
    o.func = index
    if (index as usize) < module.funcs.len {
        o.ty = module.funcs.get(index as usize).ty
    }
    return o
}

fn empty_term(): Term {
    var t: Term
    t.kind = TermKind.NONE
    t.value = none_op()
    t.target = 0
    t.else_target = 0
    t.cases = list.empty<Case>()
    t.pos = pos_none()
    return t
}

fn module_create(types: *check.TypeTable): Module with (a: mem.Allocator) {
    return Module(
        types: types,
        funcs: list.empty<*Func>(),
        globals: list.empty<*Global>(),
        iface_tables: list.empty<IfaceTable>(),
        main_func: -1,
        init_func: -1,
    )
}

/**
 * IR enum values for other packages (same pattern as lex.kind() / check.type_kinds()).
 */
struct OpKinds {
    COPY: Op
    ZERO: Op
    BINARY: Op
    UNARY: Op
    CONVERT: Op
    BITCAST: Op
    LOAD: Op
    STORE: Op
    ADDR: Op
    FIELD_ADDR: Op
    ELEM_ADDR: Op
    EXTRACT: Op
    AGGREGATE: Op
    ENUM_TAG: Op
    CALL: Op
    BOUNDS_CHECK: Op
    NULL_CHECK: Op
    PANIC: Op
}

fn op_kinds(): OpKinds {
    var k: OpKinds
    k.COPY = Op.COPY
    k.ZERO = Op.ZERO
    k.BINARY = Op.BINARY
    k.UNARY = Op.UNARY
    k.CONVERT = Op.CONVERT
    k.BITCAST = Op.BITCAST
    k.LOAD = Op.LOAD
    k.STORE = Op.STORE
    k.ADDR = Op.ADDR
    k.FIELD_ADDR = Op.FIELD_ADDR
    k.ELEM_ADDR = Op.ELEM_ADDR
    k.EXTRACT = Op.EXTRACT
    k.AGGREGATE = Op.AGGREGATE
    k.ENUM_TAG = Op.ENUM_TAG
    k.CALL = Op.CALL
    k.BOUNDS_CHECK = Op.BOUNDS_CHECK
    k.NULL_CHECK = Op.NULL_CHECK
    k.PANIC = Op.PANIC
    return k
}

struct TermKinds {
    NONE: TermKind
    BR: TermKind
    COND_BR: TermKind
    SWITCH: TermKind
    RET: TermKind
    UNREACHABLE: TermKind
}

fn term_kinds(): TermKinds {
    var k: TermKinds
    k.NONE = TermKind.NONE
    k.BR = TermKind.BR
    k.COND_BR = TermKind.COND_BR
    k.SWITCH = TermKind.SWITCH
    k.RET = TermKind.RET
    k.UNREACHABLE = TermKind.UNREACHABLE
    return k
}

struct OperandKinds {
    NONE: OperandKind
    LOCAL: OperandKind
    INT: OperandKind
    FLOAT: OperandKind
    STRING: OperandKind
    CSTRING: OperandKind
    NULL: OperandKind
    GLOBAL: OperandKind
    FUNC: OperandKind
}

fn operand_kinds(): OperandKinds {
    var k: OperandKinds
    k.NONE = OperandKind.NONE
    k.LOCAL = OperandKind.LOCAL
    k.INT = OperandKind.INT
    k.FLOAT = OperandKind.FLOAT
    k.STRING = OperandKind.STRING
    k.CSTRING = OperandKind.CSTRING
    k.NULL = OperandKind.NULL
    k.GLOBAL = OperandKind.GLOBAL
    k.FUNC = OperandKind.FUNC
    return k
}

struct Linkages {
    INTERNAL: Linkage
    PUBLIC: Linkage
    EXPORT: Linkage
    EXTERN: Linkage
}

fn linkages(): Linkages {
    var k: Linkages
    k.INTERNAL = Linkage.INTERNAL
    k.PUBLIC = Linkage.PUBLIC
    k.EXPORT = Linkage.EXPORT
    k.EXTERN = Linkage.EXTERN
    return k
}

struct RelocKinds {
    NONE: RelocKind
    STRING: RelocKind
    CSTRING: RelocKind
    GLOBAL: RelocKind
    FUNC: RelocKind
}

fn reloc_kinds(): RelocKinds {
    var k: RelocKinds
    k.NONE = RelocKind.NONE
    k.STRING = RelocKind.STRING
    k.CSTRING = RelocKind.CSTRING
    k.GLOBAL = RelocKind.GLOBAL
    k.FUNC = RelocKind.FUNC
    return k
}

struct BinOps {
    ADD: BinOp
    SUB: BinOp
    MUL: BinOp
    DIV: BinOp
    REM: BinOp
    AND: BinOp
    OR: BinOp
    XOR: BinOp
    SHL: BinOp
    SHR: BinOp
    EQ: BinOp
    NE: BinOp
    LT: BinOp
    LE: BinOp
    GT: BinOp
    GE: BinOp
}

fn bin_ops(): BinOps {
    var k: BinOps
    k.ADD = BinOp.ADD
    k.SUB = BinOp.SUB
    k.MUL = BinOp.MUL
    k.DIV = BinOp.DIV
    k.REM = BinOp.REM
    k.AND = BinOp.AND
    k.OR = BinOp.OR
    k.XOR = BinOp.XOR
    k.SHL = BinOp.SHL
    k.SHR = BinOp.SHR
    k.EQ = BinOp.EQ
    k.NE = BinOp.NE
    k.LT = BinOp.LT
    k.LE = BinOp.LE
    k.GT = BinOp.GT
    k.GE = BinOp.GE
    return k
}

struct UnOps {
    NEG: UnOp
    NOT: UnOp
    BITNOT: UnOp
}

fn un_ops(): UnOps {
    var k: UnOps
    k.NEG = UnOp.NEG
    k.NOT = UnOp.NOT
    k.BITNOT = UnOp.BITNOT
    return k
}

fn binop_aux(op: BinOp): u32 {
    when op {
        ADD -> {
            return 0
        }
        SUB -> {
            return 1
        }
        MUL -> {
            return 2
        }
        DIV -> {
            return 3
        }
        REM -> {
            return 4
        }
        AND -> {
            return 5
        }
        OR -> {
            return 6
        }
        XOR -> {
            return 7
        }
        SHL -> {
            return 8
        }
        SHR -> {
            return 9
        }
        EQ -> {
            return 10
        }
        NE -> {
            return 11
        }
        LT -> {
            return 12
        }
        LE -> {
            return 13
        }
        GT -> {
            return 14
        }
        GE -> {
            return 15
        }
    }
}

fn unop_aux(op: UnOp): u32 {
    when op {
        NEG -> {
            return 0
        }
        NOT -> {
            return 1
        }
        BITNOT -> {
            return 2
        }
    }
}

fn func_add(
    module: *Module,
    name: str,
    jog_name: str,
    linkage: Linkage,
    fn_type: *check.Type,
    param_names: list.List<str>,
): i32 with (a: mem.Allocator) {
    if !check.type_is_fn(fn_type) {
        return -1
    }
    val (raw, err) = a.alloc(size(Func), align(Func))
    if err != null {
        panic("out of memory")
    }
    val func = raw.ptr as *Func
    func.name = name
    func.jog_name = jog_name
    func.linkage = linkage
    func.ty = fn_type as *check.Type?
    func.param_count = fn_type.elems.len as u32
    func.locals = list.empty<Local>()
    func.blocks = list.empty<Block>()
    // Avoid relocating locals/blocks mid-body (nested Lists in Block + any
    // retained *Local into the locals buffer).
    func.locals.reserve(4096)
    func.blocks.reserve(256)
    func.pos = pos_none()
    var i: usize = 0
    for i < fn_type.elems.len {
        var loc: Local
        if i < param_names.len {
            loc.name = param_names.get(i)
        } else {
            loc.name = ""
        }
        loc.ty = fn_type.elems.get(i) as *check.Type?
        loc.is_param = true
        loc.address_taken = false
        func.locals.push(loc)
        i = i + 1
    }
    module.funcs.push(func)
    return (module.funcs.len - 1) as i32
}

fn func_at(module: *Module, index: u32): *Func? {
    if (index as usize) >= module.funcs.len {
        return null
    }
    return module.funcs.get(index as usize) as *Func?
}

fn local_add(func: *Func, name: str, ty: *check.Type?): u32 with (a: mem.Allocator) {
    var loc: Local
    loc.name = name
    loc.ty = ty
    loc.is_param = false
    loc.address_taken = false
    func.locals.push(loc)
    return (func.locals.len - 1) as u32
}

fn block_add(func: *Func, label: str): u32 with (a: mem.Allocator) {
    var b: Block
    b.label = label
    b.insts = list.empty<*Inst>()
    b.term = empty_term()
    func.blocks.push(b)
    return (func.blocks.len - 1) as u32
}

fn emit(func: *Func, block: u32, op: Op, dst: i32): *Inst? with (a: mem.Allocator) {
    if (block as usize) >= func.blocks.len {
        return null
    }
    val (raw, err) = a.alloc(size(Inst), align(Inst))
    if err != null {
        return null
    }
    val inst = raw.ptr as *Inst
    inst.op = op
    inst.aux = 0
    inst.aux2 = 0
    inst.checked = false
    inst.dst = dst
    inst.a = none_op()
    inst.b = none_op()
    inst.args = list.empty<Operand>()
    inst.pos = pos_none()
    val blk = func.blocks.at(block as usize)
    blk.insts.push(inst)
    return inst
}

fn set_args(inst: *Inst, args: list.List<Operand>) with (a: mem.Allocator) {
    // Fresh list (do not assign `args` by value — shared buffer / double-free).
    inst.args = list.empty<Operand>()
    inst.args.reserve(args.len)
    for arg in args.items() {
        inst.args.push(arg)
    }
}

fn terminate(func: *Func, block: u32, term: Term) {
    if (block as usize) >= func.blocks.len {
        return
    }
    func.blocks.at(block as usize).term = term
}

fn global_add(module: *Module, name: str, ty: *check.Type?, is_const: bool): i32 with (a: mem.Allocator) {
    val (raw, err) = a.alloc(size(Global), align(Global))
    if err != null {
        panic("out of memory")
    }
    val g = raw.ptr as *Global
    g.name = name
    g.ty = ty
    g.is_const = is_const
    g.data = list.empty<u8>()
    g.has_data = false
    g.data_len = 0
    g.pos = pos_none()
    g.relocs = list.empty<Reloc>()
    module.globals.push(g)
    return (module.globals.len - 1) as i32
}

fn global_at(module: *Module, index: u32): *Global? {
    if (index as usize) >= module.globals.len {
        return null
    }
    return module.globals.get(index as usize) as *Global?
}

private fn produces_value(op: Op): bool {
    when op {
        STORE -> {
            return false
        }
        CALL -> {
            return false
        }
        BOUNDS_CHECK -> {
            return false
        }
        NULL_CHECK -> {
            return false
        }
        PANIC -> {
            return false
        }
        else -> {
            return true
        }
    }
}

private fn check_operand(module: *Module, func: *Func, op: Operand): bool {
    when op.kind {
        LOCAL -> {
            if (op.local as usize) >= func.locals.len {
                return false
            }
        }
        GLOBAL -> {
            if (op.global as usize) >= module.globals.len {
                return false
            }
        }
        FUNC -> {
            if (op.func as usize) >= module.funcs.len {
                return false
            }
        }
        else -> {
        }
    }
    if op.kind != OperandKind.NONE && op.ty == null {
        return false
    }
    return true
}

/**
 * Structural IR checks. Marks address_taken on ADDR locals.
 * @return true when valid
 */
fn verify(module: *Module): bool {
    return verify_detail(module, false)
}

fn verify_detail(module: *Module, noisy: bool): bool {
    var ok = true
    for fi in 0 as usize..module.funcs.len {
        val func = module.funcs.get(fi)
        if func.linkage == Linkage.EXTERN {
            if func.blocks.len != 0 {
                if noisy {
                    io.eprintln("verify: extern has body")
                }
                ok = false
            }
            continue
        }
        if func.blocks.len == 0 {
            if noisy {
                io.eprint("verify: function has no blocks: ")
                io.eprintln(func.jog_name)
            }
            ok = false
            continue
        }
        for bi in 0 as usize..func.blocks.len {
            val block = func.blocks.at(bi)
            for ii in 0 as usize..block.insts.len {
                val inst = block.insts.get(ii)
                if produces_value(inst.op) && inst.dst < 0 {
                    if noisy {
                        io.eprintln("verify: missing dst")
                    }
                    ok = false
                }
                if inst.dst >= 0 && (inst.dst as usize) >= func.locals.len {
                    if noisy {
                        io.eprintln("verify: dst out of range")
                    }
                    ok = false
                }
                if !check_operand(module, func, inst.a) || !check_operand(module, func, inst.b) {
                    if noisy {
                        io.eprintln("verify: bad operand a/b")
                    }
                    ok = false
                }
                for arg in inst.args.items() {
                    if !check_operand(module, func, arg) {
                        if noisy {
                            io.eprintln("verify: bad call arg")
                        }
                        ok = false
                    }
                }
                if inst.op == Op.ADDR {
                    if inst.a.kind != OperandKind.LOCAL {
                        ok = false
                    } else if (inst.a.local as usize) < func.locals.len {
                        func.locals.at(inst.a.local as usize).address_taken = true
                    }
                }
            }
            when block.term.kind {
                NONE -> {
                    if noisy {
                        io.eprintln("verify: unterminated")
                    }
                    ok = false
                }
                BR -> {
                    if (block.term.target as usize) >= func.blocks.len {
                        ok = false
                    }
                }
                COND_BR -> {
                    if (block.term.target as usize) >= func.blocks.len {
                        ok = false
                    }
                    if (block.term.else_target as usize) >= func.blocks.len {
                        ok = false
                    }
                    if !check_operand(module, func, block.term.value) {
                        if noisy {
                            io.eprintln("verify: bad cond")
                        }
                        ok = false
                    }
                }
                SWITCH -> {
                    if (block.term.target as usize) >= func.blocks.len {
                        ok = false
                    }
                    if !check_operand(module, func, block.term.value) {
                        ok = false
                    }
                    for c in block.term.cases.items() {
                        if (c.target as usize) >= func.blocks.len {
                            ok = false
                        }
                    }
                }
                RET -> {
                    if block.term.value.kind != OperandKind.NONE {
                        if !check_operand(module, func, block.term.value) {
                            ok = false
                        }
                    }
                }
                UNREACHABLE -> {
                }
            }
        }
    }
    return ok
}
