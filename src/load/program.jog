// Loaded program handed from the loader to the checker. Matches the
// packages list on JogProgram after jog_load / jog_resolve_packages.
// CheckerGuide step 1.

import std.list
import std.mem

/**
 * A successfully loaded and name-resolved module graph. packages is in
 * dependency order. The checker types these; it does not resolve again.
 */
struct Program {
    packages: list.List<*Package>
    root_module: str
    // *check.TypeTable after a successful check.run (LowerGuide). Opaque
    // so load does not import check.
    types: *u8?
    // Runtime directory the loader found (JOG_ROOT/runtime, else next to std).
    runtime_root: str
    is_library: bool
    // jog.mod `link` names for the root module.
    links: list.List<str>
    // -L search paths: root libdir, then each --module, then CLI; last wins.
    libdirs: list.List<str>
}

/**
 * An empty program. The loader fills packages on a clean load.
 * @context a allocator for the package list
 * @return a program with no packages
 */
fn empty_program(): Program with (a: mem.Allocator) {
    var p: Program
    p.packages = list.empty<*Package>()
    p.root_module = ""
    p.types = null
    p.runtime_root = ""
    p.is_library = false
    p.links = list.empty<str>()
    p.libdirs = list.empty<str>()
    return p
}
