// One node of the syntax tree. Fields a kind does not use stay empty.
// kids is the print order. op is EOF when the node has no operator.
// flag holds a word the printer shows, such as const or private(file).
// head is how many leading kids are the parameters of a function type.

import src.lex
import std.list
import std.mem

struct Node {
    kind: NodeKind
    line: i64
    column: i64
    name: str
    text: str
    op: lex.TokenKind
    flag: str
    head: i64
    kids: list.List<*Node>
}

/**
 * True when the node is an `import` declaration. Other packages cannot
 * write `parse.NodeKind.IMPORT` (a variant of another package is not a
 * value), the same limit that forced `lex.kind()`.
 * @param node any AST node
 * @return whether kind is IMPORT
 */
fn is_import(node: *Node): bool {
    return node.kind == NodeKind.IMPORT
}

fn is_fn(node: *Node): bool {
    return node.kind == NodeKind.FN
}

fn is_var(node: *Node): bool {
    return node.kind == NodeKind.VAR
}

