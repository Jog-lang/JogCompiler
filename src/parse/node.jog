/**
 * True when the FN node's packed head says it has a receiver.
 * @param node a FN node
 * @return whether this is a method
 */
fn fn_has_receiver(node: *Node): bool {
    return (node.head / 65536) % 2 == 1
}

/**
 * True when `word` is a space-separated token in flag (visibility / mode).
 * @param flag node.flag text
 * @param word token to find
 * @return whether the word is present
 */
fn flag_has_word(flag: str, word: str): bool {
    if word.len == 0 {
        return false
    }
    var start: usize = 0
    var i: usize = 0
    for i <= flag.len {
        if i == flag.len || flag.ptr[i] == ' ' as u8 {
            if i > start {
                var same = i - start == word.len
                if same {
                    var j: usize = 0
                    for j < word.len {
                        if flag.ptr[start + j] != word.ptr[j] {
                            same = false
                            break
                        }
                        j = j + 1
                    }
                }
                if same {
                    return true
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    return false
}

/**
 * A node in the arena. name, text, and flag are empty. op is EOF.
 * kids is an empty list. head is 0.
 * @param kind node kind
 * @param line 1-based line of the first token
 * @param column 1-based column of the first token
 * @context a allocator for the node
 * @return the node
 */
fn make_node(kind: NodeKind, line: i64, column: i64): *Node with (a: mem.Allocator) {
    val (raw, err) = a.alloc(size(Node), align(Node))
    if err != null {
        panic("out of memory")
    }
    val node = raw.ptr as *Node
    node.kind = kind
    node.line = line
    node.column = column
    node.name = ""
    node.text = ""
    node.flag = ""
    node.op = lex.kind().EOF
    node.head = 0
    node.kids = list.empty<*Node>()
    return node
}

/**
 * A PARAM node for the checker (inferred context parameters).
 * Other packages cannot name NodeKind.PARAM as a value.
 */
fn make_param(line: i64, column: i64): *Node with (a: mem.Allocator) {
    return make_node(NodeKind.PARAM, line, column)
}
