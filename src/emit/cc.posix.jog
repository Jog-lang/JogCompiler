// POSIX bodies for emit.cc. Loaded for linux and macos.

import std.c

private fn fill(path: str, dest: *u8): bool {
    if path.len == 0 || path.len >= 4096 {
        return false
    }
    c.memcpy(dest as *void, path.ptr as *const void, path.len)
    dest[path.len] = 0
    return true
}

actual fn is_dir(path: str): bool {
    var buf: [4096]u8
    if !fill(path, buf[..].ptr) {
        return false
    }
    val dir = c.opendir(buf[..].ptr as *const c.char)
    if dir == null {
        return false
    }
    c.closedir(dir!!)
    return true
}

actual fn is_file(path: str): bool {
    if is_dir(path) {
        return false
    }
    var buf: [4096]u8
    if !fill(path, buf[..].ptr) {
        return false
    }
    val fd = c.open(buf[..].ptr as *const c.char, 0)
    if fd < 0 {
        return false
    }
    c.close(fd)
    return true
}

actual fn path_sep(): u8 {
    return ':' as u8
}

actual fn exe_suffix(): str {
    return ""
}
