// String bytes, global images, and jog_entry_init / jog_entry_main.
// Checked against compiler/src/emit_c.c. EmitGuide step 6. Interface
// tables stay unwired.

import src.check
import src.ir
import std.list
import std.mem

fn find_bytes(e: *Emit, text: str, cstring: bool): i32 {
    for i in 0 as usize..e.strings.len {
        val s = e.strings.get(i)
        if s.cstring == cstring && s.text == text {
            return i as i32
        }
    }
    return -1
}

private fn note_bytes(e: *Emit, text: str, cstring: bool) with (a: mem.Allocator) {
    if find_bytes(e, text, cstring) >= 0 {
        return
    }
    var item: EmitStr
    item.text = text
    item.cstring = cstring
    e.strings.push(item)
}

private fn note_operand(e: *Emit, op: *ir.Operand) with (a: mem.Allocator) {
    if op.kind == e.opnds.STRING {
        note_bytes(e, op.str_ptr, false)
        return
    }
    if op.kind == e.opnds.CSTRING {
        note_bytes(e, op.str_ptr, true)
    }
}

private fn note_global_relocs(e: *Emit) with (a: mem.Allocator) {
    val kinds = ir.reloc_kinds()
    for i in 0 as usize..e.module.globals.len {
        val g = e.module.globals.get(i)
        for r in 0 as usize..g.relocs.len {
            val rel = g.relocs.at(r)
            if rel.kind == kinds.STRING {
                note_bytes(e, rel.ptr, false)
            } else if rel.kind == kinds.CSTRING {
                note_bytes(e, rel.ptr, true)
            }
        }
    }
}

fn note_strings(e: *Emit) with (a: mem.Allocator) {
    note_global_relocs(e)
    for fi in 0 as usize..e.module.funcs.len {
        val func = e.module.funcs.get(fi)
        if func.linkage == e.links.EXTERN {
            continue
        }
        for bi in 0 as usize..func.blocks.len {
            val block = func.blocks.at(bi)
            for ii in 0 as usize..block.insts.len {
                val inst = block.insts.get(ii)
                note_operand(e, &inst.a)
                note_operand(e, &inst.b)
                for ai in 0 as usize..inst.args.len {
                    note_operand(e, inst.args.at(ai))
                }
            }
            note_operand(e, &block.term.value)
        }
    }
}

fn emit_string_data(e: *Emit) with (a: mem.Allocator) {
    for i in 0 as usize..e.strings.len {
        val s = e.strings.get(i)
        e.out.append("static const uint8_t jog_")
        if s.cstring {
            e.out.append("c")
        } else {
            e.out.append("s")
        }
        e.out.append_int(i as i64, 10)
        e.out.append("[] = {")
        for b in 0 as usize..s.text.len {
            if b > 0 {
                e.out.append(", ")
            }
            e.out.append_int(s.text.ptr[b] as i64, 10)
        }
        if s.cstring {
            if s.text.len > 0 {
                e.out.append(", ")
            }
            e.out.append("0")
        } else if s.text.len == 0 {
            e.out.append("0")
        }
        e.out.append("};\n")
    }
}

private fn is_ident_start(c: u8): bool {
    return (c >= 'a' as u8 && c <= 'z' as u8) || (c >= 'A' as u8 && c <= 'Z' as u8) || c == '_' as u8
}

private fn is_ident_char(c: u8): bool {
    return is_ident_start(c) || (c >= '0' as u8 && c <= '9' as u8)
}

fn c_ident(name: str): bool {
    if name.len == 0 || !is_ident_start(name.ptr[0]) {
        return false
    }
    for i in 1 as usize..name.len {
        if !is_ident_char(name.ptr[i]) {
            return false
        }
    }
    return true
}

fn global_is_object(e: *Emit, g: *ir.Global): bool {
    if g.ty == null {
        return false
    }
    return !skip_value(e, g.ty)
}

private fn emit_global_uses(e: *Emit) with (a: mem.Allocator) {
    for i in 0 as usize..e.module.globals.len {
        val g = e.module.globals.get(i)
        if !global_is_object(e, g) || !c_ident(g.name) {
            continue
        }
        e.out.append("    (void)&")
        e.out.append(g.name)
        e.out.append(";\n")
    }
}

private fn entry_variadic(e: *Emit, func: *ir.Func): bool {
    if func.ty == null {
        return false
    }
    val ty = func.ty!!
    return ty.kind == e.kinds.FN && ty.fn_variadic
}

fn emit_entry(e: *Emit, name: str, index: i32) with (a: mem.Allocator) {
    e.out.append("void ")
    e.out.append(name)
    e.out.append("(void) {\n")
    if name == "jog_entry_init" {
        emit_global_uses(e)
    }
    if index >= 0 {
        val func = ir.func_at(e.module, index as u32)
        if func == null || func!!.name.len == 0 {
            fail(e, "C backend: missing entry function")
        } else if kept_func_params(e, func!!) != 0 || entry_variadic(e, func!!) {
            fail(e, "C backend: entry function must take no parameters")
        } else {
            e.out.append("    ")
            e.out.append(func!!.name)
            e.out.append("();\n")
        }
    }
    e.out.append("}\n")
}

struct GlobalWalk {
    color: list.List<u8>
    any: bool
}

private fn round_up(n: u64, align_b: u32): u64 {
    var a = align_b
    if a < 1 {
        a = 1
    }
    val au = a as u64
    return (n + au - 1) / au * au
}

private fn byte_mask(n: usize): u64 {
    if n == 1 {
        return 255
    }
    if n == 2 {
        return 65535
    }
    if n == 4 {
        return 4294967295
    }
    return 18446744073709551615
}

private fn i64_bits(value: i64): u64 {
    if value >= 0 {
        return value as u64
    }
    return 0
}

private fn spelled_aggregate(e: *Emit, ty: *check.Type): bool {
    var cur = ty
    for cur.kind == e.kinds.DISTINCT && cur.intrinsic == 0 && cur.elem != null {
        cur = cur.elem!!
    }
    if cur.kind == e.kinds.DISTINCT && cur.intrinsic != 0 {
        return false
    }
    if cur.kind == e.kinds.OPTION && check.type_option_is_niche(cur) {
        return false
    }
    if cur.kind == e.kinds.FN && cur.fn_extern {
        return false
    }
    return type_is_struct_form(e, cur)
}

private fn append_zero_spell(e: *Emit, ty: *check.Type) with (a: mem.Allocator) {
    if spelled_aggregate(e, ty) {
        e.out.append("{0}")
    } else {
        e.out.append("0")
    }
}

private fn data_at(g: *ir.Global, index: usize): u8 {
    return g.data.ptr!![index]
}

private fn bytes_zero(g: *ir.Global, off: usize, len: usize): bool {
    if len == 0 {
        return true
    }
    if g.data.ptr == null || off + len > g.data_len {
        return false
    }
    for i in 0 as usize..len {
        if data_at(g, off + i) != 0 {
            return false
        }
    }
    return true
}

private fn range_zero(e: *Emit, g: *ir.Global, begin: usize, end: usize): bool {
    if end < begin {
        fail(e, "C backend: global field is outside its type")
        return false
    }
    if begin == end {
        return true
    }
    if g.data.ptr == null || end > g.data_len {
        fail(e, "C backend: global data has non-zero padding")
        return false
    }
    for i in begin..end {
        if data_at(g, i) != 0 {
            fail(e, "C backend: global data has non-zero padding")
            return false
        }
    }
    return true
}

private fn read_le(g: *ir.Global, off: usize, n: usize): (u64, bool) {
    if n > 8 || g.data.ptr == null || off + n > g.data_len {
        return 0, false
    }
    var bits: u64 = 0
    var scale: u64 = 1
    for i in 0 as usize..n {
        val b = data_at(g, off + i) as u64
        bits = bits + b * scale
        if i + 1 < n {
            scale = scale * 256
        }
    }
    return bits, true
}

private fn reloc_at(g: *ir.Global, offset: usize): *ir.Reloc? {
    if offset > 4294967295 {
        return null
    }
    for i in 0 as usize..g.relocs.len {
        val rel = g.relocs.at(i)
        if (rel.offset as usize) == offset {
            return rel
        }
    }
    return null
}

private fn range_has_reloc(g: *ir.Global, base: usize, size: usize): bool {
    if size == 0 {
        return false
    }
    for i in 0 as usize..g.relocs.len {
        val at = g.relocs.at(i).offset as usize
        if at >= base && at - base < size {
            return true
        }
    }
    return false
}

private fn append_reloc_expr(e: *Emit, rel: *ir.Reloc, ptr_type: *check.Type?) with (a: mem.Allocator) {
    val kinds = ir.reloc_kinds()
    if rel.kind == kinds.STRING || rel.kind == kinds.CSTRING {
        val cstring = rel.kind == kinds.CSTRING
        val id = find_bytes(e, rel.ptr, cstring)
        if id < 0 {
            fail(e, "C backend: string relocation is missing bytes")
            e.out.append("0")
            return
        }
        e.out.append("jog_")
        if cstring {
            e.out.append("c")
        } else {
            e.out.append("s")
        }
        e.out.append_int(id as i64, 10)
        return
    }
    if rel.kind == kinds.GLOBAL {
        val target = ir.global_at(e.module, rel.index)
        if target == null || !c_ident(target!!.name) {
            fail(e, "C backend: global relocation target was not emitted")
            e.out.append("0")
            return
        }
        if rel.addend == 0 {
            e.out.append("&")
            e.out.append(target!!.name)
            return
        }
        e.out.append("(")
        if ptr_type != null {
            append_type_name(e, ptr_type)
        } else {
            e.out.append("void *")
        }
        e.out.append(")((char *)&")
        e.out.append(target!!.name)
        e.out.append(" + ")
        e.out.append_int(rel.addend as i64, 10)
        e.out.append(")")
        return
    }
    if rel.kind == kinds.FUNC {
        val func = ir.func_at(e.module, rel.index)
        if func == null || func!!.name.len == 0 {
            fail(e, "C backend: function relocation target is missing")
            e.out.append("0")
            return
        }
        val f = func!!
        var bare = f.linkage == e.links.EXTERN || f.ty == null
        if f.ty != null && f.ty!!.kind == e.kinds.FN && f.ty!!.fn_extern {
            bare = true
        }
        if bare {
            e.out.append(f.name)
            return
        }
        if f.ty != null && f.ty!!.kind == e.kinds.FN && f.ty!!.fn_variadic {
            fail(e, "C backend: a Jog function used as a closure value needs a thunk")
            e.out.append("0")
            return
        }
        e.out.append("jog_fnthunk_")
        e.out.append_int(rel.index as i64, 10)
        return
    }
    fail(e, "C backend: global relocation has a bad kind")
    e.out.append("0")
}

private fn append_data_init(e: *Emit, g: *ir.Global, abs_off: usize, ty: *check.Type?) with (a: mem.Allocator) {
    if e.failed {
        return
    }
    if ty == null || !ty!!.has_layout {
        fail(e, "C backend: global data has no layout")
        return
    }
    val top = ty!!
    val size = top.size
    if size == 0 || (bytes_zero(g, abs_off, size as usize) && !range_has_reloc(g, abs_off, size as usize)) {
        append_zero_spell(e, top)
        return
    }
    if top.intrinsic == 3 || top.intrinsic == 1 {
        if size > 8 {
            fail(e, "C backend: integer global data has a bad width")
            return
        }
        val (bits, ok) = read_le(g, abs_off, size as usize)
        if !ok {
            fail(e, "C backend: integer global data has a bad width")
            return
        }
        append_bits(e, top, bits)
        return
    }
    val base = underlying(e, top)
    if base.kind == e.kinds.BOOL {
        if size != 1 || data_at(g, abs_off) > 1 {
            fail(e, "C backend: bool global data is not 0 or 1")
            return
        }
        append_bits(e, base, data_at(g, abs_off) as u64)
        return
    }
    if base.kind == e.kinds.INT || base.kind == e.kinds.UNTYPED_INT {
        if size > 8 {
            fail(e, "C backend: integer global data has a bad width")
            return
        }
        val (bits, ok) = read_le(g, abs_off, size as usize)
        if !ok {
            fail(e, "C backend: integer global data has a bad width")
            return
        }
        append_bits(e, base, bits)
        return
    }
    if base.kind == e.kinds.PTR {
        val rel = reloc_at(g, abs_off)
        if rel != null {
            append_reloc_expr(e, rel!!, base)
            return
        }
        if !bytes_zero(g, abs_off, size as usize) {
            fail(e, "C backend: global data has a pointer and no relocation")
            e.out.append("0")
            return
        }
        e.out.append("0")
        return
    }
    if base.kind == e.kinds.FN {
        append_fn_data(e, g, abs_off, base, size)
        return
    }
    if base.kind == e.kinds.BYTES || base.kind == e.kinds.SLICE {
        append_slice_data(e, g, abs_off, size)
        return
    }
    if base.kind == e.kinds.ARRAY {
        append_array_data(e, g, abs_off, base, size)
        return
    }
    if base.kind == e.kinds.TUPLE {
        append_tuple_data(e, g, abs_off, base, size)
        return
    }
    if base.kind == e.kinds.STRUCT {
        append_struct_data(e, g, abs_off, base, size)
        return
    }
    if base.kind == e.kinds.ENUM {
        append_enum_data(e, g, abs_off, base, size)
        return
    }
    if top.intrinsic == 2 || base.kind == e.kinds.FLOAT || base.kind == e.kinds.UNTYPED_FLOAT {
        append_float_global(e, g, abs_off, top, size)
        return
    }
    fail(e, "C backend: global type has no C object")
    e.out.append("0")
}

private fn append_fn_data(e: *Emit, g: *ir.Global, abs_off: usize, ty: *check.Type, size: u64) with (a: mem.Allocator) {
    if ty.fn_extern {
        val rel = reloc_at(g, abs_off)
        if rel != null {
            append_reloc_expr(e, rel!!, null)
            return
        }
        if !bytes_zero(g, abs_off, size as usize) {
            fail(e, "C backend: global data has a pointer and no relocation")
        }
        e.out.append("0")
        return
    }
    val rel = reloc_at(g, abs_off)
    val ptr = e.module.types.ptr_size as usize
    if rel == null && bytes_zero(g, abs_off, size as usize) {
        e.out.append("{0}")
        return
    }
    val kinds = ir.reloc_kinds()
    if rel == null || rel!!.kind != kinds.FUNC || ptr == 0 || size < (ptr as u64) * 2 ||
        !bytes_zero(g, abs_off + ptr, (size as usize) - ptr) {
        fail(e, "C backend: global data has a pointer and no relocation")
        e.out.append("{0}")
        return
    }
    e.out.append("{.code = ")
    append_reloc_expr(e, rel!!, null)
    e.out.append(", .env = 0}")
}

private fn append_slice_data(e: *Emit, g: *ir.Global, abs_off: usize, size: u64) with (a: mem.Allocator) {
    val ptr = e.module.types.ptr_size as usize
    if ptr == 0 || size != (ptr as u64) * 2 {
        fail(e, "C backend: global slice has a bad size")
        return
    }
    val (len, ok) = read_le(g, abs_off + ptr, ptr)
    if !ok {
        fail(e, "C backend: global slice has a bad size")
        return
    }
    val rel = reloc_at(g, abs_off)
    if rel == null && !bytes_zero(g, abs_off, ptr) {
        fail(e, "C backend: global data has a pointer and no relocation")
        return
    }
    val usize_ty = check.type_usize(e.module.types)
    e.out.append("{.ptr = ")
    if rel != null {
        append_reloc_expr(e, rel!!, null)
    } else {
        e.out.append("0")
    }
    e.out.append(", .len = ")
    append_bits(e, usize_ty, len)
    e.out.append("}")
}

private fn append_array_data(e: *Emit, g: *ir.Global, abs_off: usize, ty: *check.Type, size: u64) with (a: mem.Allocator) {
    if ty.elem == null || ty.elem!!.size == 0 || ty.len == 0 || ty.elem!!.size * ty.len != size {
        fail(e, "C backend: global array has a bad size")
        return
    }
    val elem = ty.elem!!
    val stride = elem.size as usize
    e.out.append("{.v = {")
    for i in 0 as usize..(ty.len as usize) {
        if i > 0 {
            e.out.append(", ")
        }
        append_data_init(e, g, abs_off + i * stride, elem)
        if e.failed {
            return
        }
    }
    e.out.append("}}")
}

private fn append_tuple_data(e: *Emit, g: *ir.Global, abs_off: usize, ty: *check.Type, size: u64) with (a: mem.Allocator) {
    e.out.append("{")
    var cursor: u64 = 0
    var offset: u64 = 0
    var any = false
    for i in 0 as usize..ty.elems.len {
        val elem = ty.elems.get(i)
        var al = elem.align
        if al < 1 {
            al = 1
        }
        offset = round_up(offset, al)
        val off = offset
        offset = offset + elem.size
        if elem.size == 0 || skip_value(e, elem) {
            continue
        }
        if off > size || elem.size > size - off {
            fail(e, "C backend: global field is outside its type")
            return
        }
        if !range_zero(e, g, abs_off + (cursor as usize), abs_off + (off as usize)) {
            return
        }
        if any {
            e.out.append(", ")
        }
        e.out.append(".f_")
        e.out.append_int(i as i64, 10)
        e.out.append(" = ")
        append_data_init(e, g, abs_off + (off as usize), elem)
        if e.failed {
            return
        }
        cursor = off + elem.size
        any = true
    }
    if !range_zero(e, g, abs_off + (cursor as usize), abs_off + (size as usize)) {
        return
    }
    if !any {
        e.out.append("0")
    }
    e.out.append("}")
}

private fn append_struct_data(e: *Emit, g: *ir.Global, abs_off: usize, ty: *check.Type, size: u64) with (a: mem.Allocator) {
    e.out.append("{")
    var cursor: u64 = 0
    var any = false
    for i in 0 as usize..ty.field_names.len {
        val field = check.type_field_at(ty, i)
        if field.field_type == null || field.field_type!!.size == 0 || skip_value(e, field.field_type) {
            continue
        }
        val ft = field.field_type!!
        if field.offset > size || ft.size > size - field.offset {
            fail(e, "C backend: global field is outside its type")
            return
        }
        if !range_zero(e, g, abs_off + (cursor as usize), abs_off + (field.offset as usize)) {
            return
        }
        if any {
            e.out.append(", ")
        }
        e.out.append(".")
        append_field_ident(e, ty, i)
        e.out.append(" = ")
        append_data_init(e, g, abs_off + (field.offset as usize), ft)
        if e.failed {
            return
        }
        cursor = field.offset + ft.size
        any = true
    }
    if !range_zero(e, g, abs_off + (cursor as usize), abs_off + (size as usize)) {
        return
    }
    if !any {
        e.out.append("0")
    }
    e.out.append("}")
}

private fn variant_span(ty: *check.Type, index: usize): (u64, bool) {
    val variant = check.type_variant_at(ty, index)
    var offset: u64 = 0
    var max_align: u32 = 1
    for fi in 0 as usize..variant.field_count {
        val field = check.type_variant_field_at(ty, variant, fi)
        if field.field_type == null {
            return 0, false
        }
        val ft = field.field_type!!
        var al = ft.align
        if al < 1 {
            al = 1
        }
        offset = round_up(offset, al)
        offset = offset + ft.size
        if al > max_align {
            max_align = al
        }
    }
    return round_up(offset, max_align), true
}

private fn variant_has_payload(e: *Emit, ty: *check.Type, index: usize): bool {
    val variant = check.type_variant_at(ty, index)
    for fi in 0 as usize..variant.field_count {
        val field = check.type_variant_field_at(ty, variant, fi)
        if !skip_value(e, field.field_type) {
            return true
        }
    }
    return false
}

private fn append_enum_data(e: *Emit, g: *ir.Global, abs_off: usize, ty: *check.Type, size: u64) with (a: mem.Allocator) {
    if ty.elem == null || !ty.elem!!.has_layout || ty.elem!!.size == 0 || ty.elem!!.size > 8 || ty.elem!!.size > size {
        fail(e, "C backend: global enum tag has a bad width")
        return
    }
    val tag = ty.elem!!
    val (tag_bits, ok) = read_le(g, abs_off, tag.size as usize)
    if !ok {
        fail(e, "C backend: global enum tag has a bad width")
        return
    }
    val mask = byte_mask(tag.size as usize)
    val bits = tag_bits & mask
    var active: usize = 0
    var found = false
    for i in 0 as usize..ty.variant_names.len {
        val variant = check.type_variant_at(ty, i)
        if (i64_bits(variant.tag) & mask) == bits {
            active = i
            found = true
            break
        }
    }
    if !found {
        fail(e, "C backend: global enum tag is not a variant")
        return
    }
    val (span, span_ok) = variant_span(ty, active)
    if !span_ok {
        fail(e, "C backend: global is missing fields")
        return
    }
    val tag_size = tag.size
    val payload_off = ty.payload_offset
    if payload_off < tag_size || payload_off > size || span > size - payload_off {
        fail(e, "C backend: global enum has a bad layout")
        return
    }
    if !range_zero(e, g, abs_off + (tag_size as usize), abs_off + (payload_off as usize)) ||
        !range_zero(e, g, abs_off + ((payload_off + span) as usize), abs_off + (size as usize)) {
        return
    }
    e.out.append("{.tag = ")
    append_bits(e, tag, bits)
    if variant_has_payload(e, ty, active) && span > 0 &&
        (!bytes_zero(g, abs_off + (payload_off as usize), span as usize) ||
            range_has_reloc(g, abs_off + (payload_off as usize), span as usize)) {
        e.out.append(", .payload = {.")
        append_variant_ident(e, ty, active)
        e.out.append(" = ")
        append_variant_fields(e, g, abs_off + (payload_off as usize), ty, active, span)
        e.out.append("}")
    }
    e.out.append("}")
}

private fn append_variant_fields(
    e: *Emit,
    g: *ir.Global,
    abs_base: usize,
    ty: *check.Type,
    index: usize,
    span: u64,
) with (a: mem.Allocator) {
    val variant = check.type_variant_at(ty, index)
    e.out.append("{")
    var cursor: u64 = 0
    var offset: u64 = 0
    var any = false
    for fi in 0 as usize..variant.field_count {
        val field = check.type_variant_field_at(ty, variant, fi)
        if field.field_type == null {
            fail(e, "C backend: global is missing fields")
            return
        }
        val ft = field.field_type!!
        var al = ft.align
        if al < 1 {
            al = 1
        }
        offset = round_up(offset, al)
        val off = offset
        offset = offset + ft.size
        if ft.size == 0 || skip_value(e, ft) {
            continue
        }
        if off > span || ft.size > span - off {
            fail(e, "C backend: global field is outside its type")
            return
        }
        if !range_zero(e, g, abs_base + (cursor as usize), abs_base + (off as usize)) {
            return
        }
        if any {
            e.out.append(", ")
        }
        e.out.append(".")
        append_variant_field_ident(e, ty, index, fi)
        e.out.append(" = ")
        append_data_init(e, g, abs_base + (off as usize), ft)
        if e.failed {
            return
        }
        cursor = off + ft.size
        any = true
    }
    if !range_zero(e, g, abs_base + (cursor as usize), abs_base + (span as usize)) {
        return
    }
    if !any {
        e.out.append("0")
    }
    e.out.append("}")
}

private fn global_pos(pos: ir.Pos): bool {
    return pos.file.len != 0 && pos.line != 0
}

private fn global_is_stored(e: *Emit, index: u32): bool {
    for fi in 0 as usize..e.module.funcs.len {
        val func = e.module.funcs.get(fi)
        for bi in 0 as usize..func.blocks.len {
            val block = func.blocks.at(bi)
            for ii in 0 as usize..block.insts.len {
                val inst = block.insts.get(ii)
                if inst.op == e.ops.STORE && inst.a.kind == e.opnds.GLOBAL && inst.a.global == index {
                    return true
                }
            }
        }
    }
    return false
}

private fn emit_global(e: *Emit, g: *ir.Global, index: u32): bool with (a: mem.Allocator) {
    if g.ty == null {
        fail(e, "C backend: missing global")
        return false
    }
    if !global_is_object(e, g) {
        if g.data_len != 0 {
            fail(e, "C backend: global type has no C object")
            return false
        }
        return true
    }
    if !c_ident(g.name) {
        fail(e, "C backend: global name is not a C identifier")
        return false
    }
    val ty = g.ty!!
    if !ty.has_layout {
        fail(e, "C backend: global type has no layout")
        return false
    }
    val size = ty.size as usize
    var zero = false
    if g.data_len == 0 {
        zero = true
    } else if g.data.ptr == null {
        fail(e, "C backend: global data is missing")
        return false
    } else if g.data_len != size {
        fail(e, "C backend: global data length does not match its type")
        return false
    } else {
        zero = bytes_zero(g, 0, size) && g.relocs.len == 0
    }
    var lined = false
    if global_pos(g.pos) {
        e.out.append("#line ")
        e.out.append_int(g.pos.line, 10)
        e.out.append(" ")
        append_c_literal(&e.out, g.pos.file)
        e.out.append("\n")
        lined = true
    }
    e.out.append("static ")
    if g.is_const && !global_is_stored(e, index) {
        e.out.append("const ")
    }
    append_type_name(e, ty)
    e.out.append(" ")
    e.out.append(g.name)
    e.out.append(" = ")
    if zero {
        append_zero_spell(e, ty)
    } else {
        append_data_init(e, g, 0, ty)
    }
    e.out.append(";\n")
    if lined {
        e.out.append("#line 1 \"jog_emit.c\"\n")
    }
    return !e.failed
}

private fn emit_ordered(e: *Emit, walk: *GlobalWalk, index: u32): bool with (a: mem.Allocator) {
    if (index as usize) >= e.module.globals.len {
        fail(e, "C backend: global relocation target was not emitted")
        return false
    }
    if walk.color.get(index as usize) == 2 as u8 {
        return true
    }
    if walk.color.get(index as usize) == 1 as u8 {
        fail(e, "C backend: global relocation cycle")
        return false
    }
    walk.color.set(index as usize, 1 as u8)
    val global = ir.global_at(e.module, index)
    if global != null {
        val kinds = ir.reloc_kinds()
        val g = global!!
        for r in 0 as usize..g.relocs.len {
            val rel = g.relocs.at(r)
            if rel.kind == kinds.GLOBAL && !emit_ordered(e, walk, rel.index) {
                return false
            }
            if e.failed {
                return false
            }
        }
    }
    if e.failed {
        return false
    }
    walk.color.set(index as usize, 2 as u8)
    if is_vtable_dummy(e, index) {
        return true
    }
    if global == null {
        fail(e, "C backend: missing global")
        return false
    }
    val g = global!!
    if !global_is_object(e, g) {
        return emit_global(e, g, index)
    }
    if !walk.any {
        e.out.append("\n")
        walk.any = true
    }
    return emit_global(e, g, index)
}

private fn func_is_closure_code(e: *Emit, func: *ir.Func): bool {
    if func.ty == null {
        return false
    }
    val ty = func.ty!!
    if ty.kind != e.kinds.FN || ty.fn_extern || func.linkage == e.links.EXTERN {
        return false
    }
    val declared = ty.elems.len + ty.contexts.len
    return func.param_count == (declared as u32) + 1
}

private fn reloc_needs_thunk(e: *Emit, rel: *ir.Reloc): bool {
    val kinds = ir.reloc_kinds()
    if rel.kind != kinds.FUNC || (rel.index as usize) >= e.module.funcs.len {
        return false
    }
    val func = ir.func_at(e.module, rel.index)
    if func == null {
        return false
    }
    val f = func!!
    if f.ty == null {
        return false
    }
    val ty = f.ty!!
    if ty.kind != e.kinds.FN || ty.fn_extern || ty.fn_variadic || f.linkage == e.links.EXTERN ||
        func_is_closure_code(e, f) {
        return false
    }
    return true
}

private fn thunk_result(e: *Emit, func: *ir.Func) with (a: mem.Allocator) {
    var ret: *check.Type? = null
    if func.ty != null && func.ty!!.kind == e.kinds.FN {
        ret = func.ty!!.elem
    }
    if skip_value(e, ret) {
        e.out.append("void")
        return
    }
    append_type_name(e, ret)
}

private fn thunk_params(e: *Emit, func: *ir.Func, names: bool): bool with (a: mem.Allocator) {
    var any = false
    var limit = func.param_count as usize
    if limit > func.locals.len {
        limit = func.locals.len
    }
    for i in 0 as usize..limit {
        val loc = func.locals.get(i)
        if skip_value(e, loc.ty) {
            continue
        }
        if any {
            e.out.append(", ")
        }
        if names {
            append_type_name(e, loc.ty)
            e.out.append(" l")
            e.out.append_int(i as i64, 10)
        } else {
            e.out.append("l")
            e.out.append_int(i as i64, 10)
        }
        any = true
    }
    return any
}

private fn emit_thunk_proto(e: *Emit, func: *ir.Func, index: u32) with (a: mem.Allocator) {
    if func.name.len == 0 {
        fail(e, "C backend: missing function")
        return
    }
    e.out.append("static ")
    thunk_result(e, func)
    e.out.append(" jog_fnthunk_")
    e.out.append_int(index as i64, 10)
    e.out.append("(")
    val any = thunk_params(e, func, true)
    if any {
        e.out.append(", ")
    }
    e.out.append("void *env);\n")
}

private fn emit_one_fn_thunk(e: *Emit, func: *ir.Func, index: u32) with (a: mem.Allocator) {
    if func.name.len == 0 {
        fail(e, "C backend: missing function")
        return
    }
    var ret_void = true
    if func.ty != null && func.ty!!.kind == e.kinds.FN && !skip_value(e, func.ty!!.elem) {
        ret_void = false
    }
    e.out.append("static ")
    thunk_result(e, func)
    e.out.append(" jog_fnthunk_")
    e.out.append_int(index as i64, 10)
    e.out.append("(")
    val any = thunk_params(e, func, true)
    if any {
        e.out.append(", ")
    }
    e.out.append("void *env) {\n    (void)env;\n    ")
    if !ret_void {
        e.out.append("return ")
    }
    e.out.append(func.name)
    e.out.append("(")
    _ = thunk_params(e, func, false)
    e.out.append(");\n}\n")
}

private fn mark_func_value(e: *Emit, need: *list.List<bool>, op: *ir.Operand) {
    if op.kind != e.opnds.FUNC || (op.func as usize) >= e.module.funcs.len {
        return
    }
    val func = ir.func_at(e.module, op.func)
    if func == null {
        return
    }
    val f = func!!
    if f.ty == null {
        return
    }
    val ty = f.ty!!
    if ty.kind != e.kinds.FN || ty.fn_extern || ty.fn_variadic || f.linkage == e.links.EXTERN ||
        func_is_closure_code(e, f) {
        return
    }
    need.set(op.func as usize, true)
}

private fn mark_func_inst(e: *Emit, need: *list.List<bool>, inst: *ir.Inst) {
    if inst.op != e.ops.CALL {
        mark_func_value(e, need, &inst.a)
    }
    mark_func_value(e, need, &inst.b)
    var i: usize = 0
    for i < inst.args.len {
        mark_func_value(e, need, inst.args.at(i))
        i = i + 1
    }
}

private fn note_thunks(e: *Emit): list.List<bool> with (a: mem.Allocator) {
    var need = list.empty<bool>()
    for _i in 0 as usize..e.module.funcs.len {
        need.push(false)
    }
    for i in 0 as usize..e.module.globals.len {
        val g = e.module.globals.get(i)
        for r in 0 as usize..g.relocs.len {
            val rel = g.relocs.at(r)
            if reloc_needs_thunk(e, rel) {
                need.set(rel.index as usize, true)
            }
        }
    }
    val terms = e.terms
    var fi: usize = 0
    for fi < e.module.funcs.len {
        val func = ir.func_at(e.module, fi as u32)
        if func != null {
            var bi: usize = 0
            for bi < func!!.blocks.len {
                val block = func!!.blocks.at(bi)
                var ii: usize = 0
                for ii < block.insts.len {
                    mark_func_inst(e, &need, block.insts.get(ii))
                    ii = ii + 1
                }
                if block.term.kind == terms.RET || block.term.kind == terms.COND_BR ||
                    block.term.kind == terms.SWITCH {
                    mark_func_value(e, &need, &block.term.value)
                }
                bi = bi + 1
            }
        }
        fi = fi + 1
    }
    return need
}

private fn emit_thunk_protos(e: *Emit) with (a: mem.Allocator) {
    if e.module.funcs.len == 0 {
        return
    }
    val need = note_thunks(e)
    var any = false
    for i in 0 as usize..need.len {
        if need.get(i) {
            any = true
            break
        }
    }
    if !any {
        return
    }
    e.out.append("\n")
    for i in 0 as usize..need.len {
        if need.get(i) {
            val func = ir.func_at(e.module, i as u32)
            if func == null {
                fail(e, "C backend: missing function")
                return
            }
            emit_thunk_proto(e, func!!, i as u32)
        }
    }
}

fn emit_fn_thunks(e: *Emit) with (a: mem.Allocator) {
    if e.module.funcs.len == 0 {
        return
    }
    val need = note_thunks(e)
    for i in 0 as usize..need.len {
        if !need.get(i) {
            continue
        }
        val func = ir.func_at(e.module, i as u32)
        if func == null {
            fail(e, "C backend: missing function")
            return
        }
        e.out.append("\n")
        emit_one_fn_thunk(e, func!!, i as u32)
    }
}

fn emit_globals(e: *Emit): bool with (a: mem.Allocator) {
    emit_thunk_protos(e)
    if e.failed {
        return false
    }
    val n = e.module.globals.len
    if n == 0 {
        return emit_vtables(e)
    }
    var walk = GlobalWalk(color: list.empty<u8>(), any: false)
    for _i in 0 as usize..n {
        walk.color.push(0)
    }
    for i in 0 as usize..n {
        if !emit_ordered(e, &walk, i as u32) {
            return false
        }
    }
    return emit_vtables(e)
}

private fn read_u32_le(g: *ir.Global, off: usize): u32 {
    var w: u32 = 0
    val p: *u8 = &w as *u8
    p[0] = data_at(g, off)
    p[1] = data_at(g, off + 1)
    p[2] = data_at(g, off + 2)
    p[3] = data_at(g, off + 3)
    return w
}

private fn append_float_global(e: *Emit, g: *ir.Global, abs_off: usize, ty: *check.Type, size: u64) with (a: mem.Allocator) {
    if size != 4 && size != 8 {
        fail(e, "C backend: float global data has a bad width")
        e.out.append("0.0")
        return
    }
    if size == 4 {
        val (lo, hi) = widen_f32(read_u32_le(g, abs_off))
        append_float_bits(e, ty, lo, hi)
        return
    }
    val lo = read_u32_le(g, abs_off)
    val hi = read_u32_le(g, abs_off + 4)
    append_float_bits(e, ty, lo, hi)
}

private fn is_vtable_dummy(e: *Emit, index: u32): bool {
    for i in 0 as usize..e.module.iface_tables.len {
        if e.module.iface_tables.at(i).global == index as i32 {
            return true
        }
    }
    return false
}

fn emit_vtables(e: *Emit): bool with (a: mem.Allocator) {
    if e.module.iface_tables.len == 0 {
        return true
    }
    for i in 0 as usize..e.module.iface_tables.len {
        if e.failed {
            return false
        }
        val table = e.module.iface_tables.at(i)
        var seen = false
        for j in 0 as usize..i {
            if e.module.iface_tables.at(j).iface == table.iface {
                seen = true
                break
            }
        }
        if seen {
            continue
        }
        var id: u32 = 0
        if table.iface != null {
            id = table.iface!!.id
        }
        e.out.append("\nstruct jog_it_")
        e.out.append_int(id as i64, 10)
        e.out.append(" {\n    const void *type_id;\n    size_t size;\n    size_t align;\n")
        for s in 0 as usize..table.slots.len {
            e.out.append("    ")
            append_type_name(e, table.slots.at(s).fn_type)
            e.out.append(" m")
            e.out.append_int(s as i64, 10)
            e.out.append(";\n")
        }
        for s in 0 as usize..table.offsets.len {
            e.out.append("    size_t off")
            e.out.append_int(s as i64, 10)
            e.out.append(";\n")
        }
        e.out.append("};\n")
    }
    for i in 0 as usize..e.module.iface_tables.len {
        if e.failed {
            return false
        }
        val table = e.module.iface_tables.at(i)
        var id: u32 = 0
        if table.iface != null {
            id = table.iface!!.id
        }
        if table.name.len == 0 || !c_ident(table.name) || table.concrete == null || table.tid_name.len == 0 {
            fail(e, "C backend: interface table is incomplete")
            return false
        }
        e.out.append("static const struct jog_it_")
        e.out.append_int(id as i64, 10)
        e.out.append(" ")
        e.out.append(table.name)
        e.out.append(" = {\n    &")
        e.out.append(table.tid_name)
        e.out.append(",\n    sizeof(")
        append_type_name(e, table.concrete)
        e.out.append("),\n    _Alignof(")
        append_type_name(e, table.concrete)
        e.out.append(")")
        for s in 0 as usize..table.slots.len {
            val slot = table.slots.at(s)
            val thunk = ir.func_at(e.module, slot.func as u32)
            if thunk == null || thunk!!.name.len == 0 {
                fail(e, "C backend: interface method is missing")
                return false
            }
            e.out.append(",\n    ")
            e.out.append(thunk!!.name)
        }
        for s in 0 as usize..table.offsets.len {
            e.out.append(",\n    ")
            e.out.append_int(table.offsets.get(s) as i64, 10)
        }
        e.out.append("\n};\n")
    }
    return !e.failed
}

fn module_needs_fmod(e: *Emit): bool {
    val b = ir.bin_ops()
    val rem = ir.binop_aux(b.REM)
    for fi in 0 as usize..e.module.funcs.len {
        val func = e.module.funcs.get(fi)
        for bi in 0 as usize..func.blocks.len {
            val block = func.blocks.at(bi)
            for ii in 0 as usize..block.insts.len {
                val inst = block.insts.get(ii)
                if inst.op == e.ops.BINARY && inst.aux == rem && type_is_float_t(e, inst.a.ty) {
                    return true
                }
            }
        }
    }
    return false
}

fn emit_fmod_helpers(e: *Emit) with (a: mem.Allocator) {
    e.out.append("static double jog_fmod(double a, double b) {\n")
    e.out.append("    double q;\n")
    e.out.append("    double t;\n")
    e.out.append("    if (b == 0) {\n")
    e.out.append("        return a;\n")
    e.out.append("    }\n")
    e.out.append("    q = a / b;\n")
    e.out.append("    if (q != q || (q != 0 && q + q == q) || q >= 9223372036854775808.0 || q < -9223372036854775808.0) {\n")
    e.out.append("        t = q;\n")
    e.out.append("    } else if (q >= 0) {\n")
    e.out.append("        t = (double)(long long)q;\n")
    e.out.append("    } else {\n")
    e.out.append("        t = -(double)(long long)(-q);\n")
    e.out.append("    }\n")
    e.out.append("    return a - b * t;\n")
    e.out.append("}\n")
    e.out.append("static float jog_fmodf(float a, float b) {\n")
    e.out.append("    float q;\n")
    e.out.append("    float t;\n")
    e.out.append("    if (b == 0) {\n")
    e.out.append("        return a;\n")
    e.out.append("    }\n")
    e.out.append("    q = a / b;\n")
    e.out.append("    if (q != q || (q != 0 && q + q == q) || q >= 9223372036854775808.0f || q < -9223372036854775808.0f) {\n")
    e.out.append("        t = q;\n")
    e.out.append("    } else if (q >= 0) {\n")
    e.out.append("        t = (float)(long long)q;\n")
    e.out.append("    } else {\n")
    e.out.append("        t = -(float)(long long)(-q);\n")
    e.out.append("    }\n")
    e.out.append("    return a - b * t;\n")
    e.out.append("}\n")
}
