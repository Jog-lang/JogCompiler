// Interfaces and narrowing.
// Checked against compiler/src/check_interface.c.
// CheckerGuide step 11.

import src.load
import src.parse
import std.list
import std.mem
import std.strbuilder

enum FitKind {
    OK
    NOT
    MISSING
    GENERIC
    RECV
    SIG
    CONST
    AMBIG
}

struct Fit {
    kind: FitKind
    method: str
    needs_ptr: bool
    is_prop: bool
}

/**
 * Saved symbol types while `is` / `when is` narrows a val or parameter.
 */
struct IfaceNarrow {
    syms: list.List<*load.Symbol>
    saved: list.List<*Type>
}

private fn empty_fit(): Fit {
    var f: Fit
    f.kind = FitKind.NOT
    f.method = ""
    f.needs_ptr = false
    f.is_prop = false
    return f
}

private fn empty_narrow(): IfaceNarrow {
    var st: IfaceNarrow
    st.syms = list.empty<*load.Symbol>()
    st.saved = list.empty<*Type>()
    return st
}

private fn ptr_eq_ty(a: *Type?, b: *Type?): bool {
    if a == null && b == null {
        return true
    }
    if a == null || b == null {
        return false
    }
    return (a!! as *u8) == (b!! as *u8)
}

private fn ptr_eq_node(a: *parse.Node?, b: *parse.Node?): bool {
    if a == null && b == null {
        return true
    }
    if a == null || b == null {
        return false
    }
    return (a!! as *u8) == (b!! as *u8)
}

private fn iface_name(typ: *Type): str {
    if typ.name.len > 0 {
        return typ.name
    }
    return "?"
}

private fn concrete_name(typ: *Type): str {
    if typ.name.len > 0 {
        return typ.name
    }
    return "?"
}

private fn is_universe_error(typ: *Type?): bool {
    if typ == null || typ!!.kind != TypeKind.INTERFACE {
        return false
    }
    if typ!!.package.len > 0 || typ!!.decl != null {
        return false
    }
    return typ!!.name == "error"
}

private fn is_user_nominal(typ: *Type?): bool {
    if typ == null {
        return false
    }
    if typ!!.kind != TypeKind.STRUCT && typ!!.kind != TypeKind.ENUM {
        return false
    }
    return typ!!.decl != null
}

private fn user_iface(typ: *Type?): bool {
    return typ != null && typ!!.kind == TypeKind.INTERFACE && !is_universe_error(typ) &&
        !constraint_is_typeset(typ)
}

private fn peel_iface(typ: *Type?): (*Type?, bool) {
    if typ == null {
        return null, false
    }
    if typ!!.kind == TypeKind.INTERFACE {
        return typ, false
    }
    if typ!!.kind == TypeKind.PTR && typ!!.elem != null && typ!!.elem!!.kind == TypeKind.INTERFACE {
        return typ!!.elem, true
    }
    return null, false
}

private fn iface_recv_ptr(req: *parse.Node): bool {
    return req.text == "recv *"
}

private fn prop_is_var(prop: *parse.Node): bool {
    return prop.text == "var"
}

private fn explain_fit(ck: *Check, file: str, line: i64, column: i64, have: *Type, need: *Type, fit: Fit) with (a: mem.Allocator) {
    val iface = iface_name(need)
    val method = if fit.method.len > 0 { fit.method } else { "?" }
    if fit.kind == FitKind.MISSING {
        var b = strbuilder.empty()
        if fit.is_prop {
            b.append("type '")
            b.append(concrete_name(have))
            b.append("' is missing property '")
            b.append(method)
            b.append("' for interface '")
            b.append(iface)
            b.append("'")
        } else {
            b.append("type '")
            b.append(concrete_name(have))
            b.append("' is missing method '")
            b.append(method)
            b.append("' for interface '")
            b.append(iface)
            b.append("'")
        }
        check_fail(ck, file, line, column, b.str())
        b.free()
        return
    }
    if fit.kind == FitKind.GENERIC {
        var b = strbuilder.empty()
        b.append("generic method '")
        b.append(method)
        b.append("' cannot satisfy interface '")
        b.append(iface)
        b.append("'")
        check_fail(ck, file, line, column, b.str())
        b.free()
        return
    }
    if fit.kind == FitKind.RECV {
        if fit.needs_ptr {
            var b = strbuilder.empty()
            b.append("method '")
            b.append(method)
            b.append("' needs a pointer receiver")
            check_fail(ck, file, line, column, b.str())
            b.free()
        } else {
            var b = strbuilder.empty()
            b.append("method '")
            b.append(method)
            b.append("' has a pointer receiver")
            check_fail(ck, file, line, column, b.str())
            b.free()
        }
        return
    }
    if fit.kind == FitKind.SIG {
        var b = strbuilder.empty()
        if fit.is_prop {
            b.append("property '")
            b.append(method)
            b.append("' has the wrong type for interface '")
            b.append(iface)
            b.append("'")
        } else {
            b.append("method '")
            b.append(method)
            b.append("' has the wrong signature for interface '")
            b.append(iface)
            b.append("'")
        }
        check_fail(ck, file, line, column, b.str())
        b.free()
        return
    }
    if fit.kind == FitKind.CONST {
        var b = strbuilder.empty()
        b.append("cannot convert ")
        b.append(type_print(have as *Type?))
        b.append(" to ")
        b.append(type_print(need as *Type?))
        check_fail(ck, file, line, column, b.str())
        b.free()
        return
    }
    if fit.kind == FitKind.AMBIG {
        var b = strbuilder.empty()
        if fit.is_prop {
            b.append("ambiguous field '")
            b.append(method)
            b.append("'")
        } else {
            b.append("ambiguous method '")
            b.append(method)
            b.append("' for interface '")
            b.append(iface)
            b.append("'")
        }
        check_fail(ck, file, line, column, b.str())
        b.free()
        return
    }
}

private fn same_pkg(typ: *Type, sym: *load.Symbol): bool {
    val want = typ.package
    var have = ""
    if sym.package != null {
        have = sym.package!!.path
    }
    return want == have
}

private fn sig_ok(method: *Type, req: *Type): bool {
    if method.kind != TypeKind.FN || req.kind != TypeKind.FN {
        return false
    }
    if method.fn_variadic || req.fn_variadic {
        return false
    }
    if method.elems.len != req.elems.len + 1 {
        return false
    }
    if method.contexts.len != req.contexts.len {
        return false
    }
    if !ptr_eq_ty(method.elem, req.elem) {
        return false
    }
    var i: usize = 0
    for i < req.elems.len {
        if !ptr_eq_ty(method.elems.get(i + 1) as *Type?, req.elems.get(i) as *Type?) {
            return false
        }
        i = i + 1
    }
    i = 0
    for i < req.contexts.len {
        if !ptr_eq_ty(method.contexts.get(i) as *Type?, req.contexts.get(i) as *Type?) {
            return false
        }
        i = i + 1
    }
    return true
}

private fn any_ptr_req_depth(ck: *Check, job: *CheckJob, iface: *Type, depth: i64): bool with (a: mem.Allocator) {
    if iface.decl == null || depth > 16 {
        return false
    }
    val decl = iface.decl!!
    if !parse.is_interface(decl) {
        return false
    }
    var i = decl.head as usize
    for i < decl.kids.len {
        val member = decl.kids.get(i)
        if parse.is_fn(member) && iface_recv_ptr(member) {
            return true
        }
        if parse.is_embed(member) && member.kids.len > 0 {
            val emb = resolve_type(ck, job, member.kids.get(0))
            if emb != null && emb!!.kind == TypeKind.INTERFACE && !constraint_is_typeset(emb) {
                if any_ptr_req_depth(ck, job, emb!!, depth + 1) {
                    return true
                }
            }
        }
        i = i + 1
    }
    return false
}

private fn any_ptr_req(ck: *Check, job: *CheckJob, iface: *Type): bool with (a: mem.Allocator) {
    return any_ptr_req_depth(ck, job, iface, 0)
}

/**
 * Build the requirement FN type for an interface method (no receiver).
 * Returns null when the checker stops; otherwise a FN or ERROR type.
 */
private fn build_req(ck: *Check, job: *CheckJob, fn_node: *parse.Node, bad: *bool): *Type? with (a: mem.Allocator) {
    val shape = fn_node.head
    val nparams = shape % 256
    val nctx = (shape / 256) % 256
    val has_ret = (shape / 131072) % 2 == 1
    var params = list.empty<*Type>()
    var contexts = list.empty<*Type>()
    var at: i64 = 0
    var p: i64 = 0
    for p < nparams && (at as usize) < fn_node.kids.len && !ck.stop {
        val param = fn_node.kids.get(at as usize)
        if param.kids.len == 0 {
            check_fail(ck, job.file, param.line, param.column, "missing parameter type")
            *bad = true
            at = at + 1
            p = p + 1
            continue
        }
        val typ = resolve_type(ck, job, param.kids.get(0))
        if typ == null {
            return null
        }
        params.push(typ!!)
        if typ!!.kind == TypeKind.ERROR {
            *bad = true
        }
        at = at + 1
        p = p + 1
    }
    var c: i64 = 0
    for c < nctx && (at as usize) < fn_node.kids.len && !ck.stop {
        val param = fn_node.kids.get(at as usize)
        if param.kids.len == 0 {
            check_fail(ck, job.file, param.line, param.column, "missing parameter type")
            *bad = true
            at = at + 1
            c = c + 1
            continue
        }
        if param.kids.len > 1 {
            check_fail(ck, job.file, param.line, param.column, "a context parameter cannot have a default")
            *bad = true
        }
        val typ = resolve_type(ck, job, param.kids.get(0))
        if typ == null {
            return null
        }
        contexts.push(typ!!)
        if typ!!.kind == TypeKind.ERROR {
            *bad = true
        }
        at = at + 1
        c = c + 1
    }
    if ck.stop {
        return null
    }
    var ret = unit_ty(ck)
    if has_ret {
        if (at as usize) >= fn_node.kids.len {
            return err_ty(ck) as *Type?
        }
        val r = resolve_type(ck, job, fn_node.kids.get(at as usize))
        if r == null {
            return null
        }
        ret = r!!
        if ret.kind == TypeKind.ERROR {
            *bad = true
        }
    }
    if *bad {
        return err_ty(ck) as *Type?
    }
    return type_fn(&ck.types, params, ret, contexts, false, false, false) as *Type?
}

/**
 * Requirement FN type rebuilt from an already-checked interface method node.
 */
private fn req_fn_type(ck: *Check, job: *CheckJob, fn_node: *parse.Node): *Type? with (a: mem.Allocator) {
    var bad = false
    return build_req(ck, job, fn_node, &bad)
}

private fn prop_type(ck: *Check, job: *CheckJob, prop: *parse.Node): *Type? with (a: mem.Allocator) {
    if prop.kids.len == 0 {
        return null
    }
    return resolve_type(ck, job, prop.kids.get(0))
}

private fn prop_fit(
    ck: *Check,
    job: *CheckJob,
    elem: *Type,
    have: *Type,
    prop: *parse.Node,
    fit: *Fit,
): i32 with (a: mem.Allocator) {
    if !parse.is_field(prop) {
        return fit_code(FitKind.NOT)
    }
    val name = if prop.name.len > 0 { prop.name } else { "?" }
    if have.is_const && prop_is_var(prop) {
        fit.kind = FitKind.CONST
        fit.method = name
        fit.is_prop = true
        return fit_code(FitKind.CONST)
    }
    val want = prop_type(ck, job, prop)
    if want == null || ck.stop {
        return -1
    }
    if prop.name.len == 0 || want!!.kind == TypeKind.ERROR || elem.kind != TypeKind.STRUCT {
        fit.kind = FitKind.MISSING
        fit.method = name
        fit.is_prop = true
        return fit_code(FitKind.MISSING)
    }
    if elem.decl != null {
        val tsym = decl_type_symbol(ck, elem.decl!!)
        if tsym != null {
            if !wait_for_symbol_finished(ck, job, tsym!!) {
                return -1
            }
        }
    }
    if ck.stop {
        return -1
    }
    val hit = struct_lookup_field(elem, prop.name, job.decl as *parse.Node?, job.pkg)
    if hit.ambiguous {
        fit.kind = FitKind.AMBIG
        fit.method = name
        fit.is_prop = true
        return fit_code(FitKind.AMBIG)
    }
    if hit.hidden || !hit.found || hit.field.field_type == null {
        fit.kind = FitKind.MISSING
        fit.method = name
        fit.is_prop = true
        return fit_code(FitKind.MISSING)
    }
    if want!!.kind != TypeKind.ERROR && !ptr_eq_ty(hit.field.field_type, want) {
        fit.kind = FitKind.SIG
        fit.method = name
        fit.is_prop = true
        return fit_code(FitKind.SIG)
    }
    return fit_code(FitKind.OK)
}

private fn decl_type_symbol(ck: *Check, decl: *parse.Node): *load.Symbol? {
    for pkg in ck.prog.packages.items() {
        for i in 0 as usize..pkg.scope.bindings.len {
            val s = pkg.scope.bindings.at(i)
            if s.decl != null && (s.decl!! as *u8) == (decl as *u8) {
                return s as *load.Symbol?
            }
        }
        for fi in 0 as usize..pkg.scope.file_scopes.len {
            val fs = pkg.scope.file_scopes.get(fi)
            for i in 0 as usize..fs.bindings.len {
                val s = fs.bindings.at(i)
                if s.decl != null && (s.decl!! as *u8) == (decl as *u8) {
                    return s as *load.Symbol?
                }
            }
        }
    }
    return null
}

private fn fit_code(k: FitKind): i32 {
    if k == FitKind.OK {
        return 0
    }
    if k == FitKind.NOT {
        return 1
    }
    if k == FitKind.MISSING {
        return 2
    }
    if k == FitKind.GENERIC {
        return 3
    }
    if k == FitKind.RECV {
        return 4
    }
    if k == FitKind.SIG {
        return 5
    }
    if k == FitKind.CONST {
        return 6
    }
    return 7
}

/**
 * -1 stopped; else FitKind ordinal. have must be a pointer to a user struct or enum for OK.
 */
private fn satisfy(ck: *Check, job: *CheckJob, have: *Type, need: *Type, fit: *Fit, depth: i64): i32 with (a: mem.Allocator) {
    *fit = empty_fit()
    if ck.stop || need.kind != TypeKind.INTERFACE || is_universe_error(need as *Type?) {
        if ck.stop {
            return -1
        }
        return 1
    }
    if depth > 16 || constraint_is_typeset(need as *Type?) {
        return 1
    }
    if have.kind != TypeKind.PTR || have.elem == null {
        return 1
    }
    val elem = have.elem!!
    if !is_user_nominal(elem as *Type?) {
        return 1
    }
    val decl = need.decl
    if decl == null || !parse.is_interface(decl!!) {
        return 1
    }
    if ptr_eq_node(job.decl as *parse.Node?, decl) {
        return 1
    }
    val isym = decl_type_symbol(ck, decl!!)
    if isym != null {
        if !wait_for_symbol_finished(ck, job, isym!!) {
            return -1
        }
    }
    if ck.stop {
        return -1
    }
    if have.is_const && any_ptr_req(ck, job, need) {
        fit.kind = FitKind.CONST
        return 6
    }
    var i = decl!!.head as usize
    for i < decl!!.kids.len && !ck.stop {
        val req = decl!!.kids.get(i)
        if parse.is_embed(req) {
            if req.kids.len == 0 {
                i = i + 1
                continue
            }
            val emb = resolve_type(ck, job, req.kids.get(0))
            if emb == null || emb!!.kind != TypeKind.INTERFACE || constraint_is_typeset(emb) {
                i = i + 1
                continue
            }
            val sub = satisfy(ck, job, have, emb!!, fit, depth + 1)
            if sub != 0 {
                return sub
            }
            i = i + 1
            continue
        }
        if parse.is_field(req) {
            val sub = prop_fit(ck, job, elem, have, req, fit)
            if sub != 0 {
                return sub
            }
            i = i + 1
            continue
        }
        if !parse.is_fn(req) || req.name.len == 0 {
            i = i + 1
            continue
        }
        val name = req.name
        val req_ty = req_fn_type(ck, job, req)
        if req_ty == null || ck.stop {
            return -1
        }
        if req_ty!!.kind != TypeKind.FN {
            fit.kind = FitKind.MISSING
            fit.method = name
            return 2
        }
        var full: i64 = 0
        var saw_generic = false
        var saw_recv = false
        var saw_sig = false
        var needs_ptr = false
        var bad_name = ""
        for pkg in ck.prog.packages.items() {
            for mi in 0 as usize..pkg.methods.len {
                val sym = pkg.methods.at(mi)
                if sym.name != name || sym.decl == null {
                    continue
                }
                val fn_node = sym.decl!!
                if !parse.is_fn(fn_node) || !parse.fn_has_receiver(fn_node) {
                    continue
                }
                if !same_pkg(elem, sym) {
                    continue
                }
                if get_sema(sym) == null {
                    if ptr_eq_node(job.decl as *parse.Node?, fn_node as *parse.Node?) {
                        continue
                    }
                    if !wait_for_symbol(ck, job, sym, false) {
                        return -1
                    }
                }
                val mty = get_sema(sym)
                if mty == null || mty!!.kind != TypeKind.FN || mty!!.elems.len == 0 {
                    continue
                }
                val (recv, is_ptr) = type_peel_ptr(mty!!.elems.get(0))
                if recv.kind != elem.kind || recv.decl == null || elem.decl == null {
                    continue
                }
                if (recv.decl!! as *u8) != (elem.decl!! as *u8) {
                    continue
                }
                if sym_type_param_count(sym) > 0 {
                    saw_generic = true
                    bad_name = name
                    continue
                }
                if !ptr_eq_ty(recv as *Type?, elem as *Type?) {
                    continue
                }
                val want_ptr = iface_recv_ptr(req)
                if is_ptr != want_ptr {
                    saw_recv = true
                    needs_ptr = want_ptr
                    bad_name = name
                    continue
                }
                if !sig_ok(mty!!, req_ty!!) {
                    saw_sig = true
                    bad_name = name
                    continue
                }
                full = full + 1
                bad_name = name
            }
        }
        if ck.stop {
            return -1
        }
        if full == 1 {
            i = i + 1
            continue
        }
        if full > 1 {
            fit.kind = FitKind.AMBIG
            fit.method = name
            return 7
        }
        var failed = FitKind.MISSING
        if saw_sig {
            failed = FitKind.SIG
        } else if saw_recv {
            failed = FitKind.RECV
        } else if saw_generic {
            failed = FitKind.GENERIC
        }
        fit.kind = failed
        if bad_name.len > 0 {
            fit.method = bad_name
        } else {
            fit.method = name
        }
        fit.needs_ptr = needs_ptr
        return fit_code(failed)
    }
    if ck.stop {
        return -1
    }
    fit.kind = FitKind.OK
    return 0
}

/**
 * True when have converts implicitly to need (silent).
 */
fn iface_converts(ck: *Check, have: *Type, need: *Type): bool with (a: mem.Allocator) {
    var fit = empty_fit()
    val job = ck.current
    if job == null {
        return false
    }
    return satisfy(ck, job!!, have, need, &fit, 0) == 0
}

/**
 * Interface conversion for expect_type.
 * @return (out_type, 1) handled, (null, 0) not iface, (null|-err, -1) stop
 */
fn iface_expect(ck: *Check, job: *CheckJob, node: *parse.Node, got: *Type, want: *Type): (*Type?, i32) with (a: mem.Allocator) {
    if want.kind != TypeKind.INTERFACE {
        return null, 0
    }
    var fit = empty_fit()
    val kind = satisfy(ck, job, got, want, &fit, 0)
    if kind < 0 {
        return null, -1
    }
    if kind == 1 {
        return null, 0
    }
    if kind == 0 {
        return want as *Type?, 1
    }
    if kind == 2 || kind == 3 || kind == 4 || kind == 5 {
        var elem = got
        if got.kind == TypeKind.PTR && got.elem != null {
            elem = got.elem!!
        }
        explain_fit(ck, job.file, node.line, node.column, elem, want, fit)
    } else {
        explain_fit(ck, job.file, node.line, node.column, got, want, fit)
    }
    return err_ty(ck) as *Type?, 1
}

private fn find_req_depth(ck: *Check, job: *CheckJob, iface: *Type, name: str, depth: i64): *parse.Node? with (a: mem.Allocator) {
    if iface.decl == null || depth > 16 {
        return null
    }
    val decl = iface.decl!!
    if !parse.is_interface(decl) {
        return null
    }
    var i = decl.head as usize
    for i < decl.kids.len {
        val member = decl.kids.get(i)
        if parse.is_fn(member) && member.name == name {
            return member as *parse.Node?
        }
        if parse.is_embed(member) && member.kids.len > 0 {
            val emb = resolve_type(ck, job, member.kids.get(0))
            if emb != null && emb!!.kind == TypeKind.INTERFACE && !constraint_is_typeset(emb) {
                val nested = find_req_depth(ck, job, emb!!, name, depth + 1)
                if nested != null {
                    return nested
                }
            }
        }
        i = i + 1
    }
    return null
}

private fn find_prop_depth(ck: *Check, job: *CheckJob, iface: *Type, name: str, depth: i64): *parse.Node? with (a: mem.Allocator) {
    if iface.decl == null || depth > 16 {
        return null
    }
    val decl = iface.decl!!
    if !parse.is_interface(decl) {
        return null
    }
    var i = decl.head as usize
    for i < decl.kids.len {
        val member = decl.kids.get(i)
        if parse.is_field(member) && member.name == name {
            return member as *parse.Node?
        }
        if parse.is_embed(member) && member.kids.len > 0 {
            val emb = resolve_type(ck, job, member.kids.get(0))
            if emb != null && emb!!.kind == TypeKind.INTERFACE && !constraint_is_typeset(emb) {
                val nested = find_prop_depth(ck, job, emb!!, name, depth + 1)
                if nested != null {
                    return nested
                }
            }
        }
        i = i + 1
    }
    return null
}

private fn iface_ready(ck: *Check, job: *CheckJob, iface: *Type): i32 with (a: mem.Allocator) {
    if iface.decl == null {
        return 1
    }
    val isym = decl_type_symbol(ck, iface.decl!!)
    if isym != null {
        if !wait_for_symbol_finished(ck, job, isym!!) {
            return -1
        }
    }
    if ck.stop {
        return -1
    }
    return 1
}

private fn param_named_iface(fn_node: *parse.Node, name: str, count: usize): i64 {
    val shape = fn_node.head
    val nparams = (shape % 256) as usize
    var limit = count
    if nparams < limit {
        limit = nparams
    }
    var i: usize = 0
    for i < limit && i < fn_node.kids.len {
        val param = fn_node.kids.get(i)
        if param.name == name {
            return i as i64
        }
        i = i + 1
    }
    return -1
}

private fn param_has_default(fn_node: *parse.Node, index: usize): bool {
    if index >= fn_node.kids.len {
        return false
    }
    val param = fn_node.kids.get(index)
    return param.kids.len > 1
}

private fn param_name_iface(fn_node: *parse.Node, index: usize): str {
    if index >= fn_node.kids.len {
        return "?"
    }
    val n = fn_node.kids.get(index).name
    if n.len > 0 {
        return n
    }
    return "?"
}

/**
 * Call a method through an interface value.
 * @return (ret, 1) handled, (null, 0) not iface, (null, -1) stop
 */
fn check_interface_call(env: *Env, call: *parse.Node, base_ty: *Type): (*Type?, i32) with (a: mem.Allocator) {
    if call.kids.len == 0 {
        return null, 0
    }
    val callee = call.kids.get(0)
    if !parse.is_member(callee) || callee.flag == "?." || callee.name.len == 0 {
        return null, 0
    }
    val (iface, _) = peel_iface(base_ty as *Type?)
    if iface == null || is_universe_error(iface) {
        return null, 0
    }
    val isym_wait = iface_ready(env.ck, env.job, iface!!)
    if isym_wait < 0 {
        return null, -1
    }
    if callee.kids.len > 0 {
        // type args on MEMBER live in callee.kids after base — interface methods forbid them.
        // C checks type_args.count; Jog MEMBER kids[0] is base, kids[1..] may be type args for methods.
        // For `s.name<i32>()`, type args sit on the MEMBER node.
    }
    // Type arguments: MEMBER with extra kids beyond base for generics — check kid count after base.
    // parse puts type args as kids of MEMBER when written `name<T>`. Base is kids[0]; type args follow
    // only for TypeName.method; for value.method type args are also on the member node after base.
    if member_has_type_args(callee) {
        check_fail(env.ck, env.job.file, callee.line, callee.column, "an interface method cannot have type parameters")
        return err_ty(env.ck) as *Type?, 1
    }
    val req = find_req_depth(env.ck, env.job, iface!!, callee.name, 0)
    var fn_ty: *Type? = null
    if req != null {
        fn_ty = req_fn_type(env.ck, env.job, req!!)
    }
    if req == null || fn_ty == null || fn_ty!!.kind != TypeKind.FN {
        var b = strbuilder.empty()
        b.append("missing method '")
        b.append(callee.name)
        b.append("'")
        check_fail(env.ck, env.job.file, call.line, call.column, b.str())
        b.free()
        return err_ty(env.ck) as *Type?, 1
    }
    val count = fn_ty!!.elems.len
    var filled = list.empty<bool>()
    var fi: usize = 0
    for fi < count {
        filled.push(false)
        fi = fi + 1
    }
    val nctx = parse.call_nctx(call)
    var arg_end = call.kids.len
    if nctx > 0 && arg_end >= nctx {
        arg_end = arg_end - nctx
    }
    var positional: usize = 0
    var seen_named = false
    var ai: usize = 1
    for ai < arg_end && !env.ck.stop {
        val arg = call.kids.get(ai)
        if !parse.is_arg(arg) {
            check_fail(env.ck, env.job.file, arg.line, arg.column, "expected an argument")
            ai = ai + 1
            continue
        }
        var value: *parse.Node? = null
        if arg.kids.len > 0 {
            value = arg.kids.get(0) as *parse.Node?
        }
        var want: *Type? = null
        if arg.name.len > 0 {
            seen_named = true
            val index = param_named_iface(req!!, arg.name, count)
            if index < 0 {
                var b = strbuilder.empty()
                b.append("unknown parameter '")
                b.append(arg.name)
                b.append("'")
                check_fail(env.ck, env.job.file, arg.line, arg.column, b.str())
                b.free()
                if value != null {
                    check_expr(env, value!!, null)
                }
                ai = ai + 1
                continue
            }
            val idx = index as usize
            if filled.get(idx) {
                var b = strbuilder.empty()
                b.append("duplicate argument '")
                b.append(arg.name)
                b.append("'")
                check_fail(env.ck, env.job.file, arg.line, arg.column, b.str())
                b.free()
                ai = ai + 1
                continue
            }
            filled = filled_set_bool(filled, idx, true)
            want = fn_ty!!.elems.get(idx) as *Type?
        } else {
            if seen_named {
                check_fail(env.ck, env.job.file, arg.line, arg.column, "positional argument after a named argument")
                if value != null {
                    check_expr(env, value!!, null)
                }
                ai = ai + 1
                continue
            }
            if positional >= count {
                check_fail(env.ck, env.job.file, arg.line, arg.column, "too many arguments")
                if value != null {
                    check_expr(env, value!!, null)
                }
                ai = ai + 1
                continue
            }
            val idx = positional
            positional = positional + 1
            filled = filled_set_bool(filled, idx, true)
            want = fn_ty!!.elems.get(idx) as *Type?
        }
        if value != null {
            check_expr(env, value!!, want)
        }
        ai = ai + 1
    }
    // Trailing lambda: bit on call.head / 256
    if (call.head / 256) % 2 == 1 && !env.ck.stop {
        // Trailing is last non-context kid; rare for iface fixtures — skip detailed for now if not present.
    }
    var mi: usize = 0
    for mi < count && !env.ck.stop {
        if !filled.get(mi) {
            if param_has_default(req!!, mi) {
                mi = mi + 1
                continue
            }
            var b = strbuilder.empty()
            b.append("missing argument '")
            b.append(param_name_iface(req!!, mi))
            b.append("'")
            check_fail(env.ck, env.job.file, call.line, call.column, b.str())
            b.free()
        }
        mi = mi + 1
    }
    if env.ck.stop {
        return null, -1
    }
    if context_resolve_call(env, call, fn_ty!!, callee) < 0 {
        return null, -1
    }
    if fn_ty!!.elem == null {
        return unit_ty(env.ck) as *Type?, 1
    }
    return fn_ty!!.elem, 1
}

private fn filled_set_bool(filled: list.List<bool>, index: usize, value: bool): list.List<bool> with (a: mem.Allocator) {
    var out = list.empty<bool>()
    var i: usize = 0
    for i < filled.len {
        if i == index {
            out.push(value)
        } else {
            out.push(filled.get(i))
        }
        i = i + 1
    }
    return out
}

private fn member_has_type_args(member: *parse.Node): bool {
    // Value method call MEMBER: kids[0] = base. Type args for `name<T>` are additional kids.
    return member.kids.len > 1
}

private fn concrete_ptr(typ: *Type?): bool {
    if typ == null || typ!!.kind != TypeKind.PTR || typ!!.elem == null {
        return false
    }
    return is_user_nominal(typ!!.elem)
}

/**
 * as? from an interface. Returns (type, 1) handled, (null, 0) not, (null, -1) stop.
 */
fn check_interface_asq(env: *Env, node: *parse.Node): (*Type?, i32) with (a: mem.Allocator) {
    if node.kids.len < 2 {
        return null, 0
    }
    val dest = resolve_type(env.ck, env.job, node.kids.get(1))
    if dest == null || env.ck.stop {
        return null, -1
    }
    val got = check_expr(env, node.kids.get(0), null)
    if got == null || env.ck.stop {
        return null, -1
    }
    if got!!.kind != TypeKind.INTERFACE || is_universe_error(got) {
        return null, 0
    }
    if type_is_error(got!!) {
        return got, 1
    }
    if !concrete_ptr(dest) {
        check_fail(env.ck, env.job.file, node.line, node.column, "as? expects a pointer to a struct or enum")
        return err_ty(env.ck) as *Type?, 1
    }
    val opt = type_option(&env.ck.types, dest!!)
    return opt as *Type?, 1
}

/**
 * as: iface conversion or iface → *T downcast.
 * @return (type, 1) handled, (null, 0) not, (null, -1) stop
 */
fn check_interface_as(ck: *Check, job: *CheckJob, node: *parse.Node, got: *Type, dest: *Type): (*Type?, i32) with (a: mem.Allocator) {
    if dest.kind == TypeKind.INTERFACE && !is_universe_error(dest as *Type?) {
        var fit = empty_fit()
        val kind = satisfy(ck, job, got, dest, &fit, 0)
        if kind < 0 {
            return null, -1
        }
        if kind == 0 {
            return dest as *Type?, 1
        }
        if kind == 1 {
            return null, 0
        }
        if kind == 2 || kind == 3 || kind == 4 || kind == 5 {
            var elem = got
            if got.kind == TypeKind.PTR && got.elem != null {
                elem = got.elem!!
            }
            explain_fit(ck, job.file, node.line, node.column, elem, dest, fit)
        } else {
            explain_fit(ck, job.file, node.line, node.column, got, dest, fit)
        }
        return err_ty(ck) as *Type?, 1
    }
    if got.kind == TypeKind.INTERFACE && !is_universe_error(got as *Type?) && concrete_ptr(dest as *Type?) {
        return dest as *Type?, 1
    }
    return null, 0
}

/**
 * Property or method-as-value on an interface.
 */
fn check_interface_member(ck: *Check, job: *CheckJob, member: *parse.Node, iface: *Type): (*Type?, i32) with (a: mem.Allocator) {
    if !user_iface(iface as *Type?) {
        return null, 0
    }
    val ready = iface_ready(ck, job, iface)
    if ready <= 0 {
        return null, ready
    }
    var prop: *parse.Node? = null
    if member.name.len > 0 {
        prop = find_prop_depth(ck, job, iface, member.name, 0)
    }
    if prop != null {
        val pty = prop_type(ck, job, prop!!)
        if pty != null && pty!!.kind != TypeKind.ERROR {
            return pty, 1
        }
    }
    var method: *parse.Node? = null
    if member.name.len > 0 {
        method = find_req_depth(ck, job, iface, member.name, 0)
    }
    if method != null {
        var b = strbuilder.empty()
        b.append("method '")
        b.append(member.name)
        b.append("' must be called")
        check_fail(ck, job.file, member.line, member.column, b.str())
        b.free()
        return err_ty(ck) as *Type?, 1
    }
    var b = strbuilder.empty()
    b.append("unknown property '")
    if member.name.len > 0 {
        b.append(member.name)
    } else {
        b.append("?")
    }
    b.append("'")
    check_fail(ck, job.file, member.line, member.column, b.str())
    b.free()
    return err_ty(ck) as *Type?, 1
}

/**
 * Store through an interface property.
 * @return 1 handled, 0 not, -1 stop
 */
fn check_interface_store(env: *Env, assign: *parse.Node): i32 with (a: mem.Allocator) {
    if assign.kids.len < 2 {
        return 0
    }
    val target = assign.kids.get(0)
    if !parse.is_member(target) || target.kids.len == 0 {
        return 0
    }
    val base = target.kids.get(0)
    // Base type must already be checked via check_struct_member; re-check expr type from symbol/sema.
    var base_ty: *Type? = null
    if parse.is_ident(base) {
        val sym = lookup_name(env, base.name)
        if sym != null {
            base_ty = get_sema(sym!!)
        }
    }
    if base_ty == null {
        // Fall back: not an iface store we can see.
        return 0
    }
    val (iface, needs_load) = peel_iface(base_ty)
    if !user_iface(iface) {
        return 0
    }
    val prop = find_prop_depth(env.ck, env.job, iface!!, target.name, 0)
    if prop == null {
        // Method or unknown — already diagnosed in member check; still consume assign.
        check_expr(env, assign.kids.get(1), null)
        return 1
    }
    val pty = prop_type(env.ck, env.job, prop!!)
    if pty == null || pty!!.kind == TypeKind.ERROR {
        check_expr(env, assign.kids.get(1), pty)
        return 1
    }
    if (needs_load && base_ty!!.is_const) || !prop_is_var(prop!!) {
        var b = strbuilder.empty()
        b.append("cannot assign to property '")
        if target.name.len > 0 {
            b.append(target.name)
        } else {
            b.append("?")
        }
        b.append("'")
        check_fail(env.ck, env.job.file, target.line, target.column, b.str())
        b.free()
        check_expr(env, assign.kids.get(1), pty)
        return 1
    }
    if assign.text != "=" {
        var b = strbuilder.empty()
        b.append("operator '")
        b.append(assign.text)
        b.append("' is not checked yet")
        check_fail(env.ck, env.job.file, assign.line, assign.column, b.str())
        b.free()
        return 1
    }
    check_expr(env, assign.kids.get(1), pty)
    return 1
}

private fn named_concrete(ck: *Check, job: *CheckJob, dest: *Type): *Type? with (a: mem.Allocator) {
    if (dest.kind == TypeKind.STRUCT || dest.kind == TypeKind.ENUM) && dest.decl != null {
        return dest as *Type?
    }
    if dest.kind == TypeKind.PTR && dest.elem != null {
        val elem = dest.elem!!
        if (elem.kind == TypeKind.STRUCT || elem.kind == TypeKind.ENUM) && elem.decl != null {
            return elem as *Type?
        }
    }
    _ = ck
    _ = job
    return null
}

/**
 * `v is T` on an interface. Returns (bool_ty, 1), (null, 0) not iface, (null, -1) stop.
 * Also records the subject symbol for narrowing via return of the checked type only;
 * narrowing walks the AST and looks up IDENT symbols.
 */
fn check_interface_is(env: *Env, node: *parse.Node): (*Type?, i32) with (a: mem.Allocator) {
    if !parse.is_is(node) || node.kids.len < 2 {
        return null, 0
    }
    val expr = node.kids.get(0)
    val got = check_expr(env, expr, null)
    if env.ck.stop {
        return null, -1
    }
    if got == null || type_is_error(got!!) || !user_iface(got) {
        return null, 0
    }
    val boolean = type_builtin(&env.ck.types, Builtin.BOOL)
    val dest = resolve_type(env.ck, env.job, node.kids.get(1))
    if dest == null || env.ck.stop {
        return null, -1
    }
    if dest!!.kind == TypeKind.ERROR {
        return dest, 1
    }
    val concrete = named_concrete(env.ck, env.job, dest!!)
    if concrete == null {
        check_fail(env.ck, env.job.file, node.kids.get(1).line, node.kids.get(1).column, "is expects a struct or enum")
        return err_ty(env.ck) as *Type?, 1
    }
    // Narrowing uses the type node + subject IDENT; nothing else to stash on AST.
    _ = concrete
    return boolean as *Type?, 1
}

/**
 * `is T` pattern on an interface subject. 1 accepted, 0 not/reject, -1 stop.
 */
fn check_interface_pat_is(ck: *Check, job: *CheckJob, pat: *parse.Node, subject: *Type): i32 with (a: mem.Allocator) {
    if !parse.is_pat_is(pat) || !user_iface(subject as *Type?) {
        return 0
    }
    if pat.kids.len == 0 {
        return 0
    }
    val type_node = pat.kids.get(0)
    val dest = resolve_type(ck, job, type_node)
    if dest == null || ck.stop {
        return -1
    }
    if dest!!.kind == TypeKind.ERROR {
        return 0
    }
    val concrete = named_concrete(ck, job, dest!!)
    if concrete == null {
        check_fail(ck, job.file, type_node.line, type_node.column, "is expects a struct or enum")
        return 0
    }
    _ = concrete
    return 1
}

private fn narrow_push(st: *IfaceNarrow, sym: *load.Symbol, to: *Type) with (a: mem.Allocator) {
    var i: usize = 0
    for i < st.syms.len {
        if (st.syms.get(i) as *u8) == (sym as *u8) {
            if !ptr_eq_ty(get_sema(sym), to as *Type?) {
                set_sema(sym, st.saved.get(i) as *Type?)
                // Drop slot by clearing — leave leave() to restore remaining.
                // Replace with null-like: restore already done; mark by setting saved to current.
            }
            return
        }
        i = i + 1
    }
    if st.syms.len >= 8 {
        return
    }
    val cur = get_sema(sym)
    if cur == null || cur!!.kind != TypeKind.INTERFACE {
        return
    }
    st.syms.push(sym)
    st.saved.push(cur!!)
    set_sema(sym, to as *Type?)
}

private fn narrow_one(ck: *Check, st: *IfaceNarrow, sym: *load.Symbol?, concrete: *Type) with (a: mem.Allocator) {
    if sym == null {
        return
    }
    if !load.is_symbol_constant(sym!!) && sym!!.kind != load.kind_parameter() {
        return
    }
    val ptr = type_ptr(&ck.types, concrete, false)
    narrow_push(st, sym!!, ptr)
}

private fn is_concrete_nominal(ty: *Type?): bool {
    if ty == null {
        return false
    }
    return (ty!!.kind == TypeKind.STRUCT || ty!!.kind == TypeKind.ENUM) && ty!!.decl != null
}

private fn narrow_walk(ck: *Check, job: *CheckJob, env: *Env, node: *parse.Node, st: *IfaceNarrow) with (a: mem.Allocator) {
    if ck.stop {
        return
    }
    if parse.is_binary(node) && node.text == "&&" && node.kids.len >= 2 {
        narrow_walk(ck, job, env, node.kids.get(0), st)
        narrow_walk(ck, job, env, node.kids.get(1), st)
        return
    }
    if !parse.is_is(node) || node.kids.len < 2 {
        return
    }
    val expr = node.kids.get(0)
    if !parse.is_ident(expr) {
        return
    }
    val sym = lookup_name(env, expr.name)
    if sym == null {
        return
    }
    val cur = get_sema(sym!!)
    if cur == null || cur!!.kind != TypeKind.INTERFACE {
        return
    }
    val dest = resolve_type(ck, job, node.kids.get(1))
    if dest == null || ck.stop {
        return
    }
    val concrete = named_concrete(ck, job, dest!!)
    if concrete == null || !is_concrete_nominal(concrete) {
        return
    }
    narrow_one(ck, st, sym, concrete!!)
}

/**
 * Enter true-side narrowing for a condition.
 */
fn iface_narrow_enter(env: *Env, cond: *parse.Node): IfaceNarrow with (a: mem.Allocator) {
    var st = empty_narrow()
    narrow_walk(env.ck, env.job, env, cond, &st)
    return st
}

/**
 * Narrow subject for a `when` arm whose single pattern is `is T`.
 */
fn iface_narrow_pat(env: *Env, subject: *parse.Node?, pat: *parse.Node?): IfaceNarrow with (a: mem.Allocator) {
    var st = empty_narrow()
    if subject == null || pat == null || !parse.is_pat_is(pat!!) || !parse.is_ident(subject!!) {
        return st
    }
    if pat!!.kids.len == 0 {
        return st
    }
    val dest = resolve_type(env.ck, env.job, pat!!.kids.get(0))
    if dest == null || env.ck.stop {
        return st
    }
    val concrete = named_concrete(env.ck, env.job, dest!!)
    if concrete == null || !is_concrete_nominal(concrete) {
        return st
    }
    val sym = lookup_name(env, subject!!.name)
    narrow_one(env.ck, &st, sym, concrete!!)
    return st
}

/**
 * Restore types after a narrowed region.
 */
fn iface_narrow_leave(st: *IfaceNarrow) {
    var i: usize = 0
    for i < st.syms.len {
        set_sema(st.syms.get(i), st.saved.get(i) as *Type?)
        i = i + 1
    }
    st.syms = list.empty<*load.Symbol>()
    st.saved = list.empty<*Type>()
}

/**
 * Publish an interface type and check members (methods, props, embeds, type sets).
 */
fn check_interface(ck: *Check, job: *CheckJob): *Type? with (a: mem.Allocator) {
    if ck.stop || !parse.is_interface(job.decl) {
        return null
    }
    val node = job.decl
    var name = node.name
    if name.len == 0 {
        name = "?"
    }
    val ty = type_new_nominal(&ck.types, TypeKind.INTERFACE, name, job.pkg.path)
    ty.decl = node as *parse.Node?
    publish_job_type(job, ty as *Type?)
    if !type_layout(&ck.types, ty) {
        return null
    }
    var i = node.head as usize
    for i < node.kids.len && !ck.stop {
        val member = node.kids.get(i)
        if parse.is_field(member) || parse.is_embed(member) || parse.is_type_set(member) {
            if !constraint_iface_member(ck, job, node, member) {
                return null
            }
            // Duplicate property names (match C).
            if parse.is_field(member) && member.name.len > 0 {
                var prev = node.head as usize
                for prev < i {
                    val earlier = node.kids.get(prev)
                    if parse.is_field(earlier) && earlier.name == member.name {
                        var b = strbuilder.empty()
                        b.append("duplicate property '")
                        b.append(member.name)
                        b.append("'")
                        check_fail(ck, job.file, member.line, member.column, b.str())
                        b.free()
                        break
                    }
                    if parse.is_fn(earlier) && earlier.name == member.name {
                        var b = strbuilder.empty()
                        b.append("duplicate property '")
                        b.append(member.name)
                        b.append("'")
                        check_fail(ck, job.file, member.line, member.column, b.str())
                        b.free()
                        break
                    }
                    prev = prev + 1
                }
                if member.kids.len > 1 {
                    check_fail(ck, job.file, member.line, member.column, "an interface property cannot have a default")
                }
            }
            i = i + 1
            continue
        }
        if parse.is_fn(member) {
            if member.name.len == 0 {
                check_fail(ck, job.file, member.line, member.column, "missing method name")
                i = i + 1
                continue
            }
            val shape = member.head
            val ntype = (shape / 1048576) % 256
            if ntype > 0 {
                check_fail(ck, job.file, member.line, member.column, "an interface method cannot have type parameters")
                i = i + 1
                continue
            }
            if parse.flag_has_word(member.flag, "variadic") {
                check_fail(ck, job.file, member.line, member.column, "an interface method cannot be variadic")
                i = i + 1
                continue
            }
            val has_body = (shape / 262144) % 2 == 1
            if has_body {
                check_fail(ck, job.file, member.line, member.column, "an interface method cannot have a body")
                i = i + 1
                continue
            }
            var prev = node.head as usize
            for prev < i {
                val earlier = node.kids.get(prev)
                if parse.is_fn(earlier) && earlier.name == member.name {
                    var b = strbuilder.empty()
                    b.append("duplicate method '")
                    b.append(member.name)
                    b.append("'")
                    check_fail(ck, job.file, member.line, member.column, b.str())
                    b.free()
                    break
                }
                prev = prev + 1
            }
            var member_bad = false
            val fn_ty = build_req(ck, job, member, &member_bad)
            if fn_ty == null {
                return null
            }
            _ = fn_ty
            i = i + 1
            continue
        }
        check_fail(ck, job.file, member.line, member.column, "interface member is not checked yet")
        i = i + 1
    }
    if ck.stop {
        return null
    }
    return ty as *Type?
}
