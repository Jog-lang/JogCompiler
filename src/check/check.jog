// Checker entry. Checked against compiler/src/check.c (jog_check).
// Study note: JogDocs bootstrap/study/TypeChecking.
// Steps are JogDocs bootstrap/CheckerGuide.md.

import src.load
import std.io
import std.mem

/**
 * Type-check a loaded program. Step 4 checks core function bodies.
 * On success, prog.types holds the type table for lowering.
 * @param prog packages in dependency order from load.run
 * @context a allocator for the type table and jobs
 * @return updated program and 0 on success; non-zero on failure
 */
fn run(prog: load.Program): (load.Program, i32) with (a: mem.Allocator) {
    var out = prog
    out.types = null
    if out.packages.len == 0 {
        io.eprintln("jogc: check received no packages")
        return out, 1
    }
    var ck = check_new(out, 8)
    if !collect_jobs(&ck) {
        return out, 1
    }
    if ck.jobs.len > 0 {
        // run_jobs returns false when failed; still run duplicate-method
        // checks when the scheduler did not stop (matches jog_check).
        val ok = run_jobs(&ck)
        if !ck.stop {
            check_method_duplicates(&ck)
        }
        if !ok || ck.failed || ck.stop {
            return out, 1
        }
    }
    if ck.failed || ck.stop {
        return out, 1
    }
    if !check_platform(&ck) {
        return out, 1
    }
    check_package_tests(&ck)
    if ck.failed || ck.stop {
        return out, 1
    }
    // Keep the type table for emit-ir / lowering (lists share heap storage).
    val (raw, err) = a.alloc(size(TypeTable), align(TypeTable))
    if err != null {
        panic("out of memory")
    }
    val table = raw.ptr as *TypeTable
    *table = ck.types
    out.types = table as *u8?
    return out, 0
}
