// Shared type predicates used across check modules.

/**
 * TypeKind values for other packages (same pattern as lex.kind()).
 */
struct TypeKinds {
    ERROR: TypeKind
    UNIT: TypeKind
    BOOL: TypeKind
    INT: TypeKind
    FLOAT: TypeKind
    UNTYPED_INT: TypeKind
    UNTYPED_FLOAT: TypeKind
    NULL: TypeKind
    BYTES_N: TypeKind
    BYTES: TypeKind
    PTR: TypeKind
    SLICE: TypeKind
    ARRAY: TypeKind
    OPTION: TypeKind
    TUPLE: TypeKind
    FN: TypeKind
    STRUCT: TypeKind
    ENUM: TypeKind
    INTERFACE: TypeKind
    DISTINCT: TypeKind
    TYPE_PARAM: TypeKind
}

fn type_kinds(): TypeKinds {
    var k: TypeKinds
    k.ERROR = TypeKind.ERROR
    k.UNIT = TypeKind.UNIT
    k.BOOL = TypeKind.BOOL
    k.INT = TypeKind.INT
    k.FLOAT = TypeKind.FLOAT
    k.UNTYPED_INT = TypeKind.UNTYPED_INT
    k.UNTYPED_FLOAT = TypeKind.UNTYPED_FLOAT
    k.NULL = TypeKind.NULL
    k.BYTES_N = TypeKind.BYTES_N
    k.BYTES = TypeKind.BYTES
    k.PTR = TypeKind.PTR
    k.SLICE = TypeKind.SLICE
    k.ARRAY = TypeKind.ARRAY
    k.OPTION = TypeKind.OPTION
    k.TUPLE = TypeKind.TUPLE
    k.FN = TypeKind.FN
    k.STRUCT = TypeKind.STRUCT
    k.ENUM = TypeKind.ENUM
    k.INTERFACE = TypeKind.INTERFACE
    k.DISTINCT = TypeKind.DISTINCT
    k.TYPE_PARAM = TypeKind.TYPE_PARAM
    return k
}

fn type_is_error(t: *Type): bool {
    return t.kind == TypeKind.ERROR
}

fn type_is_unit(t: *Type): bool {
    return t.kind == TypeKind.UNIT
}

fn type_is_bool(t: *Type): bool {
    return t.kind == TypeKind.BOOL
}

fn type_is_fn(t: *Type): bool {
    return t.kind == TypeKind.FN
}

fn type_is_host_int(t: *Type): bool {
    // Builtin INT, or distinct with @intrinsic(int, …) (C host_int).
    return t.kind == TypeKind.INT || t.intrinsic == 1
}

fn type_is_host_float(t: *Type): bool {
    return t.kind == TypeKind.FLOAT || t.intrinsic == 2
}

/** Bits / signedness for host int (builtin or intrinsic). */
fn type_host_int_info(t: *Type): (u8, bool, bool) {
    if t.kind == TypeKind.INT {
        return t.int_bits, t.int_signed, true
    }
    if t.intrinsic == 1 {
        return t.intrinsic_bits, t.intrinsic_signed, true
    }
    return 0, false, false
}

fn type_same(a: *Type, b: *Type): bool {
    return a == b
}

fn type_peel_ptr(ty: *Type): (*Type, bool) {
    if ty.kind == TypeKind.PTR && ty.elem != null {
        return ty.elem!!, true
    }
    return ty, false
}

fn type_peel_distinct(ty: *Type): *Type {
    var t = ty
    for t.kind == TypeKind.DISTINCT && t.elem != null {
        t = t.elem!!
    }
    return t
}
