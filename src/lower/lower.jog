// Lowering entry. Checked against compiler/src/lower.c (jog_lower).
// Study note: JogDocs bootstrap/study/IR. LowerGuide steps 1+.

import src.check
import src.ir
import src.load
import src.parse
import std.io
import std.list
import std.mem
import std.strbuilder

struct LocalBind {
    symbol: *load.Symbol?
    local: u32
}

struct FnBind {
    decl: *parse.Node?
    index: i32
    body_done: bool
}

struct LoopFrame {
    cont: u32
    brk: u32
    cleanup_base: usize
}

struct Overlay {
    symbol: *load.Symbol?
    value: ir.Operand
}

struct GlobalBind {
    symbol: *load.Symbol?
    index: i32
    decl: *parse.Node?
    runtime: bool
    part: i32 // multi-bind element index, or -1
}

/** Capture slot for `go` bodies (C Cap). */
struct CoroCap {
    symbol: *load.Symbol?
    parent_local: u32
    indirect: bool
    indirect_slot: u32
}

/** One outer local closed over by a lambda (C LamCap). */
struct LamCap {
    symbol: *load.Symbol?
    parent: u32
}

struct Lower {
    prog: load.Program
    types: *check.TypeTable
    module: ir.Module
    func: *ir.Func?
    ast_fn: *parse.Node?
    file: str
    block: u32
    terminated: bool
    failed: bool
    locals: list.List<LocalBind>
    fns: list.List<FnBind>
    loops: list.List<LoopFrame>
    overlays: list.List<Overlay>
    globals: list.List<GlobalBind>
    cleanups: list.List<Cleanup>
    in_cleanup: bool
    root_pkg: *load.Package?
    unchecked: bool
    generic_pending: list.List<GenericInst>
    subst_params: list.List<*check.Type>
    subst_args: list.List<*check.Type>
    ctx_frames: list.List<CtxFrame>
    iface_tables: list.List<IfaceTable>
    coro_scopes: list.List<u32>
    coro_seq: u32
    in_coro: bool
    coro_caps: list.List<CoroCap>
    ct_seq: u32
    in_comptime: bool
    ensuring: i32
    ct_steps: u64
    in_lambda: bool
    lambda_env: u32
    lambda_caps: list.List<LamCap>
    lambda_tuple: *check.Type?
}

fn fail(L: *Lower, node: *parse.Node?, message: str) with (a: mem.Allocator) {
    L.failed = true
    if node != null {
        load.print_pos_error(L.file, node!!.line, node!!.column, message)
    } else {
        load.print_bare_error(message)
    }
}

fn node_pos(L: *Lower, node: *parse.Node): ir.Pos {
    return ir.pos_of(L.file, node.line, node.column)
}

fn pkg_source(L: *Lower, pkg: *load.Package): str {
    if pkg.path.len > 0 {
        return pkg.path
    }
    if pkg.name.len > 0 {
        return pkg.name
    }
    if L.prog.root_module.len > 0 {
        return L.prog.root_module
    }
    return "main"
}

private fn is_ident_char(c: u8): bool {
    return (c >= 'a' as u8 && c <= 'z' as u8) || (c >= 'A' as u8 && c <= 'Z' as u8) ||
        (c >= '0' as u8 && c <= '9' as u8) || c == '_' as u8
}

private fn method_spell(name: str): str {
    if name == "op+" {
        return "op_add"
    }
    if name == "op-" {
        return "op_sub"
    }
    if name == "op*" {
        return "op_mul"
    }
    if name == "op/" {
        return "op_div"
    }
    if name == "op%" {
        return "op_rem"
    }
    if name == "op&" {
        return "op_and"
    }
    if name == "op|" {
        return "op_or"
    }
    if name == "op^" {
        return "op_xor"
    }
    if name == "op<<" {
        return "op_shl"
    }
    if name == "op>>" {
        return "op_shr"
    }
    if name == "op==" {
        return "op_eq"
    }
    if name == "op!=" {
        return "op_ne"
    }
    if name == "op<" {
        return "op_lt"
    }
    if name == "op<=" {
        return "op_le"
    }
    if name == "op>" {
        return "op_gt"
    }
    if name == "op>=" {
        return "op_ge"
    }
    if name == "op<=>" {
        return "op_cmp"
    }
    if name == "op[]" {
        return "op_index"
    }
    if name == "op[]=" {
        return "op_index_set"
    }
    if name == "op!" {
        return "op_not"
    }
    if name == "op~" {
        return "op_bitnot"
    }
    return name
}

fn append_c_piece(b: *strbuilder.StrBuilder, src: str) with (a: mem.Allocator) {
    if src.len == 0 {
        b.append("main")
        return
    }
    val spelled = method_spell(src)
    var i: usize = 0
    for i < spelled.len {
        var c = spelled.ptr[i]
        if c == '.' as u8 {
            c = '_' as u8
        } else if !is_ident_char(c) {
            c = '_' as u8
        }
        b.append_byte(c)
        i = i + 1
    }
}

fn receiver_type_name(fn_node: *parse.Node): str {
    val shape = fn_node.head
    val nattrs = (shape / 268435456) % 256
    val at = nattrs as usize
    if at >= fn_node.kids.len {
        return ""
    }
    var recv = fn_node.kids.get(at)
    // Receiver type kid may be TYPE_PTR wrapping the named type.
    if parse.is_type_ptr(recv) && recv.kids.len > 0 {
        recv = recv.kids.get(0)
    }
    if parse.is_type_name(recv) {
        if recv.name.len > 0 {
            return recv.name
        }
        return recv.text
    }
    if parse.is_ident(recv) {
        if recv.name.len > 0 {
            return recv.name
        }
        return recv.text
    }
    return ""
}

/** `@export` / `@export("name")` → C symbol, or empty when not exported. */
private fn export_c_name(fn_node: *parse.Node): str {
    val nattrs = (fn_node.head / 268435456) % 256
    var i: usize = 0
    for i < (nattrs as usize) && i < fn_node.kids.len {
        val attr = fn_node.kids.get(i)
        i = i + 1
        if !parse.is_attribute(attr) || attr.name != "export" {
            continue
        }
        if attr.kids.len > 0 {
            var arg = attr.kids.get(0)
            if parse.is_arg(arg) && arg.kids.len > 0 {
                arg = arg.kids.get(0)
            }
            if parse.is_string_lit(arg) && arg.text.len > 0 {
                return arg.text
            }
        }
        if fn_node.name.len > 0 {
            return fn_node.name
        }
        return "export"
    }
    return ""
}

private fn mangle_fn(L: *Lower, pkg: *load.Package, fn_node: *parse.Node): str with (a: mem.Allocator) {
    var b = strbuilder.empty()
    if parse.flag_has_word(fn_node.flag, "extern") {
        if fn_node.name.len > 0 {
            b.append(fn_node.name)
        } else {
            b.append("extern_fn")
        }
        return b.str()
    }
    val exported = export_c_name(fn_node)
    if exported.len > 0 {
        b.append(exported)
        return b.str()
    }
    b.append("jog_")
    append_c_piece(&b, pkg_source(L, pkg))
    b.append("__")
    if parse.fn_has_receiver(fn_node) {
        // Match C: jog_<pkg>__<Type>__<name> (pointer receivers still use Type).
        val recv_name = receiver_type_name(fn_node)
        if recv_name.len > 0 {
            append_c_piece(&b, recv_name)
            b.append("__")
        } else {
            b.append("Recv__")
        }
    }
    if fn_node.name.len > 0 {
        append_c_piece(&b, method_spell(fn_node.name))
    } else {
        b.append("fn")
    }
    if parse.flag_has_word(fn_node.flag, "private(file)") && L.file.len > 0 {
        b.append("__")
        append_c_piece(&b, L.file)
    }
    return b.str()
}

private fn jog_fn_name(L: *Lower, pkg: *load.Package, fn_node: *parse.Node): str with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append(pkg_source(L, pkg))
    b.append_byte('.' as u8)
    if parse.fn_has_receiver(fn_node) {
        val recv_name = receiver_type_name(fn_node)
        if recv_name.len > 0 {
            b.append(recv_name)
            b.append_byte('.' as u8)
        }
    }
    if fn_node.name.len > 0 {
        b.append(fn_node.name)
    } else {
        b.append("fn")
    }
    return b.str()
}

fn linkage_of(fn_node: *parse.Node): ir.Linkage {
    val link = ir.linkages()
    if parse.flag_has_word(fn_node.flag, "extern") {
        return link.EXTERN
    }
    if export_c_name(fn_node).len > 0 {
        return link.EXPORT
    }
    // Empty visibility is public (Jog default). private* is internal.
    if parse.flag_has_word(fn_node.flag, "private") || parse.flag_has_word(fn_node.flag, "private(file)") ||
        parse.flag_has_word(fn_node.flag, "private(package)") || parse.flag_has_word(fn_node.flag, "private(scope)") {
        return link.INTERNAL
    }
    return link.PUBLIC
}

private fn find_fn_type(pkg: *load.Package, decl: *parse.Node): *check.Type? {
    for i in 0 as usize..pkg.methods.len {
        val s = pkg.methods.at(i)
        if s.decl != null && s.decl!! == decl {
            return check.get_sema(s)
        }
    }
    for i in 0 as usize..pkg.scope.bindings.len {
        val s = pkg.scope.bindings.at(i)
        if s.decl != null && s.decl!! == decl {
            return check.get_sema(s)
        }
    }
    for fi in 0 as usize..pkg.scope.file_scopes.len {
        val fs = pkg.scope.file_scopes.get(fi)
        for i in 0 as usize..fs.bindings.len {
            val s = fs.bindings.at(i)
            if s.decl != null && s.decl!! == decl {
                return check.get_sema(s)
            }
        }
    }
    return null
}

fn jir_fn_type(L: *Lower, fn_ty: *check.Type): *check.Type? with (a: mem.Allocator) {
    if !check.type_is_fn(fn_ty) {
        return null
    }
    if fn_ty.contexts.len == 0 {
        return fn_ty as *check.Type?
    }
    // Append context params as trailing ordinary params.
    var params = list.empty<*check.Type>()
    for p in fn_ty.elems.items() {
        params.push(p)
    }
    for c in fn_ty.contexts.items() {
        params.push(c)
    }
    val ret = fn_ty.elem
    if ret == null {
        return null
    }
    var empty_ctx = list.empty<*check.Type>()
    return check.type_fn(
        L.types,
        params,
        ret!!,
        empty_ctx,
        fn_ty.fn_variadic,
        fn_ty.fn_escaping,
        fn_ty.fn_extern,
    ) as *check.Type?
}

fn fn_param_names(fn_node: *parse.Node, nparam: usize): list.List<str> with (a: mem.Allocator) {
    var names = list.empty<str>()
    val shape = fn_node.head
    val nparams = shape % 256
    val nctx = (shape / 256) % 256
    val has_recv = (shape / 65536) % 2 == 1
    val nattrs = (shape / 268435456) % 256
    var i: i64 = nattrs
    if has_recv {
        if (i as usize) < fn_node.kids.len {
            names.push("self")
        }
        i = i + 1
    }
    val ntype = (shape / 1048576) % 256
    i = i + ntype
    var p: i64 = 0
    for p < nparams {
        if (i as usize) < fn_node.kids.len {
            val param = fn_node.kids.get(i as usize)
            names.push(param.name)
        } else {
            names.push("")
        }
        i = i + 1
        p = p + 1
    }
    // Context params follow ordinary params in the flat kids list.
    var c: i64 = 0
    for c < nctx {
        if (i as usize) < fn_node.kids.len {
            val cparam = fn_node.kids.get(i as usize)
            names.push(cparam.name)
        } else {
            names.push("")
        }
        i = i + 1
        c = c + 1
    }
    // Pad/truncate to nparam from the lowered type.
    for names.len < nparam {
        names.push("")
    }
    return names
}

private fn bind_fn(L: *Lower, decl: *parse.Node, index: i32) with (a: mem.Allocator) {
    var b: FnBind
    b.decl = decl as *parse.Node?
    b.index = index
    b.body_done = false
    L.fns.push(b)
}

fn find_fn(L: *Lower, decl: *parse.Node): i32 {
    for i in 0 as usize..L.fns.len {
        val b = L.fns.at(i)
        if b.decl != null && b.decl!! == decl {
            return b.index
        }
    }
    return -1
}

private fn declare_fn(L: *Lower, pkg: *load.Package, fn_node: *parse.Node) with (a: mem.Allocator) {
    if parse.flag_has_word(fn_node.flag, "expect") {
        return
    }
    // Generic templates are not emitted (C declare_fn type_param_count > 0).
    val ntype = (fn_node.head / 1048576) % 256
    if ntype > 0 {
        return
    }
    var fn_sym = check.get_node_sym(fn_node)
    if fn_sym == null && fn_node.name.len > 0 {
        fn_sym = load.package_scope_lookup(&pkg.scope, fn_node.name)
        if fn_sym == null {
            for fi in 0 as usize..pkg.files.len {
                fn_sym = load.file_lookup(&pkg.scope, fi, fn_node.name)
                if fn_sym != null {
                    break
                }
            }
        }
    }
    // Methods live on pkg.methods (not the name scope).
    if fn_sym == null {
        for mi in 0 as usize..pkg.methods.len {
            val ms = pkg.methods.at(mi)
            if ms.decl != null && ms.decl!! == fn_node {
                fn_sym = ms
                break
            }
        }
    }
    if fn_sym != null && check.sym_type_param_count(fn_sym!!) > 0 {
        return
    }
    // Receiver type args: `fn Box<T>.get` — open if the FN type still names a param.
    val raw_probe = find_fn_type(pkg, fn_node)
    if raw_probe != null && check.generic_has_param(raw_probe!!) {
        return
    }
    // Also: AST still carries TYPE_PARAM kids on the FN when the symbol list is empty.
    for kid in fn_node.kids.items() {
        if parse.is_type_param(kid) {
            return
        }
    }
    val raw_ty = find_fn_type(pkg, fn_node)
    if raw_ty == null || !check.type_is_fn(raw_ty!!) {
        fail(L, fn_node, "function has no type")
        return
    }
    val ty = jir_fn_type(L, raw_ty!!)
    if ty == null {
        fail(L, fn_node, "function has no type")
        return
    }
    val name = mangle_fn(L, pkg, fn_node)
    val jog_name = jog_fn_name(L, pkg, fn_node)
    val names = fn_param_names(fn_node, ty!!.elems.len)
    val index = ir.func_add(&L.module, name, jog_name, linkage_of(fn_node), ty!!, names)
    if index < 0 {
        fail(L, fn_node, "out of memory")
        return
    }
    val func = ir.func_at(&L.module, index as u32)
    if func != null {
        func!!.pos = node_pos(L, fn_node)
    }
    bind_fn(L, fn_node, index)
    if !parse.flag_has_word(fn_node.flag, "extern") && fn_node.name == "main" && L.root_pkg != null &&
        pkg == L.root_pkg!! {
        L.module.main_func = index
    }
}

private fn declare_decl(L: *Lower, pkg: *load.Package, decl: *parse.Node) with (a: mem.Allocator) {
    if L.failed {
        return
    }
    if parse.is_fn(decl) {
        declare_fn(L, pkg, decl)
        return
    }
    if parse.is_extern_block(decl) {
        for kid in decl.kids.items() {
            if parse.is_fn(kid) {
                declare_fn(L, pkg, kid)
            }
        }
        return
    }
}

fn new_local(L: *Lower, name: str, ty: *check.Type?): u32 with (a: mem.Allocator) {
    var use_ty = lower_type_subst(L, ty)
    if use_ty == null {
        use_ty = ty
    }
    if L.func == null || use_ty == null {
        var msg = strbuilder.empty()
        msg.append("lowering is missing a type")
        if name.len > 0 {
            msg.append(" for ")
            msg.append(name)
        }
        fail(L, null, msg.str())
        msg.free()
        return 0
    }
    return ir.local_add(L.func!!, name, use_ty)
}

fn bind_local(L: *Lower, symbol: *load.Symbol?, local: u32) with (a: mem.Allocator) {
    var b: LocalBind
    b.symbol = symbol
    b.local = local
    L.locals.push(b)
}

fn find_local(L: *Lower, symbol: *load.Symbol): (u32, bool) {
    var i = L.locals.len
    for i > 0 {
        i = i - 1
        val b = L.locals.at(i)
        if b.symbol != null && b.symbol!! == symbol {
            return b.local, true
        }
    }
    return 0, false
}

fn find_local_by_name(L: *Lower, name: str): (u32, bool) {
    if L.func == null || name.len == 0 {
        return 0, false
    }
    var i = L.locals.len
    for i > 0 {
        i = i - 1
        val b = L.locals.at(i)
        if b.symbol != null && b.symbol!!.name == name {
            return b.local, true
        }
        // Multi-name `var (a, b)` stores the local with no symbol. A context
        // parameter of the same name is an older bind and must not win.
        if b.symbol == null && (b.local as usize) < L.func!!.locals.len &&
            L.func!!.locals.at(b.local as usize).name == name {
            return b.local, true
        }
    }
    // Newest local wins (nested `for i, …` reuses the name).
    var li = L.func!!.locals.len
    for li > 0 {
        li = li - 1
        if L.func!!.locals.at(li).name == name {
            return li as u32, true
        }
    }
    return 0, false
}

fn find_overlay(L: *Lower, symbol: *load.Symbol): (ir.Operand, bool) {
    var i = L.overlays.len
    for i > 0 {
        i = i - 1
        val o = L.overlays.at(i)
        if o.symbol != null && o.symbol!! == symbol {
            return o.value, true
        }
    }
    return ir.none_op(), false
}

fn new_block(L: *Lower, label: str): u32 with (a: mem.Allocator) {
    if L.func == null {
        return 0
    }
    return ir.block_add(L.func!!, label)
}

fn use_block(L: *Lower, block: u32) {
    L.block = block
    if L.func == null {
        L.terminated = true
        return
    }
    val b = L.func!!.blocks.at(block as usize)
    L.terminated = b.term.kind != ir.term_kinds().NONE
}

fn emit_inst(L: *Lower, op: ir.Op, dst: i32, pos: ir.Pos): *ir.Inst? with (a: mem.Allocator) {
    if L.failed || L.func == null {
        return null
    }
    if L.terminated {
        fail(L, null, "internal: instruction after a terminator")
        return null
    }
    val inst = ir.emit(L.func!!, L.block, op, dst)
    if inst == null {
        fail(L, null, "out of memory")
        return null
    }
    inst!!.pos = pos
    return inst
}

fn emit_copy(L: *Lower, dst: u32, src: ir.Operand, pos: ir.Pos) with (a: mem.Allocator) {
    val inst = emit_inst(L, ir.op_kinds().COPY, dst as i32, pos)
    if inst != null {
        inst!!.a = src
    }
}

fn emit_br(L: *Lower, target: u32, pos: ir.Pos) {
    if L.failed || L.terminated {
        return
    }
    var term = ir.empty_term()
    term.kind = ir.term_kinds().BR
    term.target = target
    term.pos = pos
    ir.terminate(L.func!!, L.block, term)
    L.terminated = true
}

fn emit_cond(L: *Lower, cond: ir.Operand, yes: u32, no: u32, pos: ir.Pos) {
    if L.failed || L.terminated {
        return
    }
    var term = ir.empty_term()
    term.kind = ir.term_kinds().COND_BR
    term.value = cond
    term.target = yes
    term.else_target = no
    term.pos = pos
    ir.terminate(L.func!!, L.block, term)
    L.terminated = true
}

fn emit_switch(L: *Lower, value: ir.Operand, def: u32, cases: list.List<ir.Case>, pos: ir.Pos) with (a: mem.Allocator) {
    if L.failed || L.terminated {
        return
    }
    var term = ir.empty_term()
    term.kind = ir.term_kinds().SWITCH
    term.value = value
    term.target = def
    // Deep-copy cases — `term.cases = cases` shares the buffer; a later
    // grow/free of the caller's list double-frees (string.jog host AV).
    term.cases = list.empty<ir.Case>()
    for c in cases.items() {
        term.cases.push(c)
    }
    term.pos = pos
    ir.terminate(L.func!!, L.block, term)
    L.terminated = true
}

fn emit_unreachable(L: *Lower, pos: ir.Pos) {
    if L.failed || L.terminated {
        return
    }
    var term = ir.empty_term()
    term.kind = ir.term_kinds().UNREACHABLE
    term.pos = pos
    ir.terminate(L.func!!, L.block, term)
    L.terminated = true
}

fn emit_ret(L: *Lower, value: ir.Operand, pos: ir.Pos) {
    if L.failed || L.terminated {
        return
    }
    var term = ir.empty_term()
    term.kind = ir.term_kinds().RET
    term.value = value
    term.pos = pos
    ir.terminate(L.func!!, L.block, term)
    L.terminated = true
}

fn local_operand(L: *Lower, index: u32): ir.Operand {
    return ir.local_op(L.func!!, index)
}

fn as_local(L: *Lower, src: ir.Operand, pos: ir.Pos): ir.Operand with (a: mem.Allocator) {
    if src.kind == ir.operand_kinds().LOCAL {
        return src
    }
    val dst = new_local(L, "", src.ty)
    emit_copy(L, dst, src, pos)
    return local_operand(L, dst)
}

fn none_value(): ir.Operand {
    return ir.none_op()
}

/**
 * True when a checked program can be lowered. The messages match emit-ir.
 */
fn ready(prog: load.Program): bool {
    if prog.types == null {
        io.eprintln("jogc: emit-ir missing type table")
        return false
    }
    if prog.packages.len == 0 {
        io.eprintln("jogc: emit-ir received no packages")
        return false
    }
    return true
}

/**
 * Lower a checked program to JIR. Does not print. emit-ir dumps the module;
 * emit-c prints C from the same module.
 */
fn build(prog: load.Program): (ir.Module, i32) with (a: mem.Allocator) {
    return build_steps(prog, 0)
}

/**
 * Lower a checked program. steps is the comptime budget; 0 keeps the
 * default of 10_000_000. A positive --comptime-steps replaces it.
 */
fn build_steps(prog: load.Program, steps: u64): (ir.Module, i32) with (a: mem.Allocator) {
    var budget: u64 = 10000000
    if steps != 0 {
        budget = steps
    }
    val types = prog.types!! as *check.TypeTable
    var L = Lower(
        prog: prog,
        types: types,
        module: ir.module_create(types),
        func: null,
        ast_fn: null,
        file: "",
        block: 0,
        terminated: false,
        failed: false,
        locals: list.empty<LocalBind>(),
        fns: list.empty<FnBind>(),
        loops: list.empty<LoopFrame>(),
        overlays: list.empty<Overlay>(),
        globals: list.empty<GlobalBind>(),
        cleanups: list.empty<Cleanup>(),
        in_cleanup: false,
        root_pkg: prog.packages.get(prog.packages.len - 1) as *load.Package?,
        unchecked: false,
        generic_pending: list.empty<GenericInst>(),
        subst_params: list.empty<*check.Type>(),
        subst_args: list.empty<*check.Type>(),
        ctx_frames: list.empty<CtxFrame>(),
        iface_tables: list.empty<IfaceTable>(),
        coro_scopes: list.empty<u32>(),
        coro_seq: 0,
        in_coro: false,
        coro_caps: list.empty<CoroCap>(),
        ct_seq: 0,
        in_comptime: false,
        ensuring: -1,
        ct_steps: budget,
        in_lambda: false,
        lambda_env: 0,
        lambda_caps: list.empty<LamCap>(),
        lambda_tuple: null,
    )

    for pi in 0 as usize..prog.packages.len {
        val pkg = prog.packages.get(pi)
        for fi in 0 as usize..pkg.files.len {
            val source = pkg.files.get(fi)
            if source.ast == null {
                continue
            }
            L.file = source.path
            val root = source.ast!!
            for decl in root.kids.items() {
                if parse.is_import(decl) {
                    continue
                }
                declare_decl(&L, pkg, decl)
                if L.failed {
                    return L.module, 1
                }
            }
        }
    }
    declare_globals(&L)
    if L.failed {
        return L.module, 1
    }
    // C: comptime_vals before decl bodies so ct_seq / ctdat names match.
    if !lower_comptime_vals(&L) {
        return L.module, 1
    }

    for pi in 0 as usize..prog.packages.len {
        val pkg = prog.packages.get(pi)
        for fi in 0 as usize..pkg.files.len {
            val source = pkg.files.get(fi)
            if source.ast == null {
                continue
            }
            L.file = source.path
            val root = source.ast!!
            for decl in root.kids.items() {
                if parse.is_import(decl) {
                    continue
                }
                lower_decl_body(&L, decl)
                if L.failed {
                    return L.module, 1
                }
            }
        }
    }
    // C lowers function bodies before __0init, so pointer types taken in
    // main are allocated before the init function's () -> ().
    if !L.failed {
        build_init_func(&L)
    }
    if !L.failed {
        lower_package_tests(&L)
    }
    if L.failed {
        return L.module, 1
    }

    for !L.failed {
        if !generic_take_and_lower(&L) {
            break
        }
    }

    if L.failed {
        return L.module, 1
    }
    // Optional type-allocation probe (set JOG_TID_LOG=1 when launching).
    check.dump_tid_log(types, "out/tid_log_jc.txt")
    // Marks address_taken on ADDR locals (dump prints "addr").
    _ = ir.verify(&L.module)
    return L.module, 0
}

/**
 * Lower a checked program to JIR and print the dump to stdout.
 */
fn run(prog: load.Program): i32 with (a: mem.Allocator) {
    if !ready(prog) {
        return 1
    }
    val (got, code) = build(prog)
    if code != 0 {
        return code
    }
    var module = got
    val text = ir.dump(&module)
    io.print(text)
    return 0
}

private struct TestBind {
    decl: *parse.Node
    index: i32
    file: str
}

private fn fn_is_test(node: *parse.Node): bool {
    if !parse.is_fn(node) {
        return false
    }
    val nattrs = (node.head / 268435456) % 256
    var i: i64 = 0
    for i < nattrs {
        if (i as usize) >= node.kids.len {
            break
        }
        val attr = node.kids.get(i as usize)
        if parse.is_attribute(attr) && attr.name == "test" {
            return true
        }
        i = i + 1
    }
    return false
}

private fn is_testing_ty(ty: *check.Type): bool {
    val kinds = check.type_kinds()
    return ty.kind == kinds.INTERFACE && ty.name == "Testing" && ty.package == "std.testing"
}

private fn pkg_loaded(L: *Lower, want: str): bool {
    var i: usize = 0
    for i < L.prog.packages.len {
        val pkg: *load.Package = L.prog.packages.get(i)
        if pkg.path == want {
            return true
        }
        i = i + 1
    }
    return false
}

private fn testing_fn(L: *Lower, name: str): *parse.Node? {
    for pkg in L.prog.packages.items() {
        if pkg.path != "std.testing" {
            continue
        }
        val sym = load.package_scope_lookup(&pkg.scope, name)
        if sym == null || sym!!.decl == null || !parse.is_fn(sym!!.decl!!) {
            return null
        }
        return sym!!.decl
    }
    return null
}

private fn emit_call_idx(L: *Lower, index: i32, args: list.List<ir.Operand>, pos: ir.Pos): ir.Operand with (a: mem.Allocator) {
    val f = ir.func_at(&L.module, index as u32)
    var ret: *check.Type? = null
    if f != null && f!!.ty != null {
        ret = f!!.ty!!.elem
    }
    var dst: i32 = -1
    if ret != null && !check.type_is_unit(ret!!) {
        dst = new_local(L, "", ret) as i32
    }
    val inst = emit_inst(L, ir.op_kinds().CALL, dst, pos)
    if inst != null {
        inst!!.a = ir.func_ref(&L.module, index as u32)
        ir.set_args(inst!!, args)
    }
    if dst >= 0 {
        return local_operand(L, dst as u32)
    }
    return none_value()
}

private fn emit_testing_named(L: *Lower, name: str, args: list.List<ir.Operand>, pos: ir.Pos) with (a: mem.Allocator) {
    val decl = testing_fn(L, name)
    if decl == null {
        fail(L, null, "missing test result")
        return
    }
    val index = find_fn(L, decl!!)
    if index < 0 {
        fail(L, null, "missing test result")
        return
    }
    _ = emit_call_idx(L, index, args, pos)
}

private fn supply_test_args(L: *Lower, decl: *parse.Node, index: i32, args: *list.List<ir.Operand>, pos: ir.Pos) with (a: mem.Allocator) {
    val nparams = decl.head % 256
    val nctx = (decl.head / 256) % 256
    if nparams != 0 {
        fail(L, decl, "test function was not lowered")
        return
    }
    val f = ir.func_at(&L.module, index as u32)
    if f == null || f!!.ty == null {
        fail(L, decl, "test function was not lowered")
        return
    }
    var c: i64 = 0
    for c < nctx && !L.failed {
        if (c as usize) >= f!!.ty!!.elems.len {
            fail(L, decl, "missing context argument")
            return
        }
        val want = f!!.ty!!.elems.get(c as usize)
        if !is_testing_ty(want) {
            fail(L, decl, "missing context argument")
            return
        }
        val value = call_pkg(L, "std.testing", "testing", want as *check.Type?, pos)
        if L.failed {
            return
        }
        args.push(value)
        c = c + 1
    }
}

/**
 * When *.test.jog was loaded, the entry calls each @test and does not call main.
 * Matches jog_lower_package_tests.
 */
fn lower_package_tests(L: *Lower) with (a: mem.Allocator) {
    if L.failed || L.root_pkg == null {
        return
    }
    var tests = list.empty<TestBind>()
    for pi in 0 as usize..L.prog.packages.len {
        val pkg: *load.Package = L.prog.packages.get(pi)
        for fi in 0 as usize..pkg.files.len {
            val source = pkg.files.get(fi)
            if source.ast == null {
                continue
            }
            val root = source.ast!!
            for decl in root.kids.items() {
                if !fn_is_test(decl) {
                    continue
                }
                val index = find_fn(L, decl)
                if index < 0 {
                    L.file = source.path
                    fail(L, decl, "test function was not lowered")
                    return
                }
                val tb = TestBind(decl: decl, index: index, file: source.path)
                tests.push(tb)
            }
        }
    }
    if tests.len == 0 {
        return
    }
    val unit = check.type_unit(L.types)
    var params = list.empty<*check.Type>()
    var contexts = list.empty<*check.Type>()
    val fn_ty = check.type_fn(L.types, params, unit, contexts, false, false, false)
    var empty_names = list.empty<str>()
    var c_name = strbuilder.empty()
    c_name.append("jog_")
    append_c_piece(&c_name, pkg_source(L, L.root_pkg!!))
    c_name.append("__0test")
    var jog_name = strbuilder.empty()
    jog_name.append(pkg_source(L, L.root_pkg!!))
    jog_name.append(".test")
    val index = ir.func_add(&L.module, c_name.str(), jog_name.str(), ir.linkages().INTERNAL, fn_ty, empty_names)
    if index < 0 {
        fail(L, null, "out of memory")
        return
    }
    L.module.main_func = index
    L.func = ir.func_at(&L.module, index as u32)
    L.locals = list.empty<LocalBind>()
    L.loops = list.empty<LoopFrame>()
    L.overlays = list.empty<Overlay>()
    L.cleanups = list.empty<Cleanup>()
    L.ctx_frames = list.empty<CtxFrame>()
    L.in_cleanup = false
    L.terminated = false
    L.ast_fn = null
    L.file = tests.get(0).file
    val entry = new_block(L, "entry")
    use_block(L, entry)
    val pos0 = node_pos(L, tests.get(0).decl)
    if L.func != null {
        L.func!!.pos = pos0
    }
    var i: usize = 0
    for i < tests.len && !L.failed {
        val tb = tests.get(i)
        L.file = tb.file
        val pos = node_pos(L, tb.decl)
        if pkg_loaded(L, "std.testing") {
            var note_args = list.empty<ir.Operand>()
            val str_ty = check.type_const_bytes(L.types)
            note_args.push(ir.string_op(str_ty as *check.Type?, tb.decl.name))
            emit_testing_named(L, "note", note_args, pos)
        }
        if L.failed {
            return
        }
        var args = list.empty<ir.Operand>()
        supply_test_args(L, tb.decl, tb.index, &args, pos)
        if L.failed {
            return
        }
        _ = emit_call_idx(L, tb.index, args, pos)
        i = i + 1
    }
    if !L.failed && pkg_loaded(L, "std.testing") {
        L.file = tests.get(0).file
        var report_args = list.empty<ir.Operand>()
        val i32_ty = check.type_i32(L.types)
        report_args.push(ir.int_op(i32_ty as *check.Type?, tests.len as i64))
        emit_testing_named(L, "report", report_args, pos0)
    }
    if !L.failed {
        emit_ret(L, none_value(), pos0)
    }
}
