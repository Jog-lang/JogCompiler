// Statement and expression lowering. Checked against compiler/src/lower.c.
// LowerGuide steps 2+.

import src.check
import src.ir
import src.load
import src.parse
import std.fs
import std.list
import std.mem
import std.strbuilder

// load used for is_symbol_variable / is_symbol_constant in lower_name

/** Locals that may be found by name when the symbol pointer was not recorded. */
private fn local_symbol_kind(sym: *load.Symbol): bool {
    return load.is_symbol_variable(sym) || load.is_symbol_constant(sym) || sym.kind == load.kind_parameter() ||
        sym.kind == load.kind_context()
}

private fn fn_body_node(node: *parse.Node): (*parse.Node?, bool, bool) {
    val shape = node.head
    val nparams = shape % 256
    val nctx = (shape / 256) % 256
    val has_recv = (shape / 65536) % 2 == 1
    val has_ret = (shape / 131072) % 2 == 1
    val has_body = (shape / 262144) % 2 == 1
    val expr_body = (shape / 524288) % 2 == 1
    val ntype = (shape / 1048576) % 256
    val nattrs = (shape / 268435456) % 256
    if !has_body {
        return null, false, false
    }
    var i: i64 = nattrs
    if has_recv {
        i = i + 1
    }
    i = i + ntype + nparams + nctx
    if has_ret {
        i = i + 1
    }
    if i < 0 || (i as usize) >= node.kids.len {
        return null, has_body, expr_body
    }
    return node.kids.get(i as usize) as *parse.Node?, has_body, expr_body
}

private fn fn_ret_type(fn_ty: *check.Type?): *check.Type? {
    if fn_ty == null || !check.type_is_fn(fn_ty!!) {
        return null
    }
    return fn_ty!!.elem
}

private fn is_unit_ty(ty: *check.Type?): bool {
    return ty == null || check.type_is_unit(ty!!)
}

private fn finish_open(L: *Lower, ret: *check.Type?, pos: ir.Pos) with (a: mem.Allocator) {
    if L.failed || L.terminated {
        return
    }
    // C finish_open: join root scope before the implicit return of main.
    lower_coro_on_exit(L, pos)
    if L.failed || L.terminated {
        return
    }
    if is_unit_ty(ret) {
        emit_ret(L, none_value(), pos)
        return
    }
    var term = ir.empty_term()
    term.kind = ir.term_kinds().UNREACHABLE
    term.pos = pos
    ir.terminate(L.func!!, L.block, term)
    L.terminated = true
}

private fn bind_params(L: *Lower, fn_node: *parse.Node) with (a: mem.Allocator) {
    val shape = fn_node.head
    val nparams = shape % 256
    val nctx = (shape / 256) % 256
    val has_recv = (shape / 65536) % 2 == 1
    val nattrs = (shape / 268435456) % 256
    val ntype = (shape / 1048576) % 256
    var slot: u32 = 0
    var i: i64 = nattrs
    if has_recv {
        if (i as usize) < fn_node.kids.len {
            val recv = fn_node.kids.get(i as usize)
            val sym = check.get_node_sym(recv)
            if sym != null {
                bind_local(L, sym, 0)
            }
        }
        slot = 1
        i = i + 1
    }
    i = i + ntype
    var p: i64 = 0
    for p < nparams {
        if (i as usize) < fn_node.kids.len {
            val param = fn_node.kids.get(i as usize)
            val sym = check.get_node_sym(param)
            if sym != null {
                bind_local(L, sym, slot + (p as u32))
            }
        }
        i = i + 1
        p = p + 1
    }
    var base = slot + (nparams as u32)
    var c: i64 = 0
    for c < nctx {
        if (i as usize) < fn_node.kids.len {
            val param = fn_node.kids.get(i as usize)
            val sym = check.get_node_sym(param)
            val local = base + (c as u32)
            if sym != null {
                bind_local(L, sym, local)
            }
            // Context params are ordinary IR locals and live context frames, so
            // calls and `go` children can resolve them (Friction go-with).
            var ty = check.get_node_ty(param)
            if ty == null && sym != null {
                ty = check.get_sema(sym!!)
            }
            context_push_local(L, ty, local)
        }
        i = i + 1
        c = c + 1
    }
}

fn lower_body(L: *Lower, fn_node: *parse.Node) with (a: mem.Allocator) {
    L.locals = list.empty<LocalBind>()
    L.loops = list.empty<LoopFrame>()
    L.cleanups = list.empty<Cleanup>()
    L.ctx_frames = list.empty<CtxFrame>()
    L.in_cleanup = false
    L.terminated = false
    L.unchecked = false
    if parse.flag_has_word(fn_node.flag, "extern") {
        return
    }
    val (body, has_body, expr_body) = fn_body_node(fn_node)
    if !has_body || body == null {
        fail(L, fn_node, "function has no body")
        return
    }
    val entry = new_block(L, "entry")
    use_block(L, entry)
    L.ast_fn = fn_node as *parse.Node?
    bind_params(L, fn_node)
    val fn_ty = L.func!!.ty
    val ret = fn_ret_type(fn_ty)
    if expr_body {
        val value = lower_expr(L, body!!)
        if !L.terminated && !L.failed {
            if is_unit_ty(ret) {
                emit_ret(L, none_value(), node_pos(L, body!!))
            } else {
                emit_ret(L, value, node_pos(L, body!!))
            }
        }
        L.ast_fn = null
        return
    }
    lower_block(L, body!!)
    finish_open(L, ret, node_pos(L, fn_node))
    L.ast_fn = null
}

fn lower_decl_body(L: *Lower, decl: *parse.Node) with (a: mem.Allocator) {
    if L.failed {
        return
    }
    if parse.is_fn(decl) {
        val ntype = (decl.head / 1048576) % 256
        if ntype > 0 {
            return
        }
        val sym = check.get_node_sym(decl)
        if sym != null && check.sym_type_param_count(sym!!) > 0 {
            return
        }
        val index = find_fn(L, decl)
        if index < 0 {
            return
        }
        // Already lowered on-demand during comptime_vals ensure.
        var bi: usize = 0
        for bi < L.fns.len {
            if L.fns.at(bi).index == index {
                if L.fns.at(bi).body_done {
                    return
                }
                break
            }
            bi = bi + 1
        }
        L.func = ir.func_at(&L.module, index as u32)
        if L.func == null {
            fail(L, decl, "missing lowered function")
            return
        }
        if L.func!!.blocks.len > 0 {
            bi = 0
            for bi < L.fns.len {
                if L.fns.at(bi).index == index {
                    L.fns.at(bi).body_done = true
                    break
                }
                bi = bi + 1
            }
            return
        }
        lower_body(L, decl)
        bi = 0
        for bi < L.fns.len {
            if L.fns.at(bi).index == index {
                L.fns.at(bi).body_done = true
                break
            }
            bi = bi + 1
        }
        return
    }
    if parse.is_extern_block(decl) {
        for kid in decl.kids.items() {
            if parse.is_fn(kid) {
                // Extern: declaration only, no body.
            }
        }
        return
    }
}

fn lower_block(L: *Lower, block: *parse.Node) with (a: mem.Allocator) {
    if !parse.is_block(block) {
        fail(L, block, "expected a block")
        return
    }
    val base = L.cleanups.len
    for stmt in block.kids.items() {
        if L.failed || L.terminated {
            break
        }
        lower_stmt(L, stmt)
    }
    lower_error_block_end(L, base, node_pos(L, block))
}

fn lower_stmt(L: *Lower, node: *parse.Node) with (a: mem.Allocator) {
    if L.failed || L.terminated {
        return
    }
    if parse.is_val(node) || parse.is_var(node) {
        lower_binding(L, node)
        return
    }
    if parse.is_defer(node) || parse.is_errdefer(node) {
        lower_error_note(L, node)
        return
    }
    if parse.is_return(node) {
        lower_error_return(L, node)
        return
    }
    if parse.is_if(node) {
        lower_if_stmt(L, node)
        return
    }
    if parse.is_expr_stmt(node) {
        if node.kids.len > 0 {
            val expr = node.kids.get(0)
            // Parser wraps bare `if` / `for` / `when` in EXPR_STMT.
            if parse.is_if(expr) {
                lower_if_stmt(L, expr)
            } else if parse.is_for(expr) {
                lower_for(L, expr)
            } else if parse.is_when(expr) {
                val (_, iface_wok) = lower_iface_when(L, expr, false)
                if !iface_wok {
                    lower_enum_when(L, expr, false)
                }
            } else if parse.is_with(expr) {
                lower_context_with(L, expr)
            } else {
                lower_expr(L, expr)
            }
        }
        return
    }
    if parse.is_block(node) {
        lower_block(L, node)
        return
    }
    if parse.is_assign_stmt(node) {
        lower_assign(L, node)
        return
    }
    if parse.is_destructure(node) {
        lower_destructure(L, node)
        return
    }
    if parse.is_break(node) || parse.is_continue(node) {
        if L.loops.len == 0 {
            if parse.is_break(node) {
                fail(L, node, "break outside of a loop")
            } else {
                fail(L, node, "continue outside of a loop")
            }
            return
        }
        val frame = L.loops.at(L.loops.len - 1)
        var target = frame.cont
        if parse.is_break(node) {
            target = frame.brk
        }
        lower_error_exit(L, frame.cleanup_base, target, node_pos(L, node))
        return
    }
    if parse.is_for(node) {
        lower_for(L, node)
        return
    }
    if parse.is_with(node) {
        lower_context_with(L, node)
        return
    }
    if parse.is_context(node) {
        lower_context_binding(L, node)
        return
    }
    // Fall through: treat as expression statement shape used by some stmts.
    lower_expr(L, node)
}

private fn binding_init(node: *parse.Node): *parse.Node? {
    // VAL/VAR: kids after optional type annotation hold the initializer.
    // Multi-bind uses empty `name` and space-separated `text` (`var (a, b)`).
    if node.name.len == 0 && node.text.len == 0 {
        return null
    }
    if node.kids.len == 0 {
        return null
    }
    if node.kids.len == 1 {
        // Could be type-only or init-only; checker required init for val.
        val only = node.kids.get(0)
        if parse.is_type_name(only) || parse.is_type_ptr(only) || parse.is_type_slice(only) ||
            parse.is_type_array(only) || parse.is_type_option(only) || parse.is_type_tuple(only) ||
            parse.is_type_fn(only) || parse.is_type_unit(only) {
            return null
        }
        return only as *parse.Node?
    }
    return node.kids.get(node.kids.len - 1) as *parse.Node?
}

private fn type_has_zero(ty: *check.Type?): bool {
    if ty == null {
        return false
    }
    return check.type_has_zero(ty!!)
}

private fn lower_binding(L: *Lower, node: *parse.Node) with (a: mem.Allocator) {
    if check.binding_is_multi(node) {
        lower_error_binding(L, node)
        return
    }
    val ty = check.get_node_ty(node)
    val sym = check.get_node_sym(node)
    var name = node.name
    if name.len == 0 && node.text.len > 0 {
        name = node.text
    }
    if name == "_" {
        name = ""
    }
    val local = new_local(L, name, ty)
    bind_local(L, sym, local)
    val init = binding_init(node)
    if init != null {
        var value = lower_expr(L, init!!)
        // Binding annotation may leave the init node typed as the concrete
        // source (`&c` as *Circle while the local is Shape); convert here.
        if ty != null && ty!!.kind == check.type_kinds().INTERFACE && user_iface_ty(ty) &&
            (value.ty == null || value.ty!!.kind != check.type_kinds().INTERFACE) &&
            value.kind != ir.operand_kinds().NONE {
            value = lower_iface_convert(L, value, ty!!, node_pos(L, init!!))
        }
        if !L.terminated {
            emit_copy(L, local, value, node_pos(L, node))
        }
        return
    }
    if type_has_zero(ty) {
        emit_inst(L, ir.op_kinds().ZERO, local as i32, node_pos(L, node))
    }
}

private fn lower_return(L: *Lower, node: *parse.Node) with (a: mem.Allocator) {
    if node.kids.len == 0 {
        emit_ret(L, none_value(), node_pos(L, node))
        return
    }
    if node.kids.len == 1 {
        val value = lower_expr(L, node.kids.get(0))
        if !L.terminated {
            emit_ret(L, value, node_pos(L, node))
        }
        return
    }
    // Multi-value return → aggregate of the function return type.
    var args = list.empty<ir.Operand>()
    for kid in node.kids.items() {
        args.push(lower_expr(L, kid))
        if L.failed || L.terminated {
            return
        }
    }
    val ret = fn_ret_type(L.func!!.ty)
    val value = emit_aggregate(L, ret, args, node_pos(L, node))
    if !L.terminated {
        emit_ret(L, value, node_pos(L, node))
    }
}

private fn lower_if_stmt(L: *Lower, node: *parse.Node) with (a: mem.Allocator) {
    if node.kids.len == 0 {
        fail(L, node, "missing condition")
        return
    }
    val cond = lower_expr(L, node.kids.get(0))
    val then_b = new_block(L, "if.then")
    val join = new_block(L, "if.join")
    var else_b = join
    val has_else = node.kids.len > 2
    if has_else {
        else_b = new_block(L, "if.else")
        emit_cond(L, cond, then_b, else_b, node_pos(L, node))
    } else {
        emit_cond(L, cond, then_b, join, node_pos(L, node))
    }
    use_block(L, then_b)
    if node.kids.len > 1 {
        val then_block = node.kids.get(1)
        if parse.is_block(then_block) {
            lower_block(L, then_block)
        }
    }
    if !L.terminated {
        emit_br(L, join, node_pos(L, node))
    }
    if has_else {
        use_block(L, else_b)
        val else_branch = node.kids.get(2)
        if parse.is_if(else_branch) {
            lower_if_stmt(L, else_branch)
        } else if parse.is_block(else_branch) {
            lower_block(L, else_branch)
        }
        if !L.terminated {
            emit_br(L, join, node_pos(L, node))
        }
    }
    use_block(L, join)
}

private fn lower_if_expr(L: *Lower, node: *parse.Node): ir.Operand with (a: mem.Allocator) {
    val ty = check.get_node_ty(node)
    val result = new_local(L, "", ty)
    val cond = lower_expr(L, node.kids.get(0))
    val then_b = new_block(L, "if.then")
    val else_b = new_block(L, "if.else")
    val join = new_block(L, "if.join")
    emit_cond(L, cond, then_b, else_b, node_pos(L, node))
    use_block(L, then_b)
    if node.kids.len > 1 {
        val then_v = lower_block_value(L, node.kids.get(1))
        if !L.terminated {
            emit_copy(L, result, then_v, node_pos(L, node))
            emit_br(L, join, node_pos(L, node))
        }
    }
    use_block(L, else_b)
    if node.kids.len > 2 {
        val else_branch = node.kids.get(2)
        var else_v = none_value()
        if parse.is_if(else_branch) {
            else_v = lower_if_expr(L, else_branch)
        } else {
            else_v = lower_block_value(L, else_branch)
        }
        if !L.terminated {
            emit_copy(L, result, else_v, node_pos(L, node))
            emit_br(L, join, node_pos(L, node))
        }
    }
    use_block(L, join)
    return local_operand(L, result)
}

fn lower_block_value(L: *Lower, block: *parse.Node): ir.Operand with (a: mem.Allocator) {
    if parse.is_block(block) {
        if block.kids.len == 0 {
            return none_value()
        }
        var i: usize = 0
        for i + 1 < block.kids.len {
            if L.failed || L.terminated {
                return none_value()
            }
            lower_stmt(L, block.kids.get(i))
            i = i + 1
        }
        val last = block.kids.get(block.kids.len - 1)
        if parse.is_expr_stmt(last) && last.kids.len > 0 {
            return lower_expr(L, last.kids.get(0))
        }
        return lower_expr(L, last)
    }
    return lower_expr(L, block)
}

fn assign_base_binop(text: str): (ir.BinOp, bool, bool) {
    val b = ir.bin_ops()
    if text == "+=" {
        return b.ADD, true, true
    }
    if text == "-=" {
        return b.SUB, true, true
    }
    if text == "*=" {
        return b.MUL, true, true
    }
    if text == "/=" {
        return b.DIV, true, true
    }
    if text == "%=" {
        return b.REM, true, true
    }
    if text == "&=" {
        return b.AND, false, true
    }
    if text == "|=" {
        return b.OR, false, true
    }
    if text == "^=" {
        return b.XOR, false, true
    }
    if text == "<<=" {
        return b.SHL, true, true
    }
    if text == ">>=" {
        return b.SHR, true, true
    }
    return b.ADD, false, false
}

private fn hold_local(L: *Lower, src: ir.Operand, ty: *check.Type?, pos: ir.Pos): ir.Operand with (a: mem.Allocator) {
    // C `hold` always allocates a fresh local and copies (even if src is already local).
    var use_ty = ty
    if use_ty == null {
        use_ty = src.ty
    }
    val dst = new_local(L, "", use_ty)
    emit_copy(L, dst, src, pos)
    return local_operand(L, dst)
}

private fn is_discard_ident(node: *parse.Node): bool {
    if !parse.is_ident(node) {
        return false
    }
    if node.name == "_" {
        return true
    }
    return node.text == "_"
}

private fn store_destructure_list(
    L: *Lower,
    targets: list.List<*parse.Node>,
    tuple: ir.Operand,
    tuple_ty: *check.Type?,
) with (a: mem.Allocator) {
    if L.failed || L.terminated {
        return
    }
    val tk = check.type_kinds()
    if tuple_ty == null || tuple_ty!!.kind != tk.TUPLE {
        fail(L, targets.get(0), "destructuring is missing a tuple type")
        return
    }
    var i: usize = 0
    for i < targets.len {
        if L.failed || L.terminated {
            return
        }
        val target = targets.get(i)
        if is_discard_ident(target) {
            i = i + 1
            continue
        }
        var elem_ty: *check.Type? = null
        if tuple_ty!!.elems.len > i {
            elem_ty = tuple_ty!!.elems.get(i)
        }
        if elem_ty == null {
            elem_ty = check.get_node_ty(target)
        }
        val tpos = node_pos(L, target)
        val field = emit_extract(L, tuple, i as u32, elem_ty, tpos)
        if parse.is_tuple(target) {
            store_destructure_list(L, target.kids, field, elem_ty)
            i = i + 1
            continue
        }
        store_destructure_one(L, target, field)
        i = i + 1
    }
}

private fn store_destructure_one(L: *Lower, target: *parse.Node, value: ir.Operand) with (a: mem.Allocator) {
    if L.failed || L.terminated {
        return
    }
    val tpos = node_pos(L, target)
    if parse.is_ident(target) {
        var name = target.name
        if name.len == 0 {
            name = target.text
        }
        var local: u32 = 0
        var ok = false
        val sym = check.get_node_sym(target)
        if sym != null {
            val (found, hit) = find_local(L, sym!!)
            local = found
            ok = hit
            // Multi-bind did not record the symbol; match by the symbol's name.
            if !ok && local_symbol_kind(sym!!) && sym!!.name.len > 0 {
                val (found2, hit2) = find_local_by_name(L, sym!!.name)
                local = found2
                ok = hit2
                if ok {
                    bind_local(L, sym, local)
                }
            }
        }
        if !ok && name.len > 0 {
            val (found, hit) = find_local_by_name(L, name)
            local = found
            ok = hit
        }
        if ok {
            emit_copy(L, local, value, tpos)
            return
        }
        fail(L, target, "missing local")
        return
    }
    // Complex targets: store through address (C routes via fake assign).
    val ptr = value_addr(L, target)
    if !L.terminated {
        emit_store(L, ptr, value, tpos)
    }
}

private fn lower_destructure(L: *Lower, node: *parse.Node) with (a: mem.Allocator) {
    // DESTRUCTURE: head = N targets; kids[0..N) targets; kids[N] = RHS.
    val n = node.head as usize
    if n == 0 || node.kids.len <= n {
        fail(L, node, "bad destructure")
        return
    }
    val rhs_node = node.kids.get(n)
    val rhs = lower_expr(L, rhs_node)
    if L.failed || L.terminated {
        return
    }
    var tuple_ty = check.get_node_ty(rhs_node)
    if tuple_ty == null {
        tuple_ty = rhs.ty
    }
    // C `hold`: always copy RHS into a fresh local at the destructure/`=` pos.
    val held = hold_local(L, rhs, tuple_ty, node_pos(L, node))
    var targets = list.empty<*parse.Node>()
    var i: usize = 0
    for i < n {
        targets.push(node.kids.get(i))
        i = i + 1
    }
    store_destructure_list(L, targets, held, tuple_ty)
}

private fn lower_assign(L: *Lower, node: *parse.Node) with (a: mem.Allocator) {
    if node.kids.len < 2 {
        fail(L, node, "missing assignment")
        return
    }
    if lower_iface_store(L, node) {
        return
    }
    if lower_package_view_assign(L, node) {
        return
    }
    if lower_memory_assign(L, node) {
        return
    }
    if lower_coro_store(L, node) {
        return
    }
    val target = node.kids.get(0)
    val rhs_node = node.kids.get(1)
    if parse.is_ident(target) {
        if target.name == "_" || target.text == "_" {
            lower_expr(L, rhs_node)
            return
        }
        val sym = check.get_node_sym(target)
        if sym != null {
            var local: u32 = 0
            var ok = false
            val (by_sym, sym_ok) = find_local(L, sym!!)
            if sym_ok {
                local = by_sym
                ok = true
            } else if local_symbol_kind(sym!!) {
                // Same fallback as lower_name: LocalBind may miss the pointer.
                val (by_name, name_ok) = find_local_by_name(L, sym!!.name)
                if name_ok {
                    local = by_name
                    ok = true
                }
            }
            if !ok && L.in_lambda {
                val (slot, cap_ok) = lambda_cap_slot(L, sym!!)
                if cap_ok {
                    val value = lower_expr(L, rhs_node)
                    if !L.terminated {
                        store_lambda_cap(L, target, slot, sym!!, value)
                    }
                    return
                }
            }
            if ok {
                var value = none_value()
                if node.text != "=" && node.text.len > 0 {
                    val (bin, checked, ok_op) = assign_base_binop(node.text)
                    if !ok_op {
                        fail(L, node, "assignment not lowered yet")
                        return
                    }
                    // C: copy local to a temp before RHS so `a += e` matches `a = a + e`.
                    val lhs = local_operand(L, local)
                    val ty = check.get_node_ty(target)
                    val saved = new_local(L, "", lhs.ty)
                    emit_copy(L, saved, lhs, node_pos(L, node))
                    val rhs = lower_expr(L, rhs_node)
                    value = emit_binop(L, bin, checked, local_operand(L, saved), rhs, ty, node_pos(L, node))
                } else {
                    value = lower_expr(L, rhs_node)
                }
                if !L.terminated {
                    emit_copy(L, local, value, node_pos(L, node))
                }
                return
            }
            var gindex = find_global(L, sym!!)
            if gindex < 0 {
                var gname = target.name
                if gname.len == 0 {
                    gname = target.text
                }
                if gname.len == 0 {
                    gname = sym!!.name
                }
                gindex = find_global_by_name(L, gname)
            }
            if gindex >= 0 {
                var value = none_value()
                if node.text != "=" && node.text.len > 0 {
                    val (bin, checked, ok_op) = assign_base_binop(node.text)
                    if !ok_op {
                        fail(L, node, "assignment not lowered yet")
                        return
                    }
                    val lhs = load_global(L, gindex as u32, node_pos(L, node))
                    val rhs = lower_expr(L, rhs_node)
                    val ty = check.get_node_ty(target)
                    value = emit_binop(L, bin, checked, lhs, rhs, ty, node_pos(L, node))
                } else {
                    value = lower_expr(L, rhs_node)
                }
                if !L.terminated {
                    store_global(L, gindex as u32, value, node_pos(L, node))
                }
                return
            }
        } else {
            var gname = target.name
            if gname.len == 0 {
                gname = target.text
            }
            val gindex = find_global_by_name(L, gname)
            if gindex >= 0 {
                val value = lower_expr(L, rhs_node)
                if !L.terminated {
                    store_global(L, gindex as u32, value, node_pos(L, node))
                }
                return
            }
        }
    }
    fail(L, node, "assignment not lowered yet")
}

fn push_loop(L: *Lower, cont: u32, brk: u32) with (a: mem.Allocator) {
    var frame: LoopFrame
    frame.cont = cont
    frame.brk = brk
    frame.cleanup_base = L.cleanups.len
    L.loops.push(frame)
}

private fn pop_loop(L: *Lower) {
    if L.loops.len > 0 {
        L.loops.pop()
    }
}

fn for_body(node: *parse.Node): *parse.Node? {
    if node.text == "forever" {
        if node.kids.len > 0 {
            return node.kids.get(0) as *parse.Node?
        }
        return null
    }
    if node.kids.len >= 2 {
        return node.kids.get(1) as *parse.Node?
    }
    return null
}

/** Collection for-in layout (slice/bytes/array/[N]byte). Matches C collection_layout. */
private fn collection_layout(
    L: *Lower,
    base_in: *check.Type?,
): (*check.Type?, *check.Type?, bool, u64, bool) with (a: mem.Allocator) {
    if base_in == null {
        return null, null, false, 0, false
    }
    var base = base_in!!
    val view_b = check.type_bytes_view(base)
    if base.kind == check.type_kinds().DISTINCT && view_b != null {
        base = view_b!!
    }
    val tk = check.type_kinds()
    if base.kind == tk.SLICE {
        if base.elem == null {
            return null, null, false, 0, false
        }
        val ptr_ty = check.type_ptr(L.types, base.elem!!, base.is_const) as *check.Type?
        return base.elem, ptr_ty, true, 0, true
    }
    if base.kind == tk.BYTES {
        val byte = check.type_bytes_n(L.types, 1) as *check.Type?
        if byte == null {
            return null, null, false, 0, false
        }
        val ptr_ty = check.type_ptr(L.types, byte!!, base.is_const) as *check.Type?
        return byte, ptr_ty, true, 0, true
    }
    if base.kind == tk.ARRAY {
        if base.elem == null {
            return null, null, false, 0, false
        }
        val ptr_ty = check.type_ptr(L.types, base.elem!!, false) as *check.Type?
        return base.elem, ptr_ty, false, base.len, true
    }
    if base.kind == tk.BYTES_N {
        val byte = check.type_bytes_n(L.types, 1) as *check.Type?
        if byte == null {
            return null, null, false, 0, false
        }
        val ptr_ty = check.type_ptr(L.types, byte!!, false) as *check.Type?
        return byte, ptr_ty, false, base.len, true
    }
    return null, null, false, 0, false
}

private fn is_collection_type(ty: *check.Type?): bool {
    if ty == null {
        return false
    }
    val tk = check.type_kinds()
    val view = check.type_bytes_view(ty!!)
    if ty!!.kind == tk.DISTINCT && view != null {
        return true
    }
    return ty!!.kind == tk.ARRAY || ty!!.kind == tk.SLICE || ty!!.kind == tk.BYTES || ty!!.kind == tk.BYTES_N
}

private fn emit_addr_into(L: *Lower, dst: u32, local: u32, pos: ir.Pos) with (a: mem.Allocator) {
    val inst = emit_inst(L, ir.op_kinds().ADDR, dst as i32, pos)
    if inst != null {
        inst!!.a = ir.local_op(L.func!!, local)
    }
}

private fn emit_bitcast_into(L: *Lower, dst: u32, src: ir.Operand, pos: ir.Pos) with (a: mem.Allocator) {
    val inst = emit_inst(L, ir.op_kinds().BITCAST, dst as i32, pos)
    if inst != null {
        inst!!.a = src
    }
}

private fn emit_load_into(L: *Lower, dst: u32, ptr: ir.Operand, pos: ir.Pos) with (a: mem.Allocator) {
    val inst = emit_inst(L, ir.op_kinds().LOAD, dst as i32, pos)
    if inst != null {
        inst!!.a = ptr
    }
}

private fn emit_elem_addr_into(L: *Lower, dst: u32, base: ir.Operand, index: ir.Operand, pos: ir.Pos) with (a: mem.Allocator) {
    val inst = emit_inst(L, ir.op_kinds().ELEM_ADDR, dst as i32, pos)
    if inst != null {
        inst!!.a = base
        inst!!.b = index
    }
}

/** for x in xs / for i, x in xs. Matches C lower_collection_for. */
private fn lower_collection_for(L: *Lower, node: *parse.Node) with (a: mem.Allocator) {
    val pos = node_pos(L, node)
    val expr = node.kids.get(0)
    var base = check.get_node_ty(expr)
    val (elem, ptr_ty, view, n, ok) = collection_layout(L, base)
    if !ok {
        if L.failed {
            return
        }
        if is_collection_type(base) {
            fail(L, node, "out of memory")
        } else {
            fail(L, node, "for-in over a collection is not lowered yet")
        }
        return
    }
    val usize_ty = check.type_usize(L.types) as *check.Type?
    val boolean = check.type_bool(L.types) as *check.Type?
    if usize_ty == null || boolean == null || elem == null || ptr_ty == null {
        fail(L, node, "out of memory")
        return
    }
    val two = node.flag.len > 0
    var index_name = ""
    var elem_name = ""
    var elem_sym: *load.Symbol? = null
    if two {
        if node.name.len > 0 && node.name != "_" {
            index_name = node.name
        }
        if node.flag != "_" {
            elem_name = node.flag
            elem_sym = check.get_node_sym(node)
        }
    } else {
        if node.name.len > 0 && node.name != "_" {
            elem_name = node.name
            elem_sym = check.get_node_sym(node)
        }
    }
    val value = lower_expr(L, expr)
    if L.failed || value.kind == ir.operand_kinds().NONE {
        return
    }
    // Peel DISTINCT→BYTES for the saved local type (matches C jog_lower_type after bytes_view).
    var saved_ty = base
    if base != null {
        val vb = check.type_bytes_view(base!!)
        if base!!.kind == check.type_kinds().DISTINCT && vb != null {
            saved_ty = vb
        }
    }
    val saved = new_local(L, "", saved_ty)
    val index_l = new_local(L, index_name, usize_ty)
    val len_l = new_local(L, "", usize_ty)
    emit_copy(L, saved, value, pos)
    // Index has no node.sym when two names (elem overwrites); bind by local name.
    bind_local(L, null, index_l)
    var elem_l: u32 = 0
    var ptr_l: u32 = 0
    var at_l: u32 = 0
    if elem_sym != null || elem_name.len > 0 {
        var ename = elem_name
        if elem_sym != null {
            ename = elem_sym!!.name
        }
        elem_l = new_local(L, ename, elem)
        ptr_l = new_local(L, "", ptr_ty)
        at_l = new_local(L, "", ptr_ty)
        bind_local(L, elem_sym, elem_l)
    }
    val need_elem = elem_sym != null || elem_name.len > 0
    if view && saved_ty != null && saved_ty!!.kind == check.type_kinds().BYTES {
        if need_elem {
            val u8t = check.type_u8(L.types)
            val raw_ty = check.type_ptr(L.types, u8t, saved_ty!!.is_const) as *check.Type?
            if raw_ty == null {
                fail(L, node, "out of memory")
                return
            }
            val raw_l = new_local(L, "", raw_ty)
            emit_extract_into(L, raw_l, local_operand(L, saved), 0, pos)
            emit_bitcast_into(L, ptr_l, local_operand(L, raw_l), pos)
        }
    } else if view {
        if need_elem {
            emit_extract_into(L, ptr_l, local_operand(L, saved), 0, pos)
        }
    } else if need_elem {
        val addr_ty = check.type_ptr(L.types, saved_ty!!, false) as *check.Type?
        if addr_ty == null {
            fail(L, node, "out of memory")
            return
        }
        val addr_l = new_local(L, "", addr_ty)
        emit_addr_into(L, addr_l, saved, pos)
        emit_bitcast_into(L, ptr_l, local_operand(L, addr_l), pos)
    }
    if view {
        emit_extract_into(L, len_l, local_operand(L, saved), 1, pos)
    } else {
        emit_copy(L, len_l, ir.int_op(usize_ty, n as i64), pos)
    }
    emit_copy(L, index_l, ir.int_op(usize_ty, 0), pos)
    val head = new_block(L, "for.head")
    val body = new_block(L, "for.body")
    val step = new_block(L, "for.step")
    val exit_b = new_block(L, "for.exit")
    emit_br(L, head, pos)
    use_block(L, head)
    val cmp = emit_binop(
        L,
        ir.bin_ops().LT,
        false,
        local_operand(L, index_l),
        local_operand(L, len_l),
        boolean,
        pos,
    )
    emit_cond(L, cmp, body, exit_b, pos)
    use_block(L, body)
    if need_elem {
        emit_elem_addr_into(L, at_l, local_operand(L, ptr_l), local_operand(L, index_l), pos)
        emit_load_into(L, elem_l, local_operand(L, at_l), pos)
    }
    push_loop(L, step, exit_b)
    val body_node = for_body(node)
    if body_node != null {
        lower_block(L, body_node!!)
    }
    pop_loop(L)
    if !L.terminated {
        emit_br(L, step, pos)
    }
    use_block(L, step)
    val next = emit_binop(
        L,
        ir.bin_ops().ADD,
        true,
        local_operand(L, index_l),
        ir.int_op(usize_ty, 1),
        usize_ty,
        pos,
    )
    emit_copy(L, index_l, next, pos)
    emit_br(L, head, pos)
    use_block(L, exit_b)
}

private fn lower_for(L: *Lower, node: *parse.Node) with (a: mem.Allocator) {
    if lower_chan_for(L, node) {
        return
    }
    val pos = node_pos(L, node)
    if node.text == "in" && node.kids.len > 0 {
        val range = node.kids.get(0)
        if node.flag.len == 0 && parse.is_binary(range) && range.text == ".." && range.kids.len >= 2 {
            val sym = check.get_node_sym(node)
            var elem = check.get_node_ty(range)
            if sym != null {
                val st = check.get_sema(sym!!)
                if st != null {
                    elem = st
                }
            }
            if elem == null && range.kids.len > 0 {
                elem = check.get_node_ty(range.kids.get(0))
            }
            val start = lower_expr(L, range.kids.get(0))
            val end = lower_expr(L, range.kids.get(1))
            var iname = node.name
            if iname == "_" {
                iname = ""
            }
            val index = new_local(L, iname, elem)
            val end_local = new_local(L, "", elem)
            bind_local(L, sym, index)
            emit_copy(L, index, start, pos)
            emit_copy(L, end_local, end, pos)
            val head = new_block(L, "for.head")
            val body = new_block(L, "for.body")
            val step = new_block(L, "for.step")
            val exit_b = new_block(L, "for.exit")
            emit_br(L, head, pos)
            use_block(L, head)
            val boolean = check.type_bool(L.types)
            val cmp = emit_binop(
                L,
                ir.bin_ops().LT,
                false,
                local_operand(L, index),
                local_operand(L, end_local),
                boolean as *check.Type?,
                pos,
            )
            emit_cond(L, cmp, body, exit_b, pos)
            use_block(L, body)
            push_loop(L, step, exit_b)
            val body_node = for_body(node)
            if body_node != null {
                lower_block(L, body_node!!)
            }
            pop_loop(L)
            if !L.terminated {
                emit_br(L, step, pos)
            }
            use_block(L, step)
            val next = emit_binop(
                L,
                ir.bin_ops().ADD,
                true,
                local_operand(L, index),
                ir.int_op(elem, 1),
                elem,
                pos,
            )
            emit_copy(L, index, next, pos)
            emit_br(L, head, pos)
            use_block(L, exit_b)
            return
        }
        lower_collection_for(L, node)
        return
    }
    if node.text == "forever" {
        val head = new_block(L, "for.head")
        val exit_b = new_block(L, "for.exit")
        emit_br(L, head, pos)
        use_block(L, head)
        push_loop(L, head, exit_b)
        val body_node = for_body(node)
        if body_node != null {
            lower_block(L, body_node!!)
        }
        pop_loop(L)
        if !L.terminated {
            emit_br(L, head, pos)
        }
        use_block(L, exit_b)
        return
    }
    // Condition for.
    val head = new_block(L, "for.head")
    val body = new_block(L, "for.body")
    val exit_b = new_block(L, "for.exit")
    emit_br(L, head, pos)
    use_block(L, head)
    if node.kids.len > 0 {
        val cond = lower_expr(L, node.kids.get(0))
        emit_cond(L, cond, body, exit_b, pos)
    } else {
        emit_br(L, body, pos)
    }
    use_block(L, body)
    push_loop(L, head, exit_b)
    val body_node = for_body(node)
    if body_node != null {
        lower_block(L, body_node!!)
    }
    pop_loop(L)
    if !L.terminated {
        emit_br(L, head, pos)
    }
    use_block(L, exit_b)
}

fn emit_binop(
    L: *Lower,
    bin: ir.BinOp,
    checked: bool,
    lhs: ir.Operand,
    rhs: ir.Operand,
    result_ty: *check.Type?,
    pos: ir.Pos,
): ir.Operand with (a: mem.Allocator) {
    // C emit_binop keeps constants as operands (no as_local).
    val dst = new_local(L, "", result_ty)
    val inst = emit_inst(L, ir.op_kinds().BINARY, dst as i32, pos)
    if inst != null {
        inst!!.aux = ir.binop_aux(bin)
        inst!!.checked = checked
        inst!!.a = lhs
        inst!!.b = rhs
    }
    return local_operand(L, dst)
}

fn emit_unop(
    L: *Lower,
    un: ir.UnOp,
    checked: bool,
    src: ir.Operand,
    result_ty: *check.Type?,
    pos: ir.Pos,
): ir.Operand with (a: mem.Allocator) {
    val dst = new_local(L, "", result_ty)
    val inst = emit_inst(L, ir.op_kinds().UNARY, dst as i32, pos)
    if inst != null {
        inst!!.aux = ir.unop_aux(un)
        inst!!.checked = checked
        inst!!.a = src
    }
    return local_operand(L, dst)
}

// str / bytes compare by length, then by bytes. Matches C lower_bytes_cmp.
fn lower_bytes_cmp(
    L: *Lower,
    lhs_in: ir.Operand,
    rhs_in: ir.Operand,
    negate: bool,
    pos: ir.Pos,
): ir.Operand with (a: mem.Allocator) {
    val boolean = check.type_bool(L.types) as *check.Type?
    val usize_ty = check.type_usize(L.types) as *check.Type?
    val u8_ty = check.type_u8(L.types) as *check.Type?
    var bytes: *check.Type? = null
    if lhs_in.ty != null {
        bytes = check.type_bytes_view(lhs_in.ty!!)
    }
    if bytes == null && rhs_in.ty != null {
        bytes = check.type_bytes_view(rhs_in.ty!!)
    }
    if boolean == null || usize_ty == null || u8_ty == null || bytes == null {
        fail(L, null, "bytes compare needs types")
        return none_value()
    }
    val ptr_ty = check.type_ptr(L.types, u8_ty!!, bytes!!.is_const) as *check.Type?
    val lhs = as_local(L, lhs_in, pos)
    val rhs = as_local(L, rhs_in, pos)
    val result = new_local(L, "", boolean)
    val index = new_local(L, "", usize_ty)
    val len_l = new_local(L, "", usize_ty)
    val ptr_l = new_local(L, "", ptr_ty)
    val len_r = new_local(L, "", usize_ty)
    val ptr_r = new_local(L, "", ptr_ty)
    // Extract ptr then len (C emit order); locals were allocated len then ptr.
    emit_extract_into(L, ptr_l, lhs, 0, pos)
    emit_extract_into(L, len_l, lhs, 1, pos)
    emit_extract_into(L, ptr_r, rhs, 0, pos)
    emit_extract_into(L, len_r, rhs, 1, pos)
    emit_copy(L, index, ir.int_op(usize_ty, 0), pos)
    val len_eq = emit_binop(L, ir.bin_ops().EQ, false, local_operand(L, len_l), local_operand(L, len_r), boolean, pos)
    val loop_b = new_block(L, "eq.loop")
    val cmp_b = new_block(L, "eq.cmp")
    val step_b = new_block(L, "eq.step")
    val yes_b = new_block(L, "eq.yes")
    val no_b = new_block(L, "eq.no")
    val join_b = new_block(L, "eq.join")
    emit_cond(L, len_eq, loop_b, no_b, pos)
    use_block(L, loop_b)
    val done = emit_binop(L, ir.bin_ops().EQ, false, local_operand(L, index), local_operand(L, len_l), boolean, pos)
    emit_cond(L, done, yes_b, cmp_b, pos)
    use_block(L, cmp_b)
    val addr_l = new_local(L, "", ptr_ty)
    val addr_r = new_local(L, "", ptr_ty)
    val byte_l = new_local(L, "", u8_ty)
    val byte_r = new_local(L, "", u8_ty)
    val ea_l = emit_inst(L, ir.op_kinds().ELEM_ADDR, addr_l as i32, pos)
    if ea_l != null {
        ea_l!!.a = local_operand(L, ptr_l)
        ea_l!!.b = local_operand(L, index)
    }
    val ea_r = emit_inst(L, ir.op_kinds().ELEM_ADDR, addr_r as i32, pos)
    if ea_r != null {
        ea_r!!.a = local_operand(L, ptr_r)
        ea_r!!.b = local_operand(L, index)
    }
    val ld_l = emit_inst(L, ir.op_kinds().LOAD, byte_l as i32, pos)
    if ld_l != null {
        ld_l!!.a = local_operand(L, addr_l)
    }
    val ld_r = emit_inst(L, ir.op_kinds().LOAD, byte_r as i32, pos)
    if ld_r != null {
        ld_r!!.a = local_operand(L, addr_r)
    }
    val same = emit_binop(L, ir.bin_ops().EQ, false, local_operand(L, byte_l), local_operand(L, byte_r), boolean, pos)
    emit_cond(L, same, step_b, no_b, pos)
    use_block(L, step_b)
    val next = emit_binop(L, ir.bin_ops().ADD, true, local_operand(L, index), ir.int_op(usize_ty, 1), usize_ty, pos)
    emit_copy(L, index, next, pos)
    emit_br(L, loop_b, pos)
    var yes_bits: i64 = 1
    var no_bits: i64 = 0
    if negate {
        yes_bits = 0
        no_bits = 1
    }
    use_block(L, yes_b)
    emit_copy(L, result, ir.int_op(boolean, yes_bits), pos)
    emit_br(L, join_b, pos)
    use_block(L, no_b)
    emit_copy(L, result, ir.int_op(boolean, no_bits), pos)
    emit_br(L, join_b, pos)
    use_block(L, join_b)
    return local_operand(L, result)
}

private fn emit_extract_into(L: *Lower, dst: u32, agg: ir.Operand, index: u32, pos: ir.Pos) with (a: mem.Allocator) {
    // as_local before emit — must not hold *Inst across an emit that
    // pushes into the same block (legacy List<Inst> grow risk; still
    // clearer order matching emit_extract_aux).
    val src = as_local(L, agg, pos)
    val inst = emit_inst(L, ir.op_kinds().EXTRACT, dst as i32, pos)
    if inst != null {
        inst!!.a = src
        inst!!.aux = index
        inst!!.aux2 = 0
    }
}

fn map_binop(op: str): (ir.BinOp, bool, bool) {
    val b = ir.bin_ops()
    if op == "+" {
        return b.ADD, true, true
    }
    if op == "-" {
        return b.SUB, true, true
    }
    if op == "*" {
        return b.MUL, true, true
    }
    if op == "/" {
        return b.DIV, true, true
    }
    if op == "%" {
        return b.REM, true, true
    }
    if op == "&" {
        return b.AND, false, true
    }
    if op == "|" {
        return b.OR, false, true
    }
    if op == "^" {
        return b.XOR, false, true
    }
    if op == "<<" {
        return b.SHL, true, true
    }
    if op == ">>" {
        return b.SHR, true, true
    }
    if op == "==" {
        return b.EQ, false, true
    }
    if op == "!=" {
        return b.NE, false, true
    }
    if op == "<" {
        return b.LT, false, true
    }
    if op == "<=" {
        return b.LE, false, true
    }
    if op == ">" {
        return b.GT, false, true
    }
    if op == ">=" {
        return b.GE, false, true
    }
    return b.ADD, false, false
}

private fn is_u8_elem(ty: *check.Type?): bool {
    if ty == null {
        return false
    }
    val t = check.type_peel_distinct(ty!!)
    return t.kind == check.type_kinds().INT && !t.int_signed && t.int_bits == 8 && !t.int_is_size
}

private fn is_str_ty(ty: *check.Type?): bool {
    if ty == null {
        return false
    }
    val t = ty!!
    return t.kind == check.type_kinds().DISTINCT && t.name == "str"
}

/** View reinterprets that C's lower_expr wraps as BITCAST (not ptr casts). */
private fn want_view_bitcast(got: *check.Type?, want: *check.Type?): bool {
    if got == null || want == null {
        return false
    }
    val g = got!!
    val w = want!!
    val tk = check.type_kinds()
    if g.kind == tk.BYTES && w.kind == tk.BYTES && !g.is_const && w.is_const {
        return true
    }
    if g.kind == tk.SLICE && w.kind == tk.SLICE && !g.is_const && w.is_const && g.elem != null && w.elem != null &&
        g.elem!! == w.elem!! {
        return true
    }
    if g.kind == tk.PTR && w.kind == tk.PTR && !g.is_const && w.is_const && g.elem != null && w.elem != null &&
        g.elem!! == w.elem!! {
        return true
    }
    if g.kind == tk.SLICE && is_str_ty(w) && is_u8_elem(g.elem) {
        return true
    }
    if is_str_ty(w) && !check.type_same(g, w) {
        if g.kind == tk.BYTES {
            return true
        }
        if g.kind == tk.SLICE && is_u8_elem(g.elem) {
            return true
        }
    }
    return false
}

/** Explicit `as` bitcast cases: views + ptr_like package cast + bytes_n (C). */
private fn want_cast_bitcast(got: *check.Type?, want: *check.Type?): bool {
    if want_view_bitcast(got, want) {
        return true
    }
    if got == null || want == null {
        return false
    }
    val g = got!!
    val w = want!!
    val tk = check.type_kinds()
    // C jog_lower_package_cast: both ptr-like (*T / *T? niche) → BITCAST.
    if check.memory_ptr_cast_ok(g, w) {
        return true
    }
    if g.has_layout && w.has_layout && g.size > 0 && g.size == w.size && (g.kind == tk.BYTES_N || w.kind == tk.BYTES_N) {
        return true
    }
    return false
}

fn lower_expr(L: *Lower, node: *parse.Node): ir.Operand with (a: mem.Allocator) {
    val op = lower_expr_raw(L, node)
    if L.failed {
        return op
    }
    val want = check.get_node_ty(node)
    if want != null && op.ty != null && want_view_bitcast(op.ty, want) {
        return emit_bitcast(L, op, want, node_pos(L, node))
    }
    // T → T? (C wrap_option_some in lower_expr).
    if want != null && want!!.kind == check.type_kinds().OPTION && op.ty != null &&
        want!!.elem != null && want!!.elem!! == op.ty!! {
        return wrap_option_some(L, op, want!!, node_pos(L, node))
    }
    return maybe_iface_wrap(L, node, op)
}

private fn lower_expr_raw(L: *Lower, node: *parse.Node): ir.Operand with (a: mem.Allocator) {
    if L.failed {
        return none_value()
    }
    val pos = node_pos(L, node)
    val ty = check.get_node_ty(node)
    // Fold float literal trees before requiring child types (C try_fold).
    val (folded_f, fold_ok) = try_fold_float(L, node, ty)
    if fold_ok {
        return folded_f
    }
    // Int lit trees may lack node.ty when nested under typed bindings (`var b: i8 = -128`).
    if ty == null && (parse.is_int_lit(node) || parse.is_unary(node) || parse.is_binary(node)) && is_int_tree(node) {
        return lower_int_const(L, node, check.type_i64(L.types) as *check.Type?)
    }
    if ty == null && !parse.is_call(node) {
        // Unit-producing forms may omit ty; calls handle unit via dst -1.
        if parse.is_if(node) {
            return lower_if_expr(L, node)
        }
    }
    if ty == null {
        // Variant ctor calls (`Shape.Circle(...)`) may lack node.ty in some paths.
        if parse.is_call(node) {
            val (en_c, en_ok) = lower_enum_call(L, node)
            if en_ok {
                return en_c
            }
        }
        if parse.is_dot_variant(node) {
            return lower_enum_dot(L, node)
        }
        // Interp / string pieces inside `"a=${x}"` may omit node.ty.
        if parse.is_interp(node) {
            return lower_string_interp(L, node)
        }
        if parse.is_string_lit(node) {
            return ir.string_op(check.type_const_bytes(L.types) as *check.Type?, node.text)
        }
        fail(L, node, "expression has no type")
        return none_value()
    }
    if parse.is_bool_lit(node) {
        var bits: i64 = 0
        if node.text == "true" {
            bits = 1
        }
        return ir.int_op(ty, bits)
    }
    // Fold int lit trees (incl. unary `-128`) before emit_unop — match C try_fold.
    // When the site type is T?, fold as T; lower_expr wraps Some (C try_fold + wrap_option_some).
    if parse.is_int_lit(node) || ((parse.is_binary(node) || parse.is_unary(node)) && is_int_tree(node)) {
        var fold_ty = ty
        if ty != null && ty!!.kind == check.type_kinds().OPTION && ty!!.elem != null {
            fold_ty = ty!!.elem
        }
        return lower_int_const(L, node, fold_ty)
    }
    if parse.is_cstring_lit(node) {
        return ir.cstring_op(ty, node.text)
    }
    if parse.is_string_lit(node) {
        return ir.string_op(ty, node.text)
    }
    if parse.is_float_lit(node) {
        var lit_f = parse_float_text(node.text)
        return ir.float_op(ty, &lit_f)
    }
    if parse.is_null_lit(node) {
        return lower_error_null(L, node)
    }
    if parse.is_char_lit(node) {
        // Approximate: first byte; full UTF-8 later.
        var bits: i64 = 0
        if node.text.len > 0 {
            bits = node.text.ptr[0] as i64
        }
        return ir.int_op(ty, bits)
    }
    if parse.is_ident(node) {
        val raw = lower_name(L, node)
        val (narrowed, ok) = lower_iface_narrowed(L, node, raw)
        if ok {
            return narrowed
        }
        return raw
    }
    if parse.is_unary(node) {
        if node.text == "&" || node.text == "*" {
            return lower_memory_unary(L, node)
        }
        if node.kids.len == 0 {
            return none_value()
        }
        val operand = lower_expr(L, node.kids.get(0))
        val u = ir.un_ops()
        if node.text == "-" {
            return emit_unop(L, u.NEG, true, operand, ty, pos)
        }
        if node.text == "~" {
            return emit_unop(L, u.BITNOT, false, operand, ty, pos)
        }
        if node.text == "!" {
            return emit_unop(L, u.NOT, false, operand, ty, pos)
        }
        fail(L, node, "unary not lowered yet")
        return none_value()
    }
    if parse.is_binary(node) {
        if node.text == "&&" || node.text == "||" {
            return lower_logic(L, node, node.text == "||")
        }
        if node.text == "?:" {
            return lower_enum_elvis(L, node)
        }
        val lhs = lower_expr(L, node.kids.get(0))
        val rhs = lower_expr(L, node.kids.get(1))
        // C: error compare before pointer arithmetic / constraint ops.
        val (err_op, err_ok) = lower_error_compare(L, node, lhs, rhs)
        if err_ok {
            return err_op
        }
        val (mem_op, mem_ok) = lower_memory_binary(L, node, lhs, rhs)
        if mem_ok {
            return mem_op
        }
        val (c_op, c_ok) = lower_constraint_binop(L, node, lhs, rhs)
        if c_ok {
            return c_op
        }
        if (node.text == "==" || node.text == "!=") && lhs.ty != null &&
            check.type_bytes_view(lhs.ty!!) != null {
            return lower_bytes_cmp(L, lhs, rhs, node.text == "!=", pos)
        }
        if (node.text == "==" || node.text == "!=") && lhs.ty != null {
            val lu = check.type_peel_distinct(lhs.ty!!)
            if lu.kind == check.type_kinds().ENUM {
                return lower_enum_eq(L, lhs, rhs, node.text == "!=", pos)
            }
        }
        val (bin, checked, ok) = map_binop(node.text)
        if !ok {
            fail(L, node, "binary not lowered yet")
            return none_value()
        }
        return emit_binop(L, bin, checked, lhs, rhs, ty, pos)
    }
    if parse.is_tuple(node) {
        return lower_tuple(L, node)
    }
    if parse.is_array_lit(node) {
        return lower_array_lit(L, node)
    }
    if parse.is_member(node) {
        val (opt_m, opt_mok) = lower_option_ctor(L, node)
        if opt_mok {
            return opt_m
        }
        val (ov_op, ov_ok) = lower_option_view(L, node)
        if ov_ok {
            return ov_op
        }
        val (safe, safe_ok) = lower_enum_safe(L, node)
        if safe_ok {
            return safe
        }
        val (name_op, name_ok) = lower_enum_name(L, node)
        if name_ok {
            return name_op
        }
        val (en_m, en_ok) = lower_enum_member(L, node)
        if en_ok {
            return en_m
        }
        val (iface_load, iface_ok) = lower_iface_load(L, node)
        if iface_ok {
            return iface_load
        }
        val (view, view_ok) = lower_package_view(L, node)
        if view_ok {
            return view
        }
        // Package / fn / method / const / variant members: resolve by symbol (C lower_name).
        val msym = check.get_node_sym(node)
        if msym != null && (load.is_symbol_function(msym!!) || load.is_symbol_method(msym!!) ||
            load.is_symbol_constant(msym!!) || load.is_symbol_variant(msym!!) ||
            load.is_symbol_variable(msym!!)) {
            return lower_name(L, node)
        }
        return lower_member_value(L, node)
    }
    if parse.is_dot_variant(node) {
        val (opt_dot, opt_ok) = lower_option_ctor(L, node)
        if opt_ok {
            return opt_dot
        }
        return lower_enum_dot(L, node)
    }
    if parse.is_force(node) {
        return lower_enum_force(L, node)
    }
    if parse.is_is(node) {
        val (iface_is, iface_ok) = lower_iface_is(L, node)
        if iface_ok {
            return iface_is
        }
        return lower_enum_is(L, node)
    }
    if parse.is_when(node) {
        val (iface_when, iface_wok) = lower_iface_when(L, node, true)
        if iface_wok {
            return iface_when
        }
        return lower_enum_when(L, node, true)
    }
    if parse.is_index(node) {
        return lower_index_value(L, node)
    }
    if parse.is_slice_expr(node) {
        return lower_slice_expr(L, node)
    }
    if parse.is_go(node) {
        return lower_go(L, node)
    }
    if parse.is_call(node) {
        if lower_error_panic(L, node) {
            return none_value()
        }
        val (str_c, str_cok) = lower_string_call(L, node)
        if str_cok {
            return str_c
        }
        val (opt_c, opt_cok) = lower_option_ctor_call(L, node)
        if opt_cok {
            return opt_c
        }
        val (en_c, en_ok) = lower_enum_call(L, node)
        if en_ok {
            return en_c
        }
        val (iface_c, iface_cok) = lower_iface_call(L, node)
        if iface_cok {
            return iface_c
        }
        val (coro_c, coro_ok) = lower_coro_call(L, node)
        if coro_ok {
            return coro_c
        }
        return lower_call(L, node)
    }
    if parse.is_if(node) {
        return lower_if_expr(L, node)
    }
    if parse.is_cast(node) {
        val (ctx_cast, ctx_cok) = lower_context_cast(L, node)
        if ctx_cok {
            return ctx_cast
        }
        val (iface_cast, iface_cok) = lower_iface_cast(L, node)
        if iface_cok {
            return iface_cast
        }
        val (en_cast, cast_ok) = lower_enum_cast(L, node)
        if cast_ok {
            return en_cast
        }
        return lower_cast(L, node)
    }
    if parse.is_block(node) {
        return lower_block_value(L, node)
    }
    if parse.is_builtin(node) {
        val (sop, sok) = lower_scalar_intrinsic(L, node)
        if sok {
            return sop
        }
        val (op, ok) = lower_comptime_builtin(L, node)
        if ok {
            return op
        }
    }
    if parse.is_lambda(node) {
        return lower_lambda(L, node)
    }
    if parse.is_interp(node) {
        return lower_string_interp(L, node)
    }
    fail(L, node, "expression not lowered yet")
    return none_value()
}

private fn bytes_as_str(b: bytes): str with (a: mem.Allocator) {
    if b.len == 0 {
        return ""
    }
    val (raw, err) = a.alloc(b.len, 1)
    if err != null {
        panic("out of memory")
    }
    var i: usize = 0
    for i < b.len {
        raw.ptr[i] = b.ptr[i]
        i = i + 1
    }
    return raw
}

private fn lower_embed(L: *Lower, node: *parse.Node): ir.Operand with (a: mem.Allocator) {
    if L.func == null {
        fail(L, node, "@embed is outside a function")
        return none_value()
    }
    if node.kids.len != 1 {
        fail(L, node, "@embed expects one argument")
        return none_value()
    }
    var arg = node.kids.get(0)
    if parse.is_arg(arg) {
        if arg.name.len > 0 || arg.kids.len == 0 {
            fail(L, node, "@embed expects one argument")
            return none_value()
        }
        arg = arg.kids.get(0)
    }
    if !parse.is_string_lit(arg) {
        fail(L, node, "@embed expects a string literal")
        return none_value()
    }
    var mod_root = ""
    if L.root_pkg != null {
        mod_root = L.root_pkg!!.module_root
    }
    val full = check.embed_resolve(L.file, arg.text, mod_root)
    if full.len == 0 || !fs.exists(full) {
        fail(L, node, "cannot embed file: file is missing")
        return none_value()
    }
    val (data, err) = fs.read_all(full)
    if err != null {
        fail(L, node, "cannot embed file: file is missing")
        return none_value()
    }
    val ty = check.get_node_ty(node)
    if ty == null {
        fail(L, node, "compile-time embed has no type")
        return none_value()
    }
    val text = bytes_as_str(data)
    val bytes_op = ir.string_op(ty, text)
    val dst = new_local(L, "", ty)
    emit_copy(L, dst, bytes_op, node_pos(L, node))
    return local_operand(L, dst)
}

private fn builtin_arg(node: *parse.Node, index: usize): *parse.Node? {
    if index >= node.kids.len {
        return null
    }
    val arg = node.kids.get(index)
    if parse.is_arg(arg) && arg.kids.len > 0 {
        return arg.kids.get(0) as *parse.Node?
    }
    return arg as *parse.Node?
}

private fn intrinsic_binop(name: str): (ir.BinOp, bool, bool) {
    if name == "add" {
        return ir.bin_ops().ADD, true, true
    }
    if name == "sub" {
        return ir.bin_ops().SUB, true, true
    }
    if name == "mul" {
        return ir.bin_ops().MUL, true, true
    }
    if name == "div" {
        return ir.bin_ops().DIV, true, true
    }
    if name == "rem" {
        return ir.bin_ops().REM, true, true
    }
    if name == "shl" {
        return ir.bin_ops().SHL, true, true
    }
    if name == "shr" {
        return ir.bin_ops().SHR, true, true
    }
    if name == "and" {
        return ir.bin_ops().AND, false, true
    }
    if name == "or" {
        return ir.bin_ops().OR, false, true
    }
    if name == "xor" {
        return ir.bin_ops().XOR, false, true
    }
    if name == "eq" {
        return ir.bin_ops().EQ, false, true
    }
    if name == "ne" {
        return ir.bin_ops().NE, false, true
    }
    if name == "lt" {
        return ir.bin_ops().LT, false, true
    }
    if name == "le" {
        return ir.bin_ops().LE, false, true
    }
    if name == "gt" {
        return ir.bin_ops().GT, false, true
    }
    if name == "ge" {
        return ir.bin_ops().GE, false, true
    }
    return ir.bin_ops().ADD, false, false
}

/** `@add` / `@eq` / … operator bodies (C lower_scalar_intrinsic). */
private fn lower_scalar_intrinsic(L: *Lower, node: *parse.Node): (ir.Operand, bool) with (a: mem.Allocator) {
    if !check.is_op_intrinsic_name(node.name) {
        return none_value(), false
    }
    val ty = check.get_node_ty(node)
    if ty == null {
        fail(L, node, "expression not lowered yet")
        return none_value(), true
    }
    val a0 = builtin_arg(node, 0)
    if a0 == null {
        fail(L, node, "expression not lowered yet")
        return none_value(), true
    }
    val lhs = lower_expr(L, a0!!)
    if L.failed {
        return none_value(), true
    }
    val pos = node_pos(L, node)
    if node.name == "neg" {
        return emit_unop(L, ir.un_ops().NEG, true, lhs, ty, pos), true
    }
    if node.name == "bitnot" {
        return emit_unop(L, ir.un_ops().BITNOT, false, lhs, ty, pos), true
    }
    if node.name == "not" {
        return emit_unop(L, ir.un_ops().NOT, false, lhs, ty, pos), true
    }
    val a1 = builtin_arg(node, 1)
    if a1 == null {
        fail(L, node, "expression not lowered yet")
        return none_value(), true
    }
    val rhs = lower_expr(L, a1!!)
    if L.failed {
        return none_value(), true
    }
    val (bin, checked, ok) = intrinsic_binop(node.name)
    if !ok {
        fail(L, node, "expression not lowered yet")
        return none_value(), true
    }
    return emit_binop(L, bin, checked, lhs, rhs, ty, pos), true
}

fn lower_comptime_builtin(L: *Lower, node: *parse.Node): (ir.Operand, bool) with (a: mem.Allocator) {
    if node.name == "embed" {
        return lower_embed(L, node), true
    }
    if node.name == "comptime" {
        if node.kids.len != 1 {
            fail(L, node, "@comptime expects one argument")
            return none_value(), true
        }
        var expr = node.kids.get(0)
        if parse.is_arg(expr) {
            if expr.name.len > 0 || expr.kids.len == 0 {
                fail(L, node, "@comptime expects one argument")
                return none_value(), true
            }
            expr = expr.kids.get(0)
        }
        return eval_comptime_expr(L, node, expr), true
    }
    return none_value(), false
}

private fn lambda_nparams(node: *parse.Node): usize {
    return (node.head % 256) as usize
}

private fn lambda_has_ret(node: *parse.Node): bool {
    return (node.head / 256) % 2 == 1
}

private fn lambda_expr_body(node: *parse.Node): bool {
    return (node.head / 512) % 2 == 1
}

private fn lambda_implicit_it(node: *parse.Node): bool {
    return (node.head / 1024) % 2 == 1
}

private fn lambda_body_node(node: *parse.Node): *parse.Node? {
    val nparams = lambda_nparams(node)
    var i = nparams
    if lambda_has_ret(node) {
        i = i + 1
    }
    if i >= node.kids.len {
        return null
    }
    return node.kids.get(i) as *parse.Node?
}

private fn lower_lambda_block(L: *Lower, block: *parse.Node, ret: *check.Type?) with (a: mem.Allocator) {
    if !parse.is_block(block) {
        fail(L, block, "expected a block")
        return
    }
    val base = L.cleanups.len
    var n = block.kids.len
    var last: *parse.Node? = null
    var tail = false
    if n > 0 {
        last = block.kids.get(n - 1) as *parse.Node?
        if last != null && parse.is_expr_stmt(last!!) && !is_unit_ty(ret) {
            tail = true
            n = n - 1
        }
    }
    var i: usize = 0
    for i < n && !L.failed && !L.terminated {
        lower_stmt(L, block.kids.get(i))
        i = i + 1
    }
    if L.failed || L.terminated {
        return
    }
    if tail && last != null && last!!.kids.len > 0 {
        val value = lower_expr(L, last!!.kids.get(0))
        if L.failed || L.terminated {
            return
        }
        lower_error_block_end(L, base, node_pos(L, block))
        if L.failed || L.terminated {
            return
        }
        if value.kind == ir.operand_kinds().NONE {
            fail(L, last, "lambda does not produce a value")
            return
        }
        emit_ret(L, value, node_pos(L, last!!))
        return
    }
    lower_error_block_end(L, base, node_pos(L, block))
    if L.failed || L.terminated {
        return
    }
    if is_unit_ty(ret) {
        emit_ret(L, none_value(), node_pos(L, block))
        return
    }
    emit_unreachable(L, node_pos(L, block))
}

private fn lambda_void_ptr(L: *Lower): *check.Type? {
    if L.root_pkg == null || L.root_pkg!!.scope.universe == null {
        return null
    }
    val sym = load.package_scope_lookup(L.root_pkg!!.scope.universe!!, "void")
    if sym == null {
        return null
    }
    val ty = check.get_sema(sym!!)
    if ty == null {
        return null
    }
    return check.type_ptr(L.types, ty!!, false) as *check.Type?
}

private fn scan_lambda_caps(L: *Lower, node: *parse.Node, caps: *list.List<LamCap>) with (a: mem.Allocator) {
    if parse.is_ident(node) {
        val sym = check.get_node_sym(node)
        var local: u32 = 0
        var ok = false
        if sym != null {
            val (found, hit) = find_local(L, sym!!)
            local = found
            ok = hit
            // Multi-name `var (data, err)` records the local by name only.
            if !ok && local_symbol_kind(sym!!) && sym!!.name.len > 0 {
                val (found2, hit2) = find_local_by_name(L, sym!!.name)
                local = found2
                ok = hit2
            }
        }
        if ok {
            var seen = false
            var i: usize = 0
            for i < caps.len {
                val c = caps.get(i)
                if c.parent == local {
                    seen = true
                } else if sym != null && c.symbol != null && c.symbol!! == sym!! {
                    seen = true
                }
                i = i + 1
            }
            if !seen {
                caps.push(LamCap(symbol: sym, parent: local))
            }
        }
    }
    var k: usize = 0
    for k < node.kids.len {
        scan_lambda_caps(L, node.kids.get(k), caps)
        k = k + 1
    }
}

private struct CapBuilt {
    op: ir.Operand
    tuple: *check.Type?
    ok: bool
}

/** Stack tuple of *void, one slot per capture. The closure env is that tuple as *void. */
private fn build_capture_env(L: *Lower, node: *parse.Node, caps: *list.List<LamCap>): CapBuilt with (a: mem.Allocator) {
    var built: CapBuilt
    built.op = none_value()
    built.tuple = null
    built.ok = false
    val vp = lambda_void_ptr(L)
    if vp == null {
        fail(L, node, "lambda capture is missing void*")
        return built
    }
    var elems = list.empty<*check.Type>()
    var i: usize = 0
    for i < caps.len {
        elems.push(vp!!)
        i = i + 1
    }
    val tup = check.type_tuple(L.types, elems)
    val pos = node_pos(L, node)
    val slot = new_local(L, "cap", tup as *check.Type?)
    if L.failed {
        return built
    }
    val base = emit_addr(L, slot, pos)
    i = 0
    for i < caps.len {
        val cap = caps.get(i)
        val addr = emit_addr(L, cap.parent, pos)
        val raw = emit_bitcast(L, addr, vp, pos)
        val field = emit_field_addr(L, base, i as u32, pos)
        emit_store(L, field, raw, pos)
        i = i + 1
    }
    built.op = emit_bitcast(L, base, vp, pos)
    built.tuple = tup as *check.Type?
    built.ok = !L.failed
    return built
}

private fn lambda_cap_slot(L: *Lower, sym: *load.Symbol): (u32, bool) {
    var i: usize = 0
    for i < L.lambda_caps.len {
        val c = L.lambda_caps.get(i)
        if c.symbol != null && c.symbol!! == sym {
            return i as u32, true
        }
        i = i + 1
    }
    return 0, false
}

private fn load_lambda_cap(L: *Lower, node: *parse.Node, slot: u32, sym: *load.Symbol): ir.Operand with (a: mem.Allocator) {
    if L.lambda_tuple == null || L.func == null {
        fail(L, node, "lambda capture has no environment")
        return none_value()
    }
    val vp = lambda_void_ptr(L)
    val ty = check.get_sema(sym)
    if vp == null || ty == null {
        fail(L, node, "lambda capture has no type")
        return none_value()
    }
    val pos = node_pos(L, node)
    val env = local_operand(L, L.lambda_env)
    val tup_ptr = check.type_ptr(L.types, L.lambda_tuple!!, false)
    val as_tup = emit_bitcast(L, env, tup_ptr as *check.Type?, pos)
    val field = emit_field_addr(L, as_tup, slot, pos)
    val raw = emit_load(L, field, pos)
    val typed = check.type_ptr(L.types, ty!!, false)
    val as_t = emit_bitcast(L, raw, typed as *check.Type?, pos)
    return emit_load(L, as_t, pos)
}

/** Store through the captured *T. The env slot holds the address of the parent local. */
private fn store_lambda_cap(L: *Lower, node: *parse.Node, slot: u32, sym: *load.Symbol, value: ir.Operand) with (a: mem.Allocator) {
    if L.lambda_tuple == null || L.func == null {
        fail(L, node, "lambda capture has no environment")
        return
    }
    val vp = lambda_void_ptr(L)
    val ty = check.get_sema(sym)
    if vp == null || ty == null {
        fail(L, node, "lambda capture has no type")
        return
    }
    val pos = node_pos(L, node)
    val env = local_operand(L, L.lambda_env)
    val tup_ptr = check.type_ptr(L.types, L.lambda_tuple!!, false)
    val as_tup = emit_bitcast(L, env, tup_ptr as *check.Type?, pos)
    val field = emit_field_addr(L, as_tup, slot, pos)
    val raw = emit_load(L, field, pos)
    val typed = check.type_ptr(L.types, ty!!, false)
    val as_t = emit_bitcast(L, raw, typed as *check.Type?, pos)
    emit_store(L, as_t, value, pos)
}

/**
 * Lambdas. No captures return a function reference (C prep.count == 0).
 * A capture is a stack tuple of *void plus an env parameter; the value is
 * the aggregate { function, env } (C jog_lower_lambda_closure).
 */
private fn lower_lambda(L: *Lower, node: *parse.Node): ir.Operand with (a: mem.Allocator) {
    val ty = check.get_node_ty(node)
    if ty == null || ty!!.kind != check.type_kinds().FN || ty!!.fn_extern {
        fail(L, node, "lambda is not a function")
        return none_value()
    }
    var caps = list.empty<LamCap>()
    val cap_body = lambda_body_node(node)
    if cap_body != null {
        scan_lambda_caps(L, cap_body!!, &caps)
    }
    var env_op = none_value()
    var tuple_ty: *check.Type? = null
    if caps.len > 0 {
        val built = build_capture_env(L, node, &caps)
        if !built.ok {
            return none_value()
        }
        env_op = built.op
        tuple_ty = built.tuple
    }
    var name_buf = strbuilder.empty()
    name_buf.append("jog_lambda_")
    name_buf.append_int(L.module.funcs.len as i64, 10)
    val name = name_buf.str()
    val pnames = list.empty<str>()
    val index = ir.func_add(&L.module, name, name, ir.linkages().INTERNAL, ty!!, pnames)
    if index < 0 {
        fail(L, node, "out of memory")
        return none_value()
    }
    val child = ir.func_at(&L.module, index as u32)
    if child == null {
        fail(L, node, "out of memory")
        return none_value()
    }
    child!!.pos = node_pos(L, node)
    // Context parameters are real parameters, ahead of a capture env.
    // Calls inside the lambda read them from ctx_frames.
    var ctx_locals = list.empty<u32>()
    var ci: usize = 0
    for ci < ty!!.contexts.len {
        val cty = ty!!.contexts.get(ci) as *check.Type?
        val slot = ir.local_add(child!!, "ctx", cty)
        child!!.param_count = child!!.param_count + 1
        child!!.locals.at(slot as usize).is_param = true
        ctx_locals.push(slot)
        ci = ci + 1
    }
    var env_local: u32 = 0
    if caps.len > 0 {
        val vp = lambda_void_ptr(L)
        if vp == null {
            fail(L, node, "lambda capture is missing void*")
            return none_value()
        }
        env_local = ir.local_add(child!!, "env", vp)
        child!!.param_count = child!!.param_count + 1
        child!!.locals.at(env_local as usize).is_param = true
    }
    // Snap enclosing state (mirror coro child swap).
    val saved_func = L.func
    val saved_ast = L.ast_fn
    val saved_block = L.block
    val saved_term = L.terminated
    val saved_locals = L.locals
    val saved_loops = L.loops
    val saved_cleanups = L.cleanups
    val saved_overlays = L.overlays
    val saved_in_coro = L.in_coro
    val saved_in_ct = L.in_comptime
    val saved_in_cleanup = L.in_cleanup
    val saved_ensuring = L.ensuring
    val saved_in_lambda = L.in_lambda
    val saved_lambda_env = L.lambda_env
    val saved_lambda_caps = L.lambda_caps
    val saved_lambda_tuple = L.lambda_tuple
    val saved_frames = L.ctx_frames
    L.ctx_frames = list.empty<CtxFrame>()
    var cfi: usize = 0
    for cfi < ctx_locals.len && cfi < ty!!.contexts.len {
        context_push_local(L, ty!!.contexts.get(cfi) as *check.Type?, ctx_locals.get(cfi))
        cfi = cfi + 1
    }
    L.locals = list.empty<LocalBind>()
    L.loops = list.empty<LoopFrame>()
    L.cleanups = list.empty<Cleanup>()
    L.overlays = list.empty<Overlay>()
    L.func = child
    L.ast_fn = node as *parse.Node?
    L.terminated = false
    L.in_coro = false
    L.in_comptime = false
    L.in_cleanup = false
    L.ensuring = 0
    L.in_lambda = caps.len > 0
    L.lambda_env = env_local
    L.lambda_caps = caps
    L.lambda_tuple = tuple_ty
    // Bind parameters / implicit `it`.
    if lambda_implicit_it(node) {
        bind_local(L, check.get_node_sym(node), 0)
    } else {
        val nparams = lambda_nparams(node)
        var pi: usize = 0
        for pi < nparams && pi < node.kids.len {
            val param = node.kids.get(pi)
            if parse.is_param(param) {
                bind_local(L, check.get_node_sym(param), pi as u32)
            }
            pi = pi + 1
        }
    }
    val entry = ir.block_add(child!!, "entry")
    L.block = entry
    val ret = ty!!.elem
    val body = lambda_body_node(node)
    if body == null {
        fail(L, node, "lambda needs a body")
    } else if lambda_expr_body(node) {
        val value = lower_expr(L, body!!)
        if !L.failed && !L.terminated {
            if is_unit_ty(ret) {
                emit_ret(L, none_value(), node_pos(L, body!!))
            } else if value.kind == ir.operand_kinds().NONE {
                fail(L, node, "lambda does not produce a value")
            } else {
                emit_ret(L, value, node_pos(L, body!!))
            }
        }
    } else {
        lower_lambda_block(L, body!!, ret)
    }
    val failed = L.failed
    L.func = saved_func
    L.ast_fn = saved_ast
    L.block = saved_block
    L.terminated = saved_term
    L.locals = saved_locals
    L.loops = saved_loops
    L.cleanups = saved_cleanups
    L.overlays = saved_overlays
    L.in_coro = saved_in_coro
    L.in_comptime = saved_in_ct
    L.in_cleanup = saved_in_cleanup
    L.ensuring = saved_ensuring
    L.in_lambda = saved_in_lambda
    L.lambda_env = saved_lambda_env
    L.lambda_caps = saved_lambda_caps
    L.lambda_tuple = saved_lambda_tuple
    L.ctx_frames = saved_frames
    if failed {
        L.failed = true
        return none_value()
    }
    if caps.len > 0 {
        var args = list.empty<ir.Operand>()
        args.push(ir.func_ref(&L.module, index as u32))
        args.push(env_op)
        return emit_aggregate(L, ty, args, node_pos(L, node))
    }
    return ir.func_ref(&L.module, index as u32)
}

private fn is_int_tree(node: *parse.Node): bool {
    if parse.is_int_lit(node) || parse.is_char_lit(node) {
        return true
    }
    if parse.is_unary(node) && node.kids.len > 0 && (node.text == "-" || node.text == "~" || node.text == "+") {
        return is_int_tree(node.kids.get(0))
    }
    if parse.is_binary(node) && node.kids.len >= 2 {
        val op = node.text
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "^" ||
            op == "<<" || op == ">>" {
            return is_int_tree(node.kids.get(0)) && is_int_tree(node.kids.get(1))
        }
    }
    return false
}

private fn parse_int_text(text: str): i64 {
    var i: usize = 0
    var v: u64 = 0
    var neg = false
    if text.len > 0 && text.ptr[0] == '-' as u8 {
        neg = true
        i = 1
    }
    // Hex: 0x… / 0X…
    if i + 2 <= text.len && text.ptr[i] == '0' as u8 &&
        (text.ptr[i + 1] == 'x' as u8 || text.ptr[i + 1] == 'X' as u8) {
        i = i + 2
        for i < text.len {
            val c = text.ptr[i]
            var dig: u64 = 0
            if c >= '0' as u8 && c <= '9' as u8 {
                dig = (c - '0' as u8) as u64
            } else if c >= 'a' as u8 && c <= 'f' as u8 {
                dig = (c - 'a' as u8) as u64 + 10
            } else if c >= 'A' as u8 && c <= 'F' as u8 {
                dig = (c - 'A' as u8) as u64 + 10
            } else {
                break
            }
            v = v * 16 + dig
            i = i + 1
        }
    } else {
        for i < text.len {
            val c = text.ptr[i]
            if c >= '0' as u8 && c <= '9' as u8 {
                // u64 wrap-friendly accumulate so 2^64-1 (u64 max) folds.
                v = v * 10 + ((c - '0' as u8) as u64)
            }
            i = i + 1
        }
    }
    // Bit-pun u64→i64 so values above i64::MAX (e.g. u64 max) do not panic.
    var buf = v
    val p: *u8 = &buf as *u8
    var out: i64 = 0
    val op: *u8 = &out as *u8
    var j: usize = 0
    for j < 8 {
        op[j] = p[j]
        j = j + 1
    }
    if neg {
        if out == -9223372036854775808 {
            return out
        }
        return -out
    }
    return out
}

private fn fold_int_tree(node: *parse.Node): i64 {
    if parse.is_int_lit(node) || parse.is_char_lit(node) {
        return parse_int_text(int_lit_text(node))
    }
    if parse.is_unary(node) && node.kids.len > 0 {
        val inner = fold_int_tree(node.kids.get(0))
        if node.text == "-" {
            if inner == -9223372036854775808 {
                return inner
            }
            return -inner
        }
        if node.text == "~" {
            return ~inner
        }
        if node.text == "+" {
            return inner
        }
    }
    if parse.is_binary(node) && node.kids.len >= 2 {
        val l = fold_int_tree(node.kids.get(0))
        val r = fold_int_tree(node.kids.get(1))
        if node.text == "+" {
            return l + r
        }
        if node.text == "-" {
            return l - r
        }
        if node.text == "*" {
            return l * r
        }
        if node.text == "&" {
            return l & r
        }
        if node.text == "|" {
            return l | r
        }
        if node.text == "^" {
            return l ^ r
        }
        if node.text == "<<" && r >= 0 && r < 64 {
            return l << r
        }
        if node.text == ">>" && r >= 0 && r < 64 {
            return l >> r
        }
    }
    return 0
}

private fn parse_float_text(text: str): f64 {
    var i: usize = 0
    var neg = false
    var v: f64 = 0.0
    if text.len > 0 && text.ptr[0] == '-' as u8 {
        neg = true
        i = 1
    }
    for i < text.len {
        val c = text.ptr[i]
        if c >= '0' as u8 && c <= '9' as u8 {
            v = v * 10.0 + ((c - '0' as u8) as f64)
            i = i + 1
            continue
        }
        break
    }
    if i < text.len && text.ptr[i] == '.' as u8 {
        i = i + 1
        var place: f64 = 0.1
        for i < text.len {
            val c = text.ptr[i]
            if c < '0' as u8 || c > '9' as u8 {
                break
            }
            v = v + ((c - '0' as u8) as f64) * place
            place = place * 0.1
            i = i + 1
        }
    }
    if neg {
        return -v
    }
    return v
}

private fn eval_float_tree(node: *parse.Node): (f64, bool) {
    if parse.is_float_lit(node) {
        return parse_float_text(node.text), true
    }
    if parse.is_unary(node) && node.text == "-" && node.kids.len > 0 {
        val (inner, ok) = eval_float_tree(node.kids.get(0))
        if !ok {
            return 0.0, false
        }
        return -inner, true
    }
    if parse.is_binary(node) && node.kids.len >= 2 {
        val (lhs, lok) = eval_float_tree(node.kids.get(0))
        if !lok {
            return 0.0, false
        }
        val (rhs, rok) = eval_float_tree(node.kids.get(1))
        if !rok {
            return 0.0, false
        }
        val op = node.text
        if op == "+" {
            return lhs + rhs, true
        }
        if op == "-" {
            return lhs - rhs, true
        }
        if op == "*" {
            return lhs * rhs, true
        }
        if op == "/" {
            if rhs == 0.0 {
                return 0.0, false
            }
            return lhs / rhs, true
        }
    }
    return 0.0, false
}

private fn float_fold_ty(ty: *check.Type?): *check.Type? {
    if ty == null {
        return null
    }
    val tk = check.type_kinds()
    var fold = ty!!
    if fold.kind == tk.OPTION && fold.elem != null {
        fold = fold.elem!!
    }
    if fold.kind == tk.FLOAT || fold.kind == tk.UNTYPED_FLOAT {
        return fold as *check.Type?
    }
    return null
}

/** C try_fold for float lit trees. Returns (op, true) when folded. */
private fn try_fold_float(L: *Lower, node: *parse.Node, ty: *check.Type?): (ir.Operand, bool) with (a: mem.Allocator) {
    if !check.is_float_lit_tree(node) {
        return none_value(), false
    }
    val tk = check.type_kinds()
    var fold_ty = float_fold_ty(ty)
    if fold_ty == null {
        // Untyped float lit alone: use f64.
        if parse.is_float_lit(node) || parse.is_unary(node) || parse.is_binary(node) {
            fold_ty = check.type_f64(L.types) as *check.Type?
        }
    }
    if fold_ty == null {
        return none_value(), false
    }
    // Only fold when the result type is float-ish (C requires fold_ty FLOAT/UNTYPED_FLOAT).
    if fold_ty!!.kind != tk.FLOAT && fold_ty!!.kind != tk.UNTYPED_FLOAT {
        return none_value(), false
    }
    val (value, ok) = eval_float_tree(node)
    if !ok {
        fail(L, node, "invalid float literal")
        return none_value(), true
    }
    var out_ty = fold_ty
    if fold_ty!!.kind == tk.UNTYPED_FLOAT {
        out_ty = check.type_f64(L.types) as *check.Type?
    }
    // Narrow f32 when requested.
    var v = value
    if out_ty != null && out_ty!!.kind == tk.FLOAT && out_ty!!.float_bits == 32 {
        val narrow: f32 = v as f32
        v = narrow as f64
    }
    return ir.float_op(out_ty, &v), true
}

private fn int_lit_text(node: *parse.Node): str {
    if node.text.len > 0 {
        return node.text
    }
    return node.name
}

private fn lower_int_const(L: *Lower, node: *parse.Node, ty: *check.Type?): ir.Operand with (a: mem.Allocator) {
    if parse.is_int_lit(node) {
        return ir.int_op(ty, parse_int_text(int_lit_text(node)))
    }
    if parse.is_unary(node) && node.text == "-" && node.kids.len > 0 && parse.is_int_lit(node.kids.get(0)) {
        val raw = parse_int_text(node.kids.get(0).text)
        // `-9223372036854775808`: inner bits are already i64::MIN; negating panics.
        if raw == -9223372036854775808 {
            return ir.int_op(ty, raw)
        }
        return ir.int_op(ty, -raw)
    }
    // Binary constant trees (incl. shifts for shift_fit / unchecked folds).
    if parse.is_binary(node) && node.kids.len >= 2 && is_int_tree(node.kids.get(0)) && is_int_tree(node.kids.get(1)) {
        val l = fold_int_tree(node.kids.get(0))
        val r = fold_int_tree(node.kids.get(1))
        var v: i64 = 0
        if node.text == "+" {
            v = l + r
        } else if node.text == "-" {
            v = l - r
        } else if node.text == "*" {
            v = l * r
        } else if node.text == "&" {
            v = l & r
        } else if node.text == "|" {
            v = l | r
        } else if node.text == "^" {
            v = l ^ r
        } else if node.text == "<<" {
            if r < 0 || r >= 64 {
                fail(L, node, "integer literal did not fold")
                return none_value()
            }
            v = l << r
        } else if node.text == ">>" {
            if r < 0 || r >= 64 {
                fail(L, node, "integer literal did not fold")
                return none_value()
            }
            v = l >> r
        } else {
            fail(L, node, "integer literal did not fold")
            return none_value()
        }
        return ir.int_op(ty, v)
    }
    fail(L, node, "integer literal did not fold")
    return none_value()
}

private fn lower_name(L: *Lower, node: *parse.Node): ir.Operand with (a: mem.Allocator) {
    val sym = check.get_node_sym(node)
    if sym != null {
        val (coro_n, coro_ok) = lower_coro_name(L, node, sym!!)
        if coro_ok {
            return coro_n
        }
        val (err_c, err_ok) = lower_universe_err_const(L, node, sym!!)
        if err_ok {
            return err_c
        }
        val (ov, hit) = find_overlay(L, sym!!)
        if hit {
            return ov
        }
        val (local, ok) = find_local(L, sym!!)
        if ok {
            return local_operand(L, local)
        }
        if L.in_lambda {
            val (slot, cap_ok) = lambda_cap_slot(L, sym!!)
            if cap_ok {
                return load_lambda_cap(L, node, slot, sym!!)
            }
        }
        // Multi-name `var (data, err)` records the local by name only.
        // A package function can share that name (`lex.kind` next to a
        // parameter `kind`); do not steal the function.
        if local_symbol_kind(sym!!) {
            val (by_name, name_ok) = find_local_by_name(L, sym!!.name)
            if name_ok {
                return local_operand(L, by_name)
            }
        }
        val (gref, gok) = lower_global_name(L, sym!!)
        if gok {
            // Reading a global variable: load from its address.
            if load.is_symbol_variable(sym!!) || load.is_symbol_constant(sym!!) {
                return emit_load(L, gref, node_pos(L, node))
            }
            return gref
        }
        if sym!!.decl != null && parse.is_fn(sym!!.decl!!) {
            val index = find_fn(L, sym!!.decl!!)
            if index >= 0 {
                return ir.func_ref(&L.module, index as u32)
            }
        }
        if load.is_symbol_function(sym!!) || load.is_symbol_method(sym!!) {
            for i in 0 as usize..L.fns.len {
                val b = L.fns.at(i)
                if b.decl != null && b.decl!!.name == node.name {
                    return ir.func_ref(&L.module, b.index as u32)
                }
            }
        }
    }
    // Fallback: local by name (sym missing or LocalBind missed the pointer).
    var name = node.name
    if name.len == 0 {
        name = node.text
    }
    if name.len > 0 {
        val (local, ok) = find_local_by_name(L, name)
        if ok {
            return local_operand(L, local)
        }
        for i in 0 as usize..L.fns.len {
            val b = L.fns.at(i)
            if b.decl != null && b.decl!!.name == name {
                return ir.func_ref(&L.module, b.index as u32)
            }
        }
    }
    fail(L, node, "name not lowered yet")
    return none_value()
}

private fn fn_decl_of(callee: *parse.Node): *parse.Node? {
    val sym = check.get_node_sym(callee)
    if sym != null && sym!!.decl != null && parse.is_fn(sym!!.decl!!) {
        return sym!!.decl
    }
    return null
}

private fn fn_params_of(fn_node: *parse.Node): list.List<*parse.Node> with (a: mem.Allocator) {
    var params = list.empty<*parse.Node>()
    val shape = fn_node.head
    val nparams = shape % 256
    val has_recv = (shape / 65536) % 2 == 1
    val ntype = (shape / 1048576) % 256
    val nattrs = (shape / 268435456) % 256
    var i: i64 = nattrs
    if has_recv {
        i = i + 1
    }
    i = i + ntype
    var p: i64 = 0
    for p < nparams {
        if (i as usize) < fn_node.kids.len {
            params.push(fn_node.kids.get(i as usize))
        }
        i = i + 1
        p = p + 1
    }
    return params
}

fn param_default(param: *parse.Node): *parse.Node? {
    // PARAM kids: [type?, default?]
    if param.kids.len >= 2 {
        return param.kids.get(param.kids.len - 1) as *parse.Node?
    }
    if param.kids.len == 1 {
        val only = param.kids.get(0)
        if parse.is_type_name(only) || parse.is_type_ptr(only) || parse.is_type_slice(only) ||
            parse.is_type_array(only) || parse.is_type_option(only) || parse.is_type_tuple(only) ||
            parse.is_type_fn(only) || parse.is_type_unit(only) {
            return null
        }
        return only as *parse.Node?
    }
    return null
}

fn pack_slot_of(decl: *parse.Node?, nparam: usize): i32 with (a: mem.Allocator) {
    if decl == null || nparam == 0 {
        return -1
    }
    val params = fn_params_of(decl!!)
    if params.len == 0 {
        return -1
    }
    val last = params.get(params.len - 1)
    if !parse.is_param(last) || last.text != "pack" {
        return -1
    }
    // Receiver methods: fn type includes self, so nparam == ast_n + 1.
    val has_recv = (decl!!.head / 65536) % 2 == 1
    if has_recv {
        if nparam != params.len + 1 {
            return -1
        }
    } else if nparam != params.len {
        return -1
    }
    return (nparam as i32) - 1
}

fn lower_pack_slice(
    L: *Lower,
    slice_ty: *check.Type?,
    elems: list.List<ir.Operand>,
    pos: ir.Pos,
): ir.Operand with (a: mem.Allocator) {
    if slice_ty == null || slice_ty!!.kind != check.type_kinds().SLICE {
        fail_pos_msg(L, pos, "pack is not a slice")
        return none_value()
    }
    if elems.len == 0 {
        return emit_zero(L, slice_ty, pos)
    }
    val elem = slice_ty!!.elem
    if elem == null {
        fail_pos_msg(L, pos, "generic type was not instantiated")
        return none_value()
    }
    val arr_ty = check.type_array(L.types, elem!!, elems.len as u64)
    val tmp = emit_zero(L, arr_ty as *check.Type?, pos)
    val addr = emit_addr(L, tmp.local, pos)
    val ptr_ty = check.type_ptr(L.types, elem!!, false) as *check.Type?
    var header = emit_bitcast(L, addr, ptr_ty, pos)
    var i: usize = 0
    for i < elems.len && !L.failed {
        val at = emit_elem_addr(L, header, ir.int_op(check.type_usize(L.types) as *check.Type?, i as i64), pos)
        emit_store(L, at, elems.get(i), pos)
        i = i + 1
    }
    if L.failed {
        return none_value()
    }
    if slice_ty!!.is_const {
        val cptr = check.type_ptr(L.types, elem!!, true) as *check.Type?
        header = emit_bitcast(L, header, cptr, pos)
    }
    var parts = list.empty<ir.Operand>()
    parts.push(header)
    parts.push(ir.int_op(check.type_usize(L.types) as *check.Type?, elems.len as i64))
    return emit_aggregate(L, slice_ty, parts, pos)
}

private fn fail_pos_msg(L: *Lower, pos: ir.Pos, message: str) with (a: mem.Allocator) {
    L.failed = true
    load.print_pos_error(pos.file, pos.line, pos.column, message)
}

private fn param_index_named(params: list.List<*parse.Node>, name: str): i32 {
    for i in 0 as usize..params.len {
        if params.get(i).name == name {
            return i as i32
        }
    }
    return -1
}

private fn lower_wrapping(L: *Lower, node: *parse.Node): (ir.Operand, bool) with (a: mem.Allocator) {
    if node.kids.len == 0 {
        return none_value(), false
    }
    val callee = node.kids.get(0)
    if !parse.is_member(callee) || callee.name.len == 0 || callee.kids.len == 0 {
        return none_value(), false
    }
    val bops = ir.bin_ops()
    var op = bops.ADD
    if callee.name == "wrappingAdd" {
        op = bops.ADD
    } else if callee.name == "wrappingSub" {
        op = bops.SUB
    } else if callee.name == "wrappingMul" {
        op = bops.MUL
    } else {
        return none_value(), false
    }
    if L.failed {
        return none_value(), true
    }
    val base = callee.kids.get(0)
    if node.kids.len < 2 {
        fail(L, node, "wrapping call is not lowered yet")
        return none_value(), true
    }
    var value_node = node.kids.get(1)
    if parse.is_arg(value_node) && value_node.kids.len > 0 {
        value_node = value_node.kids.get(0)
    }
    val ty = check.get_node_ty(node)
    if ty == null {
        fail(L, node, "wrapping call is not lowered yet")
        return none_value(), true
    }
    val lhs = lower_expr(L, base)
    val rhs = lower_expr(L, value_node)
    if L.failed {
        return none_value(), true
    }
    // Unchecked wrap (C emit_binop with checked=false).
    return emit_binop(L, op, false, lhs, rhs, ty, node_pos(L, node)), true
}

private fn lower_builtin_layout(L: *Lower, node: *parse.Node, which: str, use_align: bool): (ir.Operand, bool) with (a: mem.Allocator) {
    if node.kids.len != 2 {
        return none_value(), false
    }
    val callee = node.kids.get(0)
    if !parse.is_ident(callee) || callee.kids.len > 0 || callee.name != which {
        return none_value(), false
    }
    // Not a user binding named size/align.
    if check.get_node_sym(callee) != null {
        return none_value(), false
    }
    if L.failed {
        return none_value(), true
    }
    val arg = node.kids.get(1)
    var value = arg
    if parse.is_arg(arg) && arg.kids.len > 0 {
        value = arg.kids.get(0)
    }
    var ty = check.get_node_ty(value)
    ty = lower_type_subst(L, ty)
    var usz = check.get_node_ty(node)
    usz = lower_type_subst(L, usz)
    if usz == null || usz!!.kind != check.type_kinds().INT {
        usz = check.type_usize(L.types) as *check.Type?
    }
    if ty == null || usz == null {
        if use_align {
            fail(L, node, "type has no alignment")
        } else {
            fail(L, node, "type has no size")
        }
        return none_value(), true
    }
    if !ty!!.has_layout && !check.type_layout(L.types, ty!!) {
        if use_align {
            fail(L, node, "type has no alignment")
        } else {
            fail(L, node, "type has no size")
        }
        return none_value(), true
    }
    if !ty!!.has_layout {
        if use_align {
            fail(L, node, "type has no alignment")
        } else {
            fail(L, node, "type has no size")
        }
        return none_value(), true
    }
    var bits: i64 = ty!!.size as i64
    if use_align {
        bits = ty!!.align as i64
    }
    return ir.int_op(usz, bits), true
}

private fn lower_call(L: *Lower, node: *parse.Node): ir.Operand with (a: mem.Allocator) {
    if node.kids.len == 0 {
        fail(L, node, "call missing callee")
        return none_value()
    }
    val (constraint, constraint_ok) = lower_constraint_call(L, node)
    if constraint_ok {
        return constraint
    }
    val (special, handled) = lower_struct_call(L, node)
    if handled {
        return special
    }
    val (mem_special, mem_handled) = lower_memory_call(L, node)
    if mem_handled {
        return mem_special
    }
    val (sized, size_ok) = lower_builtin_layout(L, node, "size", false)
    if size_ok {
        return sized
    }
    val (aligned, align_ok) = lower_builtin_layout(L, node, "align", true)
    if align_ok {
        return aligned
    }
    val (wrapped, wrap_ok) = lower_wrapping(L, node)
    if wrap_ok {
        return wrapped
    }
    val callee_node = node.kids.get(0)
    var callee = none_value()
    var fn_ty = check.get_node_ty(callee_node)
    if node.solved_type_args.len > 0 {
        val gi = generic_callee(L, node)
        if gi < 0 || L.failed {
            return none_value()
        }
        callee = ir.func_ref(&L.module, gi as u32)
        if fn_ty == null || !check.type_is_fn(fn_ty!!) {
            fn_ty = check.get_node_ty(node)
            // Prefer instantiated signature from pending inst.
            var pi: usize = 0
            for pi < L.generic_pending.len {
                if L.generic_pending.at(pi).jir_index == gi {
                    fn_ty = L.generic_pending.at(pi).fn_type
                    break
                }
                pi = pi + 1
            }
        }
    } else {
        callee = lower_expr(L, callee_node)
    }
    if fn_ty == null || !check.type_is_fn(fn_ty!!) {
        fail(L, node, "call target is not a function")
        return none_value()
    }
    val nparam = fn_ty!!.elems.len
    val decl = fn_decl_of(callee_node)
    var params = list.empty<*parse.Node>()
    if decl != null {
        params = fn_params_of(decl!!)
    }
    val pack = pack_slot_of(decl, nparam)
    var present = list.empty<bool>()
    var slots = list.empty<ir.Operand>()
    var extras = list.empty<ir.Operand>()
    var pack_elems = list.empty<ir.Operand>()
    for _ in 0 as usize..nparam {
        present.push(false)
        slots.push(none_value())
    }
    var positional: usize = 0
    val arg_end = parse.call_arg_end(node)
    var i: usize = 1
    for i < arg_end {
        val arg = node.kids.get(i)
        var value_node = arg
        if parse.is_arg(arg) && arg.kids.len > 0 {
            value_node = arg.kids.get(0)
        }
        val lowered = lower_expr(L, value_node)
        if L.failed {
            return none_value()
        }
        if parse.is_arg(arg) && arg.name.len > 0 {
            val index = param_index_named(params, arg.name)
            if index < 0 {
                fail(L, arg, "unknown parameter")
                return none_value()
            }
            if pack >= 0 && index == pack && pack_elems.len > 0 {
                fail(L, arg, "duplicate argument")
                return none_value()
            }
            present.set(index as usize, true)
            slots.set(index as usize, lowered)
        } else if pack >= 0 && positional >= (pack as usize) {
            if present.get(pack as usize) {
                fail(L, arg, "duplicate argument")
                return none_value()
            }
            pack_elems.push(lowered)
            positional = positional + 1
        } else if positional < nparam {
            present.set(positional, true)
            slots.set(positional, lowered)
            positional = positional + 1
        } else {
            // C variadic / trailing extras after fixed params.
            extras.push(lowered)
        }
        i = i + 1
    }
    if pack >= 0 && !present.get(pack as usize) {
        var slice_ty: *check.Type? = null
        if (pack as usize) < fn_ty!!.elems.len {
            slice_ty = fn_ty!!.elems.get(pack as usize) as *check.Type?
        }
        slots.set(pack as usize, lower_pack_slice(L, slice_ty, pack_elems, node_pos(L, node)))
        present.set(pack as usize, !L.failed)
        if L.failed {
            return none_value()
        }
    }
    // Trailing lambda fills the last open parameter (C lower_call).
    if parse.call_has_trailing(node) {
        val trail = node.kids.get(node.kids.len - 1 - parse.call_nctx(node))
        if nparam == 0 || present.get(nparam - 1) {
            fail(L, node, "trailing lambda does not fit")
            return none_value()
        }
        val lam = lower_expr(L, trail)
        if L.failed {
            return none_value()
        }
        present.set(nparam - 1, true)
        slots.set(nparam - 1, lam)
    }
    // Fill defaults with overlays so later defaults can see earlier args (echo).
    for pi in 0 as usize..nparam {
        if present.get(pi) {
            continue
        }
        if (pi as i64) >= (params.len as i64) {
            fail(L, node, "missing argument")
            return none_value()
        }
        val param = params.get(pi)
        val def = param_default(param)
        if def == null {
            fail(L, node, "missing argument")
            return none_value()
        }
        val saved_len = L.overlays.len
        for k in 0 as usize..nparam {
            if present.get(k) && (k as i64) < (params.len as i64) {
                val earlier = params.get(k)
                val esym = check.get_node_sym(earlier)
                if esym == null {
                    // Params may only have symbols on the binding; use decl's param symbol via name lookup in body.
                    // Checker attaches sym on PARAM nodes when present.
                }
                if esym != null {
                    var ov: Overlay
                    ov.symbol = esym
                    ov.value = slots.get(k)
                    L.overlays.push(ov)
                }
            }
        }
        val lowered = lower_expr(L, def!!)
        for L.overlays.len > saved_len {
            L.overlays.pop()
        }
        if L.failed {
            return none_value()
        }
        present.set(pi, true)
        slots.set(pi, lowered)
    }
    var args = list.empty<ir.Operand>()
    for pi in 0 as usize..nparam {
        args.push(slots.get(pi))
    }
    lower_context_args(L, node, fn_ty!!, &args)
    if L.failed {
        return none_value()
    }
    for ei in 0 as usize..extras.len {
        args.push(extras.get(ei))
    }
    val ty = check.get_node_ty(node)
    var dst: i32 = -1
    if ty != null && !check.type_is_unit(ty!!) {
        dst = new_local(L, "", ty) as i32
    }
    val inst = emit_inst(L, ir.op_kinds().CALL, dst, node_pos(L, node))
    if inst != null {
        inst!!.a = callee
        ir.set_args(inst!!, args)
    }
    if dst >= 0 {
        return local_operand(L, dst as u32)
    }
    return none_value()
}

private fn lower_cast(L: *Lower, node: *parse.Node): ir.Operand with (a: mem.Allocator) {
    if node.kids.len == 0 {
        return none_value()
    }
    val src = lower_expr(L, node.kids.get(0))
    val ty = check.get_node_ty(node)
    if ty != null && src.ty != null && check.type_same(src.ty!!, ty!!) {
        return src
    }
    // C const_eval / lower: int lit `as` host int → retyped INT (no CONVERT).
    if ty != null && check.type_is_host_int(ty!!) && src.kind == ir.operand_kinds().INT {
        return ir.int_op(ty, ir.int_operand_bits(src) as i64)
    }
    if want_cast_bitcast(src.ty, ty) {
        return emit_bitcast(L, src, ty, node_pos(L, node))
    }
    val dst = new_local(L, "", ty)
    val inst = emit_inst(L, ir.op_kinds().CONVERT, dst as i32, node_pos(L, node))
    if inst != null {
        inst!!.checked = true
        // Match C: keep int/float const operands; do not as_local.
        inst!!.a = src
    }
    return local_operand(L, dst)
}

private fn lower_logic(L: *Lower, node: *parse.Node, is_or: bool): ir.Operand with (a: mem.Allocator) {
    val ty = check.get_node_ty(node)
    val result = new_local(L, "", ty)
    val lhs = lower_expr(L, node.kids.get(0))
    var rhs_label = "and.rhs"
    var early_label = "and.false"
    var join_label = "and.join"
    if is_or {
        rhs_label = "or.rhs"
        early_label = "or.true"
        join_label = "or.join"
    }
    val rhs_b = new_block(L, rhs_label)
    val early = new_block(L, early_label)
    val join = new_block(L, join_label)
    if is_or {
        emit_cond(L, lhs, early, rhs_b, node_pos(L, node))
    } else {
        emit_cond(L, lhs, rhs_b, early, node_pos(L, node))
    }
    use_block(L, early)
    var bits: i64 = 0
    if is_or {
        bits = 1
    }
    emit_copy(L, result, ir.int_op(ty, bits), node_pos(L, node))
    emit_br(L, join, node_pos(L, node))
    use_block(L, rhs_b)
    val rhs = lower_expr(L, node.kids.get(1))
    if !L.terminated {
        emit_copy(L, result, rhs, node_pos(L, node))
        emit_br(L, join, node_pos(L, node))
    }
    use_block(L, join)
    return local_operand(L, result)
}
