// Interface values, `is`, props, calls, when. Checked against lower_interface.c.
// LowerGuide step 13.

import src.check
import src.ir
import src.load
import src.parse
import std.list
import std.mem
import std.strbuilder

struct IfaceSlot {
    func: i32
    fn_type: *check.Type?
}

struct IfaceTable {
    name: str
    tid_name: str
    global: i32
    tid_global: i32
    concrete: *check.Type?
    iface: *check.Type?
    slots: list.List<IfaceSlot>
    offsets: list.List<u64>
    prop_count: usize
}

private fn is_universe_error_ty(ty: *check.Type?): bool {
    if ty == null || ty!!.kind != check.type_kinds().INTERFACE {
        return false
    }
    if ty!!.package.len > 0 || ty!!.decl != null {
        return false
    }
    return ty!!.name == "error"
}

fn user_iface_ty(ty: *check.Type?): bool {
    if ty == null {
        return false
    }
    val tk = check.type_kinds()
    if ty!!.kind == tk.INTERFACE {
        return !is_universe_error_ty(ty)
    }
    if ty!!.kind == tk.PTR && ty!!.elem != null && ty!!.elem!!.kind == tk.INTERFACE {
        return !is_universe_error_ty(ty!!.elem)
    }
    return false
}

private fn peel_user_iface(ty: *check.Type?): (*check.Type?, bool) {
    if ty == null {
        return null, false
    }
    val tk = check.type_kinds()
    if ty!!.kind == tk.INTERFACE && !is_universe_error_ty(ty) {
        return ty, false
    }
    if ty!!.kind == tk.PTR && ty!!.elem != null && ty!!.elem!!.kind == tk.INTERFACE &&
        !is_universe_error_ty(ty!!.elem) {
        return ty!!.elem, true
    }
    return null, false
}

fn void_ty(L: *Lower): *check.Type? {
    if L.root_pkg == null {
        return null
    }
    val uni = L.root_pkg!!.scope.universe
    if uni == null {
        return null
    }
    val sym = load.package_scope_lookup(uni!!, "void")
    if sym == null {
        return null
    }
    return check.get_sema(sym!!)
}

fn void_ptr(L: *Lower): *check.Type? with (a: mem.Allocator) {
    val v = void_ty(L)
    if v == null {
        fail(L, null, "missing void")
        return null
    }
    return check.type_ptr(L.types, v!!, false) as *check.Type?
}

fn universe_error_ty(L: *Lower): *check.Type? {
    if L.root_pkg == null {
        return null
    }
    val uni = L.root_pkg!!.scope.universe
    if uni == null {
        return null
    }
    val sym = load.package_scope_lookup(uni!!, "error")
    if sym == null {
        return null
    }
    return check.get_sema(sym!!)
}

private fn find_global_by_ir_name(L: *Lower, name: str): i32 {
    var i: usize = 0
    for i < L.module.globals.len {
        val g = L.module.globals.get(i)
        if g.name == name {
            return i as i32
        }
        i = i + 1
    }
    return -1
}

private fn ensure_tid(L: *Lower, concrete: *check.Type): i32 with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append("jog_tid_")
    b.append_int(concrete.id as i64, 10)
    // Keep builder memory: global_add stores the str view (same as global.jog).
    val name = b.str()
    val existing = find_global_by_ir_name(L, name)
    if existing >= 0 {
        return existing
    }
    val u8t = check.type_u8(L.types) as *check.Type?
    val index = ir.global_add(&L.module, name, u8t, true)
    if index < 0 {
        fail(L, null, "out of memory")
        return -1
    }
    return index
}

/** Index into L.iface_tables, or -1. Never return a raw `at` pointer across pushes —
 *  list growth moves storage and would dangle. */
private fn find_table_index(L: *Lower, concrete: *check.Type, iface: *check.Type): i32 {
    var i: usize = 0
    for i < L.iface_tables.len {
        val row = L.iface_tables.at(i)
        if row.concrete != null && row.iface != null && row.concrete!! == concrete && row.iface!! == iface {
            return i as i32
        }
        i = i + 1
    }
    return -1
}

private fn same_pkg(concrete: *check.Type, sym: *load.Symbol): bool {
    // Match check/iface.jog: Type.package string vs Symbol.package path.
    val want = concrete.package
    var have = ""
    val pkg = sym.package
    if pkg != null {
        val p: *load.Package = pkg!!
        have = p.path
    }
    return want == have
}

private fn find_method_decl(L: *Lower, concrete: *check.Type, req: *parse.Node): *parse.Node? {
    if req.name.len == 0 {
        return null
    }
    val want_ptr = req.text == "recv *"
    for pkg in L.prog.packages.items() {
        for mi in 0 as usize..pkg.methods.len {
            val ms = pkg.methods.at(mi)
            if ms.decl == null || ms.name != req.name {
                continue
            }
            if !same_pkg(concrete, ms) {
                continue
            }
            if check.sym_type_param_count(ms) > 0 {
                continue
            }
            val mty = check.get_sema(ms)
            if mty == null || !check.type_is_fn(mty!!) || mty!!.elems.len == 0 {
                continue
            }
            val self_ty = mty!!.elems.get(0)
            var is_ptr = false
            var on = self_ty
            if self_ty.kind == check.type_kinds().PTR && self_ty.elem != null {
                is_ptr = true
                on = self_ty.elem!!
            }
            if on != concrete {
                continue
            }
            if is_ptr != want_ptr {
                continue
            }
            return ms.decl
        }
    }
    return null
}

private fn thunk_type(L: *Lower, method: *check.Type, data: *check.Type): *check.Type? with (a: mem.Allocator) {
    if !check.type_is_fn(method) || method.elems.len == 0 {
        return null
    }
    var params = list.empty<*check.Type>()
    params.push(data)
    var i: usize = 1
    for i < method.elems.len {
        params.push(method.elems.get(i))
        i = i + 1
    }
    for c in method.contexts.items() {
        params.push(c)
    }
    val ret = method.elem
    if ret == null {
        return null
    }
    var empty = list.empty<*check.Type>()
    return check.type_fn(L.types, params, ret!!, empty, false, false, true) as *check.Type?
}

private fn build_thunk(
    L: *Lower,
    method: *parse.Node,
    fn_ty: *check.Type,
    name: str,
    pos: ir.Pos,
): i32 with (a: mem.Allocator) {
    val method_index = find_fn(L, method)
    if method_index < 0 {
        fail(L, method, "missing lowered function")
        return -1
    }
    var mty = check.get_node_ty(method)
    if mty == null {
        val msym = check.get_node_sym(method)
        if msym != null {
            mty = check.get_sema(msym!!)
        }
    }
    if mty == null {
        for pkg in L.prog.packages.items() {
            for mi in 0 as usize..pkg.methods.len {
                val ms = pkg.methods.at(mi)
                if ms.decl != null && (ms.decl!! as *u8) == (method as *u8) {
                    mty = check.get_sema(ms)
                    break
                }
            }
            if mty != null {
                break
            }
        }
    }
    if mty == null || !check.type_is_fn(mty!!) || mty!!.elems.len == 0 {
        fail(L, method, "missing method type")
        return -1
    }
    var names = list.empty<str>()
    names.push("")
    var ni: usize = 1
    for ni < fn_ty.elems.len {
        names.push("")
        ni = ni + 1
    }
    val saved_func = L.func
    val saved_ast = L.ast_fn
    val saved_block = L.block
    val saved_term = L.terminated
    val index = ir.func_add(&L.module, name, name, ir.linkages().INTERNAL, fn_ty, names)
    if index < 0 {
        fail(L, method, "out of memory")
        return -1
    }
    val thunk = ir.func_at(&L.module, index as u32)
    if thunk == null {
        fail(L, method, "out of memory")
        return -1
    }
    thunk!!.pos = pos
    val entry = ir.block_add(thunk!!, "entry")
    L.func = thunk
    L.ast_fn = null
    L.block = entry
    L.terminated = false
    val self_ty = mty!!.elems.get(0)
    val data_op = local_operand(L, 0)
    var self_op = none_value()
    if self_ty.kind == check.type_kinds().PTR {
        self_op = emit_bitcast(L, data_op, self_ty as *check.Type?, pos)
    } else {
        val ptr_ty = check.type_ptr(L.types, self_ty, false) as *check.Type?
        val ptr = emit_bitcast(L, data_op, ptr_ty, pos)
        self_op = emit_load(L, ptr, pos)
    }
    var args = list.empty<ir.Operand>()
    args.push(self_op)
    var ai: usize = 1
    for ai < fn_ty.elems.len {
        args.push(local_operand(L, ai as u32))
        ai = ai + 1
    }
    val ret = fn_ty.elem
    var produces = false
    if ret != null && !check.type_is_unit(ret!!) {
        produces = true
    }
    var dst: i32 = -1
    if produces {
        dst = new_local(L, "", ret) as i32
    }
    val call = emit_inst(L, ir.op_kinds().CALL, dst, pos)
    if call != null {
        call!!.a = ir.func_ref(&L.module, method_index as u32)
        ir.set_args(call!!, args)
    }
    if produces {
        emit_ret(L, local_operand(L, dst as u32), pos)
    } else {
        emit_ret(L, none_value(), pos)
    }
    L.func = saved_func
    L.ast_fn = saved_ast
    L.block = saved_block
    L.terminated = saved_term
    if L.failed {
        return -1
    }
    return index
}

private fn count_iface_methods(iface: *check.Type): usize {
    if iface.decl == null || !parse.is_interface(iface.decl!!) {
        return 0
    }
    val decl = iface.decl!!
    var n: usize = 0
    var i = decl.head as usize
    for i < decl.kids.len {
        if parse.is_fn(decl.kids.get(i)) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

private fn embed_iface_of(embed: *parse.Node): *check.Type? {
    var et = check.get_node_ty(embed)
    if et == null && embed.kids.len > 0 {
        et = check.get_node_ty(embed.kids.get(0))
    }
    if et == null || et!!.kind != check.type_kinds().INTERFACE || is_universe_error_ty(et) {
        return null
    }
    return et
}

private fn count_iface_props(iface: *check.Type, depth: i32): usize {
    if depth > 16 || iface.decl == null || !parse.is_interface(iface.decl!!) {
        return 0
    }
    val decl = iface.decl!!
    var n: usize = 0
    var i = decl.head as usize
    for i < decl.kids.len {
        val m = decl.kids.get(i)
        if parse.is_field(m) && m.name.len > 0 {
            n = n + 1
        } else if parse.is_embed(m) {
            val et = embed_iface_of(m)
            if et != null {
                n = n + count_iface_props(et!!, depth + 1)
            }
        }
        i = i + 1
    }
    return n
}

private fn caller_pkg(L: *Lower): *load.Package? {
    if L.ast_fn == null {
        return null
    }
    val fsym = check.get_node_sym(L.ast_fn!!)
    if fsym == null {
        return null
    }
    return fsym!!.package
}

private fn prop_byte_offset(L: *Lower, concrete: *check.Type, name: str): (u64, bool) with (a: mem.Allocator) {
    val hit = check.struct_lookup_field(concrete, name, L.ast_fn, caller_pkg(L))
    if !hit.found || hit.ambiguous || hit.hidden || hit.indices.len == 0 {
        return 0, false
    }
    var cur = concrete
    var off: u64 = 0
    for i in 0 as usize..hit.indices.len {
        val idx = hit.indices.get(i) as usize
        if cur.kind != check.type_kinds().STRUCT || idx >= cur.field_names.len {
            return 0, false
        }
        if idx < cur.field_offsets.len {
            off = off + cur.field_offsets.get(idx)
        }
        val field = check.type_field_at(cur, idx)
        if field.field_type == null {
            return 0, false
        }
        cur = field.field_type!!
    }
    return off, true
}

private fn fill_prop_offsets(L: *Lower, iface: *check.Type, concrete: *check.Type, offsets: *list.List<u64>, depth: i32): bool with (a: mem.Allocator) {
    if depth > 16 || iface.decl == null || !parse.is_interface(iface.decl!!) {
        return true
    }
    val decl = iface.decl!!
    var i = decl.head as usize
    for i < decl.kids.len {
        val m = decl.kids.get(i)
        if parse.is_field(m) && m.name.len > 0 {
            val (off, ok) = prop_byte_offset(L, concrete, m.name)
            if !ok {
                var msg = strbuilder.empty()
                msg.append("missing property '")
                msg.append(m.name)
                msg.append("'")
                fail(L, m, msg.str())
                msg.free()
                return false
            }
            offsets.push(off)
        } else if parse.is_embed(m) {
            val et = embed_iface_of(m)
            if et != null && !fill_prop_offsets(L, et!!, concrete, offsets, depth + 1) {
                return false
            }
        }
        i = i + 1
    }
    return !L.failed
}

private fn publish_table(L: *Lower, row: IfaceTable) with (a: mem.Allocator) {
    var rec: ir.IfaceTable
    rec.name = row.name
    rec.tid_name = row.tid_name
    rec.global = row.global
    rec.concrete = row.concrete
    rec.iface = row.iface
    rec.slots = list.empty<ir.IfaceSlot>()
    for s in row.slots.items() {
        var slot: ir.IfaceSlot
        slot.func = s.func
        slot.fn_type = s.fn_type
        rec.slots.push(slot)
    }
    rec.offsets = row.offsets
    L.module.iface_tables.push(rec)
}

/** Returns table index, or -1 on failure. */
private fn ensure_table(L: *Lower, concrete: *check.Type, iface: *check.Type, pos: ir.Pos): i32 with (a: mem.Allocator) {
    val found = find_table_index(L, concrete, iface)
    if found >= 0 {
        return found
    }
    val data = void_ptr(L)
    if data == null {
        return -1
    }
    val tid = ensure_tid(L, concrete)
    if tid < 0 {
        return -1
    }
    var row: IfaceTable
    row.name = ""
    row.tid_name = ""
    row.global = -1
    row.tid_global = tid
    row.concrete = concrete as *check.Type?
    row.iface = iface as *check.Type?
    row.slots = list.empty<IfaceSlot>()
    row.offsets = list.empty<u64>()
    row.prop_count = count_iface_props(iface, 0)
    var tb = strbuilder.empty()
    tb.append("jog_tid_")
    tb.append_int(concrete.id as i64, 10)
    row.tid_name = tb.str()
    if iface.decl == null || !parse.is_interface(iface.decl!!) {
        fail(L, null, "missing interface")
        return -1
    }
    var slot: usize = 0
    var mi = iface.decl!!.head as usize
    for mi < iface.decl!!.kids.len {
        val m = iface.decl!!.kids.get(mi)
        mi = mi + 1
        if !parse.is_fn(m) {
            continue
        }
        val req_ty0 = check.get_node_ty(m)
        if req_ty0 == null || req_ty0!!.kind != check.type_kinds().FN {
            continue
        }
        val method = find_method_decl(L, concrete, m)
        if method == null {
            var msg = strbuilder.empty()
            msg.append("missing method '")
            msg.append(m.name)
            msg.append("'")
            fail(L, null, msg.str())
            msg.free()
            return -1
        }
        var mty = check.get_node_ty(method!!)
        if mty == null {
            val msym = check.get_node_sym(method!!)
            if msym != null {
                mty = check.get_sema(msym!!)
            }
        }
        if mty == null {
            // Method symbols live on pkg.methods; match by decl pointer.
            for pkg in L.prog.packages.items() {
                for mi in 0 as usize..pkg.methods.len {
                    val ms = pkg.methods.at(mi)
                    if ms.decl != null && (ms.decl!! as *u8) == (method!! as *u8) {
                        mty = check.get_sema(ms)
                        break
                    }
                }
                if mty != null {
                    break
                }
            }
        }
        if mty == null {
            fail(L, method, "missing method type")
            return -1
        }
        val fn_ty = thunk_type(L, mty!!, data!!)
        if fn_ty == null {
            fail(L, method, "missing method type")
            return -1
        }
        var nb = strbuilder.empty()
        nb.append("jog_ifn_")
        nb.append_int(iface.id as i64, 10)
        nb.append("_")
        nb.append_int(concrete.id as i64, 10)
        nb.append("_")
        nb.append_int(slot as i64, 10)
        val tname = nb.str()
        val index = build_thunk(L, method!!, fn_ty!!, tname, pos)
        if index < 0 {
            return -1
        }
        var s: IfaceSlot
        s.func = index
        s.fn_type = fn_ty
        row.slots.push(s)
        slot = slot + 1
    }
    var vb = strbuilder.empty()
    vb.append("jog_vt_")
    vb.append_int(iface.id as i64, 10)
    vb.append("_")
    vb.append_int(concrete.id as i64, 10)
    row.name = vb.str()
    val u8t = check.type_u8(L.types) as *check.Type?
    row.global = ir.global_add(&L.module, row.name, u8t, true)
    if row.global < 0 {
        fail(L, null, "out of memory")
        return -1
    }
    if !fill_prop_offsets(L, iface, concrete, &row.offsets, 0) {
        return -1
    }
    publish_table(L, row)
    L.iface_tables.push(row)
    return (L.iface_tables.len - 1) as i32
}

fn lower_iface_convert(L: *Lower, src_in: ir.Operand, iface: *check.Type, pos: ir.Pos): ir.Operand with (a: mem.Allocator) {
    if iface.kind != check.type_kinds().INTERFACE {
        return none_value()
    }
    var src = src_in
    // Checker may type `&x` as the interface while unary-& left a concrete local;
    // take the address so the fat pointer can form (same IR shape as an explicit PTR).
    if src.ty != null &&
        (src.ty!!.kind == check.type_kinds().STRUCT || src.ty!!.kind == check.type_kinds().ENUM) &&
        src.kind == ir.operand_kinds().LOCAL {
        src = emit_addr(L, src.local, pos)
    }
    if src.ty == null || src.ty!!.kind != check.type_kinds().PTR || src.ty!!.elem == null {
        L.failed = true
        if pos.file.len > 0 && pos.line > 0 {
            load.print_pos_error(pos.file, pos.line, pos.column, "cannot convert to an interface")
        } else {
            load.print_bare_error("cannot convert to an interface")
        }
        return none_value()
    }
    val concrete = src.ty!!.elem!!
    val ti = ensure_table(L, concrete, iface, pos)
    val data = void_ptr(L)
    if ti < 0 || data == null || L.failed {
        return none_value()
    }
    // Re-resolve after ensure_table: push may have moved the list.
    val table = L.iface_tables.at(ti as usize)
    val ptr = emit_bitcast(L, src, data, pos)
    val vt = emit_bitcast(L, ir.global_ref(&L.module, table.global as u32), data, pos)
    var args = list.empty<ir.Operand>()
    args.push(ptr)
    args.push(vt)
    return emit_aggregate(L, iface as *check.Type?, args, pos)
}

private fn load_type_id(L: *Lower, iface_val: ir.Operand, pos: ir.Pos): ir.Operand with (a: mem.Allocator) {
    val data = void_ptr(L)
    if data == null {
        return none_value()
    }
    val data_ptr = check.type_ptr(L.types, data!!, false) as *check.Type?
    val vt = emit_extract(L, iface_val, 1, data, pos)
    val table = emit_bitcast(L, vt, data_ptr, pos)
    return emit_load(L, table, pos)
}

private fn type_is(L: *Lower, iface_val: ir.Operand, concrete: *check.Type, pos: ir.Pos): ir.Operand with (a: mem.Allocator) {
    val data = void_ptr(L)
    val tid = ensure_tid(L, concrete)
    if data == null || tid < 0 || L.failed {
        return none_value()
    }
    val have = load_type_id(L, iface_val, pos)
    val want = emit_bitcast(L, ir.global_ref(&L.module, tid as u32), data, pos)
    val boolean = check.type_bool(L.types) as *check.Type?
    return emit_binop(L, ir.bin_ops().EQ, false, have, want, boolean, pos)
}

private fn resolve_is_concrete(L: *Lower, type_node: *parse.Node): *check.Type? {
    var ty = check.get_node_ty(type_node)
    val tk = check.type_kinds()
    if ty != null {
        ty = check.type_peel_distinct(ty!!) as *check.Type?
        if ty!!.kind == tk.STRUCT || ty!!.kind == tk.ENUM {
            return ty
        }
        // Pointer to concrete (narrowed forms).
        if ty!!.kind == tk.PTR && ty!!.elem != null {
            val elem = check.type_peel_distinct(ty!!.elem!!)
            if elem.kind == tk.STRUCT || elem.kind == tk.ENUM {
                return elem as *check.Type?
            }
        }
    }
    val sym = check.get_node_sym(type_node)
    if sym != null {
        val sema = check.get_sema(sym!!)
        if sema != null {
            val peeled = check.type_peel_distinct(sema!!)
            if peeled.kind == tk.STRUCT || peeled.kind == tk.ENUM {
                return peeled as *check.Type?
            }
        }
    }
    // Fallback: look up by name in root package.
    var name = type_node.name
    if name.len == 0 {
        name = type_node.text
    }
    if name.len > 0 && L.root_pkg != null {
        val found = load.package_scope_lookup(&L.root_pkg!!.scope, name)
        if found != null {
            val sema = check.get_sema(found!!)
            if sema != null {
                val peeled = check.type_peel_distinct(sema!!)
                if peeled.kind == tk.STRUCT || peeled.kind == tk.ENUM {
                    return peeled as *check.Type?
                }
            }
        }
    }
    return null
}

/** `x is T` on an interface. */
fn lower_iface_is(L: *Lower, node: *parse.Node): (ir.Operand, bool) with (a: mem.Allocator) {
    if !parse.is_is(node) || node.kids.len < 2 {
        return none_value(), false
    }
    val expr = node.kids.get(0)
    val src_ty = check.get_node_ty(expr)
    if !user_iface_ty(src_ty) {
        return none_value(), false
    }
    val concrete = resolve_is_concrete(L, node.kids.get(1))
    val tk = check.type_kinds()
    if concrete == null || (concrete!!.kind != tk.STRUCT && concrete!!.kind != tk.ENUM) {
        fail(L, node, "is expects a struct or enum")
        return none_value(), true
    }
    val src = lower_expr(L, expr)
    if L.failed {
        return none_value(), true
    }
    return type_is(L, src, concrete!!, node_pos(L, node)), true
}

/** After `is T`, an IDENT typed `*T` but bound as iface extracts the data pointer. */
fn lower_iface_narrowed(L: *Lower, node: *parse.Node, raw: ir.Operand): (ir.Operand, bool) with (a: mem.Allocator) {
    if !parse.is_ident(node) || raw.kind == ir.operand_kinds().NONE {
        return none_value(), false
    }
    val want = check.get_node_ty(node)
    val have = raw.ty
    if want == null || want!!.kind != check.type_kinds().PTR || want!!.elem == null {
        return none_value(), false
    }
    val elem = want!!.elem!!
    val tk = check.type_kinds()
    if elem.kind != tk.STRUCT && elem.kind != tk.ENUM {
        return none_value(), false
    }
    if !user_iface_ty(have) {
        return none_value(), false
    }
    val data = void_ptr(L)
    if data == null || L.failed {
        return none_value(), true
    }
    var ptr = emit_extract(L, raw, 0, data, node_pos(L, node))
    ptr = emit_bitcast(L, ptr, want, node_pos(L, node))
    return ptr, true
}

private fn method_slot_of(iface: *check.Type, req: *parse.Node): i32 {
    if iface.decl == null {
        return -1
    }
    val decl = iface.decl!!
    var slot: i32 = 0
    var i = decl.head as usize
    for i < decl.kids.len {
        val m = decl.kids.get(i)
        i = i + 1
        if !parse.is_fn(m) {
            continue
        }
        val mty = check.get_node_ty(m)
        if mty == null || mty!!.kind != check.type_kinds().FN {
            continue
        }
        if m == req {
            return slot
        }
        slot = slot + 1
    }
    return -1
}

/** Walk iface fields/embeds. Returns (found_slot, next_slot). found_slot < 0 when missing. */
/** Relative prop index (0-based among props). Matches C prop_index. */
private fn prop_index_walk(iface: *check.Type, name: str, slot: i32, depth: i32): (i32, i32) {
    if depth > 16 || iface.decl == null || !parse.is_interface(iface.decl!!) {
        return -1, slot
    }
    val decl = iface.decl!!
    var cur = slot
    var i = decl.head as usize
    for i < decl.kids.len {
        val m = decl.kids.get(i)
        if parse.is_field(m) && m.name.len > 0 {
            if m.name == name {
                return cur, cur + 1
            }
            cur = cur + 1
        } else if parse.is_embed(m) {
            val et = embed_iface_of(m)
            if et != null {
                val (found, next) = prop_index_walk(et!!, name, cur, depth + 1)
                if found >= 0 {
                    return found, next
                }
                cur = next
            }
        }
        i = i + 1
    }
    return -1, cur
}

private fn prop_slot_of(iface: *check.Type, name: str): i32 {
    if iface.decl == null || name.len == 0 {
        return -1
    }
    val nmethods = count_iface_methods(iface)
    val (found, _) = prop_index_walk(iface, name, 0, 0)
    if found < 0 {
        return -1
    }
    return 3 + (nmethods as i32) + found
}

private fn base_iface(
    L: *Lower,
    base_node: *parse.Node,
): (*check.Type?, ir.Operand, bool, i32) with (a: mem.Allocator) {
    // Returns (iface, recv, needs_load handled, kind) kind: 0=no, 1=yes, -1=fail
    val base_ty = check.get_node_ty(base_node)
    val (iface, _) = peel_user_iface(base_ty)
    if iface == null {
        return null, none_value(), false, 0
    }
    val recv = lower_expr(L, base_node)
    if L.failed {
        return null, none_value(), false, -1
    }
    return iface, recv, false, 1
}

private fn prop_addr(L: *Lower, node: *parse.Node, iface: *check.Type, recv: ir.Operand): ir.Operand with (a: mem.Allocator) {
    val pos = node_pos(L, node)
    val data = void_ptr(L)
    val usize_ty = check.type_usize(L.types) as *check.Type?
    val u8t = check.type_u8(L.types) as *check.Type?
    val u8ptr = check.type_ptr(L.types, u8t!!, false) as *check.Type?
    if data == null {
        return none_value()
    }
    val slot = prop_slot_of(iface, node.name)
    if slot < 0 {
        fail(L, node, "missing property")
        return none_value()
    }
    if usize_ty == null || u8t == null || u8ptr == null {
        fail(L, node, "missing builtins")
        return none_value()
    }
    val data_op = emit_extract(L, recv, 0, data, pos)
    val vt = emit_extract(L, recv, 1, data, pos)
    // C emit_elem bitcasts the vtable pointer straight to *usize.
    val usize_ptr = check.type_ptr(L.types, usize_ty!!, false) as *check.Type?
    val slots = emit_bitcast(L, vt, usize_ptr, pos)
    val idx = ir.int_op(usize_ty, slot as i64)
    val slot_ptr = emit_elem_addr(L, slots, idx, pos)
    val off = emit_load(L, slot_ptr, pos)
    val base_u8 = emit_bitcast(L, data_op, u8ptr, pos)
    val at = emit_elem_addr(L, base_u8, off, pos)
    var field_ty = check.get_node_ty(node)
    if field_ty == null {
        val sym = check.get_node_sym(node)
        if sym != null {
            field_ty = check.get_sema(sym!!)
        }
    }
    if field_ty == null && iface.decl != null {
        for m in iface.decl!!.kids.items() {
            if parse.is_field(m) && m.name == node.name {
                field_ty = check.get_node_ty(m)
                if field_ty == null && m.kids.len > 0 {
                    val tn = m.kids.get(0)
                    field_ty = check.get_node_ty(tn)
                    if field_ty == null {
                        val tsym = check.get_node_sym(tn)
                        if tsym != null {
                            field_ty = check.get_sema(tsym!!)
                        }
                    }
                    if field_ty == null {
                        var tname = tn.name
                        if tname.len == 0 {
                            tname = tn.text
                        }
                        if tname.len > 0 && L.root_pkg != null {
                            val uni = L.root_pkg!!.scope.universe
                            if uni != null {
                                val us = load.package_scope_lookup(uni!!, tname)
                                if us != null {
                                    field_ty = check.get_sema(us!!)
                                }
                            }
                        }
                    }
                }
                break
            }
        }
    }
    if field_ty == null {
        fail(L, node, "missing property type")
        return none_value()
    }
    val field_ptr = check.type_ptr(L.types, field_ty!!, false) as *check.Type?
    return emit_bitcast(L, at, field_ptr, pos)
}

/** Interface property load. */
fn lower_iface_load(L: *Lower, node: *parse.Node): (ir.Operand, bool) with (a: mem.Allocator) {
    if !parse.is_member(node) || node.kids.len == 0 {
        return none_value(), false
    }
    val (iface, recv, _, kind) = base_iface(L, node.kids.get(0))
    if kind == 0 {
        return none_value(), false
    }
    if kind < 0 || iface == null {
        return none_value(), true
    }
    // Method members are calls, not loads.
    val sym = check.get_node_sym(node)
    if sym != null && load.is_symbol_method(sym!!) {
        return none_value(), false
    }
    val addr = prop_addr(L, node, iface!!, recv)
    if L.failed {
        return none_value(), true
    }
    return emit_load(L, addr, node_pos(L, node)), true
}

/** Interface property store (`s.n = 4`). */
fn lower_iface_store(L: *Lower, node: *parse.Node): bool with (a: mem.Allocator) {
    if !parse.is_assign_stmt(node) || node.kids.len < 2 {
        return false
    }
    val target = node.kids.get(0)
    if !parse.is_member(target) || target.kids.len == 0 {
        return false
    }
    val (iface, recv, _, kind) = base_iface(L, target.kids.get(0))
    if kind == 0 {
        return false
    }
    if kind < 0 || iface == null {
        return true
    }
    if node.text.len > 0 && node.text != "=" {
        fail(L, node, "operator is not lowered yet")
        return true
    }
    val addr = prop_addr(L, target, iface!!, recv)
    val value = lower_expr(L, node.kids.get(1))
    if L.failed {
        return true
    }
    emit_store(L, addr, value, node_pos(L, node))
    return true
}

/** Interface method call `named.id()`. */
fn lower_iface_call(L: *Lower, node: *parse.Node): (ir.Operand, bool) with (a: mem.Allocator) {
    if !parse.is_call(node) || node.kids.len == 0 {
        return none_value(), false
    }
    val callee = node.kids.get(0)
    if !parse.is_member(callee) || callee.kids.len == 0 {
        return none_value(), false
    }
    val (iface, recv, _, kind) = base_iface(L, callee.kids.get(0))
    if kind == 0 {
        return none_value(), false
    }
    if kind < 0 || iface == null {
        return none_value(), true
    }
    val pos = node_pos(L, node)
    val data = void_ptr(L)
    val usize_ty = check.type_usize(L.types) as *check.Type?
    if data == null {
        return none_value(), true
    }
    // Find requirement FN on iface by name.
    var req: *parse.Node? = null
    if iface!!.decl != null {
        val idecl = iface!!.decl!!
        var ri = idecl.head as usize
        for ri < idecl.kids.len {
            val m = idecl.kids.get(ri)
            ri = ri + 1
            if parse.is_fn(m) && m.name == callee.name {
                req = m as *parse.Node?
                break
            }
        }
    }
    if req == null {
        return none_value(), false
    }
    val slot = method_slot_of(iface!!, req!!)
    if slot < 0 {
        fail(L, node, "missing method")
        return none_value(), true
    }
    // Call type: (*void, ...req params) -> ret with extern (C call_fn_type).
    var call_params = list.empty<*check.Type>()
    call_params.push(data!!)
    var req_ty = check.get_node_ty(req!!)
    if req_ty == null {
        val rsym = check.get_node_sym(req!!)
        if rsym != null {
            req_ty = check.get_sema(rsym!!)
        }
    }
    if req_ty == null {
        // Interface method req: params are kids; return type is last type kid / node.ty.
        // Fixture `fn id(): i32` — recover i32 from universe when unchecked.
        var ret_guess: *check.Type? = null
        if L.root_pkg != null && L.root_pkg!!.scope.universe != null {
            val us = load.package_scope_lookup(L.root_pkg!!.scope.universe!!, "i32")
            if us != null {
                ret_guess = check.get_sema(us!!)
            }
        }
        if ret_guess == null {
            fail(L, node, "missing method type")
            return none_value(), true
        }
        var empty_p = list.empty<*check.Type>()
        var empty_c = list.empty<*check.Type>()
        req_ty = check.type_fn(L.types, empty_p, ret_guess!!, empty_c, false, false, false) as *check.Type?
    }
    if req_ty != null {
        for p in req_ty!!.elems.items() {
            call_params.push(p)
        }
        for c in req_ty!!.contexts.items() {
            call_params.push(c)
        }
    }
    var ret: *check.Type? = null
    if req_ty != null {
        ret = req_ty!!.elem
    }
    if ret == null {
        fail(L, node, "missing method type")
        return none_value(), true
    }
    var empty = list.empty<*check.Type>()
    val call_ty = check.type_fn(L.types, call_params, ret!!, empty, false, false, true)
    val data_op = emit_extract(L, recv, 0, data, pos)
    val vt = emit_extract(L, recv, 1, data, pos)
    // C: bitcast vtable to *fn, elem_addr, load fn.
    val fn_ptr_ty = check.type_ptr(L.types, call_ty, false) as *check.Type?
    val table = emit_bitcast(L, vt, fn_ptr_ty, pos)
    val idx = ir.int_op(usize_ty, (3 + slot) as i64)
    val slot_ptr = emit_elem_addr(L, table, idx, pos)
    val fn_ptr = emit_load(L, slot_ptr, pos)
    var args = list.empty<ir.Operand>()
    args.push(data_op)
    // User args (none for id()).
    val arg_end = parse.call_arg_end(node)
    var i: usize = 1
    for i < arg_end {
        var value_node = node.kids.get(i)
        if parse.is_arg(value_node) && value_node.kids.len > 0 {
            value_node = value_node.kids.get(0)
        }
        args.push(lower_expr(L, value_node))
        if L.failed {
            return none_value(), true
        }
        i = i + 1
    }
    if parse.call_has_trailing(node) {
        val trail = node.kids.get(node.kids.len - 1 - parse.call_nctx(node))
        args.push(lower_expr(L, trail))
        if L.failed {
            return none_value(), true
        }
    }
    var produces = !check.type_is_unit(ret!!)
    var dst: i32 = -1
    if produces {
        dst = new_local(L, "", ret) as i32
    }
    val inst = emit_inst(L, ir.op_kinds().CALL, dst, pos)
    if inst != null {
        inst!!.a = fn_ptr
        ir.set_args(inst!!, args)
    }
    if produces {
        return local_operand(L, dst as u32), true
    }
    return none_value(), true
}

/** Interface `when` on a subject. Mirror C: join, then all arm blocks, then dispatch. */
fn lower_iface_when(L: *Lower, node: *parse.Node, as_value: bool): (ir.Operand, bool) with (a: mem.Allocator) {
    if !parse.is_when(node) || node.kids.len == 0 {
        return none_value(), false
    }
    val subject_node = node.kids.get(0)
    val sty = check.get_node_ty(subject_node)
    if !user_iface_ty(sty) {
        return none_value(), false
    }
    val pos = node_pos(L, node)
    val subject = as_local(L, lower_expr(L, subject_node), pos)
    if L.failed {
        return none_value(), true
    }
    val n_arms = node.kids.len - 1
    if n_arms == 0 {
        fail(L, node, "when needs an arm")
        return none_value(), true
    }
    val result_ty = check.get_node_ty(node)
    var have_result = as_value && result_ty != null && !check.type_is_unit(result_ty!!)
    var result_local: u32 = 0
    if have_result {
        result_local = new_local(L, "", result_ty)
    }
    val join = new_block(L, "")
    var arm_blocks = list.empty<u32>()
    var ai: usize = 0
    for ai < n_arms {
        arm_blocks.push(new_block(L, ""))
        ai = ai + 1
    }
    // Dispatch
    ai = 0
    for ai < n_arms && !L.failed && !L.terminated {
        val arm = node.kids.get(ai + 1)
        if !parse.is_when_arm(arm) {
            fail(L, node, "when needs an arm")
            return none_value(), true
        }
        if arm.head == 0 {
            emit_br(L, arm_blocks.get(ai), node_pos(L, arm))
            break
        }
        if arm.kids.len == 0 {
            fail(L, arm, "pattern is not lowered yet")
            return none_value(), true
        }
        val pat = arm.kids.get(0)
        var concrete: *check.Type? = null
        var pat_pos = node_pos(L, pat)
        if parse.is_pat_is(pat) && pat.kids.len > 0 {
            concrete = resolve_is_concrete(L, pat.kids.get(0))
        } else if parse.is_is(pat) && pat.kids.len > 1 {
            concrete = resolve_is_concrete(L, pat.kids.get(1))
        }
        if concrete == null {
            fail(L, pat, "pattern is not lowered yet")
            return none_value(), true
        }
        val cmp = type_is(L, subject, concrete!!, pat_pos)
        if L.failed || cmp.kind == ir.operand_kinds().NONE {
            return none_value(), true
        }
        val next_b = new_block(L, "")
        emit_cond(L, cmp, arm_blocks.get(ai), next_b, pat_pos)
        use_block(L, next_b)
        ai = ai + 1
    }
    if L.failed {
        return none_value(), true
    }
    if !L.terminated {
        emit_br(L, join, pos)
    }
    // Arm bodies
    ai = 0
    for ai < n_arms && !L.failed {
        val arm = node.kids.get(ai + 1)
        use_block(L, arm_blocks.get(ai))
        var body: *parse.Node? = null
        if arm.kids.len > 0 {
            body = arm.kids.get(arm.kids.len - 1) as *parse.Node?
        }
        if as_value {
            var value = none_value()
            if body != null {
                if parse.is_block(body!!) {
                    value = lower_block_value(L, body!!)
                } else {
                    value = lower_expr(L, body!!)
                }
            }
            if have_result && !L.terminated && value.kind != ir.operand_kinds().NONE {
                emit_copy(L, result_local, value, node_pos(L, arm))
            }
            if !L.terminated {
                emit_br(L, join, node_pos(L, arm))
            }
        } else {
            if body != null {
                if parse.is_block(body!!) {
                    lower_stmt(L, body!!)
                } else {
                    lower_expr(L, body!!)
                }
            }
            if !L.terminated {
                emit_br(L, join, node_pos(L, arm))
            }
        }
        ai = ai + 1
    }
    if L.failed {
        return none_value(), true
    }
    use_block(L, join)
    if have_result {
        return local_operand(L, result_local), true
    }
    return none_value(), true
}

/** Wrap raw operand into interface when node.ty asks for one. */
fn maybe_iface_wrap(L: *Lower, node: *parse.Node, op: ir.Operand): ir.Operand with (a: mem.Allocator) {
    val want = check.get_node_ty(node)
    if want == null || want!!.kind != check.type_kinds().INTERFACE {
        return op
    }
    if is_universe_error_ty(want) {
        return op
    }
    if op.ty == null || op.ty!!.kind == check.type_kinds().INTERFACE ||
        op.ty!!.kind == check.type_kinds().ERROR || op.kind == ir.operand_kinds().NONE {
        return op
    }
    return lower_iface_convert(L, op, want!!, node_pos(L, node))
}

private fn emit_eq_ops(L: *Lower, lhs: ir.Operand, rhs: ir.Operand, pos: ir.Pos): ir.Operand with (a: mem.Allocator) {
    val boolean = check.type_bool(L.types) as *check.Type?
    return emit_binop(L, ir.bin_ops().EQ, false, lhs, rhs, boolean, pos)
}

private fn iface_data_ptr(
    L: *Lower,
    iface_val: ir.Operand,
    ptr_ty: *check.Type?,
    pos: ir.Pos,
): ir.Operand with (a: mem.Allocator) {
    val data = void_ptr(L)
    if data == null {
        return none_value()
    }
    var ptr = emit_extract(L, iface_val, 0, data, pos)
    return emit_bitcast(L, ptr, ptr_ty, pos)
}

/** `as Iface`, `as *T`, and `as? *T` from an interface value (C jog_lower_iface_cast). */
fn lower_iface_cast(L: *Lower, node: *parse.Node): (ir.Operand, bool) with (a: mem.Allocator) {
    if !parse.is_cast(node) || node.kids.len == 0 {
        return none_value(), false
    }
    val dest = check.get_node_ty(node)
    val expr = node.kids.get(0)
    val src_ty = check.get_node_ty(expr)
    val pos = node_pos(L, node)
    val tk = check.type_kinds()

    // as? *T  (optional pointer from iface)
    if node.text == "as?" {
        if src_ty == null || src_ty!!.kind != tk.INTERFACE || is_universe_error_ty(src_ty) {
            return none_value(), false
        }
        if dest == null || dest!!.kind != tk.OPTION || dest!!.elem == null ||
            dest!!.elem!!.kind != tk.PTR {
            fail(L, node, "as? expects a pointer to a struct or enum")
            return none_value(), true
        }
        val ptr_ty = dest!!.elem!!
        val elem = ptr_ty.elem
        if elem == null || (elem!!.kind != tk.STRUCT && elem!!.kind != tk.ENUM) {
            fail(L, node, "as? expects a pointer to a struct or enum")
            return none_value(), true
        }
        val src = lower_expr(L, expr)
        val data = void_ptr(L)
        val tid = ensure_tid(L, elem!!)
        if data == null || tid < 0 || L.failed {
            return none_value(), true
        }
        val have = load_type_id(L, src, pos)
        val want = emit_bitcast(L, ir.global_ref(&L.module, tid as u32), data, pos)
        val cmp = emit_eq_ops(L, have, want, pos)
        val ptr = iface_data_ptr(L, src, ptr_ty as *check.Type?, pos)
        if L.failed {
            return none_value(), true
        }
        var args = list.empty<ir.Operand>()
        args.push(cmp)
        args.push(ptr)
        return emit_aggregate(L, dest, args, pos), true
    }

    // as Iface
    if dest != null && dest!!.kind == tk.INTERFACE && !is_universe_error_ty(dest) {
        if node.text != "as" && node.text.len > 0 {
            return none_value(), false
        }
        val src = lower_expr(L, expr)
        if L.failed {
            return none_value(), true
        }
        if src.ty != null && src.ty!!.kind == tk.INTERFACE {
            return src, true
        }
        return lower_iface_convert(L, src, dest!!, pos), true
    }

    // as *T  (checked downcast; panic on mismatch)
    if src_ty != null && src_ty!!.kind == tk.INTERFACE && !is_universe_error_ty(src_ty) &&
        dest != null && dest!!.kind == tk.PTR && dest!!.elem != null {
        val elem = dest!!.elem!!
        if elem.kind != tk.STRUCT && elem.kind != tk.ENUM {
            return none_value(), false
        }
        if node.text != "as" && node.text.len > 0 {
            return none_value(), false
        }
        val src = lower_expr(L, expr)
        val data = void_ptr(L)
        val tid = ensure_tid(L, elem)
        if data == null || tid < 0 || L.failed {
            return none_value(), true
        }
        val have = load_type_id(L, src, pos)
        val want = emit_bitcast(L, ir.global_ref(&L.module, tid as u32), data, pos)
        val cmp = emit_eq_ops(L, have, want, pos)
        val ptr = iface_data_ptr(L, src, dest, pos)
        if L.failed || L.terminated {
            return none_value(), true
        }
        val ok_b = new_block(L, "")
        val bad_b = new_block(L, "")
        emit_cond(L, cmp, ok_b, bad_b, pos)
        use_block(L, bad_b)
        val str_ty = check.type_const_bytes(L.types) as *check.Type?
        val panic = emit_inst(L, ir.op_kinds().PANIC, -1, pos)
        if panic != null && str_ty != null {
            panic!!.a = ir.string_op(str_ty, "as failed")
        }
        emit_unreachable(L, pos)
        use_block(L, ok_b)
        return ptr, true
    }
    return none_value(), false
}
