// Generic monomorphization (C lower_generic.c).

import src.check
import src.ir
import src.load
import src.parse
import std.list
import std.mem
import std.strbuilder

struct GenericInst {
    fn_decl: *parse.Node?
    jir_index: i32
    fn_type: *check.Type?
    args: list.List<*check.Type>
    body_done: bool
    key_sym: *load.Symbol?
}

fn generic_pending_push(L: *Lower, inst: GenericInst) with (a: mem.Allocator) {
    L.generic_pending.push(inst)
}

private fn same_args(inst: *GenericInst, args: list.List<*check.Type>): bool {
    if inst.args.len != args.len {
        return false
    }
    var i: usize = 0
    for i < args.len {
        if (inst.args.get(i) as *u8) != (args.get(i) as *u8) {
            return false
        }
        i = i + 1
    }
    return true
}

private fn find_inst(L: *Lower, sym: *load.Symbol, args: list.List<*check.Type>): i32 {
    var i: usize = 0
    for i < L.generic_pending.len {
        val inst = L.generic_pending.at(i)
        if inst.key_sym != null && (inst.key_sym!! as *u8) == (sym as *u8) && same_args(inst, args) {
            return inst.jir_index
        }
        i = i + 1
    }
    return -1
}

private fn append_mangle_type(b: *strbuilder.StrBuilder, ty: *check.Type?) with (a: mem.Allocator) {
    if ty == null {
        b.append("unknown")
        return
    }
    val t = ty!!
    val tk = check.type_kinds()
    if t.kind == tk.BOOL {
        b.append("bool")
        return
    }
    if t.kind == tk.INT {
        if t.int_is_size {
            if t.int_signed {
                b.append("isize")
            } else {
                b.append("usize")
            }
        } else if t.int_signed {
            b.append("i")
            b.append_int(t.int_bits as i64, 10)
        } else {
            b.append("u")
            b.append_int(t.int_bits as i64, 10)
        }
        return
    }
    if t.kind == tk.FLOAT {
        if t.float_bits == 32 {
            b.append("f32")
        } else {
            b.append("f64")
        }
        return
    }
    if t.kind == tk.UNIT {
        b.append("unit")
        return
    }
    if t.kind == tk.PTR {
        if t.is_const {
            b.append("cptr_")
        } else {
            b.append("ptr_")
        }
        append_mangle_type(b, t.elem)
        return
    }
    if t.kind == tk.STRUCT || t.kind == tk.ENUM || t.kind == tk.DISTINCT || t.kind == tk.INTERFACE {
        // Package keeps src.ir.IfaceTable and src.lower.IfaceTable apart
        // (C mangle_type).
        if t.package.len > 0 {
            append_c_piece(b, t.package)
            b.append("_")
        }
        if t.name.len > 0 {
            append_c_piece(b, t.name)
        } else {
            b.append("Type")
        }
        for e in t.elems.items() {
            b.append("_")
            append_mangle_type(b, e)
        }
        return
    }
    if t.kind == tk.TUPLE {
        b.append("tup")
        for e in t.elems.items() {
            b.append("_")
            append_mangle_type(b, e)
        }
        return
    }
    if t.kind == tk.OPTION {
        b.append("opt_")
        append_mangle_type(b, t.elem)
        return
    }
    b.append("t")
    b.append_int(t.id as i64, 10)
}

private fn inst_pkg(L: *Lower, sym: *load.Symbol?): *load.Package? {
    if sym != null && sym!!.package != null {
        return sym!!.package
    }
    return L.root_pkg
}

private fn mangle_instance(
    L: *Lower,
    fn_node: *parse.Node,
    sym: *load.Symbol?,
    args: list.List<*check.Type>,
): str with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append("jog_")
    val pkg = inst_pkg(L, sym)
    if pkg != null {
        append_c_piece(&b, pkg_source(L, pkg!!))
    } else {
        b.append("main")
    }
    b.append("__")
    // Methods: Type__name__args (C uses fn->symbol->package, not root).
    if parse.fn_has_receiver(fn_node) {
        val shape = fn_node.head
        val nattrs = (shape / 268435456) % 256
        var at = nattrs as usize
        if at < fn_node.kids.len {
            val recv = fn_node.kids.get(at)
            if recv.name.len > 0 {
                append_c_piece(&b, recv.name)
                b.append("__")
            } else if parse.is_type_name(recv) && recv.text.len > 0 {
                append_c_piece(&b, recv.text)
                b.append("__")
            }
        }
    }
    append_c_piece(&b, fn_node.name)
    for arg in args.items() {
        b.append("__")
        append_mangle_type(&b, arg)
    }
    return b.str()
}

private fn jog_instance_name(
    L: *Lower,
    fn_node: *parse.Node,
    sym: *load.Symbol?,
    args: list.List<*check.Type>,
): str with (a: mem.Allocator) {
    var b = strbuilder.empty()
    val pkg = inst_pkg(L, sym)
    if pkg != null {
        b.append(pkg_source(L, pkg!!))
    } else {
        b.append("main")
    }
    b.append(".")
    if parse.fn_has_receiver(fn_node) {
        val shape = fn_node.head
        val nattrs = (shape / 268435456) % 256
        var at = nattrs as usize
        if at < fn_node.kids.len {
            val recv = fn_node.kids.get(at)
            if recv.name.len > 0 {
                b.append(recv.name)
                b.append(".")
            } else if parse.is_type_name(recv) {
                if recv.text.len > 0 {
                    b.append(recv.text)
                } else if recv.name.len > 0 {
                    b.append(recv.name)
                }
                b.append(".")
            }
        }
    }
    b.append(fn_node.name)
    b.append("<")
    var i: usize = 0
    for i < args.len {
        if i > 0 {
            b.append(", ")
        }
        b.append(check.type_print(args.get(i)))
        i = i + 1
    }
    b.append(">")
    return b.str()
}

private fn declare_inst(
    L: *Lower,
    fn_node: *parse.Node,
    sym: *load.Symbol?,
    fn_ty: *check.Type,
    args: list.List<*check.Type>,
): i32 with (a: mem.Allocator) {
    val ty = jir_fn_type(L, fn_ty)
    if ty == null {
        fail(L, fn_node, "generic type was not instantiated")
        return -1
    }
    val name = mangle_instance(L, fn_node, sym, args)
    val jog_name = jog_instance_name(L, fn_node, sym, args)
    val names = fn_param_names(fn_node, ty!!.elems.len)
    val index = ir.func_add(&L.module, name, jog_name, linkage_of(fn_node), ty!!, names)
    if index < 0 {
        fail(L, fn_node, "out of memory")
        return -1
    }
    val func = ir.func_at(&L.module, index as u32)
    if func != null {
        // C uses fn->pos (declaring file), not the call-site L.file.
        var file = L.file
        if sym != null && sym!!.file.len > 0 {
            file = sym!!.file
        }
        func!!.pos = ir.pos_of(file, fn_node.line, fn_node.column)
    }
    return index
}

/**
 * Ensure a monomorphized callee exists for this generic call. Returns JIR func index.
 */
fn generic_callee(L: *Lower, call: *parse.Node): i32 with (a: mem.Allocator) {
    if call.solved_type_args.len == 0 || call.kids.len == 0 {
        fail(L, call, "missing generic instance")
        return -1
    }
    val callee = call.kids.get(0)
    var sym = check.get_node_sym(callee)
    if sym == null {
        sym = check.get_node_sym(call)
    }
    if sym == null || sym!!.decl == null || !parse.is_fn(sym!!.decl!!) {
        fail(L, call, "missing generic instance")
        return -1
    }
    val fn_node = sym!!.decl!!
    var args = list.empty<*check.Type>()
    for raw in call.solved_type_args.items() {
        var a_ty = raw as *check.Type
        val sub = lower_type_subst(L, a_ty)
        if sub != null {
            a_ty = sub!!
        }
        if check.generic_has_param(a_ty) {
            fail(L, call, "generic type was not instantiated")
            return -1
        }
        args.push(a_ty)
    }
    val hit = find_inst(L, sym!!, args)
    if hit >= 0 {
        return hit
    }
    // Prefer the checker-instantiated callee type (already Box<i64> etc.).
    var sig = check.get_node_ty(callee)
    if sig == null || !check.type_is_fn(sig!!) || check.generic_has_param(sig!!) {
        var template = check.get_sema(sym!!)
        if template == null || !check.type_is_fn(template!!) {
            template = sig
        }
        var params = list.empty<*check.Type>()
        val n = check.sym_type_param_count(sym!!)
        var pi: usize = 0
        for pi < n {
            val p = check.sym_type_param_at(sym!!, pi)
            if p != null {
                params.push(p!!)
            }
            pi = pi + 1
        }
        sig = instantiate_fn_type(L, template, params, args)
    }
    if sig == null || !check.type_is_fn(sig!!) || check.generic_has_param(sig!!) {
        fail(L, call, "generic type was not instantiated")
        return -1
    }
    val index = declare_inst(L, fn_node, sym, sig!!, args)
    if index < 0 {
        return -1
    }
    var inst: GenericInst
    inst.fn_decl = fn_node as *parse.Node?
    inst.jir_index = index
    inst.fn_type = sig
    inst.args = args
    inst.body_done = false
    inst.key_sym = sym
    L.generic_pending.push(inst)
    return index
}

/** Lower one pending monomorphized body. Returns false when none left. */
fn generic_take_and_lower(L: *Lower): bool with (a: mem.Allocator) {
    var i: usize = 0
    for i < L.generic_pending.len {
        val inst = L.generic_pending.at(i)
        if inst.body_done || inst.fn_decl == null {
            i = i + 1
            continue
        }
        inst.body_done = true
        L.subst_params = list.empty<*check.Type>()
        L.subst_args = list.empty<*check.Type>()
        if inst.key_sym != null {
            val n = check.sym_type_param_count(inst.key_sym!!)
            var pi: usize = 0
            for pi < n {
                val p = check.sym_type_param_at(inst.key_sym!!, pi)
                if p != null {
                    L.subst_params.push(p!!)
                }
                pi = pi + 1
            }
        }
        for a_ty in inst.args.items() {
            L.subst_args.push(a_ty)
        }
        L.func = ir.func_at(&L.module, inst.jir_index as u32)
        if L.func == null {
            fail(L, inst.fn_decl, "missing lowered function")
            return true
        }
        val saved_file = L.file
        if inst.key_sym != null && inst.key_sym!!.file.len > 0 {
            L.file = inst.key_sym!!.file
        }
        lower_body(L, inst.fn_decl!!)
        L.file = saved_file
        L.subst_params = list.empty<*check.Type>()
        L.subst_args = list.empty<*check.Type>()
        L.ast_fn = null
        return true
    }
    return false
}

/** Hold-open sentinel: one empty field name and no field types. */
private fn struct_fields_ready(ty: *check.Type): bool {
    if ty.field_types.len > 0 {
        return true
    }
    if ty.field_names.len == 1 && ty.field_names.get(0).len == 0 {
        return false
    }
    return ty.field_names.len == 0 && ty.has_layout
}

/**
 * Concrete struct the checker did not record. Field types are the template
 * fields with this symbol's type parameters replaced by args (C
 * jog_generic_struct_instance).
 */
private fn ensure_struct_instance(
    L: *Lower,
    sym: *load.Symbol,
    args: list.List<*check.Type>,
    existing: *check.Type?,
): *check.Type? with (a: mem.Allocator) {
    val tmpl = check.get_sema(sym)
    if tmpl == null || tmpl!!.kind != check.type_kinds().STRUCT {
        return existing
    }
    var params = list.empty<*check.Type>()
    var pi: usize = 0
    val nparam = check.sym_type_param_count(sym)
    for pi < nparam {
        val p = check.sym_type_param_at(sym, pi)
        if p != null {
            params.push(p!!)
        }
        pi = pi + 1
    }
    if params.len != args.len {
        return existing
    }
    var inst = existing
    if inst == null {
        val created = check.type_new_nominal(L.types, check.type_kinds().STRUCT, tmpl!!.name, tmpl!!.package)
        created.decl = tmpl!!.decl
        for arg in args.items() {
            created.elems.push(arg)
        }
        check.sym_push_nominal(sym, created)
        inst = created as *check.Type?
    }
    val got = inst!!
    var names = list.empty<str>()
    var types = list.empty<*check.Type>()
    var embedded = list.empty<bool>()
    var decls = list.empty<*parse.Node>()
    var fi: usize = 0
    for fi < tmpl!!.field_names.len {
        val src = tmpl!!.field_types.get(fi)
        val field_type = instantiate_type(L, src, params, args)
        if field_type == null {
            return null
        }
        names.push(tmpl!!.field_names.get(fi))
        types.push(field_type!!)
        if fi < tmpl!!.field_embedded.len {
            embedded.push(tmpl!!.field_embedded.get(fi))
        } else {
            embedded.push(false)
        }
        if fi < tmpl!!.field_decls.len {
            decls.push(tmpl!!.field_decls.get(fi))
        }
        fi = fi + 1
    }
    check.type_set_fields(got, names, types, embedded, decls)
    if !check.generic_has_param(got as *check.Type?) {
        _ = check.type_layout(L.types, got)
    }
    return got as *check.Type?
}

fn lower_type_subst(L: *Lower, ty: *check.Type?): *check.Type? with (a: mem.Allocator) {
    if ty == null || L.subst_params.len == 0 {
        return ty
    }
    return instantiate_type(L, ty!!, L.subst_params, L.subst_args)
}

private fn instantiate_type(
    L: *Lower,
    typ: *check.Type,
    params: list.List<*check.Type>,
    args: list.List<*check.Type>,
): *check.Type? with (a: mem.Allocator) {
    val tk = check.type_kinds()
    if typ.kind == tk.TYPE_PARAM {
        var i: usize = 0
        for i < params.len {
            if (params.get(i) as *u8) == (typ as *u8) {
                if i < args.len {
                    return args.get(i) as *check.Type?
                }
            }
            i = i + 1
        }
        return typ as *check.Type?
    }
    if !check.generic_has_param(typ) {
        return typ as *check.Type?
    }
    if typ.kind == tk.PTR && typ.elem != null {
        val elem = instantiate_type(L, typ.elem!!, params, args)
        if elem == null {
            return null
        }
        return check.type_ptr(L.types, elem!!, typ.is_const) as *check.Type?
    }
    if typ.kind == tk.OPTION && typ.elem != null {
        val elem = instantiate_type(L, typ.elem!!, params, args)
        if elem == null {
            return null
        }
        return check.type_option(L.types, elem!!) as *check.Type?
    }
    if typ.kind == tk.TUPLE {
        var elems = list.empty<*check.Type>()
        for e in typ.elems.items() {
            val s = instantiate_type(L, e, params, args)
            if s == null {
                return null
            }
            elems.push(s!!)
        }
        return check.type_tuple(L.types, elems) as *check.Type?
    }
    if typ.kind == tk.FN {
        return instantiate_fn_type(L, typ as *check.Type?, params, args)
    }
    if typ.kind == tk.SLICE && typ.elem != null {
        val elem = instantiate_type(L, typ.elem!!, params, args)
        if elem == null {
            return null
        }
        return check.type_slice(L.types, elem!!, typ.is_const) as *check.Type?
    }
    if typ.kind == tk.ARRAY && typ.elem != null {
        val elem = instantiate_type(L, typ.elem!!, params, args)
        if elem == null {
            return null
        }
        return check.type_array(L.types, elem!!, typ.len) as *check.Type?
    }
    // Box<T> → Box<i32>: look up the checker's nominal instance.
    if (typ.kind == tk.STRUCT || typ.kind == tk.ENUM) && typ.elems.len > 0 {
        var next = list.empty<*check.Type>()
        var changed = false
        for e in typ.elems.items() {
            val part = instantiate_type(L, e, params, args)
            if part == null {
                return null
            }
            if (part!! as *u8) != (e as *u8) {
                changed = true
            }
            next.push(part!!)
        }
        if !changed {
            return typ as *check.Type?
        }
        val sym = check.find_nominal_symbol(L.prog, typ)
        if sym == null {
            return typ as *check.Type?
        }
        val found = check.find_nominal_instance(sym!!, next)
        if found != null && (typ.kind != tk.STRUCT || struct_fields_ready(found!!)) {
            return found
        }
        if typ.kind == tk.STRUCT {
            val built = ensure_struct_instance(L, sym!!, next, found)
            if built != null {
                return built
            }
        }
        return typ as *check.Type?
    }
    return typ as *check.Type?
}

private fn instantiate_fn_type(
    L: *Lower,
    template: *check.Type?,
    params: list.List<*check.Type>,
    args: list.List<*check.Type>,
): *check.Type? with (a: mem.Allocator) {
    if template == null || !check.type_is_fn(template!!) {
        return null
    }
    val fn_ty = template!!
    var param_tys = list.empty<*check.Type>()
    for p in fn_ty.elems.items() {
        val s = instantiate_type(L, p, params, args)
        if s == null {
            return null
        }
        param_tys.push(s!!)
    }
    var ret = fn_ty.elem
    if ret != null {
        ret = instantiate_type(L, ret!!, params, args)
    }
    if ret == null {
        ret = check.type_unit(L.types) as *check.Type?
    }
    var contexts = list.empty<*check.Type>()
    for c in fn_ty.contexts.items() {
        val s = instantiate_type(L, c, params, args)
        if s == null {
            return null
        }
        contexts.push(s!!)
    }
    return check.type_fn(
        L.types,
        param_tys,
        ret!!,
        contexts,
        fn_ty.fn_variadic,
        fn_ty.fn_escaping,
        fn_ty.fn_extern,
    ) as *check.Type?
}
