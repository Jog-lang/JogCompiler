// Interpolation and fmt. Checked against compiler/src/lower_string.c.
// LowerGuide step 11.

import src.check
import src.ir
import src.parse
import std.list
import std.mem

private fn piece_int(): i32 { return 1 }
private fn piece_uint(): i32 { return 2 }
private fn piece_bool(): i32 { return 3 }
private fn piece_bytes(): i32 { return 4 }
private fn piece_method(): i32 { return 5 }

private struct FmtTypes {
    i32: *check.Type?
    i64: *check.Type?
    u64: *check.Type?
    usize: *check.Type?
    boolean: *check.Type?
    ptr_u8: *check.Type?
    ptr_const_u8: *check.Type?
    ptr_i32: *check.Type?
}

/** Match C JogStringFormat — fixed path, no nested List inside Piece. */
private val FORMAT_PATH_MAX: usize = 8

private struct FmtMethod {
    fn_node: *parse.Node?
    is_ptr: bool
    path_len: u8
    path0: u32
    path1: u32
    path2: u32
    path3: u32
    path4: u32
    path5: u32
    path6: u32
    path7: u32
}

private struct Piece {
    value: ir.Operand
    kind: i32
    pos: ir.Pos
    method: FmtMethod
}

private fn empty_method(): FmtMethod {
    var m: FmtMethod
    m.fn_node = null
    m.is_ptr = false
    m.path_len = 0
    m.path0 = 0
    m.path1 = 0
    m.path2 = 0
    m.path3 = 0
    m.path4 = 0
    m.path5 = 0
    m.path6 = 0
    m.path7 = 0
    return m
}

private fn path_at(m: FmtMethod, i: usize): u32 {
    if i == 0 {
        return m.path0
    }
    if i == 1 {
        return m.path1
    }
    if i == 2 {
        return m.path2
    }
    if i == 3 {
        return m.path3
    }
    if i == 4 {
        return m.path4
    }
    if i == 5 {
        return m.path5
    }
    if i == 6 {
        return m.path6
    }
    return m.path7
}

private fn path_set(m: *FmtMethod, i: usize, v: u32) {
    if i == 0 {
        m.path0 = v
    } else if i == 1 {
        m.path1 = v
    } else if i == 2 {
        m.path2 = v
    } else if i == 3 {
        m.path3 = v
    } else if i == 4 {
        m.path4 = v
    } else if i == 5 {
        m.path5 = v
    } else if i == 6 {
        m.path6 = v
    } else {
        m.path7 = v
    }
}

private fn path_from_list(m: *FmtMethod, path: list.List<u32>) {
    var n = path.len
    if n > FORMAT_PATH_MAX {
        n = FORMAT_PATH_MAX
    }
    m.path_len = n as u8
    var i: usize = 0
    for i < n {
        path_set(m, i, path.get(i))
        i = i + 1
    }
}

private fn load_fmt_types(L: *Lower, pos: ir.Pos): (FmtTypes, bool) with (a: mem.Allocator) {
    var t: FmtTypes
    t.i32 = check.type_i32(L.types) as *check.Type?
    t.i64 = check.type_i64(L.types) as *check.Type?
    t.u64 = check.type_u64(L.types) as *check.Type?
    t.usize = check.type_usize(L.types) as *check.Type?
    t.boolean = check.type_bool(L.types) as *check.Type?
    val u8t = check.type_u8(L.types) as *check.Type?
    if u8t == null || t.i32 == null || t.i64 == null || t.u64 == null || t.usize == null || t.boolean == null {
        fail(L, null, "out of memory")
        return t, false
    }
    t.ptr_u8 = check.type_ptr(L.types, u8t!!, false) as *check.Type?
    t.ptr_const_u8 = check.type_ptr(L.types, u8t!!, true) as *check.Type?
    t.ptr_i32 = check.type_ptr(L.types, t.i32!!, false) as *check.Type?
    if t.ptr_u8 == null || t.ptr_const_u8 == null || t.ptr_i32 == null {
        fail(L, null, "out of memory")
        return t, false
    }
    _ = pos
    return t, true
}

private fn piece_kind(ty: *check.Type?): i32 {
    if ty == null {
        return 0
    }
    val base = check.type_peel_distinct(ty!!)
    val tk = check.type_kinds()
    if base.kind == tk.BOOL {
        return piece_bool()
    }
    if base.kind == tk.BYTES {
        return piece_bytes()
    }
    if base.kind == tk.UNTYPED_INT {
        return piece_int()
    }
    if base.kind == tk.INT {
        if base.int_signed {
            return piece_int()
        }
        return piece_uint()
    }
    return 0
}

private fn call_extern_args(
    L: *Lower,
    fn_i: i32,
    args: list.List<ir.Operand>,
    pos: ir.Pos,
): ir.Operand with (a: mem.Allocator) {
    if fn_i < 0 || L.failed {
        return none_value()
    }
    val func = ir.func_at(&L.module, fn_i as u32)
    var ret: *check.Type? = null
    if func != null && func!!.ty != null && check.type_is_fn(func!!.ty!!) {
        ret = func!!.ty!!.elem
    }
    val dst = new_local(L, "", ret)
    val inst = emit_inst(L, ir.op_kinds().CALL, dst as i32, pos)
    if inst != null {
        inst!!.a = ir.func_ref(&L.module, fn_i as u32)
        ir.set_args(inst!!, args)
    }
    return local_operand(L, dst)
}

private fn scalar_fn(L: *Lower, t: *FmtTypes, kind: i32, pos: ir.Pos): i32 with (a: mem.Allocator) {
    var params = list.empty<*check.Type>()
    params.push(t.ptr_u8!!)
    params.push(t.usize!!)
    params.push(t.usize!!)
    var name = "jogrt_fmt_i64"
    var value = t.i64!!
    if kind == piece_bool() {
        name = "jogrt_fmt_bool"
        value = t.boolean!!
    } else if kind == piece_uint() {
        name = "jogrt_fmt_u64"
        value = t.u64!!
    }
    params.push(value)
    params.push(t.ptr_i32!!)
    return ensure_extern(L, name, params, t.usize!!)
}

private fn bytes_fn(L: *Lower, t: *FmtTypes, pos: ir.Pos): i32 with (a: mem.Allocator) {
    var params = list.empty<*check.Type>()
    params.push(t.ptr_u8!!)
    params.push(t.usize!!)
    params.push(t.usize!!)
    params.push(t.ptr_const_u8!!)
    params.push(t.usize!!)
    params.push(t.ptr_i32!!)
    _ = pos
    return ensure_extern(L, "jogrt_fmt_bytes", params, t.usize!!)
}

private fn format_owner(ty: *check.Type): *check.Type {
    if ty.kind == check.type_kinds().PTR && ty.elem != null {
        return ty.elem!!
    }
    return ty
}

private fn nominal_user(ty: *check.Type): bool {
    val k = ty.kind
    val tk = check.type_kinds()
    return k == tk.STRUCT || k == tk.ENUM || k == tk.DISTINCT
}

private fn collect_embed_path(
    outer: *check.Type,
    inner: *check.Type,
    prefix: list.List<u32>,
    best: *list.List<u32>,
    count: *i64,
) with (a: mem.Allocator) {
    if outer.kind != check.type_kinds().STRUCT || prefix.len > 16 {
        return
    }
    if outer == inner {
        if count[0] == 0 || prefix.len < best[0].len {
            best[0] = prefix
            count[0] = 1
        } else if prefix.len == best[0].len {
            count[0] = count[0] + 1
        }
        return
    }
    var i: usize = 0
    for i < check.type_field_count(outer) {
        val f = check.type_field_at(outer, i)
        if f.embedded && f.field_type != null && f.field_type!!.kind == check.type_kinds().STRUCT {
            var path = list.empty<u32>()
            var pi: usize = 0
            for pi < prefix.len {
                path.push(prefix.get(pi))
                pi = pi + 1
            }
            path.push(i as u32)
            collect_embed_path(f.field_type!!, inner, path, best, count)
        }
        i = i + 1
    }
}

private fn format_signature_ok(L: *Lower, fn_ty: *check.Type): bool {
    if !check.type_is_fn(fn_ty) || fn_ty.contexts.len > 0 || fn_ty.elems.len != 2 || fn_ty.fn_variadic {
        return false
    }
    val buf = fn_ty.elems.get(1)
    val base = check.type_peel_distinct(buf)
    if base.kind != check.type_kinds().BYTES || base.is_const {
        return false
    }
    val ret = fn_ty.elem
    if ret == null || ret!!.kind != check.type_kinds().TUPLE || ret!!.elems.len != 2 {
        return false
    }
    val s0 = ret!!.elems.get(0)
    if !(s0.kind == check.type_kinds().DISTINCT && s0.name == "str" && s0.package.len == 0) {
        return false
    }
    val opt = ret!!.elems.get(1)
    if opt.kind != check.type_kinds().OPTION || opt.elem == null {
        return false
    }
    val err = opt.elem!!
    return err.kind == check.type_kinds().INTERFACE && err.name == "error" && err.package.len == 0
}

/** Fill method; returns 0 none, 1 ok, 2 bad, 3 ambiguous. */
private fn find_format_method(L: *Lower, ty: *check.Type, out: *FmtMethod): i32 with (a: mem.Allocator) {
    val owner = format_owner(ty)
    if !nominal_user(owner) {
        return 0
    }
    var count: i64 = 0
    var best = empty_method()
    var best_len: i64 = 999
    for pkg in L.prog.packages.items() {
        for mi in 0 as usize..pkg.methods.len {
            val ms = pkg.methods.at(mi)
            if ms.name != "format" || ms.decl == null {
                continue
            }
            val fn_ty = check.get_sema(ms)
            if fn_ty == null || !check.type_is_fn(fn_ty!!) || fn_ty!!.elems.len == 0 {
                continue
            }
            val recv = fn_ty!!.elems.get(0)
            var is_ptr = false
            var on = recv
            if recv.kind == check.type_kinds().PTR && recv.elem != null {
                is_ptr = true
                on = recv.elem!!
            }
            if !nominal_user(on) || on.elems.len > 0 {
                continue
            }
            var matched = false
            var path = list.empty<u32>()
            if on == owner || (on.decl != null && owner.decl != null && on.decl == owner.decl) {
                matched = true
            } else if owner.kind == check.type_kinds().STRUCT {
                var best_path = list.empty<u32>()
                var n: i64 = 0
                var prefix = list.empty<u32>()
                collect_embed_path(owner, on, prefix, &best_path, &n)
                if n == 1 && best_path.len > 0 {
                    matched = true
                    path = best_path
                }
            }
            if !matched {
                continue
            }
            if !format_signature_ok(L, fn_ty!!) {
                continue
            }
            val plen = path.len as i64
            if count == 0 || plen < best_len {
                best.fn_node = ms.decl
                best.is_ptr = is_ptr
                path_from_list(&best, path)
                best_len = plen
                count = 1
            } else if plen == best_len {
                count = count + 1
            }
        }
    }
    if count > 1 {
        return 3
    }
    if count == 1 {
        out[0] = best
        return 1
    }
    return 0
}

private fn overflow_ptr(
    L: *Lower,
    t: *FmtTypes,
    pos: ir.Pos,
): (ir.Operand, ir.Operand, bool) with (a: mem.Allocator) {
    val flag = new_local(L, "", t.i32)
    zero_local(L, flag, pos)
    val ptr = emit_addr(L, flag, pos)
    return local_operand(L, flag), ptr, !L.failed
}

private fn format_piece(
    L: *Lower,
    t: *FmtTypes,
    dst: ir.Operand,
    cap: ir.Operand,
    at_in: ir.Operand,
    ovptr: ir.Operand,
    piece: *Piece,
): ir.Operand with (a: mem.Allocator) {
    var at = at_in
    if piece.kind == piece_method() {
        return format_user(L, t, dst, cap, at, ovptr, piece)
    }
    if piece.kind == piece_bytes() {
        val base = check.type_peel_distinct(piece.value.ty!!)
        var ptr_ty = t.ptr_u8
        if base.is_const {
            ptr_ty = t.ptr_const_u8
        }
        val ptr = emit_extract(L, piece.value, 0, ptr_ty, piece.pos)
        val len = emit_extract(L, piece.value, 1, t.usize, piece.pos)
        val fn_i = bytes_fn(L, t, piece.pos)
        var args = list.empty<ir.Operand>()
        args.push(dst)
        args.push(cap)
        args.push(at)
        args.push(ptr)
        args.push(len)
        args.push(ovptr)
        return call_extern_args(L, fn_i, args, piece.pos)
    }
    var value = piece.value
    if piece.kind == piece_uint() {
        value = emit_convert_ex(L, piece.value, t.u64, piece.pos, false)
    } else if piece.kind != piece_bool() {
        value = emit_convert_ex(L, piece.value, t.i64, piece.pos, false)
    }
    if L.failed {
        return none_value()
    }
    val fn_i = scalar_fn(L, t, piece.kind, piece.pos)
    var args = list.empty<ir.Operand>()
    args.push(dst)
    args.push(cap)
    args.push(at)
    args.push(value)
    args.push(ovptr)
    return call_extern_args(L, fn_i, args, piece.pos)
}

private fn format_user(
    L: *Lower,
    t: *FmtTypes,
    dst: ir.Operand,
    cap: ir.Operand,
    at_in: ir.Operand,
    ovptr: ir.Operand,
    piece: *Piece,
): ir.Operand with (a: mem.Allocator) {
    val meth = piece.method.fn_node
    if meth == null {
        fail(L, null, "missing format method")
        return none_value()
    }
    var fn_ty = check.get_node_ty(meth!!)
    if fn_ty == null {
        val sym = check.get_node_sym(meth!!)
        if sym != null {
            fn_ty = check.get_sema(sym!!)
        }
    }
    if fn_ty == null {
        for pkg in L.prog.packages.items() {
            for mi in 0 as usize..pkg.methods.len {
                val ms = pkg.methods.at(mi)
                if ms.decl != null && (ms.decl!! as *u8) == (meth!! as *u8) {
                    fn_ty = check.get_sema(ms)
                    break
                }
            }
            if fn_ty != null {
                break
            }
        }
    }
    if fn_ty == null || !check.type_is_fn(fn_ty!!) || fn_ty!!.elems.len < 2 {
        fail(L, null, "missing format method type")
        return none_value()
    }
    val self_ty = fn_ty!!.elems.get(0)
    val buf_ty = fn_ty!!.elems.get(1)
    val ret = fn_ty!!.elem
    var index = find_fn(L, meth!!)
    if index < 0 {
        for i in 0 as usize..L.fns.len {
            val b = L.fns.at(i)
            if b.decl != null && (b.decl!! as *u8) == (meth!! as *u8) {
                index = b.index
                break
            }
        }
    }
    if index < 0 {
        fail(L, null, "missing format method fn")
        return none_value()
    }
    val pos = piece.pos
    val recv = user_receiver(L, piece.value, &piece.method, self_ty, pos)
    if L.failed {
        return none_value()
    }
    var ptr = ir.null_op(t.ptr_u8)
    var len = ir.int_op(t.usize, 0)
    if dst.kind != ir.operand_kinds().NULL {
        ptr = emit_elem_addr(L, dst, at_in, pos)
        len = emit_binop(L, ir.bin_ops().SUB, false, cap, at_in, t.usize, pos)
    }
    var bag = list.empty<ir.Operand>()
    bag.push(ptr)
    bag.push(len)
    val buf = emit_aggregate(L, buf_ty as *check.Type?, bag, pos)
    var args = list.empty<ir.Operand>()
    args.push(recv)
    args.push(buf)
    val result = call_extern_args(L, index, args, pos)
    if L.failed || ret == null || ret!!.kind != check.type_kinds().TUPLE || ret!!.elems.len < 2 {
        if !L.failed {
            fail(L, null, "format method result has no type")
        }
        return none_value()
    }
    val text = emit_extract(L, result, 0, ret!!.elems.get(0) as *check.Type?, pos)
    val err = emit_extract(L, result, 1, ret!!.elems.get(1) as *check.Type?, pos)
    val written = emit_extract(L, text, 1, t.usize, pos)
    val has = emit_extract(L, err, 0, t.boolean, pos)
    var at = emit_binop(L, ir.bin_ops().ADD, false, at_in, written, t.usize, pos)
    val has_i = emit_convert_ex(L, has, t.i32, pos, false)
    val old = emit_load(L, ovptr, pos)
    val flag = emit_binop(L, ir.bin_ops().OR, false, old, has_i, t.i32, pos)
    emit_store(L, ovptr, flag, pos)
    return at
}

private fn user_receiver(
    L: *Lower,
    value: ir.Operand,
    fmt: *FmtMethod,
    self_ty: *check.Type,
    pos: ir.Pos,
): ir.Operand with (a: mem.Allocator) {
    val from_ptr = value.ty != null && value.ty!!.kind == check.type_kinds().PTR
    var outer: *check.Type? = value.ty
    if from_ptr && value.ty!!.elem != null {
        outer = value.ty!!.elem
    }
    if outer == null {
        fail(L, null, "format method is missing a receiver")
        return none_value()
    }
    if fmt.path_len == 0 && !fmt.is_ptr {
        if !from_ptr {
            return value
        }
        val check_n = emit_inst(L, ir.op_kinds().NULL_CHECK, -1, pos)
        if check_n != null {
            check_n!!.a = value
        }
        // Prefer explicit self_ty like C load_op.
        val dst = new_local(L, "", self_ty as *check.Type?)
        val load = emit_inst(L, ir.op_kinds().LOAD, dst as i32, pos)
        if load != null {
            load!!.a = value
        }
        return local_operand(L, dst)
    }
    if fmt.path_len == 0 && fmt.is_ptr {
        if from_ptr {
            val check_n = emit_inst(L, ir.op_kinds().NULL_CHECK, -1, pos)
            if check_n != null {
                check_n!!.a = value
            }
            // C: const *T receiver from const ptr may need mutable copy.
            if self_ty.is_const || value.ty == null || !value.ty!!.is_const {
                return value
            }
            val loaded = emit_load(L, value, pos)
            val loc = as_local(L, loaded, pos)
            return emit_addr(L, loc.local, pos)
        }
        val loc = as_local(L, value, pos)
        return emit_addr(L, loc.local, pos)
    }
    var base = value
    if from_ptr {
        val check_n = emit_inst(L, ir.op_kinds().NULL_CHECK, -1, pos)
        if check_n != null {
            check_n!!.a = value
        }
        if value.ty != null && value.ty!!.is_const {
            val loaded = emit_load(L, value, pos)
            val loc = as_local(L, loaded, pos)
            base = emit_addr(L, loc.local, pos)
        } else {
            base = value
        }
    } else {
        val loc = as_local(L, value, pos)
        base = emit_addr(L, loc.local, pos)
    }
    var cur = outer!!
    var i: usize = 0
    for i < fmt.path_len as usize && !L.failed {
        val idx_u = path_at(fmt[0], i)
        base = emit_field_addr(L, base, idx_u, pos)
        if cur.kind == check.type_kinds().STRUCT {
            val n = check.type_field_count(cur)
            val idx = idx_u as usize
            if idx < n {
                val f = check.type_field_at(cur, idx)
                if f.field_type != null {
                    cur = f.field_type!!
                }
            }
        }
        i = i + 1
    }
    if L.failed {
        return none_value()
    }
    if !fmt.is_ptr {
        val dst = new_local(L, "", self_ty as *check.Type?)
        val load = emit_inst(L, ir.op_kinds().LOAD, dst as i32, pos)
        if load != null {
            load!!.a = base
        }
        return local_operand(L, dst)
    }
    return base
}

private fn format_all(
    L: *Lower,
    t: *FmtTypes,
    dst: ir.Operand,
    cap: ir.Operand,
    at_in: ir.Operand,
    ovptr: ir.Operand,
    pieces: list.List<*Piece>,
): ir.Operand with (a: mem.Allocator) {
    var at = at_in
    var i: usize = 0
    for i < pieces.len && !L.failed {
        at = format_piece(L, t, dst, cap, at, ovptr, pieces.get(i))
        i = i + 1
    }
    return at
}

private fn alloc_piece(): *Piece with (a: mem.Allocator) {
    val (raw, err) = a.alloc(size(Piece), align(Piece))
    if err != null {
        panic("out of memory")
    }
    val p = raw.ptr as *Piece
    p.value = none_value()
    p.kind = 0
    p.pos = ir.pos_of("", 0, 0)
    p.method = empty_method()
    return p
}

private fn collect_one(L: *Lower, node: *parse.Node, piece: *Piece): bool with (a: mem.Allocator) {
    piece[0].method = empty_method()
    val raw = lower_expr(L, node)
    piece[0].value = as_local(L, raw, node_pos(L, node))
    if L.failed || L.terminated {
        return false
    }
    var ty = piece[0].value.ty
    if ty == null {
        ty = check.get_node_ty(node)
    }
    var kind = piece_kind(ty)
    if kind == 0 && ty != null {
        val status = find_format_method(L, ty!!, &piece[0].method)
        if status == 1 {
            kind = piece_method()
        } else if status != 0 {
            fail(L, node, "type cannot be formatted")
            return false
        }
    }
    if kind == 0 {
        fail(L, node, "type cannot be formatted")
        return false
    }
    if kind == piece_method() && piece[0].method.fn_node == null {
        fail(L, node, "type cannot be formatted")
        return false
    }
    piece[0].kind = kind
    piece[0].pos = node_pos(L, node)
    return true
}

private fn collect_template(L: *Lower, tmpl: *parse.Node?, pieces: *list.List<*Piece>): bool with (a: mem.Allocator) {
    if tmpl == null {
        fail(L, null, "fmt template must be a string")
        return false
    }
    pieces[0] = list.empty<*Piece>()
    if parse.is_interp(tmpl!!) {
        // Copy kid pointers first so collect_one cannot invalidate an items() slice.
        var parts = list.empty<*parse.Node>()
        for part in tmpl!!.kids.items() {
            parts.push(part)
        }
        var pi: usize = 0
        for pi < parts.len {
            val part = parts.get(pi)
            val p = alloc_piece()
            p.pos = node_pos(L, part)
            if !collect_one(L, part, p) {
                return false
            }
            pieces[0].push(p)
            pi = pi + 1
        }
        return true
    }
    val p = alloc_piece()
    p.pos = node_pos(L, tmpl!!)
    if !collect_one(L, tmpl!!, p) {
        return false
    }
    pieces[0].push(p)
    return true
}

private fn overflow_flag(L: *Lower, t: *FmtTypes, ov: ir.Operand, pos: ir.Pos): ir.Operand with (a: mem.Allocator) {
    return emit_binop(L, ir.bin_ops().NE, false, ov, ir.int_op(t.i32, 0), t.boolean, pos)
}

private fn error_value(L: *Lower, t: *FmtTypes, iface: *check.Type?, pos: ir.Pos): ir.Operand with (a: mem.Allocator) {
    var empty = list.empty<*check.Type>()
    val fn_i = ensure_extern(L, "jogrt_fmt_error", empty, t.ptr_u8!!)
    var noargs = list.empty<ir.Operand>()
    val ptr = call_extern_args(L, fn_i, noargs, pos)
    if L.failed {
        return none_value()
    }
    var args = list.empty<ir.Operand>()
    args.push(ptr)
    args.push(ptr)
    return emit_aggregate(L, iface, args, pos)
}

private fn finish_fmt(
    L: *Lower,
    t: *FmtTypes,
    result: *check.Type?,
    ptr: ir.Operand,
    at: ir.Operand,
    ov: ir.Operand,
    pos: ir.Pos,
): ir.Operand with (a: mem.Allocator) {
    if result == null || result!!.kind != check.type_kinds().TUPLE || result!!.elems.len < 2 {
        fail(L, null, "fmt result has no type")
        return none_value()
    }
    val str_ty = result!!.elems.get(0) as *check.Type?
    val err_ty = result!!.elems.get(1) as *check.Type?
    var iface: *check.Type? = null
    if err_ty != null && err_ty!!.kind == check.type_kinds().OPTION {
        iface = err_ty!!.elem
    }
    var text_args = list.empty<ir.Operand>()
    text_args.push(ptr)
    text_args.push(at)
    val text = emit_aggregate(L, str_ty, text_args, pos)
    val has = overflow_flag(L, t, ov, pos)
    val err_iface = error_value(L, t, iface, pos)
    if L.failed {
        return none_value()
    }
    var err_args = list.empty<ir.Operand>()
    err_args.push(has)
    err_args.push(err_iface)
    val err_opt = emit_aggregate(L, err_ty, err_args, pos)
    var out_args = list.empty<ir.Operand>()
    out_args.push(text)
    out_args.push(err_opt)
    return emit_aggregate(L, result, out_args, pos)
}

private fn is_fmt_call(node: *parse.Node): bool {
    if !parse.is_call(node) || node.kids.len == 0 {
        return false
    }
    val callee = node.kids.get(0)
    return parse.is_ident(callee) && check.get_node_sym(callee) == null && callee.name == "fmt" &&
        callee.kids.len == 0
}

/** 1 when call is fmt; *out set. 0 when not. */
fn lower_string_call(L: *Lower, node: *parse.Node): (ir.Operand, bool) with (a: mem.Allocator) {
    if !is_fmt_call(node) {
        return none_value(), false
    }
    val pos = node_pos(L, node)
    val arg_end = parse.call_arg_end(node)
    if arg_end != 3 {
        fail(L, node, "fmt expects a buffer and a template")
        return none_value(), true
    }
    var buf_n = node.kids.get(1)
    var tmpl_n = node.kids.get(2)
    if parse.is_arg(buf_n) && buf_n.kids.len > 0 {
        buf_n = buf_n.kids.get(0)
    }
    if parse.is_arg(tmpl_n) && tmpl_n.kids.len > 0 {
        tmpl_n = tmpl_n.kids.get(0)
    }
    val (t0, tok) = load_fmt_types(L, pos)
    if !tok {
        return none_value(), true
    }
    // Heap FmtTypes so &t stays valid across nested calls (stage0/stack).
    val (traw, terr) = a.alloc(size(FmtTypes), align(FmtTypes))
    if terr != null {
        fail(L, node, "out of memory")
        return none_value(), true
    }
    val t = traw.ptr as *FmtTypes
    t[0] = t0
    var pieces = list.empty<*Piece>()
    if !collect_template(L, tmpl_n as *parse.Node?, &pieces) {
        return none_value(), true
    }
    val buffer = as_local(L, lower_expr(L, buf_n), node_pos(L, buf_n))
    if L.failed {
        return none_value(), true
    }
    val ptr = emit_extract(L, buffer, 0, t.ptr_u8, pos)
    val cap = emit_extract(L, buffer, 1, t.usize, pos)
    val (ov, ovptr, ook) = overflow_ptr(L, t, pos)
    if !ook {
        return none_value(), true
    }
    val at = format_all(L, t, ptr, cap, ir.int_op(t.usize, 0), ovptr, pieces)
    if L.failed {
        return none_value(), true
    }
    val out = finish_fmt(L, t, check.get_node_ty(node), ptr, at, ov, pos)
    return out, true
}

/** Lower `"a=${x}"` interpolation to a str. */
fn lower_string_interp(L: *Lower, node: *parse.Node): ir.Operand with (a: mem.Allocator) {
    if L.failed {
        return none_value()
    }
    val pos = node_pos(L, node)
    val (t0, tok) = load_fmt_types(L, pos)
    if !tok {
        return none_value()
    }
    val (traw, terr) = a.alloc(size(FmtTypes), align(FmtTypes))
    if terr != null {
        fail(L, node, "out of memory")
        return none_value()
    }
    val t = traw.ptr as *FmtTypes
    t[0] = t0
    var pieces = list.empty<*Piece>()
    if !collect_template(L, node as *parse.Node?, &pieces) {
        return none_value()
    }
    val (ov, ovptr, ook) = overflow_ptr(L, t, pos)
    if !ook {
        return none_value()
    }
    val measured = format_all(L, t, ir.null_op(t.ptr_u8), ir.int_op(t.usize, 0), ir.int_op(t.usize, 0), ovptr, pieces)
    if L.failed {
        return none_value()
    }
    var ap = list.empty<*check.Type>()
    ap.push(t.usize!!)
    val alloc_fn = ensure_extern(L, "jogrt_fmt_alloc", ap, t.ptr_u8!!)
    var aargs = list.empty<ir.Operand>()
    aargs.push(measured)
    val ptr = call_extern_args(L, alloc_fn, aargs, pos)
    if L.failed {
        return none_value()
    }
    val nc = emit_inst(L, ir.op_kinds().NULL_CHECK, -1, pos)
    if nc != null {
        nc!!.a = ptr
    }
    val at = format_all(L, t, ptr, measured, ir.int_op(t.usize, 0), ovptr, pieces)
    if L.failed {
        return none_value()
    }
    var ty = check.get_node_ty(node)
    if ty == null {
        ty = check.type_const_bytes(L.types) as *check.Type?
    }
    var args = list.empty<ir.Operand>()
    args.push(ptr)
    args.push(at)
    return emit_aggregate(L, ty, args, pos)
}
