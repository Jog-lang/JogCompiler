// Globals + init. Checked against compiler/src/lower_global.c / declare_globals.

import src.check
import src.ir
import src.load
import src.parse
import std.list
import std.mem
import std.strbuilder

fn find_global(L: *Lower, symbol: *load.Symbol): i32 {
    for i in 0 as usize..L.globals.len {
        val b = L.globals.at(i)
        if b.symbol != null && b.symbol!! == symbol {
            return b.index
        }
    }
    // Fallback: same name (assign targets may not share the exact pointer).
    if symbol.name.len > 0 {
        for i in 0 as usize..L.globals.len {
            val b = L.globals.at(i)
            if b.symbol != null && b.symbol!!.name == symbol.name {
                return b.index
            }
        }
    }
    return -1
}

fn find_global_by_name(L: *Lower, name: str): i32 {
    if name.len == 0 {
        return -1
    }
    for i in 0 as usize..L.globals.len {
        val b = L.globals.at(i)
        if b.symbol != null && b.symbol!!.name == name {
            return b.index
        }
        val g = ir.global_at(&L.module, b.index as u32)
        if g != null && g!!.name.len >= name.len {
            // mangled ends with __name — last resort unused; prefer symbol.name
        }
    }
    return -1
}

fn global_operand(L: *Lower, index: u32): ir.Operand with (a: mem.Allocator) {
    return ir.global_ref(&L.module, index)
}

private fn binding_init_node(node: *parse.Node): *parse.Node? {
    if node.kids.len == 0 {
        return null
    }
    if node.kids.len == 1 {
        val only = node.kids.get(0)
        if parse.is_type_name(only) || parse.is_type_ptr(only) || parse.is_type_slice(only) ||
            parse.is_type_array(only) || parse.is_type_option(only) || parse.is_type_tuple(only) ||
            parse.is_type_fn(only) || parse.is_type_unit(only) {
            return null
        }
        return only as *parse.Node?
    }
    return node.kids.get(node.kids.len - 1) as *parse.Node?
}

private fn parse_u64_text(text: str): u64 {
    var v: u64 = 0
    var i: usize = 0
    if text.len >= 2 && text.ptr[0] == '0' as u8 && (text.ptr[1] == 'x' as u8 || text.ptr[1] == 'X' as u8) {
        i = 2
        for i < text.len {
            val c = text.ptr[i]
            var d: u64 = 0
            if c >= '0' as u8 && c <= '9' as u8 {
                d = (c - ('0' as u8)) as u64
            } else if c >= 'a' as u8 && c <= 'f' as u8 {
                d = (10 as u64) + (c - ('a' as u8)) as u64
            } else if c >= 'A' as u8 && c <= 'F' as u8 {
                d = (10 as u64) + (c - ('A' as u8)) as u64
            } else {
                break
            }
            v = v * 16 + d
            i = i + 1
        }
        return v
    }
    for i < text.len {
        val c = text.ptr[i]
        if c < '0' as u8 || c > '9' as u8 {
            break
        }
        v = v * 10 + (c - ('0' as u8)) as u64
        i = i + 1
    }
    return v
}

private fn write_le_bytes(dst: *list.List<u8>, bits: u64, n: usize) with (a: mem.Allocator) {
    var v = bits
    var i: usize = 0
    for i < n {
        dst.push((v & 0xff) as u8)
        v = v / 256
        i = i + 1
    }
}

private fn parse_float_text_place(text: str): f64 {
    var i: usize = 0
    var neg = false
    var v: f64 = 0.0
    if text.len > 0 && text.ptr[0] == '-' as u8 {
        neg = true
        i = 1
    }
    for i < text.len {
        val c = text.ptr[i]
        if c >= '0' as u8 && c <= '9' as u8 {
            v = v * 10.0 + ((c - '0' as u8) as f64)
            i = i + 1
            continue
        }
        break
    }
    if i < text.len && text.ptr[i] == '.' as u8 {
        i = i + 1
        var place: f64 = 0.1
        for i < text.len {
            val c = text.ptr[i]
            if c < '0' as u8 || c > '9' as u8 {
                break
            }
            v = v + ((c - '0' as u8) as f64) * place
            place = place * 0.1
            i = i + 1
        }
    }
    if neg {
        return -v
    }
    return v
}

private fn eval_float_for_place(node: *parse.Node): (f64, bool) {
    if parse.is_float_lit(node) {
        return parse_float_text_place(node.text), true
    }
    if parse.is_unary(node) && node.text == "-" && node.kids.len > 0 {
        val (inner, ok) = eval_float_for_place(node.kids.get(0))
        if !ok {
            return 0.0, false
        }
        return -inner, true
    }
    if parse.is_binary(node) && node.kids.len >= 2 {
        val (lhs, lok) = eval_float_for_place(node.kids.get(0))
        if !lok {
            return 0.0, false
        }
        val (rhs, rok) = eval_float_for_place(node.kids.get(1))
        if !rok {
            return 0.0, false
        }
        val op = node.text
        if op == "+" {
            return lhs + rhs, true
        }
        if op == "-" {
            return lhs - rhs, true
        }
        if op == "*" {
            return lhs * rhs, true
        }
        if op == "/" {
            if rhs == 0.0 {
                return 0.0, false
            }
            return lhs / rhs, true
        }
    }
    return 0.0, false
}

private fn const_int_bits(node: *parse.Node): (u64, bool) {
    if parse.is_int_lit(node) {
        return parse_u64_text(node.text), true
    }
    if parse.is_unary(node) && node.kids.len > 0 {
        val (inner, ok) = const_int_bits(node.kids.get(0))
        if !ok {
            return 0, false
        }
        if node.text == "-" {
            return (0 as u64) - inner, true
        }
        if node.text == "~" {
            return ~inner, true
        }
    }
    if parse.is_binary(node) && node.kids.len >= 2 {
        val (l, lok) = const_int_bits(node.kids.get(0))
        val (r, rok) = const_int_bits(node.kids.get(1))
        if !lok || !rok {
            return 0, false
        }
        if node.text == "+" {
            return l + r, true
        }
        if node.text == "-" {
            return l - r, true
        }
        if node.text == "*" {
            return l * r, true
        }
        if node.text == "&" {
            return l & r, true
        }
        if node.text == "|" {
            return l | r, true
        }
        if node.text == "^" {
            return l ^ r, true
        }
    }
    return 0, false
}

/**
 * Place a constant image (float shortcut + C jog_lower_global_place).
 */
private fn place_global_image(L: *Lower, g: *ir.Global, init: *parse.Node): bool with (a: mem.Allocator) {
    if g.ty == null {
        return false
    }
    val ty = g.ty!!
    if !check.type_layout(L.types, ty) || !ty.has_layout {
        return false
    }
    val tk = check.type_kinds()
    val size = ty.size as usize
    if ty.kind == tk.FLOAT && check.is_float_lit_tree(init) {
        val (value, ok) = eval_float_for_place(init)
        if !ok {
            return false
        }
        var bits: u64 = 0
        if ty.float_bits == 32 && size == 4 {
            var narrow: f32 = value as f32
            val p: *u8 = &narrow as *u8
            var i: usize = 0
            for i < 4 {
                bits = bits | ((p[i] as u64) << ((i as u64) * 8))
                i = i + 1
            }
        } else if ty.float_bits == 64 && size == 8 {
            var wide: f64 = value
            val p: *u8 = &wide as *u8
            var i: usize = 0
            for i < 8 {
                bits = bits | ((p[i] as u64) << ((i as u64) * 8))
                i = i + 1
            }
        } else {
            return false
        }
        g.data = list.empty<u8>()
        write_le_bytes(&g.data, bits, size)
        g.has_data = true
        g.data_len = size
        return true
    }
    return commit_place_image(L, g, init)
}

private fn declare_one_global(
    L: *Lower,
    pkg: *load.Package,
    decl: *parse.Node,
    sym: *load.Symbol?,
    gty: *check.Type?,
    init: *parse.Node?,
    name_override: str,
    part: i32,
) with (a: mem.Allocator) {
    var ty = gty
    if ty == null && sym != null {
        ty = check.get_sema(sym!!)
    }
    if ty == null {
        fail(L, decl, "global has no type")
        return
    }
    var name = strbuilder.empty()
    if name_override.len > 0 {
        name.append("jog_")
        append_c_piece(&name, pkg_source(L, pkg))
        name.append("__")
        append_c_piece(&name, name_override)
    } else {
        name.append(strbuilder_mangle_global(L, pkg, decl))
    }
    val is_const = parse.is_val(decl) || parse.is_context(decl)
    val index = ir.global_add(&L.module, name.str(), ty, is_const)
    if index < 0 {
        fail(L, decl, "out of memory")
        return
    }
    val g = ir.global_at(&L.module, index as u32)
    if g != null {
        g!!.pos = node_pos(L, decl)
    }
    var b: GlobalBind
    b.symbol = sym
    b.index = index
    b.decl = decl as *parse.Node?
    // Defer const place so later pieces can copy earlier images (&n, (c,d)=point).
    b.runtime = init != null
    b.part = part
    L.globals.push(b)
}

private fn first_of_decl(L: *Lower, index: usize): bool {
    val bind = L.globals.at(index)
    if bind.decl == null {
        return false
    }
    var i: usize = 0
    for i < index {
        val earlier = L.globals.at(i)
        if earlier.decl != null && earlier.decl!! == bind.decl!! {
            return false
        }
        i = i + 1
    }
    return true
}

private fn place_group(L: *Lower, decl: *parse.Node): bool with (a: mem.Allocator) {
    val init = binding_init_node(decl)
    if init != null && parse.is_ident(init!!) {
        val sym = check.get_node_sym(init!!)
        if sym == null {
            return false
        }
        val gi = find_global(L, sym!!)
        if gi < 0 {
            return false
        }
        var src_runtime = true
        var bi: usize = 0
        for bi < L.globals.len {
            if L.globals.at(bi).index == gi {
                src_runtime = L.globals.at(bi).runtime
                break
            }
            bi = bi + 1
        }
        if src_runtime {
            return false
        }
        val src = ir.global_at(&L.module, gi as u32)
        if src == null || src!!.ty == null {
            return false
        }
        val tuple = peel_global_type(src!!.ty)
        if tuple == null || tuple!!.kind != check.type_kinds().TUPLE {
            return false
        }
        val count = check.binding_name_count(decl)
        if tuple!!.elems.len != count {
            return false
        }
        bi = 0
        for bi < L.globals.len {
            val bind = L.globals.at(bi)
            if bind.decl == null || bind.decl!! != decl || bind.part < 0 {
                bi = bi + 1
                continue
            }
            val part = bind.part as usize
            val elem = tuple!!.elems.get(part)
            val (off, ok) = tuple_elem_offset(tuple!!, part)
            if !ok || !check.type_layout(L.types, elem) {
                return false
            }
            val dst = ir.global_at(&L.module, bind.index as u32)
            if dst == null {
                return false
            }
            if !copy_tuple_piece_image(dst!!, src!!, off as usize, elem.size as usize) {
                return false
            }
            bi = bi + 1
        }
        bi = 0
        for bi < L.globals.len {
            if L.globals.at(bi).decl != null && L.globals.at(bi).decl!! == decl {
                L.globals.at(bi).runtime = false
            }
            bi = bi + 1
        }
        return true
    }
    if init == null || !parse.is_tuple(init!!) {
        return false
    }
    var all = true
    var bi: usize = 0
    for bi < L.globals.len {
        val bind = L.globals.at(bi)
        if bind.decl == null || bind.decl!! != decl || bind.part < 0 {
            bi = bi + 1
            continue
        }
        val part = bind.part as usize
        if part >= init!!.kids.len {
            all = false
            break
        }
        val g = ir.global_at(&L.module, bind.index as u32)
        if g == null || !place_global_image(L, g!!, init!!.kids.get(part)) {
            all = false
            break
        }
        bi = bi + 1
    }
    if !all {
        bi = 0
        for bi < L.globals.len {
            if L.globals.at(bi).decl != null && L.globals.at(bi).decl!! == decl {
                val g = ir.global_at(&L.module, L.globals.at(bi).index as u32)
                if g != null {
                    clear_place_image(g!!)
                }
            }
            bi = bi + 1
        }
        return false
    }
    bi = 0
    for bi < L.globals.len {
        if L.globals.at(bi).decl != null && L.globals.at(bi).decl!! == decl {
            L.globals.at(bi).runtime = false
        }
        bi = bi + 1
    }
    return true
}

private fn place_declared(L: *Lower) with (a: mem.Allocator) {
    var i: usize = 0
    for i < L.globals.len {
        val bind = L.globals.at(i)
        if !bind.runtime || bind.decl == null {
            i = i + 1
            continue
        }
        if bind.part >= 0 {
            if first_of_decl(L, i) {
                place_group(L, bind.decl!!)
            }
            i = i + 1
            continue
        }
        val init = binding_init_node(bind.decl!!)
        if init == null {
            L.globals.at(i).runtime = false
            i = i + 1
            continue
        }
        val g = ir.global_at(&L.module, bind.index as u32)
        if g != null && place_global_image(L, g!!, init!!) {
            L.globals.at(i).runtime = false
        }
        i = i + 1
    }
}

fn declare_globals(L: *Lower) with (a: mem.Allocator) {
    for pi in 0 as usize..L.prog.packages.len {
        val pkg = L.prog.packages.get(pi)
        for fi in 0 as usize..pkg.files.len {
            val source = pkg.files.get(fi)
            if source.ast == null {
                continue
            }
            L.file = source.path
            val root = source.ast!!
            for decl in root.kids.items() {
                if !(parse.is_val(decl) || parse.is_var(decl) || parse.is_context(decl)) {
                    continue
                }
                if parse.flag_has_word(decl.flag, "expect") {
                    continue
                }
                val init = binding_init_node(decl)
                if check.binding_is_multi(decl) {
                    val count = check.binding_name_count(decl)
                    val tuple = check.get_node_ty(decl)
                    var i: usize = 0
                    for i < count {
                        val nm = check.binding_name_at(decl, i)
                        if nm.len == 0 || nm == "_" {
                            i = i + 1
                            continue
                        }
                        var sym = load.package_scope_lookup(&pkg.scope, nm)
                        if sym == null {
                            sym = load.file_lookup(&pkg.scope, fi, nm)
                        }
                        var gty: *check.Type? = null
                        if tuple != null && tuple!!.kind == check.type_kinds().TUPLE && i < tuple!!.elems.len {
                            gty = tuple!!.elems.get(i)
                        }
                        if gty == null && sym != null {
                            gty = check.get_sema(sym!!)
                        }
                        declare_one_global(L, pkg, decl, sym, gty, init, nm, i as i32)
                        i = i + 1
                    }
                    continue
                }
                var gty = check.get_node_ty(decl)
                var sym = check.get_node_sym(decl)
                if sym == null && decl.name.len > 0 {
                    sym = load.package_scope_lookup(&pkg.scope, decl.name)
                    if sym == null {
                        sym = load.file_lookup(&pkg.scope, fi, decl.name)
                    }
                }
                if gty == null && sym != null {
                    gty = check.get_sema(sym!!)
                }
                declare_one_global(L, pkg, decl, sym, gty, init, "", -1)
                if L.failed {
                    return
                }
            }
        }
    }
    place_declared(L)
    // C: comptime_vals runs before lower_init; build init after fold.
}

/**
 * Runtime global inits in reverse declaration order (works for forward refs like
 * `second = first + …` when `first` is declared later).
 */
fn build_init_func(L: *Lower) with (a: mem.Allocator) {
    var runtime = list.empty<usize>()
    var i: usize = 0
    for i < L.globals.len {
        if L.globals.at(i).runtime {
            runtime.push(i)
        }
        i = i + 1
    }
    if runtime.len == 0 {
        return
    }
    val unit = check.type_unit(L.types)
    var params = list.empty<*check.Type>()
    var contexts = list.empty<*check.Type>()
    val fn_ty = check.type_fn(L.types, params, unit, contexts, false, false, false)
    var empty_names = list.empty<str>()
    var c_name = strbuilder.empty()
    c_name.append("jog_")
    if L.root_pkg != null {
        append_c_piece(&c_name, pkg_source(L, L.root_pkg!!))
    } else {
        c_name.append("main")
    }
    c_name.append("__0init")
    var jog_name = strbuilder.empty()
    if L.root_pkg != null {
        jog_name.append(pkg_source(L, L.root_pkg!!))
    } else {
        jog_name.append("main")
    }
    jog_name.append(".init")
    val index = ir.func_add(&L.module, c_name.str(), jog_name.str(), ir.linkages().INTERNAL, fn_ty, empty_names)
    if index < 0 {
        fail(L, null, "out of memory")
        return
    }
    L.module.init_func = index
    L.func = ir.func_at(&L.module, index as u32)
    L.locals = list.empty<LocalBind>()
    L.loops = list.empty<LoopFrame>()
    L.overlays = list.empty<Overlay>()
    L.cleanups = list.empty<Cleanup>()
    L.in_cleanup = false
    L.terminated = false
    L.ast_fn = null
    val entry = new_block(L, "entry")
    use_block(L, entry)
    // Reverse declaration order among runtime globals.
    var step = runtime.len
    for step > 0 {
        step = step - 1
        val gi = runtime.get(step)
        val bind = L.globals.at(gi)
        if bind.decl == null {
            continue
        }
        // Multi-bind: lower the shared RHS once (first piece only).
        if bind.part > 0 {
            continue
        }
        val decl = bind.decl!!
        val init = binding_init_node(decl)
        if init == null {
            continue
        }
        if check.binding_is_multi(decl) {
            // Shared RHS into each piece by extract — simplified: lower whole tuple then extract.
            val raw = lower_expr(L, init!!)
            if L.failed || L.terminated {
                return
            }
            val held = hold_value_global(L, raw, raw.ty, node_pos(L, init!!))
            val count = check.binding_name_count(decl)
            var pi: usize = 0
            for pi < count {
                val nm = check.binding_name_at(decl, pi)
                if nm.len == 0 || nm == "_" {
                    pi = pi + 1
                    continue
                }
                // Find global with this name among pieces of this decl.
                var gj: usize = 0
                for gj < L.globals.len {
                    val gb = L.globals.at(gj)
                    if gb.decl != null && gb.decl!! == decl && gb.symbol != null && gb.symbol!!.name == nm {
                        var elem: *check.Type? = null
                        if held.ty != null && held.ty!!.kind == check.type_kinds().TUPLE &&
                            pi < held.ty!!.elems.len {
                            elem = held.ty!!.elems.get(pi)
                        }
                        val field = emit_extract(L, held, pi as u32, elem, node_pos(L, init!!))
                        store_global(L, gb.index as u32, field, node_pos(L, init!!))
                        break
                    }
                    gj = gj + 1
                }
                pi = pi + 1
            }
        } else {
            val value = lower_expr(L, init!!)
            if L.failed || L.terminated {
                return
            }
            store_global(L, bind.index as u32, value, node_pos(L, init!!))
        }
        if L.failed {
            return
        }
    }
    if !L.terminated {
        emit_ret(L, none_value(), ir.pos_none())
    }
    L.func = null
}

private fn hold_value_global(L: *Lower, src: ir.Operand, ty: *check.Type?, pos: ir.Pos): ir.Operand with (a: mem.Allocator) {
    var use_ty = ty
    if use_ty == null {
        use_ty = src.ty
    }
    val dst = new_local(L, "", use_ty)
    emit_copy(L, dst, src, pos)
    return local_operand(L, dst)
}

private fn strbuilder_mangle_global(L: *Lower, pkg: *load.Package, decl: *parse.Node): str with (a: mem.Allocator) {
    var b = strbuilder.empty()
    b.append("jog_")
    append_c_piece(&b, pkg_source(L, pkg))
    b.append("__")
    if decl.name.len > 0 {
        append_c_piece(&b, decl.name)
    } else {
        b.append("g")
    }
    return b.str()
}

// Re-export helpers used from body (name lookup).
fn lower_global_name(L: *Lower, symbol: *load.Symbol): (ir.Operand, bool) with (a: mem.Allocator) {
    val index = find_global(L, symbol)
    if index < 0 {
        return none_value(), false
    }
    // Use of a global loads through its address (copy of global ref value?).
    // C lower_name for globals: load from global address / or copy gN for by-value.
    // Dump shows `copy gN` for `var p: *i32 = &n` — taking address uses global ref;
    // reading n as value loads. For `&n`, value_addr uses global_ref directly.
    return global_operand(L, index as u32), true
}

fn global_addr(L: *Lower, symbol: *load.Symbol): (ir.Operand, bool) with (a: mem.Allocator) {
    return lower_global_name(L, symbol)
}

fn load_global(L: *Lower, index: u32, pos: ir.Pos): ir.Operand with (a: mem.Allocator) {
    val g = ir.global_at(&L.module, index)
    var ty: *check.Type? = null
    if g != null {
        ty = g!!.ty
    }
    val dst = new_local(L, "", ty)
    val addr = ir.global_ref(&L.module, index)
    val inst = emit_inst(L, ir.op_kinds().LOAD, dst as i32, pos)
    if inst != null {
        inst!!.a = addr
    }
    return local_operand(L, dst)
}

fn store_global(L: *Lower, index: u32, value: ir.Operand, pos: ir.Pos) with (a: mem.Allocator) {
    val addr = ir.global_ref(&L.module, index)
    emit_store(L, addr, value, pos)
}
